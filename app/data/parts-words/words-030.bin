ʿu","(is) the All-Hearer"],["l-ʿalīmu","the All-Knower"]],"s":[[50,1920],[1930,1980],[1990,3520],[3530,5110],[5120,5550],[5560,6600],[6610,8920]]},"4421":{"m":[0,1,2,3,4,6,7,8],"w":[["rabbi","Lord"],["l-samāwāti","(of) the heavens"],["wal-arḍi","and the earth"],["wamā","and whatever"],["baynahumā","(is) between both of them"],["in","if"],["kuntum","you are"],["mūqinīna","certain"]],"s":[[30,540],[550,2090],[2100,3100],[3110,3690],[3700,5630],[5640,7220],[7230,10140],[10150,12850]]},"4422":{"m":[0,1,2,3,4,5,7,8,9,10],"w":[["lā","(There is) no"],["ilāha","god"],["illā","except"],["huwa","Him"],["yuḥ'yī","He gives life"],["wayumītu","and causes death"],["rabbukum","your Lord"],["warabbu","and (the) Lord"],["ābāikumu","(of) your fathers"],["l-awalīna","the former"]],"s":[[30,2230],[2240,3080],[3090,3910],[3920,4360],[4370,5240],[5250,8050],[8060,9110],[9120,9960],[9970,13100],[13110,15910]]},"4423":{"m":[0,1,2,3,4],"w":[["bal","Nay"],["hum","they"],["fī","(are) in"],["shakkin","doubt"],["yalʿabūna","playing"]],"s":[[100,470],[480,860],[870,1300],[1310,2880],[2890,5830]]},"4424":{"m":[0,1,2,3,4,5],"w":[["fa-ir'taqib","Then watch"],["yawma","(for the) Day"],["tatī","(when) will bring"],["l-samāu","the sky"],["bidukhānin","smoke"],["mubīnin","visible"]],"s":[[30,990],[1000,1580],[1590,2230],[2240,4940],[4950,5980],[5990,9290]]},"4425":{"m":[0,1,3,4,5],"w":[["yaghshā","Enveloping"],["l-nāsa","the people"],["hādhā","This"],["ʿadhābun","(will be) a punishment"],["alīmun","painful"]],"s":[[80,740],[750,4850],[4860,5650],[5660,6710],[6720,9140]]},"4426":{"m":[0,1,2,3,4,5],"w":[["rabbanā","Our Lord"],["ik'shif","Remove"],["ʿannā","from us"],["l-ʿadhāba","the punishment"],["innā","indeed, we"],["mu'minūna","(are) believers"]],"s":[[40,780],[790,1400],[1410,2750],[2760,3870],[3880,5550],[5560,8150]]},"4427":{"m":[0,1,2,3,4,5,6],"w":[["annā","How can"],["lahumu","(there be) for them"],["l-dhik'rā","the reminder"],["waqad","when verily"],["jāahum","had come to them"],["rasūlun","a M