اجًۭا وَهَّاجًۭا","e":"And made [therein] a burning lamp","j":30,"p":582,"r":518,"h":233,"w":3,"u":"اور (آفتاب کا) روشن چراغ بنایا","s":"او مونږ روښانه ځلېدونكې ډېوه پیدا كړې ده","a":"and have placed [therein the sun,] a lamp full of blazing splendour."},{"n":14,"g":5686,"t":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا","e":"And sent down, from the rain clouds, pouring water","j":30,"p":582,"r":518,"h":233,"w":5,"u":"اور نچڑتے بادلوں سے موسلا دھار مینہ برسایا","s":"او مونږ له ډكو ورېځو نه ډېرې تويېدونكې اوبه نازلې كړې دي","a":"And from the wind-driven clouds We send down waters pouring in abundance,"},{"n":15,"g":5687,"t":"لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا","e":"That We may bring forth thereby grain and vegetation","j":30,"p":582,"r":518,"h":233,"w":4,"u":"تاکہ اس سے اناج اور سبزہ پیدا کریں","s":"د دې لپاره چې مونږ په دغو (اوبو) سره دانې او زرغونه راوباسو","a":"so that We might bring forth thereby grain, and herbs,"},{"n":16,"g":5688,"t":"وَجَنَّٰتٍ أَلْفَافًا","e":"And gardens of entwined growth.","j":30,"p":582,"r":518,"h":233,"w":2,"u":"اور گھنے گھنے باغ","s":"او باغونه یو له بل سره نژدې","a":"and gardens dense with follage."},{"n":17,"g":5689,"t":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا","e":"Indeed, the Day of Judgement is an appointed time -","j":30,"p":582,"r":518,"h":233,"w":5,"u":"بےشک فیصلہ کا دن مقرر ہے","s":"بېشكه د فیصلې ورځ مقرر وخت دى","a":"VERILY, the Day of Distinction [between the true and the false] has indeed its appointed time:"},{"n":18,"g":5690,"t":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا","e":"The Day the Horn is blown and you will come forth in multitudes","j":30,"p":582,"r":518,"h":233,"w":6,"u":"جس دن صور پھونکا جائے گا تو تم لوگ غٹ کے غٹ آ موجود ہو گے","s":"هغه ورځ چې پوكى به ووهل شي په شپېلۍ كې، نو تاسو به ډلې ډلې راځئ","a":"the Day when the trumpet [of resurrection] is sounded and you all come forward in multitudes;"},{"n":19,"g":5691,"t":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا","e":"And the heaven is opened and will become gateways","j":30,"p":582,"r":518,"h":233,"w":4,"u":"اور آسمان کھولا جائے گا تو (اس میں) دروازے ہو جائیں گے","s":"او اسمان به پرانستل شي، نو دى به دروازې دروازې وي","a":"and when the skies are opened and become [as wide-flung] gates;"},{"n":20,"g":5692,"t":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","e":"And the mountains are removed and will be [but] a mirage.","j":30,"p":582,"r":518,"h":233,"w":4,"u":"اور پہاڑ چلائے جائیں گے تو وہ ریت ہو کر رہ جائیں گے","s":"او غرونه به روان كړى شي، نو دوى به سراب شي","a":"and when the mountains are made to vanish as if they had been a mirage."},{"n":21,"g":5693,"t":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا","e":"Indeed, Hell has been lying in wait","j":30,"p":582,"r":518,"h":233,"w":4,"u":"بےشک دوزخ گھات میں ہے","s":"بېشكه دوزخ به د انتظار ځاى (كمین ځاى) شي","a":"[On that Day,] verily, hell will lie in wait [for those who deny the truth] –"},{"n":22,"g":5694,"t":"لِّلطَّٰغِينَ مَـَٔابًۭا","e":"For the transgressors, a place of return,","j":30,"p":582,"r":518,"h":233,"w":2,"u":"(یعنی) سرکشوں کا وہی ٹھکانہ ہے","s":"د سركشو لپاره د ورتللو ځاى","a":"a goal for all who are wont to transgress the bounds of what is right!"},{"n":23,"g":5695,"t":"لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا","e":"In which they will remain for ages [unending].","j":30,"p":582,"r":518,"h":233,"w":3,"u":"اس میں وہ مدتوں پڑے رہیں گے","s":"چې دوى به په هغه كې زمانې زمانې (همېشه) پاتې كېږي","a":"In it shall they remain for a long time."},{"n":24,"g":5696,"t":"لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا","e":"They will not taste therein [any] coolness or drink","j":30,"p":582,"r":518,"h":233,"w":6,"u":"وہاں نہ ٹھنڈک کا مزہ چکھیں گے۔ نہ (کچھ) پینا (نصیب ہو گا)","s":"دوى به په هغه كې نه څه یخوالى څَكي او نه څه اوبه","a":"Neither coolness shall they taste therein nor any [thirst-quenching] drink –"},{"n":25,"g":5697,"t":"إِلَّا حَمِيمًۭا وَغَسَّاقًۭا","e":"Except scalding water and [foul] purulence -","j":30,"p":582,"r":518,"h":233,"w":3,"u":"مگر گرم پانی اور بہتی پیپ","s":"غیر د اېشېدلو تودو اوبو او بهېدونكو وینو زوو نه","a":"only burning despair and ice-cold darkness:"},{"n":26,"g":5698,"t":"جَزَآءًۭ وِفَاقًا","e":"An appropriate recompense.","j":30,"p":582,"r":518,"h":233,"w":2,"u":"(یہ) بدلہ ہے پورا پورا","s":"بدله به وركولى شي د عملونو سره برابره موافقه","a":"a meet requital [for their sins]!"},{"n":27,"g":5699,"t":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا","e":"Indeed, they were not expecting an account","j":30,"p":582,"r":518,"h":233,"w":5,"u":"یہ لوگ حساب (آخرت) کی امید ہی نہیں رکھتے تھے","s":"بېشكه دوى به د حساب امېد نه كاوه","a":"Behold, they were not expecting to be called to account,"},{"n":28,"g":5700,"t":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا","e":"And denied Our verses with [emphatic] denial.","j":30,"p":582,"r":518,"h":233,"w":3,"u":"اور ہماری آیتوں کو جھوٹ سمجھ کر جھٹلاتے رہتے تھے","s":"او زمونږ ایتونه به يې دروغ ګڼل، سخت دروغ ګڼل","a":"having given the lie to Our messages one and all:"},{"n":29,"g":5701,"t":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا","e":"But all things We have enumerated in writing.","j":30,"p":582,"r":518,"h":233,"w":4,"u":"اور ہم نے ہر چیز کو لکھ کر ضبط کر رکھا ہے","s":"او هر شى، مونږ هغه په كتاب (لوح محفوظ) كې شمېرلى (او محفوظ كړى) دى","a":"but We have placed on record every single thing [of what they did]."},{"n":30,"g":5702,"t":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","e":"\"So taste [the penalty], and never will We increase you except in torment.\"","j":30,"p":582,"r":518,"h":233,"w":5,"u":"سو (اب) مزہ چکھو۔ ہم تم پر عذاب ہی بڑھاتے جائیں گے","s":"نو تاسو (خپله سزا) وڅَكئ۔، پس مونږ به تاسو ته له سره زیات نه كړو مګر عذاب","a":"[And so We shall say:] \"Taste, then, [the fruit of your evil doings,] for now We shall bestow on you nothing but more and more suffering!\""},{"n":31,"g":5703,"t":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","e":"Indeed, for the righteous is attainment -","j":30,"p":583,"r":519,"h":233,"w":3,"u":"بے شک پرہیز گاروں کے لیے کامیابی ہے","s":"بېشكه خاص د متقیانو لپاره كامیابي ده","a":"[But,] verily for the God-conscious there is supreme fulfilment in store:"},{"n":32,"g":5704,"t":"حَدَآئِقَ وَأَعْنَٰبًۭا","e":"Gardens and grapevines","j":30,"p":583,"r":519,"h":233,"w":2,"u":"(یعنی) باغ اور انگور","s":"(چې) باغونه او انګور دي","a":"luxuriant gardens and vinyards,"},{"n":33,"g":5705,"t":"وَكَوَاعِبَ أَتْرَابًۭا","e":"And full-breasted [companions] of equal age","j":30,"p":583,"r":519,"h":233,"w":2,"u":"اور ہم عمر نوجوان عورتیں","s":"او انارسینه همځولې پېغلې دي","a":"and splendid companions well matched,"},{"n":34,"g":5706,"t":"وَكَأْسًۭا دِهَاقًۭا","e":"And a full cup.","j":30,"p":583,"r":519,"h":233,"w":2,"u":"اور شراب کے چھلکتے ہوئے گلاس","s":"او ترڅنډو پورې ډكې د شرابو پیالې دي","a":"and a cup [of happiness] overflowing."},{"n":35,"g":5707,"t":"لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا","e":"No ill speech will they hear therein or any falsehood -","j":30,"p":583,"r":519,"h":233,"w":6,"u":"وہاں نہ بیہودہ بات سنیں گے نہ جھوٹ (خرافات)","s":"دوى په دغه (جنت) كې نه لغوه (بېكاره) خبره اوري او نه دروغ","a":"No empty talk will they hear in that [paradise], nor any lie."},{"n":36,"g":5708,"t":"جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا","e":"[As] reward from your Lord, [a generous] gift [made due by] account,","j":30,"p":583,"r":519,"h":233,"w":5,"u":"یہ تمہارے پروردگار کی طرف سے صلہ ہے انعام کثیر","s":"د رب له جانبه به بدله وركولى شي۔ (د عملونو) په حساب سره ډېره وركړه","a":"[All this will be] a reward from thy Sustainer, a gift in accordance with [His Own] reckoning –"},{"n":37,"g":5709,"t":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا","e":"[From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech.","j":30,"p":583,"r":519,"h":233,"w":11,"u":"وہ جو آسمانوں اور زمین اور جو ان دونوں میں ہے سب کا مالک ہے بڑا مہربان کسی کو اس سے بات کرنے کا یارا نہیں ہوگا","s":"چې د اسمانونو او ځمكې رب دى او د هغه څه چې د دغو دواړو په مینځ كې دي، چې ډېر زیات مهربان دى، دوى له هغه سره د خبرو كولو اختیار (او قدرت) نه لري","a":"[a reward from] the Sustainer of the heavens and the earth and all that is between them, the Most Gracious! [And] none shall have it in their power to raise their voices unto Him"},{"n":38,"g":5710,"t":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا","e":"The Day that the Spirit and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.","j":30,"p":583,"r":519,"h":233,"w":15,"u":"جس دن روح (الامین) اور فرشتے صف باندھ کر کھڑے ہوں گے تو کوئی بول نہ سکے گا مگر جس کو (خدائے رحمٰن) اجازت بخشے اور اس نے بات بھی درست کہی ہو","s":"په هغې ورځ كې چې روح او ملايك به صفونه صفونه ودرېږي۔، دوى به خبرې نشي كولى مګرهغه څوك چې هغه ته رحمٰن اجازت وركړي او ده (په دنیا كې) حقه خبره (لا إله الا الله) ویلې وي","a":"on the Day when all [human] souls and all the angels will stand up in ranks: none will speak but he to whom the Most Gracious will have given leave; and [everyone] will say [only] what is right."},{"n":39,"g":5711,"t":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","e":"That is the True Day; so he who wills may take to his Lord a [way of] return.","j":30,"p":583,"r":519,"h":233,"w":10,"u":"یہ دن برحق ہے۔ پس جو شخص چاہے اپنے پروردگار کے پاس ٹھکانہ بنا ئے","s":"دغه حق ورځ ده، نو هغه څوك چې د خپل رب په طرف د ورتلو ځاى نیسي (نو ودې نیسي)","a":"That will be the Day of Ultimate Truth: whoever wills, then, let him take the path that leads towards his Sustainer!"},{"n":40,"g":5712,"t":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","e":"Indeed, We have warned you of a near punishment on the Day when a man will observe what his hands have put forth and the disbeliever will say, \"Oh, I wish that I were dust!\"","j":30,"p":583,"r":519,"h":233,"w":15,"u":"ہم نے تم کو عذاب سے جو عنقریب آنے والا ہے آگاہ کر دیا ہے جس دن ہر شخص ان (اعمال) کو جو اس نے آگے بھیجے ہوں گے دیکھ لے گا اور کافر کہے گا کہ اے کاش میں مٹی ہوتا","s":"بېشكه مونږ تاسو له نژدې (راتلونكي) عذاب څخه ووېرولئ، په هغه ورځ كې چې هر سړى به هغه څه ته ګوري چې د ده لاسونو مخكې لېږلي دي او كافر به وايي: اى كاشكې چې زه خاورې وى","a":"Verily, We have warned you of suffering near at hand - [suffering] on the Day when man shall [clearly] see what his hands have sent ahead, and when he who has denied the truth shall say, \"Oh, would that I were mere dust...!\""}]},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","en":"An-Naazi'aat","tr":"Those who drag forth","rev":"Meccan","ayahs":[{"n":1,"g":5713,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا","e":"By those [angels] who extract with violence","j":30,"p":583,"r":520,"h":233,"w":6,"u":"ان (فرشتوں) کی قسم جو ڈوب کر کھینچ لیتے ہیں","s":"قسم دى په (ملايكو) راوښكونكو (روحونو د كفارو لره)، راوښكل","a":"CONSIDER those [stars] that rise only to set,"},{"n":2,"g":5714,"t":"وَٱلنَّٰشِطَٰتِ نَشْطًۭا","e":"And [by] those who remove with ease","j":30,"p":583,"r":520,"h":233,"w":2,"u":"اور ان کی جو آسانی سے کھول دیتے ہیں","s":"او په (ملايكو) اسان راوښكونكو (د مومنانو روحونو لره)، اسان راوښكل","a":"and move [in their orbits] with steady motion,"},{"n":3,"g":5715,"t":"وَٱلسَّٰبِحَٰتِ سَبْحًۭا","e":"And [by] those who glide [as if] swimming","j":30,"p":583,"r":520,"h":233,"w":2,"u":"اور ان کی جو تیرتے پھرتے ہیں","s":"او په تېزو تلونكو (ملايكو)، تېز تلل","a":"and float [through space] with floating serene,"},{"n":4,"g":5716,"t":"فَٱلسَّٰبِقَٰتِ سَبْقًۭا","e":"And those who race each other in a race","j":30,"p":583,"r":520,"h":233,"w":2,"u":"پھر لپک کر آگے بڑھتے ہیں","s":"پس په وړاندې كېدونكو (ملايكو)، وړاندې كېدل","a":"and yet overtake [one another] with swift overtaking:"},{"n":5,"g":5717,"t":"فَٱلْمُدَبِّرَٰتِ أَمْرًۭا","e":"And those who arrange [each] matter,","j":30,"p":583,"r":520,"h":233,"w":2,"u":"پھر (دنیا کے) کاموں کا انتظام کرتے ہیں","s":"بیا د كار په تدبیر جوړونكو (ملايكو) چې تاسو به خامخا بیا راژوندي كړى شئ)","a":"and thus they fulfil the [Creator's] behest!"},{"n":6,"g":5718,"t":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","e":"On the Day the blast [of the Horn] will convulse [creation],","j":30,"p":583,"r":520,"h":233,"w":3,"u":"(کہ وہ دن آ کر رہے گا) جس دن زمین کو بھونچال آئے گا","s":"په هغه ورځ چې لړځېدونكې به ولړځېږي","a":"[HENCE, think of] the Day when a violent convulsion will convulse [the world],"},{"n":7,"g":5719,"t":"تَتْبَعُهَا ٱلرَّادِفَةُ","e":"There will follow it the subsequent [one].","j":30,"p":583,"r":520,"h":233,"w":2,"u":"پھر اس کے پیچھے اور (بھونچال) آئے گا","s":"په دې پسې به راځي ورپسې راتلونكې","a":"to be followed by further [convulsions]!"},{"n":8,"g":5720,"t":"قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ","e":"Hearts, that Day, will tremble,","j":30,"p":583,"r":520,"h":233,"w":3,"u":"اس دن (لوگوں) کے دل خائف ہو رہے ہوں گے","s":"(د مجرمانو) زړونه به په دغه ورځ كې رپېدونكي (درزېدونكي) وي","a":"On that Day will [men's] hearts be throbbing,"},{"n":9,"g":5721,"t":"أَبْصَٰرُهَا خَٰشِعَةٌۭ","e":"Their eyes humbled.","j":30,"p":583,"r":520,"h":233,"w":2,"u":"اور آنکھیں جھکی ہوئی","s":"د دغو سترګې به ښكته وي","a":"[and] their eyes downcast..."},{"n":10,"g":5722,"t":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","e":"They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?","j":30,"p":583,"r":520,"h":233,"w":5,"u":"(کافر) کہتے ہیں کیا ہم الٹے پاؤں پھر لوٹ جائیں گے","s":"دوى به وايي: ایا په رښتیا (او) یقینًا به مونږ ړومبني حالت ته ګرځولى شو (بیا به ژوندي كېږو؟)","a":"[And yet,] some say, \"What! Are we indeed to be restored to our former state –"},{"n":11,"g":5723,"t":"أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ","e":"Even if we should be decayed bones?","j":30,"p":583,"r":520,"h":233,"w":4,"u":"بھلا جب ہم کھوکھلی ہڈیاں ہو جائیں گے (تو پھر زندہ کئے جائیں گے)","s":"ایا كله چې مونږ زاړه رژېدونكي هډوكي شو","a":"even though we may have become [a heap of] crumbling bones?\""},{"n":12,"g":5724,"t":"قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ","e":"They say, \"That, then, would be a losing return.\"","j":30,"p":583,"r":520,"h":233,"w":5,"u":"کہتے ہیں کہ یہ لوٹنا تو (موجب) زیاں ہے","s":"دوى وویل: دغه (ګرځېدل) به په هغه وخت كې زیانمن ګرځېدل وي","a":"[And] they add, \"That, then, would be a return with loss!\""},{"n":13,"g":5725,"t":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","e":"Indeed, it will be but one shout,","j":30,"p":583,"r":520,"h":233,"w":4,"u":"وہ تو صرف ایک ڈانٹ ہوگی","s":"پس بېشكه دغه خو بس یوه چغه ده","a":"[But,] then, that [Last Hour] will be [upon them of a sudden, as if it were] but a single accusing cry -"},{"n":14,"g":5726,"t":"فَإِذَا هُم بِٱلسَّاهِرَةِ","e":"And suddenly they will be [alert] upon the earth's surface.","j":30,"p":583,"r":520,"h":233,"w":3,"u":"اس وقت وہ (سب) میدان (حشر) میں آ جمع ہوں گے","s":"نو ناڅاپه به دوى د ځمكې په مخ وي","a":"and then, lo, they will be fully awakened [to the truth]!"},{"n":15,"g":5727,"t":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","e":"Has there reached you the story of Moses? -","j":30,"p":583,"r":520,"h":233,"w":4,"u":"بھلا تم کو موسیٰ کی حکایت پہنچی ہے","s":"ایا تا ته د موسٰی خبره راغلې ده","a":"HAS THE STORY of Moses ever come within thy ken."},{"n":16,"g":5728,"t":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","e":"When his Lord called to him in the sacred valley of Tuwa,","j":30,"p":584,"r":520,"h":233,"w":6,"u":"جب اُن کے پروردگار نے ان کو پاک میدان (یعنی) طویٰ میں پکارا","s":"كله چې ده ته خپل رب په پاكې دَرې (ناو) ’’طُوٰی‘‘ كې اواز وكړ","a":"Lo! His Sustainer called out to him in the twice-hallowed valley:"},{"n":17,"g":5729,"t":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","e":"\"Go to Pharaoh. Indeed, he has transgressed.","j":30,"p":584,"r":520,"h":233,"w":5,"u":"(اور حکم دیا) کہ فرعون کے پاس جاؤ وہ سرکش ہو رہا ہے","s":"ته فرعون ته لاړ شه، بېشكه ده سركشي شروع كړې ده","a":"\"Go unto Pharaoh - for, verily, he has transgressed all bounds of what is right -"},{"n":18,"g":5730,"t":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","e":"And say to him, 'Would you [be willing to] purify yourself","j":30,"p":584,"r":520,"h":233,"w":6,"u":"اور (اس سے) کہو کہ کیا تو چاہتا ہے کہ پاک ہو جائے؟","s":"نو ته (ورته) ووایه: ایا ته دا خوښوې چې ته پاك شې","a":"and say [unto him], 'Art thou desirous of attaining to purity?"},{"n":19,"g":5731,"t":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","e":"And let me guide you to your Lord so you would fear [Him]?'\"","j":30,"p":584,"r":520,"h":233,"w":4,"u":"اور میں تجھے تیرے پروردگار کا رستہ بتاؤں تاکہ تجھ کو خوف (پیدا) ہو","s":"او دا چې زه تا ته ستا د رب په طرف ښوونه وكړم، پس چې ته ووېرېږې","a":"[If so,] then I shall guide thee towards [a cognition of] thy Sustainer, so that [henceforth] thou wilt stand in awe [of Him].’\""},{"n":20,"g":5732,"t":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","e":"And he showed him the greatest sign,","j":30,"p":584,"r":520,"h":233,"w":3,"u":"غرض انہوں نے اس کو بڑی نشانی دکھائی","s":"نو ده (موسٰی) دغه (فرعون) ته تر ټولو لویه نښه وښودله","a":"And thereupon he [went to Pharaoh and] made him aware of the great wonder [of God's grace]."},{"n":21,"g":5733,"t":"فَكَذَّبَ وَعَصَىٰ","e":"But Pharaoh denied and disobeyed.","j":30,"p":584,"r":520,"h":233,"w":2,"u":"مگر اس نے جھٹلایا اور نہ مانا","s":"نو ده تكذيب وكړ او نافراني يې وكړه","a":"But [Pharaoh] gave him the lie and rebelliously rejected [all guidance],"},{"n":22,"g":5734,"t":"ثُمَّ أَدْبَرَ يَسْعَىٰ","e":"Then he turned his back, striving.","j":30,"p":584,"r":520,"h":233,"w":3,"u":"پھر لوٹ گیا اور تدبیریں کرنے لگا","s":"بيا يې شا كړه (او) په ډېره بيړه سره لاړ","a":"and brusquely turned his back [on Moses];"},{"n":23,"g":5735,"t":"فَحَشَرَ فَنَادَىٰ","e":"And he gathered [his people] and called out","j":30,"p":584,"r":520,"h":233,"w":2,"u":"اور (لوگوں کو) اکٹھا کیا اور پکارا","s":"نو ده (جادوګر) راجمع كړل، پس اواز يې وكړ","a":"and then he gathered [his great ones], and called [unto his people],"},{"n":24,"g":5736,"t":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","e":"And said, \"I am your most exalted lord.\"","j":30,"p":584,"r":520,"h":233,"w":4,"u":"کہنے لگا کہ تمہارا سب سے بڑا مالک میں ہوں","s":"نو ويې ويل: زه ستاسو رب یم، تر ټولو اوچت (رب)","a":"and said, \"I am your Lord All-Highest!\""},{"n":25,"g":5737,"t":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","e":"So Allah seized him in exemplary punishment for the last and the first [transgression].","j":30,"p":584,"r":520,"h":233,"w":5,"u":"تو خدا نے اس کو دنیا اور آخرت (دونوں) کے عذاب میں پکڑ لیا","s":"نو دى الله راونیوه په عذاب د اخرت او دنیا سره","a":"And thereupon God took him to task, [and made him] a warning example in the life to come as well as in this world."},{"n":26,"g":5738,"t":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","e":"Indeed in that is a warning for whoever would fear [Allah].","j":30,"p":584,"r":520,"h":233,"w":6,"u":"جو شخص (خدا سے) ڈر رکھتا ہے اس کے لیے اس (قصے) میں عبرت ہے","s":"بېشكه په دغه (غرقولو او سوځولو) كې یقینًا د هغه چا لپاره عبرت دى چې (له الله نه) وېرېږي","a":"In this, behold, there is a lesson indeed for all who stand in awe [of God]."},{"n":27,"g":5739,"t":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","e":"Are you a more difficult creation or is the heaven? Allah constructed it.","j":30,"p":584,"r":521,"h":233,"w":7,"u":"بھلا تمہارا بنانا آسان ہے یا آسمان کا؟ اسی نے اس کو بنایا","s":"ایا تاسو د پیدا كولو په لحاظ ډېر سخت یئ، یا كه اسمان، دغه هغه (الله) جوړ كړى دى","a":"[O MEN!] Are you more difficult to create than the heaven which He has built?"},{"n":28,"g":5740,"t":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","e":"He raised its ceiling and proportioned it.","j":30,"p":584,"r":521,"h":233,"w":3,"u":"اس کی چھت کو اونچا کیا اور پھر اسے برابر کر دیا","s":"د ده چت يې اوچت كړى دى، نو دغه يې ښه برابر جوړ كړى دى","a":"High has He reared its vault and formed it in accordance with what it was meant to be;"},{"n":29,"g":5741,"t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","e":"And He darkened its night and extracted its brightness.","j":30,"p":584,"r":521,"h":233,"w":4,"u":"اور اسی نے رات کو تاریک بنایا اور (دن کو) دھوپ نکالی","s":"او د ده شپه يې توره تیاره كړې ده او د ده رڼا يې راوېستلې ده","a":"and He has made dark its night and brought forth its light of day."},{"n":30,"g":5742,"t":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","e":"And after that He spread the earth.","j":30,"p":584,"r":521,"h":233,"w":4,"u":"اور اس کے بعد زمین کو پھیلا دیا","s":"او ځمكه يې له ده نه وروسته غوړولې ده","a":"And after that, the earth: wide has He spread its expanse,"},{"n":31,"g":5743,"t":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","e":"He extracted from it its water and its pasture,","j":30,"p":584,"r":521,"h":233,"w":4,"u":"اسی نے اس میں سے اس کا پانی نکالا اور چارا اگایا","s":"ده له دغې (ځمكې) نه د دې اوبه او د دې واښه رااېستلي دي","a":"and has caused its waters to come out of it, and its pastures,"},{"n":32,"g":5744,"t":"وَٱلْجِبَالَ أَرْسَىٰهَا","e":"And the mountains He set firmly","j":30,"p":584,"r":521,"h":233,"w":2,"u":"اور اس پر پہاڑوں کابوجھ رکھ دیا","s":"او غرونو لره، ده دغه محكم كړي دي","a":"and has made the mountains firm:"},{"n":33,"g":5745,"t":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","e":"As provision for you and your grazing livestock.","j":30,"p":584,"r":521,"h":233,"w":3,"u":"یہ سب کچھ تمہارے اور تمہارے چارپایوں کے فائدے کے لیے (کیا)","s":"ستاسو او ستاسو د څاریو د فايدې لپاره","a":"[all this] as a means of livelihood for you and your animals."},{"n":34,"g":5746,"t":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","e":"But when there comes the greatest Overwhelming Calamity -","j":30,"p":584,"r":521,"h":233,"w":4,"u":"تو جب بڑی آفت آئے گی","s":"نو كله چې تر ټولو لویه بلا (قیامت) راشي","a":"AND SO, when the great overwhelming event [of, resurrection] comes to pass –"},{"n":35,"g":5747,"t":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","e":"The Day when man will remember that for which he strove,","j":30,"p":584,"r":521,"h":233,"w":5,"u":"اس دن انسان اپنے کاموں کو یاد کرے گا","s":"په هغه ورځ چې انسان به هغه څه یادوي چې ده كړي وي","a":"on that Day man will [clearly] remember all that he has ever wrought;"},{"n":36,"g":5748,"t":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","e":"And Hellfire will be exposed for [all] those who see -","j":30,"p":584,"r":521,"h":233,"w":4,"u":"اور دوزخ دیکھنے والے کے سامنے نکال کر رکھ دی جائے گی","s":"او دوزخ به هغه چا ته څرګند كړى شي چې يې ویني","a":"and the blazing fire [of hell] will be lad open before all who [are destined to] see it."},{"n":37,"g":5749,"t":"فَأَمَّا مَن طَغَىٰ","e":"So as for he who transgressed","j":30,"p":584,"r":521,"h":233,"w":3,"u":"تو جس نے سرکشی کی","s":"نو هر چې هغه څوك دى چې سركشي يې كړې وي","a":"For, unto him who shall have transgressed the bounds of what is right,"},{"n":38,"g":5750,"t":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","e":"And preferred the life of the world,","j":30,"p":584,"r":521,"h":233,"w":3,"u":"اور دنیا کی زندگی کو مقدم سمجھا","s":"او دنيايي ژوند ته يې ترجیح وركړې وي","a":"and preferred the life of this world [to the good of his soul],"},{"n":39,"g":5751,"t":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","e":"Then indeed, Hellfire will be [his] refuge.","j":30,"p":584,"r":521,"h":233,"w":4,"u":"اس کا ٹھکانہ دوزخ ہے","s":"نو بېشكه چې هم دا دوزخ (د ده) استوګنه ده","a":"that blazing fire will truly be the goal!"},{"n":40,"g":5752,"t":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","e":"But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,","j":30,"p":584,"r":521,"h":233,"w":9,"u":"اور جو اپنے پروردگار کے سامنے کھڑے ہونے سے ڈرتا اور جی کو خواہشوں سے روکتا رہا","s":"او هر چې هغه څوك دى چې د خپل رب په وړاندې له ودرېدلو نه وېرېدلى وي او نفس (ځان) يې له خواهشاتو نه منع كړى وي","a":"But unto him who shall have stood in fear of his Sustainer's Presence, and held back his inner self from base desires,"},{"n":41,"g":5753,"t":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","e":"Then indeed, Paradise will be [his] refuge.","j":30,"p":584,"r":521,"h":233,"w":4,"u":"اس کا ٹھکانہ بہشت ہے","s":"نو بېشكه چې هم دا جنت (د ده) استوګنه ده","a":"paradise will truly be the goal!"},{"n":42,"g":5754,"t":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","e":"They ask you, [O Muhammad], about the Hour: when is its arrival?","j":30,"p":584,"r":521,"h":233,"w":5,"u":"(اے پیغمبر، لوگ) تم سے قیامت کے بارے میں پوچھتے ہیں کہ اس کا وقوع کب ہو گا؟","s":"(اى نبي!) دوى له تا نه د قیامت په باره كې پوښتنه كوي چې د ده واقع كېدل به كله وي","a":"THEY WILL ASK thee [O Prophet] about the Last Hour: \"When will it come to pass?\""},{"n":43,"g":5755,"t":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","e":"In what [position] are you that you should mention it?","j":30,"p":584,"r":521,"h":233,"w":4,"u":"سو تم اس کے ذکر سے کس فکر میں ہو","s":"ته د ده له یاده (علمه) په څه كې يې","a":"[But] how couldst thou tell anything about it,"},{"n":44,"g":5756,"t":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","e":"To your Lord is its finality.","j":30,"p":584,"r":521,"h":233,"w":3,"u":"اس کا منتہا (یعنی واقع ہونے کا وقت) تمہارے پروردگار ہی کو (معلوم ہے)","s":"خاص ستا رب ته د دغه (قيامت) انتها ده","a":"[seeing that] with thy Sustainer alone rests the beginning and the end [of all knowledge] thereof?"},{"n":45,"g":5757,"t":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","e":"You are only a warner for those who fear it.","j":30,"p":584,"r":521,"h":233,"w":5,"u":"جو شخص اس سے ڈر رکھتا ہے تم تو اسی کو ڈر سنانے والے ہو","s":"بېشكه ته خو يواځې د هغه چا وېروونكى يې چې له ده (قیامت) نه وېرېږي","a":"Thou art but [sent] to warn those who stand in awe of it."},{"n":46,"g":5758,"t":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","e":"It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof.","j":30,"p":584,"r":521,"h":233,"w":9,"u":"جب وہ اس کو دیکھیں گے (تو ایسا خیال کریں گے) کہ گویا (دنیا میں صرف) ایک شام یا صبح رہے تھے","s":"ګویاكې دوى به په هغې ورځې كې چې دوى دغه (قیامت) وویني (داسې به وي لكه چې) دوى (په دنیا، یا په قبر كې) نه دي ایسار شوي مګر د ورځې اخر، یا څاښت","a":"On the Day when they behold it, [it will seem to them] as if they had tarried [in this world] no longer than one evening or [one night, ending with] its morn!"}]},{"number":80,"name":"سُورَةُ عَبَسَ","en":"Abasa","tr":"He frowned","rev":"Meccan","ayahs":[{"n":1,"g":5759,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","e":"The Prophet frowned and turned away","j":30,"p":585,"r":522,"h":234,"w":6,"u":"(محمد مصطفٰےﷺ) ترش رُو ہوئے اور منہ پھیر بیٹھے","s":"ده تندى تریو كړ او مخ يې وګرځاوه","a":"HE FROWNED and turned away"},{"n":2,"g":5760,"t":"أَن جَآءَهُ ٱلْأَعْمَىٰ","e":"Because there came to him the blind man, [interrupting].","j":30,"p":585,"r":522,"h":234,"w":3,"u":"کہ ان کے پاس ایک نابینا آیا","s":"په دې وجه چې ده ته ړوند راغى","a":"because the blind man approached him!"},{"n":3,"g":5761,"t":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","e":"But what would make you perceive, [O Muhammad], that perhaps he might be purified","j":30,"p":585,"r":522,"h":234,"w":4,"u":"اور تم کو کیا خبر شاید وہ پاکیزگی حاصل کرتا","s":"او ته څه شي پوه كړى يې۔، ښايي چې دى پاك شي","a":"Yet for all thou didst know, [O Muhammad,] he might perhaps have grown in purity,"},{"n":4,"g":5762,"t":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","e":"Or be reminded and the remembrance would benefit him?","j":30,"p":585,"r":522,"h":234,"w":4,"u":"یا سوچتا تو سمجھانا اسے فائدہ دیتا","s":"یا به دى نصیحت (او پند) واخلي، نو ده ته به پند نفع ورسوي","a":"or have been reminded [of the truth], and helped by this reminder."},{"n":5,"g":5763,"t":"أَمَّا مَنِ ٱسْتَغْنَىٰ","e":"As for he who thinks himself without need,","j":30,"p":585,"r":522,"h":234,"w":3,"u":"جو پروا نہیں کرتا","s":"هر چې هغه څوك دى چې استغنا يې كړې ده","a":"Now as for him who believes himself to be self-sufficient"},{"n":6,"g":5764,"t":"فَأَنتَ لَهُۥ تَصَدَّىٰ","e":"To him you give attention.","j":30,"p":585,"r":522,"h":234,"w":3,"u":"اس کی طرف تو تم توجہ کرتے ہو","s":"نو ته په هغه پسې كېږې","a":"to him didst thou give thy whole attention,"},{"n":7,"g":5765,"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","e":"And not upon you [is any blame] if he will not be purified.","j":30,"p":585,"r":522,"h":234,"w":4,"u":"حالانکہ اگر وہ نہ سنورے تو تم پر کچھ (الزام) نہیں","s":"حال دا چې په تا هېڅ الزام نشته چې هغه پاك نشي","a":"although thou art not accountable for his failure to attain to purity;"},{"n":8,"g":5766,"t":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","e":"But as for he who came to you striving [for knowledge]","j":30,"p":585,"r":522,"h":234,"w":4,"u":"اور جو تمہارے پاس دوڑتا ہوا آیا","s":"او هر چې هغه څوك دى چې تا ته په منډو راځي","a":"but as for him who came unto thee full of eagerness"},{"n":9,"g":5767,"t":"وَهُوَ يَخْشَىٰ","e":"While he fears [Allah],","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور (خدا سے) ڈرتا ہے","s":"په داسې حال كې چې دى (له الله نه) وېرېږي","a":"and in awe [of God]"},{"n":10,"g":5768,"t":"فَأَنتَ عَنْهُ تَلَهَّىٰ","e":"From him you are distracted.","j":30,"p":585,"r":522,"h":234,"w":3,"u":"اس سے تم بےرخی کرتے ہو","s":"نو ته له هغه نه مشغولېږې","a":"him didst thou disregard!"},{"n":11,"g":5769,"t":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","e":"No! Indeed, these verses are a reminder;","j":30,"p":585,"r":522,"h":234,"w":3,"u":"دیکھو یہ (قرآن) نصیحت ہے","s":"داسې كله هم مه كوه، بېشكه دا (سورت) یو پند (او نصیحت) دى","a":"NAY, VERILY, these [messages] are but a reminder:"},{"n":12,"g":5770,"t":"فَمَن شَآءَ ذَكَرَهُۥ","e":"So whoever wills may remember it.","j":30,"p":585,"r":522,"h":234,"w":3,"u":"پس جو چاہے اسے یاد رکھے","s":"نو هغه څوك چې غواړي (نو) دى دې ومني","a":"and so, whoever is willing may remember Him"},{"n":13,"g":5771,"t":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","e":"[It is recorded] in honored sheets,","j":30,"p":585,"r":522,"h":234,"w":3,"u":"قابل ادب ورقوں میں (لکھا ہوا)","s":"(دغه) په عزتمنو پاڼو كې دى","a":"in [the light of His] revelations blest with dignity,"},{"n":14,"g":5772,"t":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","e":"Exalted and purified,","j":30,"p":585,"r":522,"h":234,"w":2,"u":"جو بلند مقام پر رکھے ہوئے (اور) پاک ہیں","s":"چې پورته كړى شوې، ښې پاكې كړى شوې دي","a":"lofty and pure,"},{"n":15,"g":5773,"t":"بِأَيْدِى سَفَرَةٍۢ","e":"[Carried] by the hands of messenger-angels,","j":30,"p":585,"r":522,"h":234,"w":2,"u":"لکھنے والوں کے ہاتھوں میں","s":"د لیكونكو (ملايكو) په لاسونو كې","a":"[borne] by the hands of messengers"},{"n":16,"g":5774,"t":"كِرَامٍۭ بَرَرَةٍۢ","e":"Noble and dutiful.","j":30,"p":585,"r":522,"h":234,"w":2,"u":"جو سردار اور نیکو کار ہیں","s":"چې ډېر عزتمن، ډېر نېك دي","a":"noble and most virtuous."},{"n":17,"g":5775,"t":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","e":"Cursed is man; how disbelieving is he.","j":30,"p":585,"r":522,"h":234,"w":4,"u":"انسان ہلاک ہو جائے کیسا ناشکرا ہے","s":"انسان دې هلاك كړى شي، دى څومره ډېر ناشكره دى!","a":"[But only too often] man destroys himself: how stubbornly does he deny the truth!"},{"n":18,"g":5776,"t":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","e":"From what substance did He create him?","j":30,"p":585,"r":522,"h":234,"w":4,"u":"اُسے (خدا نے) کس چیز سے بنایا؟","s":"دى دغه (الله) له څه شي نه پیدا كړى دى؟","a":"[Does man ever consider] out of what substance [God] creates him?"},{"n":19,"g":5777,"t":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","e":"From a sperm-drop He created him and destined for him;","j":30,"p":585,"r":522,"h":234,"w":4,"u":"نطفے سے بنایا پھر اس کا اندازہ مقرر کیا","s":"له نطفې نه۔، دى يې پیدا كړى دى، پس دى يې اندازه كړى دى","a":"Out of a drop of sperm He creates him, and thereupon determines his nature,"},{"n":20,"g":5778,"t":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","e":"Then He eased the way for him;","j":30,"p":585,"r":522,"h":234,"w":3,"u":"پھر اس کے لیے رستہ آسان کر دیا","s":"بیا يې ده ته لاره ور اسانه كړې ده","a":"and then makes it easy for him to go through life;"},{"n":21,"g":5779,"t":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","e":"Then He causes his death and provides a grave for him.","j":30,"p":585,"r":522,"h":234,"w":3,"u":"پھر اس کو موت دی پھر قبر میں دفن کرایا","s":"بیا يې دى مړ كړ، نو دى يې په قبر كې كېښود","a":"and in the end He causes him to die and brings him to the grave;"},{"n":22,"g":5780,"t":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","e":"Then when He wills, He will resurrect him.","j":30,"p":585,"r":522,"h":234,"w":4,"u":"پھر جب چاہے گا اسے اٹھا کھڑا کرے گا","s":"بیا چې كله وغواړي دى به ژوندى كړي","a":"and then, if it be His will, He shall raise him again to life,"},{"n":23,"g":5781,"t":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","e":"No! Man has not yet accomplished what He commanded him.","j":30,"p":585,"r":522,"h":234,"w":5,"u":"کچھ شک نہیں کہ خدا نے اسے جو حکم دیا اس نے اس پر عمل نہ کیا","s":"داسې نه ده۔، دغه (انسان) هغه كار نه دى كړى چې دغه (الله) ده ته حكم كړى دى","a":"Nay, but [man] has never yet fulfilled what He has enjoined upon him!"},{"n":24,"g":5782,"t":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","e":"Then let mankind look at his food -","j":30,"p":585,"r":522,"h":234,"w":4,"u":"تو انسان کو چاہیئے کہ اپنے کھانے کی طرف نظر کرے","s":"نو انسان دې خپل طعام ته وګوري","a":"Let man, then, consider [the sources of] his food:"},{"n":25,"g":5783,"t":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","e":"How We poured down water in torrents,","j":30,"p":585,"r":522,"h":234,"w":4,"u":"بے شک ہم ہی نے پانی برسایا","s":"چې بېشكه مونږ اوبه راتوى كړې دي، راتویول","a":"[how it is] that We pour down water, pouring it down abundantly;"},{"n":26,"g":5784,"t":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","e":"Then We broke open the earth, splitting [it with sprouts],","j":30,"p":585,"r":522,"h":234,"w":4,"u":"پھر ہم ہی نے زمین کو چیرا پھاڑا","s":"بیا مونږ ځمكه څیرې كړې ده، څیرول","a":"and then We cleave the earth [with new growth], cleaving it asunder,"},{"n":27,"g":5785,"t":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","e":"And caused to grow within it grain","j":30,"p":585,"r":522,"h":234,"w":3,"u":"پھر ہم ہی نے اس میں اناج اگایا","s":"نو مونږ په دې كې دانې را زرغونه كړي دي","a":"and thereupon We cause grain to grow out of it,"},{"n":28,"g":5786,"t":"وَعِنَبًۭا وَقَضْبًۭا","e":"And grapes and herbage","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور انگور اور ترکاری","s":"او انګور او تركاريانې","a":"and vines and edible plants,"},{"n":29,"g":5787,"t":"وَزَيْتُونًۭا وَنَخْلًۭا","e":"And olive and palm trees","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور زیتون اور کھجوریں","s":"او زیتون او كجورې","a":"and olive trees and date-palms,"},{"n":30,"g":5788,"t":"وَحَدَآئِقَ غُلْبًۭا","e":"And gardens of dense shrubbery","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور گھنے گھنے باغ","s":"او ګڼ باغونه","a":"and gardens dense with foliage,"},{"n":31,"g":5789,"t":"وَفَٰكِهَةًۭ وَأَبًّۭا","e":"And fruit and grass -","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور میوے اور چارا","s":"او مېوې او ګياه (واښه)","a":"and fruits and herbage,"},{"n":32,"g":5790,"t":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","e":"[As] enjoyment for you and your grazing livestock.","j":30,"p":585,"r":522,"h":234,"w":3,"u":"(یہ سب کچھ) تمہارے اور تمہارے چارپایوں کے لیے بنایا","s":"ستاسو او ستاسو د څارویو د فايدې لپاره","a":"for you and for your animals to enjoy."},{"n":33,"g":5791,"t":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","e":"But when there comes the Deafening Blast","j":30,"p":585,"r":522,"h":234,"w":3,"u":"تو جب (قیامت کا) غل مچے گا","s":"نو كله چې سخت اواز راشي","a":"AND SO, when the piercing call [of resurrection] is heard"},{"n":34,"g":5792,"t":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","e":"On the Day a man will flee from his brother","j":30,"p":585,"r":522,"h":234,"w":5,"u":"اس دن آدمی اپنے بھائی سے دور بھاگے گا","s":"په هغه ورځ چې سړى به له خپل وروره تښتي","a":"on a Day when everyone will [want to] flee from his brother,"},{"n":35,"g":5793,"t":"وَأُمِّهِۦ وَأَبِيهِ","e":"And his mother and his father","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور اپنی ماں اور اپنے باپ سے","s":"او له خپلې مور او خپل پلاره","a":"and from his mother and father,"},{"n":36,"g":5794,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","e":"And his wife and his children,","j":30,"p":585,"r":522,"h":234,"w":2,"u":"اور اپنی بیوی اور اپنے بیٹے سے","s":"او له خپلې ښځې او خپلو زامنو نه","a":"and from his spouse and his children:"},{"n":37,"g":5795,"t":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","e":"For every man, that Day, will be a matter adequate for him.","j":30,"p":585,"r":522,"h":234,"w":6,"u":"ہر شخص اس روز ایک فکر میں ہو گا جو اسے (مصروفیت کے لیے) بس کرے گا","s":"په دوى كې د هر سړي لپاره به په دغه ورځ كې یو حال وي چې دى به (له نورو نه) بې پروا (بې غوره) كوي","a":"on that Day, to every one of them will his own state be of sufficient concern."},{"n":38,"g":5796,"t":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","e":"[Some] faces, that Day, will be bright -","j":30,"p":585,"r":522,"h":234,"w":3,"u":"اور کتنے منہ اس روز چمک رہے ہوں گے","s":"څه مخونه به په دغې ورځ كې روښانه وي","a":"Some faces will on that Day be bright with happiness,"},{"n":39,"g":5797,"t":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","e":"Laughing, rejoicing at good news.","j":30,"p":585,"r":522,"h":234,"w":2,"u":"خنداں و شاداں (یہ مومنان نیکو کار ہیں)","s":"خندېدونكي (او) خوشاله به وي","a":"laughing, rejoicing at glad tidings."},{"n":40,"g":5798,"t":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","e":"And [other] faces, that Day, will have upon them dust.","j":30,"p":585,"r":522,"h":234,"w":4,"u":"اور کتنے منہ ہوں گے جن پر گرد پڑ رہی ہو گی","s":"او څه مخونه به په دغې ورځ كې پر هغو به ګرد پروت وي","a":"And some faces will on that Day with dust be covered,"},{"n":41,"g":5799,"t":"تَرْهَقُهَا قَتَرَةٌ","e":"Blackness will cover them.","j":30,"p":585,"r":522,"h":234,"w":2,"u":"(اور) سیاہی چڑھ رہی ہو گی","s":"دغه (مخونه) به توروالي پټ كړي وي","a":"with darkness overspread:"},{"n":42,"g":5800,"t":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","e":"Those are the disbelievers, the wicked ones.","j":30,"p":585,"r":522,"h":234,"w":4,"u":"یہ کفار بدکردار ہیں","s":"دغه (تور مخي) خلق هم دوى كافران (او) فاجران (بدكاران) دي","a":"these, these will be the ones who denied the truth and were immersed in iniquity!"}]},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","en":"At-Takwir","tr":"The Overthrowing","rev":"Meccan","ayahs":[{"n":1,"g":5801,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","e":"When the sun is wrapped up [in darkness]","j":30,"p":586,"r":523,"h":234,"w":7,"u":"جب سورج لپیٹ لیا جائے گا","s":"كله چې لمر ونغښتل شي","a":"WHEN THE SUN is shrouded in darkness,"},{"n":2,"g":5802,"t":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","e":"And when the stars fall, dispersing,","j":30,"p":586,"r":523,"h":234,"w":3,"u":"جب تارے بےنور ہو جائیں گے","s":"او كله چې ستوري خړ شي","a":"and when the stars lose their light,"},{"n":3,"g":5803,"t":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","e":"And when the mountains are removed","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب پہاڑ چلائے جائیں گے","s":"او كله چې غرونه روان كړل شي","a":"and when the mountains are made to vanish,"},{"n":4,"g":5804,"t":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","e":"And when full-term she-camels are neglected","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی","s":"او كله چې د لسو میاشتو بلاربې اوښې معطلې (ازادې) پرېښودى شي","a":"and when she-camels big with young, about to give birth, are left untended,"},{"n":5,"g":5805,"t":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","e":"And when the wild beasts are gathered","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب وحشی جانور جمع اکٹھے ہو جائیں گے","s":"او كله چې وحشي ځناوران راجمع كړل شي","a":"and when all beasts are gathered together,"},{"n":6,"g":5806,"t":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","e":"And when the seas are filled with flame","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب دریا آگ ہو جائیں گے","s":"او كله چې دریابونه بل كړى شي","a":"and when the seas boil over,"},{"n":7,"g":5807,"t":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","e":"And when the souls are paired","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب روحیں (بدنوں سے) ملا دی جائیں گی","s":"او كله چې نفسونه جوړه كړل شي","a":"and when all human beings are coupled [with their deeds],"},{"n":8,"g":5808,"t":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","e":"And when the girl [who was] buried alive is asked","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا","s":"او كله چې ژوندۍ خښه كړى شوې جینۍ وپوښتى شي","a":"and when the girl-child that was buried alive is made to ask"},{"n":9,"g":5809,"t":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","e":"For what sin she was killed","j":30,"p":586,"r":523,"h":234,"w":3,"u":"کہ وہ کس گناہ پرماری گئی","s":"چې دا په كومې ګناه وژل شوې ده","a":"for what crime she had been slain,"},{"n":10,"g":5810,"t":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","e":"And when the pages are made public","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب (عملوں کے) دفتر کھولے جائیں گے","s":"او كله چې اعمال نامې وغوړولى شي","a":"and when the scrolls [of men's deeds] are unfolded,"},{"n":11,"g":5811,"t":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","e":"And when the sky is stripped away","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب آسمانوں کی کھال کھینچ لی جائے گی","s":"او كله چې له اسمان نه پوستكى ووېستل شي","a":"and when heaven is laid bare,"},{"n":12,"g":5812,"t":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","e":"And when Hellfire is set ablaze","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور جب دوزخ (کی آگ) بھڑکائی جائے گی","s":"او كله چې دوزخ بلې لمبې كړى شي","a":"and when the blazing fire [of hell] is kindled bright,"},{"n":13,"g":5813,"t":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","e":"And when Paradise is brought near,","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور بہشت جب قریب لائی جائے گی","s":"او كله چې جنت ښه نژدې كړى شي","a":"and when paradise is brought into view:"},{"n":14,"g":5814,"t":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","e":"A soul will [then] know what it has brought [with it].","j":30,"p":586,"r":523,"h":234,"w":4,"u":"تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے","s":"هر نفس به په هغه شي پوه شي چې ده حاضر كړى وي","a":"[on that Day] every human being will come to know what he has prepared [for himself]."},{"n":15,"g":5815,"t":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","e":"So I swear by the retreating stars -","j":30,"p":586,"r":523,"h":234,"w":3,"u":"ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں","s":"نو زه قسم خورم په هغو (ستوریو) چې بېرته ګرځېدونكي دي","a":"BUT NAY! I call to witness the revolving stars,"},{"n":16,"g":5816,"t":"ٱلْجَوَارِ ٱلْكُنَّسِ","e":"Those that run [their courses] and disappear -","j":30,"p":586,"r":523,"h":234,"w":2,"u":"(اور) جو سیر کرتے اور غائب ہو جاتے ہیں","s":"په روانو، پټېدونكو باندې","a":"the planets that run their course and set,"},{"n":17,"g":5817,"t":"وَٱلَّيْلِ إِذَا عَسْعَسَ","e":"And by the night as it closes in","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور رات کی قسم جب ختم ہونے لگتی ہے","s":"او قسم خورم په شپې كله چې شروع شي","a":"and the night as it darkly falls,"},{"n":18,"g":5818,"t":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","e":"And by the dawn when it breathes","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور صبح کی قسم جب نمودار ہوتی ہے","s":"او په سبا كله چې دى ساه واخلي (روښانه شي)","a":"and the morn as it softly breathes:"},{"n":19,"g":5819,"t":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","e":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","j":30,"p":586,"r":523,"h":234,"w":4,"u":"کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے","s":"بېشكه دا (قرآن) خامخا د ډېر عزتمن رسول قول دى","a":"behold, this [divine writ] is indeed the [inspired] word of a noble apostle,"},{"n":20,"g":5820,"t":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","e":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","j":30,"p":586,"r":523,"h":234,"w":6,"u":"جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے","s":"چې د عرش د مالك په نیز د قوت والا (او) د مرتبې والا دى","a":"with strength endowed, secure with Him who in almightiness is enthroned"},{"n":21,"g":5821,"t":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","e":"Obeyed there [in the heavens] and trustworthy.","j":30,"p":586,"r":523,"h":234,"w":3,"u":"سردار (اور) امانت دار ہے","s":"منلى شوى دى هلته، امین دى","a":"[the word] of one to be heeded, and worthy of trust!"},{"n":22,"g":5822,"t":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","e":"And your companion is not [at all] mad.","j":30,"p":586,"r":523,"h":234,"w":3,"u":"اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں","s":"او ستاسو ملګرى (محمدﷺ) له سره لېونى نه دى","a":"For, this fellow-man of yours is not a madman:"},{"n":23,"g":5823,"t":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","e":"And he has already seen Gabriel in the clear horizon.","j":30,"p":586,"r":523,"h":234,"w":4,"u":"بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے","s":"او یقینًا یقینًا ده دغه (جبریل د اسمان) په څرګنده غاړه كې لیدلى و","a":"he truly beheld [the angel - beheld] him on the clear horizon;"},{"n":24,"g":5824,"t":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","e":"And Muhammad is not a withholder of [knowledge of] the unseen.","j":30,"p":586,"r":523,"h":234,"w":5,"u":"اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں","s":"او دى د وحي په بیانولو كې له سره بخل كوونكى نه دى","a":"and he is not one to begrudge others the knowledge [of whatever has been revealed to him] out of that which is beyond the reach of human Perception."},{"n":25,"g":5825,"t":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","e":"And the Qur'an is not the word of a devil, expelled [from the heavens].","j":30,"p":586,"r":523,"h":234,"w":5,"u":"اور یہ شیطان مردود کا کلام نہیں","s":"او بېخي نه دى دا (قرآن) خبره د شیطان رټل شوي","a":"Nor is this [message] the word of any satanic force accursed."},{"n":26,"g":5826,"t":"فَأَيْنَ تَذْهَبُونَ","e":"So where are you going?","j":30,"p":586,"r":523,"h":234,"w":2,"u":"پھر تم کدھر جا رہے ہو","s":"نو تاسو (اى كافرانو!) چېرته ځئ؟","a":"Whither, then, will you go?"},{"n":27,"g":5827,"t":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","e":"It is not except a reminder to the worlds","j":30,"p":586,"r":523,"h":234,"w":5,"u":"یہ تو جہان کے لوگوں کے لیے نصیحت ہے","s":"نه دى دا (قرآن) مګر د عالمونو لپاره نصیحت (او پند)","a":"This [message] is no less than a reminder to all mankind –"},{"n":28,"g":5828,"t":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","e":"For whoever wills among you to take a right course.","j":30,"p":586,"r":523,"h":234,"w":5,"u":"(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے","s":"د هغه چا لپاره چې په تاسو كې غواړې چې دى نېغ برابر شي","a":"to everyone of you who wills to walk a straight way."},{"n":29,"g":5829,"t":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","e":"And you do not will except that Allah wills - Lord of the worlds.","j":30,"p":586,"r":523,"h":234,"w":8,"u":"اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے","s":"او تاسو د (د سمې لارې) اراده نشئ كولى مګر دا چې الله رب العلمین يې اراده وكړي","a":"But you cannot will it unless God, the Sustainer of all the worlds, wills [to show you that way]."}]},{"number":82,"name":"سُورَةُ الانفِطَارِ","en":"Al-Infitaar","tr":"The Cleaving","rev":"Meccan","ayahs":[{"n":1,"g":5830,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","e":"When the sky breaks apart","j":30,"p":587,"r":524,"h":235,"w":7,"u":"جب آسمان پھٹ جائے گا","s":"كله چې اسمان وچوي","a":"WHEN THE SKY is cleft asunder,"},{"n":2,"g":5831,"t":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","e":"And when the stars fall, scattering,","j":30,"p":587,"r":524,"h":235,"w":3,"u":"اور جب تارے جھڑ پڑیں گے","s":"او كله چې ستوري ګډوډ شي (او) راولوېږي","a":"and when the stars are scattered,"},{"n":3,"g":5832,"t":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","e":"And when the seas are erupted","j":30,"p":587,"r":524,"h":235,"w":3,"u":"اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے","s":"او كله چې دریابونه یو ځاى روان كړى شي","a":"and when the seas burst beyond their bounds,"},{"n":4,"g":5833,"t":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","e":"And when the [contents of] graves are scattered,","j":30,"p":587,"r":524,"h":235,"w":3,"u":"اور جب قبریں اکھیڑ دی جائیں گی","s":"او كله چې قبرونه لاندې باندې كړى شي","a":"and when the graves are overturned –"},{"n":5,"g":5834,"t":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","e":"A soul will [then] know what it has put forth and kept back.","j":30,"p":587,"r":524,"h":235,"w":5,"u":"تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا","s":"هر نفس به په هغه څه پوه شي چې ده وړاندې لېږلي دي او وروسته يې پرېښې دي","a":"every human being will [at last] comprehend, what he has sent ahead and what he has held back [in this world]."},{"n":6,"g":5835,"t":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","e":"O mankind, what has deceived you concerning your Lord, the Generous,","j":30,"p":587,"r":524,"h":235,"w":6,"u":"اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا","s":"اى (كافره) انسانه! ته په خپل كریم (او سخي) رب باندې څه شي دوكه كړى يې","a":"O MAN! What is it that lures thee away from thy bountiful Sustainer,"},{"n":7,"g":5836,"t":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","e":"Who created you, proportioned you, and balanced you?","j":30,"p":587,"r":524,"h":235,"w":4,"u":"(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا","s":"هغه چې ته يې پیدا كړې، نو ته يې ښه برابر كړې","a":"who has created thee, and formed thee in accordance with what thou art meant' to be, and shaped thy nature in just proportions,"},{"n":8,"g":5837,"t":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","e":"In whatever form He willed has He assembled you.","j":30,"p":587,"r":524,"h":235,"w":6,"u":"اور جس صورت میں چاہا تجھے جوڑ دیا","s":"په هر صورت (شكل) كې چې هغه غوښتل، ته يې پیوند (او جوړ) كړې","a":"having put thee together in whatever form He willed [thee to have]?"},{"n":9,"g":5838,"t":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","e":"No! But you deny the Recompense.","j":30,"p":587,"r":524,"h":235,"w":4,"u":"مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو","s":"داسې بېخي نه ده، بلكې تاسو د بدلې ورځ (قیامت) دروغ ګڼئ","a":"Nay, [O men,] but you [are lured away from God whenever you are tempted to] give the lie to [God’s] Judgment!"},{"n":10,"g":5839,"t":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","e":"And indeed, [appointed] over you are keepers,","j":30,"p":587,"r":524,"h":235,"w":3,"u":"حالانکہ تم پر نگہبان مقرر ہیں","s":"په داسې حال كې چې پر تاسو باندې ساتونكي (ملايك) مقرر دي","a":"And yet, verily, there are ever-watchful forces over you,"},{"n":11,"g":5840,"t":"كِرَامًۭا كَٰتِبِينَ","e":"Noble and recording;","j":30,"p":587,"r":524,"h":235,"w":2,"u":"عالی قدر (تمہاری باتوں کے) لکھنے والے","s":"چې عزتمن لیكونكي دي","a":"noble, recording,"},{"n":12,"g":5841,"t":"يَعْلَمُونَ مَا تَفْعَلُونَ","e":"They know whatever you do.","j":30,"p":587,"r":524,"h":235,"w":3,"u":"جو تم کرتے ہو وہ اسے جانتے ہیں","s":"دوى په هغه څه پوهېږي چې تاسو يې كوئ","a":"aware of whatever you do!"},{"n":13,"g":5842,"t":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","e":"Indeed, the righteous will be in pleasure,","j":30,"p":587,"r":524,"h":235,"w":4,"u":"بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔","s":"بېشكه نېكان (مومنان) به خامخا په نعمتونو كې وي","a":"Behold, [in the life to come] the truly virtuous: will indeed be in bliss,"},{"n":14,"g":5843,"t":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","e":"And indeed, the wicked will be in Hellfire.","j":30,"p":587,"r":524,"h":235,"w":4,"u":"اور بدکردار دوزخ میں","s":"او بېشكه چې بدكاران (كافران) به خامخا په جهنم كې وي","a":"whereas, behold, the wicked will indeed be in a blazing fire –"},{"n":15,"g":5844,"t":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","e":"They will [enter to] burn therein on the Day of Recompense,","j":30,"p":587,"r":524,"h":235,"w":3,"u":"(یعنی) جزا کے دن اس میں داخل ہوں گے","s":"دوى به ده ته د بدلې په ورځ ننوځي","a":"[a fire] which they shall enter on Judgment Day,"},{"n":16,"g":5845,"t":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","e":"And never therefrom will they be absent.","j":30,"p":587,"r":524,"h":235,"w":4,"u":"اور اس سے چھپ نہیں سکیں گے","s":"او دوى به له دغه (دوزخ) نه له سره پټېدونكي نه وي","a":"and which they shall not [be able to] evade."},{"n":17,"g":5846,"t":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","e":"And what can make you know what is the Day of Recompense?","j":30,"p":587,"r":524,"h":235,"w":5,"u":"اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟","s":"او ته څه شي پوه كړې چې د بدلې ورځ (قیامت) څه شى دى؟","a":"And what could make thee conceive what that Judgment Day will be?"},{"n":18,"g":5847,"t":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","e":"Then, what can make you know what is the Day of Recompense?","j":30,"p":587,"r":524,"h":235,"w":6,"u":"پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟","s":"بیا ته څه شي پوه كړې چې د بدلې ورځ څه شى دى","a":"And once again: What could make thee conceive what that Judgment Day will be?"},{"n":19,"g":5848,"t":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","e":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah.","j":30,"p":587,"r":524,"h":235,"w":10,"u":"جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا","s":"(یاده كړه) هغه ورځ چې هېڅ یو نفس به د بل نفس لپاره د هېڅ شي اختیار ونه لري۔ او په دغې ورځ كې به امر (حكم) خاص الله لره وي","a":"[It will be] a Day when no human being shall be of the least avail to another human being: for on that Day [it will become manifest that] all sovereignty is God's alone."}]},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","en":"Al-Mutaffifin","tr":"Defrauding","rev":"Meccan","ayahs":[{"n":1,"g":5849,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ","e":"Woe to those who give less [than due],","j":30,"p":587,"r":525,"h":235,"w":6,"u":"ناپ اور تول میں کمی کرنے والوں کے لیے خرابی ہے","s":"(په تول او پېمانه كې) كمي كوونكو لره هلاكت دى","a":"WOE UNTO THOSE who give short measure:"},{"n":2,"g":5850,"t":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","e":"Who, when they take a measure from people, take in full.","j":30,"p":587,"r":525,"h":235,"w":6,"u":"جو لوگوں سے ناپ کر لیں تو پورا لیں","s":"هغه كسان چې دوى له خلقو نه ځان ته پېمانه اخلي (، نو) پوره (يې) اخلي","a":"those who, when they are to receive their due from [other] people, demand that it be given in full –"},{"n":3,"g":5851,"t":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","e":"But if they give by measure or by weight to them, they cause loss.","j":30,"p":587,"r":525,"h":235,"w":5,"u":"اور جب ان کو ناپ کر یا تول کر دیں تو کم کر دیں","s":"او كله چې دغو (خلقو) ته پېمانه وركوي، یا يې دوى ته تلي (، نو) كمى كوي","a":"but when they have to measure or weigh whatever they owe to others, give less than what is due!"},{"n":4,"g":5852,"t":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","e":"Do they not think that they will be resurrected","j":30,"p":587,"r":525,"h":235,"w":5,"u":"کیا یہ لوگ نہیں جانتے کہ اٹھائے بھی جائیں گے","s":"ایا دغه خلق یقین نه كوي چې بېشكه دوى به بیا راژوندي كول شي","a":"Do they not know that they are bound to be raised from the dead"},{"n":5,"g":5853,"t":"لِيَوْمٍ عَظِيمٍۢ","e":"For a tremendous Day -","j":30,"p":587,"r":525,"h":235,"w":2,"u":"(یعنی) ایک بڑے (سخت) دن میں","s":"په ډېره لویه ورځ كې (د حساب لپاره)","a":"[and called to account] on an awesome Day –"},{"n":6,"g":5854,"t":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","e":"The Day when mankind will stand before the Lord of the worlds?","j":30,"p":587,"r":525,"h":235,"w":5,"u":"جس دن (تمام) لوگ رب العالمین کے سامنے کھڑے ہوں گے","s":"هغه ورځ چې خلق به ’’رب العلمین‘‘ ته ودرېږي","a":"the Day when all men shall stand before the Sustainer of all the worlds?"},{"n":7,"g":5855,"t":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ","e":"No! Indeed, the record of the wicked is in sijjeen.","j":30,"p":588,"r":525,"h":235,"w":6,"u":"سن رکھو کہ بدکارروں کے اعمال سجّین میں ہیں","s":"هیڅكله داسې نه ده په كار، بېشكه د فاجرانو (كافرانو) كتاب (لیكل شوي عملونه) خامخا په سجین كې دي","a":"NAY, VERILY, the record of the wicked is indeed [set down] in a mode inescapable!"},{"n":8,"g":5856,"t":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ","e":"And what can make you know what is sijjeen?","j":30,"p":588,"r":525,"h":235,"w":4,"u":"اور تم کیا جانتے ہوں کہ سجّین کیا چیز ہے؟","s":"او ته څه شي پوه كړې چې سجین څه شى دى","a":"And what could make thee conceive what that that mode inescapable will be?"},{"n":9,"g":5857,"t":"كِتَٰبٌۭ مَّرْقُومٌۭ","e":"It is [their destination recorded in] a register inscribed.","j":30,"p":588,"r":525,"h":235,"w":2,"u":"ایک دفتر ہے لکھا ہوا","s":"یو دفتر (كتاب) دى لیكل شوى","a":"A record [indelibly] inscribed!"},{"n":10,"g":5858,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","e":"Woe, that Day, to the deniers,","j":30,"p":588,"r":525,"h":235,"w":3,"u":"اس دن جھٹلانے والوں کی خرابی ہے","s":"په دغې ورځ كې د دروغ ګڼونكو لپاره هلاكت دى","a":"Woe on that Day unto those who give the lie to the truth –"},{"n":11,"g":5859,"t":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","e":"Who deny the Day of Recompense.","j":30,"p":588,"r":525,"h":235,"w":4,"u":"(یعنی) جو انصاف کے دن کو جھٹلاتے ہیں","s":"هغه كسان چې د بدلې ورځ دروغ ګڼي","a":"those who give the lie to the [coming of] Judgment Day:"},{"n":12,"g":5860,"t":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","e":"And none deny it except every sinful transgressor.","j":30,"p":588,"r":525,"h":235,"w":7,"u":"اور اس کو جھٹلاتا وہی ہے جو حد سے نکل جانے والا گنہگار ہے","s":"او دغه (ورځ) دروغ نه ګڼي مګر هر زیاتي كوونكى، سخت ګناه ګار","a":"for, none gives the lie to it but such as are wont to transgress against all that is [and are] immersed in sin:"},{"n":13,"g":5861,"t":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","e":"When Our verses are recited to him, he says, \"Legends of the former peoples.\"","j":30,"p":588,"r":525,"h":235,"w":7,"u":"جب اس کو ہماری آیتیں سنائی جاتی ہیں تو کہتا ہے کہ یہ تو اگلے لوگوں کے افسانے ہیں","s":"كله چې ده ته زمونږ ایتونه تلاوت كولى شي؛ دى وايي: (دا) د ړومبنیو (خلقو) باطلې قصې دي","a":"[and so,] whenever Our messages are conveyed to them, they but say, \"Fables of ancient times!\""},{"n":14,"g":5862,"t":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","e":"No! Rather, the stain has covered their hearts of that which they were earning.","j":30,"p":588,"r":525,"h":235,"w":10,"u":"دیکھو یہ جو (اعمال بد) کرتے ہیں ان کا ان کے دلوں پر زنگ بیٹھ گیا ہے","s":"داسې نه ده، بلكې د دوى په زړونو باندې هغو (د ګناه عملونو) زنګ لګولى دى چې دوى به كول","a":"Nay, but their hearts are corroded by all [the evil] that they were wont to do!"},{"n":15,"g":5863,"t":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ","e":"No! Indeed, from their Lord, that Day, they will be partitioned.","j":30,"p":588,"r":525,"h":235,"w":6,"u":"بےشک یہ لوگ اس روز اپنے پروردگار (کے دیدار) سے اوٹ میں ہوں گے","s":"داسې نه ده په كار، بېشكه دوى به په دغې ورځ كې له خپل رب نه یقینًا په حجاب (بند) كړى شوي وي","a":"Nay, verily, from [the grace of] their Sustainer shall they on that Day be debarred;"},{"n":16,"g":5864,"t":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","e":"Then indeed, they will [enter and] burn in Hellfire.","j":30,"p":588,"r":525,"h":235,"w":4,"u":"پھر دوزخ میں جا داخل ہوں گے","s":"بیا بېشكه دوى یقینًا دوزخ ته ننوتونكي دي","a":"and then, behold, they shall enter the blazing fire"},{"n":17,"g":5865,"t":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","e":"Then it will be said [to them], \"This is what you used to deny.\"","j":30,"p":588,"r":525,"h":235,"w":7,"u":"پھر ان سے کہا جائے گا کہ یہ وہی چیز ہے جس کو تم جھٹلاتے تھے","s":"بیا به (دوى ته) ویلى شي: دا هغه (دوزخ) دى چې تاسو به دا دروغ ګاڼه","a":"and be told: \"This is the [very thing] to which you were wont to give the lie!\""},{"n":18,"g":5866,"t":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","e":"No! Indeed, the record of the righteous is in 'illiyyun.","j":30,"p":588,"r":525,"h":235,"w":6,"u":"(یہ بھی) سن رکھو کہ نیکوکاروں کے اعمال علیین میں ہیں","s":"داسې نه ده، بېشكه د نېكانو (خلقو) عملنامې (لیكلى كتاب) خامخا په ’’علِّیین‘‘ كې دي","a":"NAY, VERILY - the record of the truly virtuous is [set down] in a mode most lofty!"},{"n":19,"g":5867,"t":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","e":"And what can make you know what is 'illiyyun?","j":30,"p":588,"r":525,"h":235,"w":4,"u":"اور تم کو کیا معلوم کہ علیین کیا چیز ہے؟","s":"او ته څه شي پوه كړې چې ’’علّیون‘‘ څه شى دى","a":"And what could make thee conceive what that mode most lofty will be?"},{"n":20,"g":5868,"t":"كِتَٰبٌۭ مَّرْقُومٌۭ","e":"It is [their destination recorded in] a register inscribed","j":30,"p":588,"r":525,"h":235,"w":2,"u":"ایک دفتر ہے لکھا ہوا","s":"یو دفتر (كتاب) دى چې لیكل شوى دى","a":"A record [indelibly] inscribed,"},{"n":21,"g":5869,"t":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","e":"Which is witnessed by those brought near [to Allah].","j":30,"p":588,"r":525,"h":235,"w":2,"u":"جس کے پاس مقرب (فرشتے) حاضر رہتے ہیں","s":"چې ده ته مقرب (بنده ګان او ملايك) حاضرېږي","a":"witnessed~ by all who have [ever] been drawn close unto God."},{"n":22,"g":5870,"t":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","e":"Indeed, the righteous will be in pleasure","j":30,"p":588,"r":525,"h":235,"w":4,"u":"بےشک نیک لوگ چین میں ہوں گے","s":"بېشكه نېكان خلق یقینًا په نعمتونو كې دي","a":"Behold, [in the life to come] the truly virtuous will indeed be in bliss:"},{"n":23,"g":5871,"t":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","e":"On adorned couches, observing.","j":30,"p":588,"r":525,"h":235,"w":3,"u":"تختوں پر بیٹھے ہوئے نظارے کریں گے","s":"دوى به په تختونو باندې (ناست) وي، ګوري به","a":"[resting on couches, they will look up [to God]:"},{"n":24,"g":5872,"t":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","e":"You will recognize in their faces the radiance of pleasure.","j":30,"p":588,"r":525,"h":235,"w":5,"u":"تم ان کے چہروں ہی سے راحت کی تازگی معلوم کر لو گے","s":"(اى كتونكیه!) ته به د دوى په مخونو كې د نعمتونو تازګي وینې","a":"upon their faces thou wilt see the brightness of bliss."},{"n":25,"g":5873,"t":"يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ","e":"They will be given to drink [pure] wine [which was] sealed.","j":30,"p":588,"r":525,"h":235,"w":4,"u":"ان کو خالص شراب سربمہر پلائی جائے گی","s":"په دوى به مُهر (ټاپه) كړى شوي خالص شراب څښولى شي","a":"They will be given a drink of pure wine whereon the seal [of God] will have been set,"},{"n":26,"g":5874,"t":"خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","e":"The last of it is musk. So for this let the competitors compete.","j":30,"p":588,"r":525,"h":235,"w":7,"u":"جس کی مہر مشک کی ہو گی تو (نعمتوں کے) شائقین کو چاہیے کہ اسی سے رغبت کریں","s":"چې د دغو مُهر (ټاپه) به مشك وي، او په دغه (نعمتونو) كې، پس په كار ده چې رغبت كوونكي رغبت وكړي","a":"pouring forth with a fragrance of musk. To that [wine of paradise], then, let all such aspire as [are willing to] aspire to things of high account:"},{"n":27,"g":5875,"t":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","e":"And its mixture is of Tasneem,","j":30,"p":588,"r":525,"h":235,"w":3,"u":"اور اس میں تسنیم (کے پانی) کی آمیزش ہو گی","s":"د دغو (شرابو) ګډون له تسنیم (چينې) څخه دى","a":"for it is composed of all that is most exalting"},{"n":28,"g":5876,"t":"عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","e":"A spring from which those near [to Allah] drink.","j":30,"p":588,"r":525,"h":235,"w":4,"u":"وہ ایک چشمہ ہے جس میں سے (خدا کے) مقرب پیئیں گے","s":"چې یوه چینه ده چې له دې نه به (د الله) مقربین څښي","a":"a source [of bliss] whereof those who are drawn close unto God shall drink."},{"n":29,"g":5877,"t":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","e":"Indeed, those who committed crimes used to laugh at those who believed.","j":30,"p":588,"r":525,"h":235,"w":8,"u":"جو گنہگار (یعنی کفار) ہیں وہ (دنیا میں) مومنوں سے ہنسی کیا کرتے تھے","s":"بېشكه هغه كسان چې جرم (د كفر) يې كړى دى۔، دوى به په هغو كسانو پورې خندا كوله چې ایمان يې راوړى و","a":"BEHOLD, those who have abandoned themselves to sin are wont to laugh at such as have attained to faith"},{"n":30,"g":5878,"t":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","e":"And when they passed by them, they would exchange derisive glances.","j":30,"p":588,"r":525,"h":235,"w":4,"u":"اور جب ان کے پاس سے گزرتے تو حقارت سے اشارے کرتے","s":"او كله چې به د دوى (مومنانو) په خوا كې تېرېدل (نو) په خپلو منځونو كې به يې سترګكونه وهل","a":"and whenever they pass by them, they wink at one another [derisively];"},{"n":31,"g":5879,"t":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","e":"And when they returned to their people, they would return jesting.","j":30,"p":588,"r":525,"h":235,"w":6,"u":"اور جب اپنے گھر کو لوٹتے تو اتراتے ہوئے لوٹتے","s":"او كله چې به دوى خپلو كورونو ته واپس كېدل (نو) خوشاله به واپس كېدل","a":"and whenever they return to people of their own kind, they return full of jests;"},{"n":32,"g":5880,"t":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","e":"And when they saw them, they would say, \"Indeed, those are truly lost.\"","j":30,"p":588,"r":525,"h":235,"w":6,"u":"اور جب ان (مومنوں) کو دیکھتے تو کہتے کہ یہ تو گمراہ ہیں","s":"او كله چې به دوى دغه (مسلمانان) وليدل (نو) ويل به يې: بېشكه دغه خلق یقینًا ګمراهان دي","a":"and whenever they see those [who believe,] they say, \"Behold, these [people] have indeed gone astray!\""},{"n":33,"g":5881,"t":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","e":"But they had not been sent as guardians over them.","j":30,"p":588,"r":525,"h":235,"w":4,"u":"حالانکہ وہ ان پر نگراں بنا کر نہیں بھیجے گئے تھے","s":"حال دا چې دوى په دغو (مومنانو) باندې نګرانان (څوكيداران) نه وو لېږل شوي","a":"And, withal, they have no call to watch over [the beliefs of] others..."},{"n":34,"g":5882,"t":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","e":"So Today those who believed are laughing at the disbelievers,","j":30,"p":588,"r":525,"h":235,"w":6,"u":"تو آج مومن کافروں سے ہنسی کریں گے","s":"نو په نن ورځ به هغه كسان چې ایمان يې راوړى دى؛ په كافرانو پورې خندا كوي","a":"But on the Day [of Judgment], they who had attained to faith will [be able to] laugh at the [erstwhile] deniers of the truth:"},{"n":35,"g":5883,"t":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","e":"On adorned couches, observing.","j":30,"p":589,"r":525,"h":235,"w":3,"u":"(اور) تختوں پر (بیٹھے ہوئے ان کا حال) دیکھ رہے ہوں گے","s":"په تختونو باندې به ناست وي، چې ګوري به","a":"[for, resting in paradise] on couches, they will look on [and say to themselves]:"},{"n":36,"g":5884,"t":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","e":"Have the disbelievers [not] been rewarded [this Day] for what they used to do?","j":30,"p":589,"r":525,"h":235,"w":6,"u":"تو کافروں کو ان کے عملوں کا (پورا پورا) بدلہ مل گیا","s":"یقینًا كافرانو ته د هغه څه بدله وركړى شوه چې دوى به كول","a":"\"Are these deniers of the truth being [thus] requited for [aught but] what they were wont to do?\""}]},{"number":84,"name":"سُورَةُ الانشِقَاقِ","en":"Al-Inshiqaaq","tr":"The Splitting Open","rev":"Meccan","ayahs":[{"n":1,"g":5885,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","e":"When the sky has split [open]","j":30,"p":589,"r":526,"h":236,"w":7,"u":"جب آسمان پھٹ جائے گا","s":"كله چې اسمان څیرې شي","a":"WHEN THE SKY is split asunder,"},{"n":2,"g":5886,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","e":"And has responded to its Lord and was obligated [to do so]","j":30,"p":589,"r":526,"h":236,"w":3,"u":"اور اپنے پروردگار کا فرمان بجا لائے گا اور اسے واجب بھی یہ ہی ہے","s":"او خپل رب ته غوږ كېږدي او دى (اسمان) د همدې لايق دى","a":"obeying its Sustainer, as in truth it must;"},{"n":3,"g":5887,"t":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","e":"And when the earth has been extended","j":30,"p":589,"r":526,"h":236,"w":3,"u":"اور جب زمین ہموار کر دی جائے گی","s":"او كله چې ځمكه راښكلى شي","a":"and when the earth is leveled,"},{"n":4,"g":5888,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","e":"And has cast out that within it and relinquished [it]","j":30,"p":589,"r":526,"h":236,"w":4,"u":"جو کچھ اس میں ہے اسے نکال کر باہر ڈال دے گی اور (بالکل) خالی ہو جائے گی","s":"او هغه څه د باندې وغورځوي چې په دې كې دي او خالي شي","a":"and casts forth whatever is in it, and becomes utterly void,"},{"n":5,"g":5889,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","e":"And has responded to its Lord and was obligated [to do so] -","j":30,"p":589,"r":526,"h":236,"w":3,"u":"اور اپنے پروردگار کے ارشاد کی تعمیل کرے گی اور اس کو لازم بھی یہی ہے (تو قیامت قائم ہو جائے گی)","s":"او خپل رب ته غوږ كېږدي او دا د همدې لايق ده","a":"obeying its Sustainer, as in truth it must -:"},{"n":6,"g":5890,"t":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","e":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","j":30,"p":589,"r":526,"h":236,"w":8,"u":"اے انسان! تو اپنے پروردگار کی طرف (پہنچنے میں) خوب کوشِش کرتا ہے سو اس سے جا ملے گا","s":"اى انسانه! بېشكه ته په پوره كوشش سره كار كوونكى يې تر خپل ربه (سره د ملاقات پورې)، ښه په كوشش سره كار كول، پس ته