َءَاثَارًۭا فِى ٱلْأَرْضِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُم مِّنَ ٱللَّهِ مِن وَاقٍۢ","e":"Have they not traveled through the land and observed how was the end of those who were before them? They were greater than them in strength and in impression on the land, but Allah seized them for their sins. And they had not from Allah any protector.","j":24,"p":469,"r":406,"h":188,"w":32,"u":"کیا انہوں نے زمین میں سیر نہیں کی تاکہ دیکھ لیتے کہ جو لوگ ان سے پہلے تھے ان کا انجام کیسا ہوا۔ وہ ان سے زور اور زمین میں نشانات (بنانے) کے لحاظ سے کہیں بڑھ کر تھے تو خدا نے ان کو ان کے گناہوں کے سبب پکڑ لیا۔ اور ان کو خدا (کے عذاب) سے کوئی بھی بچانے والا نہ تھا","s":"ایا دوى په ځمكه كې نه دي ګرځېدلي، پس چې وګوري چې د هغو كسانو انجام څنګه و، چې له دوى نه مخكې وو، هغوى له دوى نه په قوت كې او په ځمكه كې د نښو (او یادګارونو) په لحاظ ډېر سخت (او مضبوط) وو، نو الله دوى د خپلو ګناهونو په سبب ونیول او د دوى لپاره له الله نه هیڅوك بچ كوونكى نه و","a":"Have they, then, never journeyed about the earth and beheld what happened in the end to those [deniers of the truth] who lived before their time? Greater were they in power than they are, and in the impact which they left on earth: but God took them to task for their sins, and they had none to defend them against God:"},{"n":22,"g":4155,"t":"ذَٰلِكَ بِأَنَّهُمْ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَكَفَرُوا۟ فَأَخَذَهُمُ ٱللَّهُ ۚ إِنَّهُۥ قَوِىٌّۭ شَدِيدُ ٱلْعِقَابِ","e":"That was because their messengers were coming to them with clear proofs, but they disbelieved, so Allah seized them. Indeed, He is Powerful and severe in punishment.","j":24,"p":469,"r":406,"h":188,"w":14,"u":"یہ اس لئے کہ ان کے پاس پیغمبر کھلی دلیلیں لاتے تھے تو یہ کفر کرتے تھے سو خدا نے ان کو پکڑ لیا۔ بےشک وہ صاحب قوت (اور) سخت عذاب دینے والا ہے","s":"دغه په دې سبب چې یقینًا دوى داسې وو چې دوى ته خپلو رسولانو ښكاره دلیلونه راوړل، نو (بیا هم) دوى كافران شول، نو الله دوى ونیول، بېشكه هغه، ډېر زورور، ډېر سخت عذاب والا دى","a":"this, because their apostles had come to them with all evidence of the truth, and yet they rejected it: and so God took them to task - for, verily, He is powerful, severe in retribution!"},{"n":23,"g":4156,"t":"وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِـَٔايَٰتِنَا وَسُلْطَٰنٍۢ مُّبِينٍ","e":"And We did certainly send Moses with Our signs and a clear authority","j":24,"p":469,"r":406,"h":188,"w":6,"u":"اور ہم نے موسیٰ کو اپنی نشانیاں اور دلیل روشن دے کر بھیجا","s":"او یقینًا یقینًا مونږ موسٰى له خپلو معجزو او ښكاره دلیل سره لېږلى و","a":"THUS, INDEED, did We send Moses with Our mes­sages and a manifest authority [from Us]"},{"n":24,"g":4157,"t":"إِلَىٰ فِرْعَوْنَ وَهَٰمَٰنَ وَقَٰرُونَ فَقَالُوا۟ سَٰحِرٌۭ كَذَّابٌۭ","e":"To Pharaoh, Haman and Qarun; but they said, \"[He is] a magician and a liar.\"","j":24,"p":469,"r":406,"h":188,"w":7,"u":"(یعنی) فرعون اور ہامان اور قارون کی طرف تو انہوں نے کہا کہ یہ تو جادوگر ہے جھوٹا","s":"فرعون او هامان او قارون ته، نو دوى وویل: (دا خو) جادوګر دى، سخت دروغجن دى","a":"unto Pharaoh, and Haman, and Qarun; but they [only] said, “A spellbinder is he, a liar!”"},{"n":25,"g":4158,"t":"فَلَمَّا جَآءَهُم بِٱلْحَقِّ مِنْ عِندِنَا قَالُوا۟ ٱقْتُلُوٓا۟ أَبْنَآءَ ٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ وَٱسْتَحْيُوا۟ نِسَآءَهُمْ ۚ وَمَا كَيْدُ ٱلْكَٰفِرِينَ إِلَّا فِى ضَلَٰلٍۢ","e":"And when he brought them the truth from Us, they said, \"Kill the sons of those who have believed with him and keep their women alive.\" But the plan of the disbelievers is not except in error.","j":24,"p":469,"r":406,"h":188,"w":20,"u":"غرض جب وہ ان کے پاس ہماری طرف سے حق لے کر پہنچے تو کہنے لگے کہ جو اس کے ساتھ (خدا پر) ایمان لائے ہیں ان کے بیٹوں کو قتل کردو اور بیٹیوں کو زندہ رہنے دو۔ اور کافروں کی تدبیریں بےٹھکانے ہوتی ہیں","s":"نو كله چې هغه دوى ته زمونږ له جانبه حق راوړ، دوى وویل: تاسو د هغو كسانو زامن ووژنئ چې له ده سره يې ایمان راوړى دى او د دوى ښځې (لوڼه) ژوندۍ پرېږدئ او د كافرانو چل مكر نه دى مګر په تباهۍ كې","a":"Now [as for Pharaoh and his followers,] when he came to them, setting forth the truth from Us, they said, “Slay the sons of those who share his beliefs, and spare [only] their women!” - but the guile of those deniers of the truth could not lead to aught but failure."},{"n":26,"g":4159,"t":"وَقَالَ فِرْعَوْنُ ذَرُونِىٓ أَقْتُلْ مُوسَىٰ وَلْيَدْعُ رَبَّهُۥٓ ۖ إِنِّىٓ أَخَافُ أَن يُبَدِّلَ دِينَكُمْ أَوْ أَن يُظْهِرَ فِى ٱلْأَرْضِ ٱلْفَسَادَ","e":"And Pharaoh said, \"Let me kill Moses and let him call upon his Lord. Indeed, I fear that he will change your religion or that he will cause corruption in the land.\"","j":24,"p":470,"r":406,"h":188,"w":19,"u":"اور فرعون بولا کہ مجھے چھوڑو کہ موسیٰ کو قتل کردوں اور وہ اپنے پروردگار کو بلالے۔ مجھے ڈر ہے کہ وہ (کہیں) تمہارے دین کو نہ بدل دے یا ملک میں فساد (نہ) پیدا کردے","s":"او فرعون (خپلو درباریانو ته) وویل: تاسو ما پرېږدئ چې زه (دا) موسٰى ووژنم او دا دې خپل رب ته چغې ووهي، بېشكه زه له دې وېرېږم چې دا به ستاسو دین بدل كړي، یا به په ځمكه كې فساد خور كړي","a":"And Pharaoh said: “Leave it to me to slay Moses - and let him invoke his [alleged] sustainer! Behold, I fear lest he cause you to change your religion, or lest he cause corruption to prevail in the land!”"},{"n":27,"g":4160,"t":"وَقَالَ مُوسَىٰٓ إِنِّى عُذْتُ بِرَبِّى وَرَبِّكُم مِّن كُلِّ مُتَكَبِّرٍۢ لَّا يُؤْمِنُ بِيَوْمِ ٱلْحِسَابِ","e":"But Moses said, \"Indeed, I have sought refuge in my Lord and your Lord from every arrogant one who does not believe in the Day of Account.\"","j":24,"p":470,"r":406,"h":188,"w":13,"u":"موسیٰ نے کہا کہ میں ہر متکبر سے جو حساب کے دن (یعنی قیامت) پر ایمان نہیں لاتا۔ اپنے اور تمہارے پروردگار کی پناہ لے چکا ہوں","s":"او موسٰى وویل چې بېشكه ما د خپل رب او ستاسو د رب پناه نیولې ده له هر تكبر كوونكي نه، چې د حساب په ورځې ایمان نه لري","a":"But Moses said: “With [Him who is] my Sus­tainer as well as your Sustainer have I indeed found refuge from everyone who, immersed in false pride, will not believe in [the coming of] the Day of Reckon­ing!”"},{"n":28,"g":4161,"t":"وَقَالَ رَجُلٌۭ مُّؤْمِنٌۭ مِّنْ ءَالِ فِرْعَوْنَ يَكْتُمُ إِيمَٰنَهُۥٓ أَتَقْتُلُونَ رَجُلًا أَن يَقُولَ رَبِّىَ ٱللَّهُ وَقَدْ جَآءَكُم بِٱلْبَيِّنَٰتِ مِن رَّبِّكُمْ ۖ وَإِن يَكُ كَٰذِبًۭا فَعَلَيْهِ كَذِبُهُۥ ۖ وَإِن يَكُ صَادِقًۭا يُصِبْكُم بَعْضُ ٱلَّذِى يَعِدُكُمْ ۖ إِنَّ ٱللَّهَ لَا يَهْدِى مَنْ هُوَ مُسْرِفٌۭ كَذَّابٌۭ","e":"And a believing man from the family of Pharaoh who concealed his faith said, \"Do you kill a man [merely] because he says, 'My Lord is Allah' while he has brought you clear proofs from your Lord? And if he should be lying, then upon him is [the consequence of] his lie; but if he should be truthful, there will strike you some of what he promises you. Indeed, Allah does not guide one who is a transgressor and a liar.","j":24,"p":470,"r":407,"h":188,"w":42,"u":"اور فرعون کے لوگوں میں سے ایک مومن شخص جو اپنے ایمان کو پوشیدہ رکھتا تھا کہنے لگا کیا تم ایسے شخص کو قتل کرنا چاہتے ہو جو کہتا ہے کہ میرا پروردگار خدا ہے اور وہ تمہارے پروردگار (کی طرف) سے نشانیاں بھی لے کر آیا ہے۔ اور اگر وہ جھوٹا ہوگا تو اس کے جھوٹ کا ضرر اسی کو ہوگا۔ اور اگر سچا ہوگا تو کوئی سا عذاب جس کا وہ تم سے وعدہ کرتا ہے تم پر واقع ہو کر رہے گا۔ بےشک خدا اس شخص کو ہدایت نہیں دیتا جو بےلحاظ جھوٹا ہے","s":"او په اٰل فرعون كې یو مومن سړي چې خپل ایمان يې پټ ساتلو، وویل: ایا تاسو یو سړى په دې وجه وژنئ چې هغه وايي: زما رب الله دى، حال دا چې یقینًا هغه تاسو ته د خپل رب له جانبه ښكاره دلیلونه هم راوړي دي او كه دى دروغجن وي، نو په همده باندې د خپلو دروغو ضرر دى او كه دى رښتینى وي (نو بیا خو به) تاسو ته د هغه (عذاب) ځینې برخه درورسېږي چې دا يې تاسو ته وعده دركوي، بېشكه الله هدایت نه كوي هغه چا ته چې هغه له حده تېرېدونكى، ډېر دروغجن وي","a":"At that, a believing man of Pharaoh’s family, who [until then] had concealed his faith, exclaimed: “Would you slay a man because he says, ‘God is my Sustainer’ - seeing, withal, that he has brought you all evidence of this truth from your Sustainer? Now if he be a liar, his lie will fall back on him; but if he is a man of truth, something [of the punishment] whereof he warns you is bound to befall you: for, verily, God would not grace with His guidance one who has wasted his own self by lying [about Him]."},{"n":29,"g":4162,"t":"يَٰقَوْمِ لَكُمُ ٱلْمُلْكُ ٱلْيَوْمَ ظَٰهِرِينَ فِى ٱلْأَرْضِ فَمَن يَنصُرُنَا مِنۢ بَأْسِ ٱللَّهِ إِن جَآءَنَا ۚ قَالَ فِرْعَوْنُ مَآ أُرِيكُمْ إِلَّا مَآ أَرَىٰ وَمَآ أَهْدِيكُمْ إِلَّا سَبِيلَ ٱلرَّشَادِ","e":"O my people, sovereignty is yours today, [your being] dominant in the land. But who would protect us from the punishment of Allah if it came to us?\" Pharaoh said, \"I do not show you except what I see, and I do not guide you except to the way of right conduct.\"","j":24,"p":470,"r":407,"h":188,"w":27,"u":"اے قوم آج تمہاری ہی بادشاہت ہے اور تم ہی ملک میں غالب ہو۔ (لیکن) اگر ہم پر خدا کا عذاب آگیا تو (اس کے دور کرنے کے لئے) ہماری مدد کون کرے گا۔ فرعون نے کہا کہ میں تمہیں وہی بات سُجھاتا ہوں جو مجھے سوجھی ہے اور وہی راہ بتاتا ہوں جس میں بھلائی ہے","s":"اى زما قومه! نن ورځ ستاسو بادشاهي ده، په داسې حال كې چې په ځمكه كې غالب يئ، نو مونږ به د الله له عذاب نه څوك بچ كوي كه هغه پر مونږ راشي؟ فرعون وویل: زه تاسو ته نه ښیم مګر هغه خبره چې زه يې وینم او زه تاسو ته ښودنه نه كوم مګر د سمې درستې لارې","a":"“O my people! Yours is the dominion today, [and] most eminent are you on earth: but who will rescue us from God’s punishment, once it befalls us?” Said Pharaoh: “I but want to make you see what I see myself; and I would never make you follow any path but that of rectitude!”"},{"n":30,"g":4163,"t":"وَقَالَ ٱلَّذِىٓ ءَامَنَ يَٰقَوْمِ إِنِّىٓ أَخَافُ عَلَيْكُم مِّثْلَ يَوْمِ ٱلْأَحْزَابِ","e":"And he who believed said, \"O my people, indeed I fear for you [a fate] like the day of the companies -","j":24,"p":470,"r":407,"h":188,"w":10,"u":"تو جو مومن تھا وہ کہنے لگا کہ اے قوم مجھے تمہاری نسبت خوف ہے کہ (مبادا) تم پر اور اُمتوں کی طرح کے دن کا عذاب آجائے","s":"او هغه كس وویل چې ایمان يې راوړى و: اى زما قومه! بېشكه زه په تاسو د (تېرو) ډلو د ورځې له مثل نه وېرېږم","a":"Thereupon exclaimed he who had attained to faith: “O my people! Verily, I fear for you the like of what one day befell those others who were leagued together [against God’s truth] –"},{"n":31,"g":4164,"t":"مِثْلَ دَأْبِ قَوْمِ نُوحٍۢ وَعَادٍۢ وَثَمُودَ وَٱلَّذِينَ مِنۢ بَعْدِهِمْ ۚ وَمَا ٱللَّهُ يُرِيدُ ظُلْمًۭا لِّلْعِبَادِ","e":"Like the custom of the people of Noah and of 'Aad and Thamud and those after them. And Allah wants no injustice for [His] servants.","j":24,"p":470,"r":407,"h":188,"w":15,"u":"یعنی) نوح کی قوم اور عاد اور ثمود اور جو لوگ ان کے پیچھے ہوئے ہیں ان کے حال کی طرح (تمہارا حال نہ ہوجائے) اور خدا تو بندوں پر ظلم کرنا نہیں چاہتا","s":"د نوح د قوم او عادیانو او ثمودیانو او د هغو كسانو د حال له مثل نه چې له دوى نه وروسته وو او الله په بنده ګانو د هېڅ ظلم اراده نه كوي","a":"the like of what happened to Noah’s people, and to [the tribes of] Ad and Thamud and those who came after them! And, withal, God does not will any wrong for His crea­tures."},{"n":32,"g":4165,"t":"وَيَٰقَوْمِ إِنِّىٓ أَخَافُ عَلَيْكُمْ يَوْمَ ٱلتَّنَادِ","e":"And O my people, indeed I fear for you the Day of Calling -","j":24,"p":470,"r":407,"h":188,"w":6,"u":"اور اے قوم مجھے تمہاری نسبت پکار کے دن (یعنی قیامت) کا خوف ہے","s":"او اى زما قومه! زه په تاسو یو بل ته د چيغو وهلو له ورځې نه وېرېږم","a":"“And, O my people, I fear for you [the coming of] that Day of [Judgment - the Day when you will be] calling unto one another [in distress] –"},{"n":33,"g":4166,"t":"يَوْمَ تُوَلُّونَ مُدْبِرِينَ مَا لَكُم مِّنَ ٱللَّهِ مِنْ عَاصِمٍۢ ۗ وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِنْ هَادٍۢ","e":"The Day you will turn your backs fleeing; there is not for you from Allah any protector. And whoever Allah leaves astray - there is not for him any guide.","j":24,"p":470,"r":407,"h":188,"w":17,"u":"جس دن تم پیٹھ پھیر کر (قیامت کے دن سے) بھاگو گے (اس دن) تم کو کوئی (عذاب) خدا سے بچانے والا نہ ہوگا۔ اور جس شخص کو خدا گمراہ کرے اس کو کوئی ہدایت دینے والا نہیں","s":"هغه ورځ چې تاسو به وګرځئ شا اړوونكي، په داسې حال كې چې تاسو لپاره به له الله نه هیڅوك بچ كوونكى نه وي. او هغه څوك چې الله يې ګمراه كړي، نو د هغه لپاره هیڅوك هدایت وركوونكى نشته","a":"the Day when you will [wish to] turn your backs and flee, having none to defend you against God: for he whom God lets go astray can never find any guide."},{"n":34,"g":4167,"t":"وَلَقَدْ جَآءَكُمْ يُوسُفُ مِن قَبْلُ بِٱلْبَيِّنَٰتِ فَمَا زِلْتُمْ فِى شَكٍّۢ مِّمَّا جَآءَكُم بِهِۦ ۖ حَتَّىٰٓ إِذَا هَلَكَ قُلْتُمْ لَن يَبْعَثَ ٱللَّهُ مِنۢ بَعْدِهِۦ رَسُولًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَنْ هُوَ مُسْرِفٌۭ مُّرْتَابٌ","e":"And Joseph had already come to you before with clear proofs, but you remained in doubt of that which he brought to you, until when he died, you said, 'Never will Allah send a messenger after him.' Thus does Allah leave astray he who is a transgressor and skeptic.\"","j":24,"p":471,"r":407,"h":188,"w":32,"u":"اور پہلے یوسف بھی تمہارے پاس نشانیاں لے کر آئے تھے تو جو وہ لائے تھے اس سے تم ہمیشہ شک ہی میں رہے۔ یہاں تک کہ جب وہ فوت ہوگئے تو تم کہنے لگے کہ خدا اس کے بعد کبھی کوئی پیغمبر نہیں بھیجے گا۔ اسی طرح خدا اس شخص کو گمراہ کر دیتا ہے جو حد سے نکل جانے والا اور شک کرنے والا ہو","s":"او یقینًا یقینًا تاسو ته له ده نه مخكې یوسف په واضحو دلیلونو سره راغلى و، نو تاسو د هغه څه په باره كې چې تاسو ته هغه راوړى و؛ تل په شك كې وئ، تر هغه پورې چې كله هغه مړ شو، تاسو وویل: له ده نه وروسته به الله له سره هېڅ رسول راونه لېږي، همداسې الله ګمراه كوي هغه چا لره چې هغه له حده تېرېدونكى، شك كوونكى دى","a":"“And [remember:] it was to you that Joseph came aforetime with all evidence of the truth; but you never ceased to throw doubt on all [the messages] that he brought you - so much so that when he died, you said, ‘Never will God send any apostle [even] after him!’ “In this way God lets go astray such as waste their own selves by throwing suspicion [on His revela­tions] –"},{"n":35,"g":4168,"t":"ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ بِغَيْرِ سُلْطَٰنٍ أَتَىٰهُمْ ۖ كَبُرَ مَقْتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُوا۟ ۚ كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلْبِ مُتَكَبِّرٍۢ جَبَّارٍۢ","e":"Those who dispute concerning the signs of Allah without an authority having come to them - great is hatred [of them] in the sight of Allah and in the sight of those who have believed. Thus does Allah seal over every heart [belonging to] an arrogant tyrant.","j":24,"p":471,"r":407,"h":188,"w":25,"u":"جو لوگ بغیر اس کے کہ ان کے پاس کوئی دلیل آئی ہو خدا کی آیتوں میں جھگڑتے ہیں۔ خدا کے نزدیک اور مومنوں کے نزدیک یہ جھگڑا سخت ناپسند ہے۔ اسی طرح خدا ہر متکبر سرکش کے دل پر مہر لگا دیتا ہے","s":"هغه كسان چې د الله په ایتونو كې جګړې كوي بې له كوم داسې دلیله چې دوى ته راغلى وي، (دغه) د الله په نېز او د هغو كسانو په نېز چې ایمان يې راوړى د غضب په لحاظ غټه خبره ده، همداسې الله د تكبر كوونكي او جبر كوونكي په هر (جز د) زړه باندې مهر لګوي","a":"such as would call God’s messages in question without having any evidence therefor: [a sin] exceedingly loathsome in the sight of God and of those who have attained to faith. It is in this way that God sets a seal on every arrogant, self-exalting heart.”"},{"n":36,"g":4169,"t":"وَقَالَ فِرْعَوْنُ يَٰهَٰمَٰنُ ٱبْنِ لِى صَرْحًۭا لَّعَلِّىٓ أَبْلُغُ ٱلْأَسْبَٰبَ","e":"And Pharaoh said, \"O Haman, construct for me a tower that I might reach the ways -","j":24,"p":471,"r":407,"h":188,"w":9,"u":"اور فرعون نے کہا کہ ہامان میرے لئے ایک محل بناؤ تاکہ میں (اس پر چڑھ کر) رستوں پر پہنچ جاؤں","s":"او فرعون وویل: اى هامانه! ته زما لپاره یوه ډېره اوچته ماڼۍ جوړه كړه، ښايي چې زه لارو ته ورسېږم","a":"But Pharaoh said: “O Haman! Build me a lofty tower, that haply I may attain to the [right] means"},{"n":37,"g":4170,"t":"أَسْبَٰبَ ٱلسَّمَٰوَٰتِ فَأَطَّلِعَ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّى لَأَظُنُّهُۥ كَٰذِبًۭا ۚ وَكَذَٰلِكَ زُيِّنَ لِفِرْعَوْنَ سُوٓءُ عَمَلِهِۦ وَصُدَّ عَنِ ٱلسَّبِيلِ ۚ وَمَا كَيْدُ فِرْعَوْنَ إِلَّا فِى تَبَابٍۢ","e":"The ways into the heavens - so that I may look at the deity of Moses; but indeed, I think he is a liar.\" And thus was made attractive to Pharaoh the evil of his deed, and he was averted from the [right] way. And the plan of Pharaoh was not except in ruin.","j":24,"p":471,"r":407,"h":188,"w":25,"u":"(یعنی) آسمانوں کے رستوں پر، پھر موسیٰ کے خدا کو دیکھ لوں اور میں تو اسے جھوٹا سمجھتا ہوں۔ اور اسی طرح فرعون کو اس کے اعمال بد اچھے معلوم ہوتے تھے اور وہ رستے سے روک دیا گیا تھا۔ اور فرعون کی تدبیر تو بےکار تھی","s":"داسمانونو لارو ته، بیا د موسٰى الله له بره وګورم او بېشكه زه یقینًا دا دروغجن ګڼم او همداسې فرعون ته خپل بد عمل ښايسته كړى شوى و، او له (حقې) لارې نه منع كړى شوى و او د فرعون چل (او مكر) نه و مګر په تباهۍ كې","a":"the means of approach to the heavens - and that [thus] I may have a look at the god of Moses: for, behold, I am indeed certain that he is a liar!” And thus, goodly seemed unto Pharaoh the evil of his own doings, and so he was barred from the path [of truth]: and Pharaoh’s guile did not lead to aught but ruin."},{"n":38,"g":4171,"t":"وَقَالَ ٱلَّذِىٓ ءَامَنَ يَٰقَوْمِ ٱتَّبِعُونِ أَهْدِكُمْ سَبِيلَ ٱلرَّشَادِ","e":"And he who believed said, \"O my people, follow me, I will guide you to the way of right conduct.","j":24,"p":471,"r":408,"h":188,"w":8,"u":"اور وہ شخص جو مومن تھا اس نے کہا کہ بھائیو میرے پیچھے چلو میں تمہیں بھلائی کا رستہ دکھاؤ ں","s":"او هغه كس چې ایمان يې راوړى و، وویل: اى زما قومه! تاسو زما پیروي وكړئ چې زه تاسو ته د هدایت لاره وښیم","a":"Still, the man who had attained to faith went on: “O my people! Follow me: I shall guide you onto the path of rectitude!"},{"n":39,"g":4172,"t":"يَٰقَوْمِ إِنَّمَا هَٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَا مَتَٰعٌۭ وَإِنَّ ٱلْءَاخِرَةَ هِىَ دَارُ ٱلْقَرَارِ","e":"O my people, this worldly life is only [temporary] enjoyment, and indeed, the Hereafter - that is the home of [permanent] settlement.","j":24,"p":471,"r":408,"h":188,"w":11,"u":"بھائیو یہ دنیا کی زندگی (چند روزہ) فائدہ اٹھانے کی چیز ہے۔ اور جو آخرت ہے وہی ہمیشہ رہنے کا گھر ہے","s":"اى زما قومه! بېشكه همدا خبره ده چې دغه دنيايي ژوند خو لږه فايده ده او یقینًا اخرت چې دى، هم هغه د قرار كور دى","a":"“O my people! This worldly life is but a brief enjoyment, whereas, behold, the life to come is the home abiding."},{"n":40,"g":4173,"t":"مَنْ عَمِلَ سَيِّئَةًۭ فَلَا يُجْزَىٰٓ إِلَّا مِثْلَهَا ۖ وَمَنْ عَمِلَ صَٰلِحًۭا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌۭ فَأُو۟لَٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍۢ","e":"Whoever does an evil deed will not be recompensed except by the like thereof; but whoever does righteousness, whether male or female, while he is a believer - those will enter Paradise, being given provision therein without account.","j":24,"p":471,"r":408,"h":188,"w":24,"u":"جو برے کام کرے گا اس کو بدلہ بھی ویسا ہی ملے گا۔ اور جو نیک کام کرے گا مرد ہو یا عورت اور وہ صاحب ایمان بھی ہوگا تو ایسے لوگ بہشت میں داخل ہوں گے وہاں ان کو بےشمار رزق ملے گا","s":"هر څوك چې بد كار وكړي، نو ده ته به بدله نه وركولى شي مګر په مثل د دغه (بد كار) او هر څوك چې نېك عمل وكړي، سړى وي، يا ښځه، په داسې حال كې چې مومن وي، نو دغه كسان به جنت ته داخلېږي، دوى ته به په دغه (جنت) كې بې حسابه رزق وركول كېږي","a":"[There,] anyone who has done a bad deed will be requited with no more than the like thereof, whereas anyone, be it man or woman, who has done righteous deeds and is a believer withal - all such will enter paradise, wherein they shall be blest with good beyond all reckoning!"},{"n":41,"g":4174,"t":"۞ وَيَٰقَوْمِ مَا لِىٓ أَدْعُوكُمْ إِلَى ٱلنَّجَوٰةِ وَتَدْعُونَنِىٓ إِلَى ٱلنَّارِ","e":"And O my people, how is it that I invite you to salvation while you invite me to the Fire?","j":24,"p":472,"r":408,"h":189,"w":10,"u":"اور اے قوم میرا کیا (حال) ہے کہ میں تم کو نجات کی طرف بلاتا ہوں اور تم مجھے (دوزخ کی) آگ کی طرف بلاتے ہو","s":"او اى زما قومه! په ما څه چل دى چې زه تاسو نجات (او خلاصي) ته راغواړم او تاسو ما اور ته رابلئ","a":"“And, O my people, how is it that I summon you to salvation, the while you summon me to the fire?"},{"n":42,"g":4175,"t":"تَدْعُونَنِى لِأَكْفُرَ بِٱللَّهِ وَأُشْرِكَ بِهِۦ مَا لَيْسَ لِى بِهِۦ عِلْمٌۭ وَأَنَا۠ أَدْعُوكُمْ إِلَى ٱلْعَزِيزِ ٱلْغَفَّٰرِ","e":"You invite me to disbelieve in Allah and associate with Him that of which I have no knowledge, and I invite you to the Exalted in Might, the Perpetual Forgiver.","j":24,"p":472,"r":408,"h":189,"w":15,"u":"تم مجھے اس لئے بلاتے ہو کہ خدا کے ساتھ کفر کروں اور اس چیز کو اس کا شریک مقرر کروں جس کا مجھے کچھ بھی علم نہیں۔ اور میں تم کو (خدائے) غالب (اور) بخشنے والے کی طرف بلاتا ہوں","s":"تاسو ما رابلئ د دې لپاره چې زه په الله سره كافر شم او له هغه سره هغه شى شریك كړم چې ما ته د دغه (شي په اله كېدو) هېڅ علم نشته، حال دا چې زه تاسو ډېر غالب، ډېر مغفرت كوونكي (الله) ته رابولم","a":"- [for] you call upon me to deny [the one­ness of] God and to ascribe a share in His divinity to aught of which I cannot [possibly] have any knowl­edge the while I summon you to [a cognition of] the Almighty, the All-Forgiving!"},{"n":43,"g":4176,"t":"لَا جَرَمَ أَنَّمَا تَدْعُونَنِىٓ إِلَيْهِ لَيْسَ لَهُۥ دَعْوَةٌۭ فِى ٱلدُّنْيَا وَلَا فِى ٱلْءَاخِرَةِ وَأَنَّ مَرَدَّنَآ إِلَى ٱللَّهِ وَأَنَّ ٱلْمُسْرِفِينَ هُمْ أَصْحَٰبُ ٱلنَّارِ","e":"Assuredly, that to which you invite me has no [response to a] supplication in this world or in the Hereafter; and indeed, our return is to Allah, and indeed, the transgressors will be companions of the Fire.","j":24,"p":472,"r":408,"h":189,"w":22,"u":"سچ تو یہ ہے کہ جس چیز کی طرف تم مجھے بلاتے ہو اس کو دنیا اور آخرت میں بلانے (یعنی دعا قبول کرنے) کا مقدور نہیں اور ہم کو خدا کی طرف لوٹنا ہے اور حد سے نکل جانے والے دوزخی ہیں","s":"حقه خبره دا ده چې یقینًا هغه (معبود) چې تاسو ما (د) هغه (عبادت) ته بلئ، د هغه لپاره خو نه په دنیا كې څه بلل شته او نه په اخرت كې او دا چې بېشكه زمونږ بېرته ورتلل خاص الله ته دي او دا چې يقينًا له حده تېرېدونكي، همدغه د اور ملګري دي","a":"“There is no doubt that what you summon me to is something that has no claim to being invoked either in this world or in the life to come - as [there is no doubt] that unto God is our return, and that they who have wasted their own selves shall find them­selves in the fire:"},{"n":44,"g":4177,"t":"فَسَتَذْكُرُونَ مَآ أَقُولُ لَكُمْ ۚ وَأُفَوِّضُ أَمْرِىٓ إِلَى ٱللَّهِ ۚ إِنَّ ٱللَّهَ بَصِيرٌۢ بِٱلْعِبَادِ","e":"And you will remember what I [now] say to you, and I entrust my affair to Allah. Indeed, Allah is Seeing of [His] servants.\"","j":24,"p":472,"r":408,"h":189,"w":14,"u":"جو بات میں تم سے کہتا ہوں تم اسے آگے چل کر یاد کرو گے۔ اور میں اپنا کام خدا کے سپرد کرتا ہوں۔ بےشک خدا بندوں کو دیکھنے والا ہے","s":"پس ژر ده چې تاسو به دغه خبرې يادوئ چې زه يې تاسو ته (اوس) وایم. او زه خپل كار الله ته سپارم، بېشكه الله (خپلو) بنده ګانو لره ښه لیدونكى دى","a":"and at that time you will [have cause to] remember what I am telling you [now]. “But [as for me,] I commit myself unto God: for, verily, God sees all that is in [the hearts of] His servants.”"},{"n":45,"g":4178,"t":"فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُوا۟ ۖ وَحَاقَ بِـَٔالِ فِرْعَوْنَ سُوٓءُ ٱلْعَذَابِ","e":"So Allah protected him from the evils they plotted, and the people of Pharaoh were enveloped by the worst of punishment -","j":24,"p":472,"r":408,"h":189,"w":11,"u":"غرض خدا نے موسیٰ کو ان لوگوں کی تدبیروں کی برائیوں سے محفوظ رکھا اور فرعون والوں کو برے عذاب نے آگھیرا","s":"نو الله هغه د دوى د مكرونو له بديو نه بچ وساته او (پخپله) اٰل فرعون ډېر سخت عذاب ګېركړل","a":"And God preserved him from the evil of their scheming, whereas suffering vile was to encompass Pharaoh’s folk:"},{"n":46,"g":4179,"t":"ٱلنَّارُ يُعْرَضُونَ عَلَيْهَا غُدُوًّۭا وَعَشِيًّۭا ۖ وَيَوْمَ تَقُومُ ٱلسَّاعَةُ أَدْخِلُوٓا۟ ءَالَ فِرْعَوْنَ أَشَدَّ ٱلْعَذَابِ","e":"The Fire, they are exposed to it morning and evening. And the Day the Hour appears [it will be said], \"Make the people of Pharaoh enter the severest punishment.\"","j":24,"p":472,"r":408,"h":189,"w":14,"u":"یعنی) آتش (جہنم) کہ صبح وشام اس کے سامنے پیش کئے جاتے ہیں۔ اور جس روز قیامت برپا ہوگی (حکم ہوگا کہ) فرعون والوں کو نہایت سخت عذاب میں داخل کرو","s":"(د دوزخ) اور (چې دى) دوى هغه ته هر سبا او هر بېګاه وړاندې كاوه شي او په هغې ورځ كې چې قیامت قايم شي (نو ملايكو ته به وویل شي:) تاسو ال فرعون لره تر ټولو سخت عذاب ته ننباسئ","a":"the fire [of the hereafter - that fire] which they had been made to contemplate [in vain], morning and evening: for on the Day when the Last Hour dawns [God will say], “Make Phar­aoh’s folk enter upon suffering most severe!”"},{"n":47,"g":4180,"t":"وَإِذْ يَتَحَآجُّونَ فِى ٱلنَّارِ فَيَقُولُ ٱلضُّعَفَٰٓؤُا۟ لِلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا كُنَّا لَكُمْ تَبَعًۭا فَهَلْ أَنتُم مُّغْنُونَ عَنَّا نَصِيبًۭا مِّنَ ٱلنَّارِ","e":"And [mention] when they will argue within the Fire, and the weak will say to those who had been arrogant, \"Indeed, we were [only] your followers, so will you relieve us of a share of the Fire?\"","j":24,"p":472,"r":408,"h":189,"w":19,"u":"اور جب وہ دوزخ میں جھگڑیں گے تو ادنیٰ درجے کے لوگ بڑے آدمیوں سے کہیں گے کہ ہم تو تمہارے تابع تھے تو کیا تم دوزخ (کے عذاب) کا کچھ حصہ ہم سے دور کرسکتے ہو؟","s":"او (یاد كړه) هغه وخت چې دوى به په خپل مینځ كې جګړې كوي، نو كمزوري به هغو كسانو ته وايي چې تكبر يې كاوه: بېشكه مونږ خو ستاسو پیروي كوونكي وو، نو ایا تاسو زمونږ نه له اور ځنې څه برخه لرې كوونكي يئ؟","a":"AND LO! They [who in life were wont to deny the truth] will contend with one another in the fire [of the hereafter]; and then the weak will say unto those who had gloried in their arrogance, “Behold, we were but your followers: can you, then, relieve us of some [of our] share of this fire?”"},{"n":48,"g":4181,"t":"قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا كُلٌّۭ فِيهَآ إِنَّ ٱللَّهَ قَدْ حَكَمَ بَيْنَ ٱلْعِبَادِ","e":"Those who had been arrogant will say, \"Indeed, all [of us] are in it. Indeed, Allah has judged between the servants.\"","j":24,"p":472,"r":408,"h":189,"w":12,"u":"بڑے آدمی کہیں گے کہ تم (بھی اور) ہم (بھی) سب دوزخ میں (رہیں گے) خدا بندوں میں فیصلہ کرچکا ہے","s":"هغه كسان به (په جواب كې) ووايي چې تكبر يې كړى و: بېشكه مونږ ټول په دغه (دوزخ) كې یو، بېشكه الله د بنده ګانو په مينځ كې فیصله كړې ده","a":"[to which] they who had [once] been arrogant will reply, “Behold, we are all in it [together]! Verily, God has judged between His creatures!”"},{"n":49,"g":4182,"t":"وَقَالَ ٱلَّذِينَ فِى ٱلنَّارِ لِخَزَنَةِ جَهَنَّمَ ٱدْعُوا۟ رَبَّكُمْ يُخَفِّفْ عَنَّا يَوْمًۭا مِّنَ ٱلْعَذَابِ","e":"And those in the Fire will say to the keepers of Hell, \"Supplicate your Lord to lighten for us a day from the punishment.\"","j":24,"p":472,"r":408,"h":189,"w":13,"u":"اور جو لوگ آگ میں (جل رہے) ہوں گے وہ دوزخ کے داروغوں سے کہیں گے کہ اپنے پروردگار سے دعا کرو کہ ایک روز تو ہم سے عذاب ہلکا کردے","s":"او هغه كسان به چې (د دوزخ) په اور كې دي، د جهنم نګرانانو ته ووايي: تاسو له خپل رب نه دعا وغواړئ چې زمونږ په عذاب كې بس یوه ورځ تخفیف وكړي","a":"And they who are in the fire will say to the keepers of hell, “Pray unto your Sustainer that He lighten, [though it be] for one day [only], this suffering of ours!”"},{"n":50,"g":4183,"t":"قَالُوٓا۟ أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُكُم بِٱلْبَيِّنَٰتِ ۖ قَالُوا۟ بَلَىٰ ۚ قَالُوا۟ فَٱدْعُوا۟ ۗ وَمَا دُعَٰٓؤُا۟ ٱلْكَٰفِرِينَ إِلَّا فِى ضَلَٰلٍ","e":"They will say, \"Did there not come to you your messengers with clear proofs?\" They will say, \"Yes.\" They will reply, \"Then supplicate [yourselves], but the supplication of the disbelievers is not except in error.\"","j":24,"p":473,"r":408,"h":189,"w":19,"u":"وہ کہیں گے کہ کیا تمہارے پاس تمہارے پیغمبر نشانیاں لے کر نہیں آئے تھے۔ وہ کہیں گے کیوں نہیں تو وہ کہیں گے کہ تم ہی دعا کرو۔ اور کافروں کی دعا (اس روز) بےکار ہوگی","s":"دوى به (په جواب كې) ووايي: ایا تاسو ته به ستاسو رسولان په واضحو دلیلونو سره نه راتلل؟ دوى (دوزخیان) به ووايي: ولې نه (نو) دوى (د دوزخ نګرانان) به ووايي، پس تاسو (پخپله) دعا وكړئ او د كافرانو دعا نه ده مګر په ضیاع كې","a":"[But the keepers of hell] will ask, “Is it not [true] that your apostles came unto you with all evidence of the truth?” Those [in the fire] will reply, “Yea, indeed.” [And the keepers of hell] will say, “Pray, then!” - for the prayer of those who deny the truth cannot lead to aught but delusion."},{"n":51,"g":4184,"t":"إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَيَوْمَ يَقُومُ ٱلْأَشْهَٰدُ","e":"Indeed, We will support Our messengers and those who believe during the life of this world and on the Day when the witnesses will stand -","j":24,"p":473,"r":409,"h":189,"w":11,"u":"ہم اپنے پیغمبروں کی اور جو لوگ ایمان لائے ہیں ان کی دنیا کی زندگی میں بھی مدد کرتے ہیں اور جس دن گواہ کھڑے ہوں گے (یعنی قیامت کو بھی)","s":"بېشكه مونږ خامخا د خپلو رسولانو او د هغو كسانو چې ایمان يې راوړى دى، په دنيايي ژوند كې مدد كوو او په هغې ورځ كې (هم) چې ګواهان به ودرېږي","a":"BEHOLD, We shall indeed succour Our apostles and those who have attained to faith, [both] in this world’s life and on the Day when all the witnesses shall stand up"},{"n":52,"g":4185,"t":"يَوْمَ لَا يَنفَعُ ٱلظَّٰلِمِينَ مَعْذِرَتُهُمْ ۖ وَلَهُمُ ٱللَّعْنَةُ وَلَهُمْ سُوٓءُ ٱلدَّارِ","e":"The Day their excuse will not benefit the wrongdoers, and they will have the curse, and they will have the worst home.","j":24,"p":473,"r":409,"h":189,"w":11,"u":"جس دن ظالموں کو ان کی معذرت کچھ فائدہ نہ دے گی اور ان کے لئے لعنت اور برا گھر ہے","s":"په هغې ورځې كې چې ظالمانو (مشركانو) ته به د هغوى معذرت هېڅ نفع نه رسوي او د همدوى لپاره لعنت دى او د همدوى لپاره بد كور (دوزخ) دى","a":"the Day when their excuses will be of no avail to the evildoers, seeing that their lot will be rejection from all that is good, and a woeful hereafter."},{"n":53,"g":4186,"t":"وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْهُدَىٰ وَأَوْرَثْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَٰبَ","e":"And We had certainly given Moses guidance, and We caused the Children of Israel to inherit the Scripture","j":24,"p":473,"r":409,"h":189,"w":8,"u":"اور ہم نے موسیٰ کو ہدایت (کی کتاب) دی اور بنی اسرائیل کو اس کتاب کا وارث بنایا","s":"او یقینًا یقینًا مونږ موسٰى ته هدایت (تورات) وركړى و او بني اسرائیلو ته مو كتاب میراث وركړ","a":"And, indeed, We bestowed aforetime [Our] guidance on Moses, and [thus] made the children of Israel heirs to the divine writ [revealed to him]"},{"n":54,"g":4187,"t":"هُدًۭى وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَٰبِ","e":"As guidance and a reminder for those of understanding.","j":24,"p":473,"r":409,"h":189,"w":4,"u":"عقل والوں کے لئے ہدایت اور نصیحت ہے","s":"په داسې حال كې چې د خالصو عقلونو والاو ته هدایت او پند و","a":"as a [means of] guidance and a reminder for those who were endowed with insight:"},{"n":55,"g":4188,"t":"فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّۭ وَٱسْتَغْفِرْ لِذَنۢبِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِٱلْعَشِىِّ وَٱلْإِبْكَٰرِ","e":"So be patient, [O Muhammad]. Indeed, the promise of Allah is truth. And ask forgiveness for your sin and exalt [Allah] with praise of your Lord in the evening and the morning.","j":24,"p":473,"r":409,"h":189,"w":12,"u":"تو صبر کرو بےشک خدا کا وعدہ سچا ہے اور اپنے گناہوں کی معافی مانگو اور صبح وشام اپنے پروردگار کی تعریف کے ساتھ تسبیح کرتے رہو","s":"نو (اى نبي) ته صبر وكړه! بېشكه د الله وعده حقه ده او د خپلې ګناه لپاره بخښنه وغواړه او د ورځې په اخره او اوله برخه كې د خپل رب له ستاينې سره تسبیح وایه","a":"hence, remain thou patient in adversity - for, verily, God’s promise always comes true - and ask forgiveness for thy sins, and extol thy Sustainer’s glory and praise by night and by day."},{"n":56,"g":4189,"t":"إِنَّ ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ بِغَيْرِ سُلْطَٰنٍ أَتَىٰهُمْ ۙ إِن فِى صُدُورِهِمْ إِلَّا كِبْرٌۭ مَّا هُم بِبَٰلِغِيهِ ۚ فَٱسْتَعِذْ بِٱللَّهِ ۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ","e":"Indeed, those who dispute concerning the signs of Allah without [any] authority having come to them - there is not within their breasts except pride, [the extent of] which they cannot reach. So seek refuge in Allah. Indeed, it is He who is the Hearing, the Seeing.","j":24,"p":473,"r":409,"h":189,"w":26,"u":"جو لوگ بغیر کسی دلیل کے جو ان کے پاس آئی ہو خدا کی آیتوں میں جھگڑتے ہیں ان کے دلوں میں اور کچھ نہیں (ارادہٴ) عظمت ہے اور وہ اس کو پہنچنے والے نہیں تو خدا کی پناہ مانگو۔ بےشک وہ سننے والا (اور) دیکھنے والا ہے","s":"بېشكه هغه كسان چې د الله په ایتونو كې جګړې كوي، بې له داسې دلیله چې دوى ته راغلى وي، د دوى په سینو كې نه دى مګر كبر چې دوى دغه (د كبر مقتضا) ته رسېدونكي نه دي، نو ته په الله پورې پناه ونیسه، بېشكه هغه، هم هغه ښه اورېدونكى، ښه لیدونكى دى","a":"Behold, as for those who call God’s messages in question without having any evidence therefore in their hearts is nothing but overweening self-con­ceit, which they will never be able to satisfy: seek thou, then, refuge with God - for, verily, He alone is all-hearing, all-seeing!"},{"n":57,"g":4190,"t":"لَخَلْقُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ أَكْبَرُ مِنْ خَلْقِ ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ","e":"The creation of the heavens and earth is greater than the creation of mankind, but most of the people do not know.","j":24,"p":473,"r":409,"h":189,"w":12,"u":"آسمانوں اور زمین کا پیدا کرنا لوگوں کے پیدا کرنے کی نسبت بڑا (کام) ہے لیکن اکثر لوگ نہیں جانتے","s":"یقینًا د اسمانونو او ځمكې پیدا كول د خلقو له پیدا كولو نه ډېر لوى دي او لېكن د خلقو اكثریت نه پوهېږي","a":"Greater indeed than the creation of man is the creation of the heavens and the earth: yet most men do not understand [what this implies]."},{"n":58,"g":4191,"t":"وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَلَا ٱلْمُسِىٓءُ ۚ قَلِيلًۭا مَّا تَتَذَكَّرُونَ","e":"And not equal are the blind and the seeing, nor are those who believe and do righteous deeds and the evildoer. Little do you remember.","j":24,"p":473,"r":409,"h":189,"w":14,"u":"اور اندھا اور آنکھ والا برابر نہیں۔ اور نہ ایمان لانے والے نیکوکار اور نہ بدکار (برابر ہیں) (حقیقت یہ ہے کہ) تم بہت کم غور کرتے ہو","s":"او ړوند او بینا سره نه برابرېږي او نه هم هغه كسان چې ایمان يې راوړى دى او نېك عملونه يې كړي دي او بدكاره (سره نه برابرېږي) تاسو ډېر لږ نصیحت اخلئ","a":"But [then,] the blind and the seeing are not equal; and neither [can] they who have attained to faith and do good works and the doers of evil [be deemed equal]. How seldom do you keep this in mind!"},{"n":59,"g":4192,"t":"إِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌۭ لَّا رَيْبَ فِيهَا وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يُؤْمِنُونَ","e":"Indeed, the Hour is coming - no doubt about it - but most of the people do not believe.","j":24,"p":474,"r":409,"h":189,"w":11,"u":"قیامت آنے والی ہے اس میں کچھ شک نہیں۔ لیکن اکثر لوگ ایمان نہیں رکھتے","s":"بېشكه قیامت خامخا راتلونكى دى، په ده كې هېڅ شك نشته. او لېكن د خلقو اكثریت ایمان نه راوړي","a":"Verily, the Last Hour is sure to come: of this there is no doubt; yet most men will not believe it."},{"n":60,"g":4193,"t":"وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ لَكُمْ ۚ إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ","e":"And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.","j":24,"p":474,"r":409,"h":189,"w":14,"u":"اور تمہارے پروردگار نے کہا ہے کہ تم مجھ سے دعا کرو میں تمہاری (دعا) قبول کروں گا۔ جو لوگ میری عبادت سے ازراہ تکبر کنیاتے ہیں۔ عنقریب جہنم میں ذلیل ہو کر داخل ہوں گے","s":"او ستاسو رب فرمايي: تاسو ما وبلئ چې زه ستاسو دعا قبوله كړم. بېشكه هغه كسان چې زما له عبادت نه تكبر كوي، ژر ده چې دوى به دوزخ ته ننوځي، په داسې حال كې چې خوار او ذلیله به وي","a":"But your Sustainer says: “Call unto Me, [and] I shall respond to you! Verily, they who are too proud to worship Me will enter hell, abased!”"},{"n":61,"g":4194,"t":"ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًا ۚ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ","e":"It is Allah who made for you the night that you may rest therein and the day giving sight. Indeed, Allah is full of bounty to the people, but most of the people are not grateful.","j":24,"p":474,"r":410,"h":189,"w":21,"u":"خدا ہی تو ہے جس نے تمہارے لئے رات بنائی کہ اس میں آرام کرو اور دن کو روشن بنایا (کہ اس میں کام کرو) بےشک خدا لوگوں پر فضل کرنے والا ہے۔ لیکن اکثر لوگ شکر نہیں کرتے","s":"الله هغه ذات دى چې تاسو لپاره يې شپه پیدا كړې ده، د دې لپاره چې تاسو په دې كې ارام حاصل كړئ او ورځ يې روښانه (ګرځولې ده)، بېشكه الله په خلقو باندې خامخا ډېر فضل كولو والا دى او لېكن د خلقو اكثریت شكر نه وباسي","a":"IT IS GOD who has made the night for you, so that you might rest therein, and the day, to make [you] see. Behold, God is indeed limitless in His bounty unto man - but most men are ungrateful."},{"n":62,"g":4195,"t":"ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ خَٰلِقُ كُلِّ شَىْءٍۢ لَّآ إِلَٰهَ إِلَّا هُوَ ۖ فَأَنَّىٰ تُؤْفَكُونَ","e":"That is Allah, your Lord, Creator of all things; there is no deity except Him, so how are you deluded?","j":24,"p":474,"r":410,"h":189,"w":13,"u":"یہی خدا تمہارا پروردگار ہے جو ہر چیز کا پیدا کرنے والا ہے۔ اس کے سوا کوئی معبود نہیں پھر تم کہاں بھٹک رہے ہو؟","s":"دغه الله ستاسو رب دى چې د هر شي پیدا كوونكى دى، نشته هېڅ لايق د عبادت مګر همدى دى، نو كوم طرف ته تاسو ګرځولى شئ","a":"Such is God, your Sustainer, the Creator of all that exists: there is no deity save Him. How perverted, then, are your minds!"},{"n":63,"g":4196,"t":"كَذَٰلِكَ يُؤْفَكُ ٱلَّذِينَ كَانُوا۟ بِـَٔايَٰتِ ٱللَّهِ يَجْحَدُونَ","e":"Thus were those [before you] deluded who were rejecting the signs of Allah.","j":24,"p":474,"r":410,"h":189,"w":7,"u":"اسی طرح وہ لوگ بھٹک رہے تھے جو خدا کی آیتوں سے انکار کرتے تھے","s":"همداسې به (له حق نه) ګرځولى كېدل هغه كسان چې د الله له ایتونو نه به يې انكار كاوه","a":"[For] thus it is: perverted are the minds of those who knowingly reject God’s messages."},{"n":64,"g":4197,"t":"ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ قَرَارًۭا وَٱلسَّمَآءَ بِنَآءًۭ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِ ۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ ۖ فَتَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","e":"It is Allah who made for you the earth a place of settlement and the sky a ceiling and formed you and perfected your forms and provided you with good things. That is Allah, your Lord; then blessed is Allah, Lord of the worlds.","j":24,"p":474,"r":410,"h":189,"w":23,"u":"خدا ہی تو ہے جس نے زمین کو تمہارے لئے ٹھیرنے کی جگہ اور آسمان کو چھت بنایا اور تمہاری صورتیں بنائیں اور صورتیں بھی خوب بنائیں اور تمہیں پاکیزہ چیزیں کھانے کو دیں۔ یہی خدا تمہارا پروردگار ہے۔ پس خدائے پروردگار عالم بہت ہی بابرکت ہے","s":"الله هغه ذات دى چې تاسو لپاره يې ځمكه قرار ځاى او اسمان چت ګرځولى دى او ستاسو صورتونه يې جوړ كړي دي، پس ستاسو صورتونه يې ښكلي جوړ كړي دي او تاسو ته يې له پاكیزه څيزونو نه رزق عطا كړى دى، دغه الله ستاسو رب دى، نو الله رب العالمین ډېر بركتي دى","a":"It is God who has made the earth a resting- place for you and the sky a canopy, and has formed you - and formed you so well and provided for you sustenance out of the good things of life. Such is God, your Sustainer: hallowed, then, is God, the Sustainer of all the worlds!"},{"n":65,"g":4198,"t":"هُوَ ٱلْحَىُّ لَآ إِلَٰهَ إِلَّا هُوَ فَٱدْعُوهُ مُخْلِصِينَ لَهُ ٱلدِّينَ ۗ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","e":"He is the Ever-Living; there is no deity except Him, so call upon Him, [being] sincere to Him in religion. [All] praise is [due] to Allah, Lord of the worlds.","j":24,"p":474,"r":410,"h":189,"w":15,"u":"وہ زندہ ہے (جسے موت نہیں) اس کے سوا کوئی عبادت کے لائق نہیں تو اس کی عبادت کو خالص کر کر اسی کو پکارو۔ ہر طرح کی تعریف خدا ہی کو (سزاوار) ہے جو تمام جہان کا پروردگار ہے","s":"هم دى (تل) ژوندى دى، نشته هېڅ حق معبود مګر هم دى دى، نو تاسو دا بلئ، په داسې حال كې چې هم ده لره د دین خالص كوونكي یئ، ټول د كمال صفتونه خاص د الله رب العالمین لپاره دي","a":"He is the Ever-Living; there is no deity save Him: call, then, unto Him [alone], sincere in your faith in Him. All praise is due to God, the Sustainer of all the worlds!"},{"n":66,"g":4199,"t":"۞ قُلْ إِنِّى نُهِيتُ أَنْ أَعْبُدَ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِ لَمَّا جَآءَنِىَ ٱلْبَيِّنَٰتُ مِن رَّبِّى وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ ٱلْعَٰلَمِينَ","e":"Say, [O Muhammad], \"Indeed, I have been forbidden to worship those you call upon besides Allah once the clear proofs have come to me from my Lord, and I have been commanded to submit to the Lord of the worlds.\"","j":24,"p":474,"r":410,"h":190,"w":21,"u":"(اے محمدﷺ ان سے) کہہ دو کہ مجھے اس بات کی ممانعت کی گئی ہے کہ جن کو تم خدا کے سوا پکارتے ہو ان کی پرستش کروں (اور میں ان کی کیونکر پرستش کروں) جب کہ میرے پاس میرے پروردگار (کی طرف) سے کھلی دلیلیں آچکی ہیں اور مجھ کو یہ حکم ہوا ہے کہ پروردگار عالم ہی کا تابع فرمان ہوں","s":"ته (دوى ته) ووایه: بېشكه زه له دې نه منع كړى شوى یم چې د هغو (معبودانو) عبادت وكړم چې تاسو يې له الله نه غیر بلئ، كله چې ما ته زما د رب له جانبه ښكاره دلیلونه راغلل او ما ته حكم شوى دى چې زه رب العالمین ته تسلیم شم","a":"Say: “Since all evidence of the truth has come to me from my Sustainer, I am forbidden to worship [any of] those beings whom you invoke instead of God; and I am bidden to surrender myself to the Sustainer of all the worlds.”"},{"n":67,"g":4200,"t":"هُوَ ٱلَّذِى خَلَقَكُم مِّن تُرَابٍۢ ثُمَّ مِن نُّطْفَةٍۢ ثُمَّ مِنْ عَلَقَةٍۢ ثُمَّ يُخْرِجُكُمْ طِفْلًۭا ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْ ثُمَّ لِتَكُونُوا۟ شُيُوخًۭا ۚ وَمِنكُم مَّن يُتَوَفَّىٰ مِن قَبْلُ ۖ وَلِتَبْلُغُوٓا۟ أَجَلًۭا مُّسَمًّۭى وَلَعَلَّكُمْ تَعْقِلُونَ","e":"It is He who created you from dust, then from a sperm-drop, then from a clinging clot; then He brings you out as a child; then [He develops you] that you reach your [time of] maturity, then [further] that you become elders. And among you is he who is taken in death before [that], so that you reach a specified term; and perhaps you will use reason.","j":24,"p":475,"r":410,"h":190,"w":32,"u":"وہی تو ہے جس نے تم کو (پہلے) مٹی سے پیدا کیا۔ ہھر نطفہ بنا کر پھر لوتھڑا بنا کر پھر تم کو نکالتا ہے (کہ تم) بچّے (ہوتے ہو) پھر تم اپنی جوانی کو پہنچتے ہو۔ پھر بوڑھے ہوجاتے ہو۔ اور کوئی تم میں سے پہلے ہی مرجاتا ہے اور تم (موت کے) وقت مقرر تک پہنچ جاتے ہو اور تاکہ تم سمجھو","s":"دى همغه ذات دى چې تاسو يې له خاورې پیدا كړئ، بیا يې له نطفې نه، بیا يې د وینې له ټوټې نه: بیا هغه تاسو راوباسي، په داسې حال كې چې واړه (ماشومان) يئ، بیا (هغه ستاسو تربیت كوي)، د دې لپاره چې تاسو خپل قوت (او ځوانۍ) ته ورسېږئ، بیا (مو ژوندي ساتي) د دې لپاره چې زاړه (بوډاګان) شئ، او ځینې په تاسو كې هغه دي چې له دغه (وخت) نه مخكې وفات كولى شي. او (تاسو ساتي) د دې لپاره چې تاسو مقررې نېټې ته ورسېږئ او د دې لپاره چې تاسو له عقل نه كار واخلئ","a":"It is He who creates you out of dust, and then out of a drop of sperm, and then out of a germ-cell; and then He brings you forth as children; and then [He ordains] that you reach maturity, and then, that you grow old - though some of you [He causes to] die earlier -: and [all this He ordains] so that you might reach a term set [by Him], and that you might [learn to] use your reason."},{"n":68,"g":4201,"t":"هُوَ ٱلَّذِى يُحْىِۦ وَيُمِيتُ ۖ فَإِذَا قَضَىٰٓ أَمْرًۭا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ","e":"He it is who gives life and causes death; and when He decrees a matter, He but says to it, \"Be,\" and it is.","j":24,"p":475,"r":410,"h":190,"w":13,"u":"وہی تو ہے جو جلاتا ہے اور مارتا ہے۔ پھر جب وہ کوئی کام کرنا (اور کسی کو پیدا کرنا) چاہتا ہے تو اس سے کہہ دیتا ہے کہ ہوجا تو وہ جاتا ہے","s":"دى همغه ذات دى چې ژوندي كول كوي او مړه كول كوي، نو كله چې د یو كار (د ایجاد) فیصله وكړي، نو بېشكه همدا خبره ده چې ده ته وايي: موجود شه! نو هغه موجود شي","a":"It is He who grants life and deals death; and when He wills a thing to be, He but says unto it, “Be” - and it is."},{"n":69,"g":4202,"t":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ أَنَّىٰ يُصْرَفُونَ","e":"Do you not consider those who dispute concerning the signs of Allah - how are they averted?","j":24,"p":475,"r":411,"h":190,"w":10,"u":"کیا تم نے ان لوگوں کو نہیں دیکھا جو خدا کی آیتوں میں جھگڑتے ہیں۔ یہ کہاں بھٹک رہے ہیں؟","s":"ایا تا هغه كسان نه دي لیدلي چې د الله په ایتونو كې جګړې كوي، كوم طرف ته دوى ګرځولى شي؟","a":"ART THOU NOT aware of how far they who call God’s messages in question have lost sight of the truth?"},{"n":70,"g":4203,"t":"ٱلَّذِينَ كَذَّبُوا۟ بِٱلْكِتَٰبِ وَبِمَآ أَرْسَلْنَا بِهِۦ رُسُلَنَا ۖ فَسَوْفَ يَعْلَمُونَ","e":"Those who deny the Book and that with which We sent Our messengers - they are going to know,","j":24,"p":475,"r":411,"h":190,"w":10,"u":"جن لوگوں نے کتاب (خدا) کو اور جو کچھ ہم نے پیغمبروں کو دے کر بھیجا اس کو جھٹلایا۔ وہ عنقریب معلوم کرلیں گے","s":"هغه كسان چې تكذیب كوي د كتابونو او د هغه څه چې په هغو سره مونږ خپل رسولان لېږلي وو، پس ژر به دوى پوه شي","a":"they who give the lie to this divine writ and [thus] to all [the messages] with which We sent forth Our apostles [of old]? But in time they will come to know [how blind they have been: they will know it on Judgment Day],"},{"n":71,"g":4204,"t":"إِذِ ٱلْأَغْلَٰلُ فِىٓ أَعْنَٰقِهِمْ وَٱلسَّلَٰسِلُ يُسْحَبُونَ","e":"When the shackles are around their necks and the chains; they will be dragged","j":24,"p":475,"r":411,"h":190,"w":6,"u":"جب کہ ان کی گردنوں میں طوق اور زنجیریں ہوں گی (اور) گھسیٹے جائیں گے","s":"كله چې به د دوى په غاړو كې طوقونه او ځنځیرونه وي، چې دوى به راښكلى كېږي","a":"when they shall have to carry the shackles and chains [of their own making] around their necks,"},{"n":72,"g":4205,"t":"فِى ٱلْحَمِيمِ ثُمَّ فِى ٱلنَّارِ يُسْجَرُونَ","e":"In boiling water; then in the Fire they will be filled [with flame].","j":24,"p":475,"r":411,"h":190,"w":6,"u":"(یعنی) کھولتے ہوئے پانی میں۔ پھر آگ میں جھونک دیئے جائیں گے","s":"په ډېرو ګرمو اوبو كې، بیا به دوى (د دوزخ) په اور كې سوځولى شي","a":"and are dragged into burning despair, and in the end become fuel for the fire [of hell]."},{"n":73,"g":4206,"t":"ثُمَّ قِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تُشْرِكُونَ","e":"Then it will be said to them, \"Where is that which you used to associate [with Him in worship]","j":24,"p":475,"r":411,"h":190,"w":7,"u":"پھر ان سے کہا جائے گا کہ وہ کہاں ہیں جن کو تم (خدا کے) شریک بناتے تھے","s":"بیا به دوى ته ویلى شي چې چېرته دي هغه (معبودان) چې تاسو به شریكول","a":"And then they will be asked: “Where now are those [powers] to which you were wont to ascribe divinity"},{"n":74,"g":4207,"t":"مِن دُونِ ٱللَّهِ ۖ قَالُوا۟ ضَلُّوا۟ عَنَّا بَل لَّمْ نَكُن نَّدْعُوا۟ مِن قَبْلُ شَيْـًۭٔا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ ٱلْكَٰفِرِينَ","e":"Other than Allah?\" They will say, \"They have departed from us; rather, we did not used to invoke previously anything.\" Thus does Allah put astray the disbelievers.","j":24,"p":475,"r":411,"h":190,"w":19,"u":"(یعنی غیر خدا) کہیں گے وہ تو ہم سے جاتے رہے بلکہ ہم تو پہلے کسی چیز کو پکارتے ہی نہیں تھے۔ اسی طرح خدا کافروں کو گمراہ کرتا ہے","s":"له الله نه غیر؟ دوى به ووايي: هغه زمونږ نه ورك شول، بلكې مونږ له دې نه مخكې هېڅ شى نه باله، همداسې الله كافرانو لره ګمراه كوي","a":"side by side with God?” They will answer: “They have forsaken us - or, rather, what we were wont to invoke aforetime did not exist at all!” And they will be told:] “It is thus that God lets the deniers of the truth go astray:"},{"n":75,"g":4208,"t":"ذَٰلِكُم بِمَا كُنتُمْ تَفْرَحُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَبِمَا كُنتُمْ تَمْرَحُونَ","e":"[The angels will say], \"That was because you used to exult upon the earth without right and you used to behave insolently.","j":24,"p":475,"r":411,"h":190,"w":11,"u":"یہ اس کا بدلہ ہے کہ تم زمین میں حق کے بغیر (یعنی اس کے خلاف) خوش ہوا کرتے تھے اور اس کی (سزا ہے) کہ اترایا کرتے تھے","s":"دغه په سبب د دې چې تاسو به په ځمكه كې ناحقه خوشحالي (اولويي) كوله او په سبب د هغه چې تاسو به تكبر كاوه","a":"this is an out­come of your having arrogantly exulted on earth without any [concern for what is] right, and of your having been so full of self-conceit!"},{"n":76,"g":4209,"t":"ٱدْخُلُوٓا۟ أَبْوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَا ۖ فَبِئْسَ مَثْوَى ٱلْمُتَكَبِّرِينَ","e":"Enter the gates of Hell to abide eternally therein, and wretched is the residence of the arrogant.\"","j":24,"p":475,"r":411,"h":190,"w":9,"u":"(اب) جہنم کے دروازوں میں داخل ہوجاؤ۔ ہمیشہ اسی میں رہو گے۔ متکبروں کا کیا برا ٹھکانا ہے","s":"تاسو د جهنم په دروازو كې ننوځئ، په داسې حال چې په دغه (جهنم) كې به همېشه يئ، نو د متكبرینو استوګنځى بد دى","a":"Enter [now] the gates of hell, therein to abide: and how vile an abode for all who are given to false pride!”"},{"n":77,"g":4210,"t":"فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّۭ ۚ فَإِمَّا نُرِيَنَّكَ بَعْضَ ٱلَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا يُرْجَعُونَ","e":"So be patient, [O Muhammad]; indeed, the promise of Allah is truth. And whether We show you some of what We have promised them or We take you in death, it is to Us they will be returned.","j":24,"p":475,"r":411,"h":190,"w":15,"u":"تو (اے پیغمبر) صبر کرو خدا کا وعدہ سچا ہے۔ اگر ہم تم کو کچھ اس میں سے دکھادیں جس کا ہم تم سے وعدہ کرتے ہیں۔ (یعنی کافروں پر عذاب نازل کریں) یا تمہاری مدت حیات پوری کردیں تو ان کو ہماری ہی طرف لوٹ کر آنا ہے","s":"نو ته صبر كوه، بېشكه د الله وعده حقه ده، نو كه خامخا مونږ تا ته ځینې د هغه (عذاب) وښیو چې مونږ يې دوى ته وعده وركوو، یا مونږ تا وفات كړو، نو هم مونږ ته به دوى بېرته راوستلى شي","a":"HENCE, remain thou patient in adversity - for, verily, God’s promise always comes true. And whether We show thee [in this world] something of what We hold in store for those [deniers of the truth], or whether We cause thee to die [ere that retribution takes place - know that, in the end], it is unto Us that they will be brought back."},{"n":78,"g":4211,"t":"وَلَقَدْ أَرْسَلْنَا رُسُلًۭا مِّن قَبْلِكَ مِنْهُم مَّن قَصَصْنَا عَلَيْكَ وَمِنْهُم مَّن لَّمْ نَقْصُصْ عَلَيْكَ ۗ وَمَا كَانَ لِرَسُولٍ أَن يَأْتِىَ بِـَٔايَةٍ إِلَّا بِإِذْنِ ٱللَّهِ ۚ فَإِذَا جَآءَ أَمْرُ ٱللَّهِ قُضِىَ بِٱلْحَقِّ وَخَسِرَ هُنَالِكَ ٱلْمُبْطِلُونَ","e":"And We have already sent messengers before you. Among them are those [whose stories] We have related to you, and among them are those [whose stories] We have not related to you. And it was not for any messenger to bring a sign [or verse] except by permission of Allah. So when the command of Allah comes, it will be concluded in truth, and the falsifiers will thereupon lose [all].","j":24,"p":476,"r":411,"h":190,"w":34,"u":"اور ہم نے تم سے پہلے (بہت سے) پیغمبر بھیجے۔ ان میں کچھ تو ایسے ہیں جن کے حالات تم سے بیان کر دیئے ہیں اور کچھ ایسے ہیں جن کے حالات بیان نہیں کئے۔ اور کسی پیغمبر کا مقدور نہ تھا کہ خدا کے حکم کے سوا کوئی نشانی لائے۔ پھر جب خدا کا حکم آپہنچا تو انصاف کے ساتھ فیصلہ کردیا گیا اور اہل باطل نقصان میں پڑ گئے","s":"او یقینًا یقینًا مونږ له تا نه مخكې ډېر رسولان رالېږلي وو، په دوى كې ځينې هغه دي چې مونږ تا ته بيان كړي دي او په دوى كې ځينې هغه دي چې مونږ تا ته نه دي بیان كړي. او د هېڅ رسول لپاره دا ممكن نه وه چې هغه پخپله كومه معجزه راوړي مګر د الله په حكم سره، نو كله چې د الله حكم راشي (نو) په حق سره به فیصله وكړى شي او په دغه وخت (او ځاى) كې به باطل پرستان تاوانیان شي","a":"And, indeed, [O Muhammad,] We sent forth apostles before thy time; some of them We have mentioned to thee, and some of them We have not mentioned to thee. And it was not given to any apostle to bring forth a miracle other than by God’s leave. Yet when God’s will becomes manifest, judgment will [already] have been passed in all justice, and lost will be, then and there, all who tried to reduce to nothing [whatever they could not understand]."},{"n":79,"g":4212,"t":"ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَنْعَٰمَ لِتَرْكَبُوا۟ مِنْهَا وَمِنْهَا تَأْكُلُونَ","e":"It is Allah who made for you the grazing animals upon which you ride, and some of them you eat.","j":24,"p":476,"r":412,"h":190,"w":9,"u":"خدا ہی تو ہے جس نے تمہارے لئے چارپائے بنائے تاکہ ان میں سے بعض پر سوار ہو اور بعض کو تم کھاتے ہو","s":"الله هغه ذات دى چې تاسو لپاره يې څاروي پیدا كړي دي، د دې لپاره چې تاسو په دوى كې په ځینو سورلي كوئ او په دوى كې ځینې تاسو خورئ","a":"It is God who [at all times works wonders for you: thus, He] provides for you [all manner of] livestock, so that on some of them you may ride, and from some derive your food,"},{"n":80,"g":4213,"t":"وَلَكُمْ فِيهَا مَنَٰفِعُ وَلِتَبْلُغُوا۟ عَلَيْهَا حَاجَةًۭ فِى صُدُورِكُمْ وَعَلَيْهَا وَعَلَى ٱلْفُلْكِ تُحْمَلُونَ","e":"And for you therein are [other] benefits and that you may realize upon them a need which is in your breasts; and upon them and upon ships you are carried.","j":24,"p":476,"r":412,"h":190,"w":12,"u":"اور تمہارے لئے ان میں (اور بھی) فائدے ہیں اور اس لئے بھی کہ (کہیں جانے کی) تمہارے دلوں میں جو حاجت ہو ان پر (چڑھ کر وہاں) پہنچ جاؤ۔ اور ان پر اور کشتیوں پر تم سوار ہوتے ہو","s":"او تاسو لپاره په دغو (څارویو) كې ډېرې نفعې دي او د دې لپاره چې تاسو په دوى سره هغه حاجت ته ورسېږئ چې ستاسو په سینو كې دى، او په دغو باندې او په كشتیو باندې تاسو سورول كېږئ","a":"and find [yet other] benefits in them; and that through them you may attain to the fulfillment of [many] a heartfelt need: for on them, as on ships, you are borne [through life]."},{"n":81,"g":4214,"t":"وَيُرِيكُمْ ءَايَٰتِهِۦ فَأَىَّ ءَايَٰتِ ٱللَّهِ تُنكِرُونَ","e":"And He shows you His signs. So which of the signs of Allah do you deny?","j":24,"p":476,"r":412,"h":190,"w":6,"u":"اور وہ تمہیں اپنی نشانیاں دکھاتا ہے تو تم خدا کی کن کن نشانیوں کو نہ مانو گے","s":"او هغه (الله) تاسو ته خپلې نښې ښیي، نو تاسو د الله له كومو نښو نه انكار كوئ؟","a":"And [thus] He displays His wonders before you: which, then, of God’s wonders can you still deny?"},{"n":82,"g":4215,"t":"أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْ ۚ كَانُوٓا۟ أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّةًۭ وَءَاثَارًۭا فِى ٱلْأَرْضِ فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ","e":"Have they not traveled through the land and observed how was the end of those before them? They were more numerous than themselves and greater in strength and in impression on the land, but they were not availed by what they used to earn.","j":24,"p":476,"r":412,"h":190,"w":26,"u":"کیا ان لوگوں نے زمین میں سیر نہیں کی تاکہ دیکھتے جو لوگ ان سے پہلے تھے ان کا انجام کیسا ہوا۔ (حالانکہ) وہ ان سے کہیں زیادہ طاقتور اور زمین میں نشانات (بنانے) کے اعتبار سے بہت بڑھ کر تھے۔ تو جو کچھ وہ کرتے تھے وہ ان کے کچھ کام نہ آیا","s":"ایا نو دوى په ځمكه كې ګرځېدلي نه دي، پس چې دوى كتلي وى چې د هغو خلقو انجام څنګه و چې له دوى نه مخكې وو، هغوى له دوى نه زیات وو او د قوت او په ځمكه كې د نښو په لحاظ ډېر سخت وو، نو د دوى هېڅ په كار رانغلل هغه څه چې دوى به ګټل","a":"HAVE THEY, then, never journeyed about the earth and beheld what happened in the end to those [deniers of the truth] who lived before their time? More numerous were they, and greater in power than they are, and in the impact which they left on earth: but all that they ever achieved was of no avail to them –"},{"n":83,"g":4216,"t":"فَلَمَّا جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَرِحُوا۟ بِمَا عِندَهُم مِّنَ ٱلْعِلْمِ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","e":"And when their messengers came to them with clear proofs, they [merely] rejoiced in what they had of knowledge, but they were enveloped by what they used to ridicule.","j":24,"p":476,"r":412,"h":190,"w":15,"u":"اور جب ان کے پیغمبر ان کے پاس کھلی نشانیاں لے کر آئے تو جو علم (اپنے خیال میں) ان کے پاس تھا اس پر اترانے لگے اور جس چیز سے تمسخر کیا کرتے تھے اس نے ان کو آ گھیرا","s":"نو كله چې دوى ته د دوى پېغمبران په ښكاره دلیلونو سره راغلل، (نو) دوى به په هغه علم خوشالي (او لويي) شروع كړه چې له دوى سره و، او ګېرچاپېره به شو هغه څه چې دوى به په هغه پورې استهزاء كولې","a":"for when their apostles came to them with all evidence of the truth, they arrogantly exulted in whatever knowledge they [already] possessed: and [so, in the end,] they were overwhelmed by the very thing which they were wont to deride."},{"n":84,"g":4217,"t":"فَلَمَّا رَأَوْا۟ بَأْسَنَا قَالُوٓا۟ ءَامَنَّا بِٱللَّهِ وَحْدَهُۥ وَكَفَرْنَا بِمَا كُنَّا بِهِۦ مُشْرِكِينَ","e":"And when they saw Our punishment, they said,\" We believe in Allah alone and disbelieve in that which we used to associate with Him.\"","j":24,"p":476,"r":412,"h":190,"w":12,"u":"پھر جب انہوں نے ہمارا عذاب دیکھ لیا تو کہنے لگے کہ ہم خدائے واحد پر ایمان لائے اور جس چیز کو اس کے ساتھ شریک بناتے تھے اس سے نامعتقد ہوئے","s":"نو كله چې به دوى زمونږ عذاب ولیده، دوى به وویل: مونږ په الله ایمان راوړى دى چې ایكي يواځې دى، او مونږ كافران شولو په هغه څیز چې مونږ به د هغه په سبب مشركان وو","a":"And then, when they [clearly] beheld Our punishment, they said: “We have come to believe in the One God, and we have renounced all belief in that to which we were wont to ascribe a share in His divinity!”"},{"n":85,"g":4218,"t":"فَلَمْ يَكُ يَنفَعُهُمْ إِيمَٰنُهُمْ لَمَّا رَأَوْا۟ بَأْسَنَا ۖ سُنَّتَ ٱللَّهِ ٱلَّتِى قَدْ خَلَتْ فِى عِبَادِهِۦ ۖ وَخَسِرَ هُنَالِكَ ٱلْكَٰفِرُونَ","e":"But never did their faith benefit them once they saw Our punishment. [It is] the established way of Allah which has preceded among His servants. And the disbelievers thereupon lost [all].","j":24,"p":476,"r":412,"h":190,"w":19,"u":"لیکن جب وہ ہمارا عذاب دیکھ چکے (اس وقت) ان کے ایمان نے ان کو کچھ بھی فائدہ نہ دیا۔ (یہ) خدا کی عادت (ہے) جو اس کے بندوں (کے بارے) میں چلی آتی ہے۔ اور وہاں کافر گھاٹے میں پڑ گئے","s":"نو دغه (كار داسې) نه و چې دوى ته د دوى ایمان راوړل نفع وركړې وي كله چې دوى زمونږ عذاب ولیده، (دا) ده ايښې طريقه د الله هغه طریقه چې د هغه په بنده ګانو كې تېره شوې ده او په دغه ځاى (او وخت) كې كافران تاوانیان شول","a":"But their attaining to faith after they had beheld Our punishment could not possibly benefit them such being the way of God that has always obtained for His creatures -: and so, then and there, lost were they who had denied the truth."}]},{"number":41,"name":"سُورَةُ فُصِّلَتۡ","en":"Fussilat","tr":"Explained in detail","rev":"Meccan","ayahs":[{"n":1,"g":4219,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ","e":"Ha, Meem.","j":24,"p":477,"r":413,"h":190,"w":5,"u":"حٰم","s":"حا، ميم","a":"Ha. Mim."},{"n":2,"g":4220,"t":"تَنزِيلٌۭ مِّنَ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","e":"[This is] a revelation from the Entirely Merciful, the Especially Merciful -","j":24,"p":477,"r":413,"h":190,"w":4,"u":"(یہ کتاب خدائے) رحمٰن ورحیم (کی طرف) سے اُتری ہے","s":"(دغه) نازلول د ډېر مهربان، بې حده رحم كوونكي له جانبه دي","a":"THE BESTOWAL from on high [of this revelation] issues from the Most Gracious, the Dis­penser of Grace:"},{"n":3,"g":4221,"t":"كِتَٰبٌۭ فُصِّلَتْ ءَايَٰتُهُۥ قُرْءَانًا عَرَبِيًّۭا لِّقَوْمٍۢ يَعْلَمُونَ","e":"A Book whose verses have been detailed, an Arabic Qur'an for a people who know,","j":24,"p":477,"r":413,"h":190,"w":7,"u":"کتاب جس کی آیتیں واضح (المعانی) ہیں (یعنی) قرآن عربی ان لوگوں کے لئے جو سمجھ رکھتے ہیں","s":"داسې كتاب چې د ده ایتونه په تفصیل سره بیان شوي دي، په داسې حال كې چې عربي قرآن دى، د هغه قوم لپاره چې پوهېږي","a":"a divine writ, the messages whereof have been clearly spelled out as a discourse in the Arabic tongue for people of [innate] knowl­edge,"},{"n":4,"g":4222,"t":"بَشِيرًۭا وَنَذِيرًۭا فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَ","e":"As a giver of good tidings and a warner; but most of them turn away, so they do not hear.","j":24,"p":477,"r":413,"h":190,"w":7,"u":"جو بشارت بھی سناتا ہے اور خوف بھی دلاتا ہے لیکن ان میں سے اکثروں نے منہ پھیر لیا اور وہ سنتے ہی نہیں","s":"زېرى وركوونكى او وېروونكى دى، نو د دوى زیاترو مخ وګرځاوه، پس دوى (حق) نه اوري","a":"to be a herald of glad tidings as well as a warning. And yet, [whenever this divine writ is offered to men,] most of them turn away, so that they cannot hear [its message];"},{"n":5,"g":4223,"t":"وَقَالُوا۟ قُلُوبُنَا فِىٓ أَكِنَّةٍۢ مِّمَّا تَدْعُونَآ إِلَيْهِ وَفِىٓ ءَاذَانِنَا وَقْرٌۭ وَمِنۢ بَيْنِنَا وَبَيْنِكَ حِجَابٌۭ فَٱعْمَلْ إِنَّنَا عَٰمِلُونَ","e":"And they say, \"Our hearts are within coverings from that to which you invite us, and in our ears is deafness, and between us and you is a partition, so work; indeed, we are working.\"","j":24,"p":477,"r":413,"h":190,"w":17,"u":"اور کہتے ہیں کہ جس چیز کی طرف تم ہمیں بلاتے ہو اس سے ہمارے دل پردوں میں ہیں اور ہمارے کانوں میں بوجھ (یعنی بہراپن) ہے اور ہمارے اور تمہارے درمیان پردہ ہے تو تم (اپنا) کام کرو ہم (اپنا) کام کرتے ہیں","s":"او دوى وویل: زمونږ زړونه په پرده كې دي له هغه څه نه چې ته مونږ هغه ته بلې او زمونږ په غوږونو كې كوڼوالى دى اوزمونږ له مينځه او ستا له مینځه پرده ده، نو ته (خپل) عمل كوه، بېشكه مونږ هم (خپل) عمل كوونكي یو","a":"and so they say, [as it were:] “Our hearts are veiled from whatever thou callest us to, [O Muhammad,] and in our ears is deafness, and between us and thee is a barrier. Do, then, [whatever thou wilt, whereas,] behold, we shall do [as we have always done]!”"},{"n":6,"g":4224,"t":"قُلْ إِنَّمَآ أَنَا۠ بَشَرٌۭ مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَٰهُكُمْ إِلَٰهٌۭ وَٰحِدٌۭ فَٱسْتَقِيمُوٓا۟ إِلَيْهِ وَٱسْتَغْفِرُوهُ ۗ وَوَيْلٌۭ لِّلْمُشْرِكِينَ","e":"Say, O [Muhammad], \"I am only a man like you to whom it has been revealed that your god is but one God; so take a straight course to Him and seek His forgiveness.\" And woe to those who associate others with Allah -","j":24,"p":477,"r":413,"h":190,"w":17,"u":"کہہ دو کہ میں بھی آدمی ہوں جیسے تم۔ (ہاں) مجھ پر یہ وحی آتی ہے کہ تمہارا معبود خدائے واحد ہے تو سیدھے اسی کی طرف (متوجہ) رہو اور اسی سے مغفرت مانگو اور مشرکوں پر افسوس ہے","s":"ته (دوى ته) ووایه: بېشكه هم دا خبره ده چې زه ستاسو په شان بشر یم، ما ته دا وحي كولى شي چې بېشكه همدا خبره ده چې ستاسو حق معبود یو معبود دى، نو تاسو ده ته مستقیم (او درست) اوسئ او له ده نه مغفرت غواړئ او د مشركانو لپاره هلاكت دى","a":"Say thou, [O Prophet:] “I am but a mortal like you. It has been revealed to me that your God is the One God: go, then, straight towards Him and seek His forgiveness!” And woe unto those who ascribe divinity to aught beside Him,"},{"n":7,"g":4225,"t":"ٱلَّذِينَ لَا يُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْءَاخِرَةِ هُمْ كَٰفِرُونَ","e":"Those who do not give zakah, and in the Hereafter they are disbelievers.","j":24,"p":477,"r":413,"h":190,"w":8,"u":"جو زکوٰة نہیں دیتے اور آخرت کے بھی قائل نہیں","s":"هغه كسان چې زكات نه ادا كوي او له اخرت نه هم دوى منكران (كافران) دي","a":"[and] those who do not spend in charity: for it is they, they who [thus] deny the truth of the life to come!"},{"n":8,"g":4226,"t":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","e":"Indeed, those who believe and do righteous deeds - for them is a reward uninterrupted.","j":24,"p":477,"r":413,"h":190,"w":9,"u":"جو لوگ ایمان لائے اور عمل نیک کرتے رہے ان کے لئے (ایسا) ثواب ہے جو ختم ہی نہ ہو","s":"بېشكه هغه كسان چې ایمان يې راوړى دى او نېك عملونه يې كړي دي، د دوى لپاره نه قطع كېدونكى اجر دى","a":"[But,] verily, they who have attained to faith and do good works shall have a reward unending!"},{"n":9,"g":4227,"t":"۞ قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ بِٱلَّذِى خَلَقَ ٱلْأَرْضَ فِى يَوْمَيْنِ وَتَجْعَلُونَ لَهُۥٓ أَندَادًۭا ۚ ذَٰلِكَ رَبُّ ٱلْعَٰلَمِينَ","e":"Say, \"Do you indeed disbelieve in He who created the earth in two days and attribute to Him equals? That is the Lord of the worlds.\"","j":24,"p":477,"r":414,"h":191,"w":16,"u":"کہو کیا تم اس سے انکار کرتے ہو جس نے زمین کو دو دن میں پیدا کیا۔ اور (بتوں کو) اس کا مدمقابل بناتے ہو۔ وہی تو سارے جہان کا مالک ہے","s":"ته (دوى ته) ووایه: ایا په رښتیا تاسو خامخا كافران كېږئ په هغه ذات چې ځمكه يې په دوه ورځو كې پیدا كړه او تاسو د هغه لپاره شریكان جوړوئ. دغه خو رب العالمین دى","a":"SAY: “Would you indeed deny Him who has created the earth in two aeons? And do you claim that there is any power that could rival Him, the Sustainer of all the worlds?”"},{"n":10,"g":4228,"t":"وَجَعَلَ فِيهَا رَوَٰسِىَ مِن فَوْقِهَا وَبَٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقْوَٰتَهَا فِىٓ أَرْبَعَةِ أَيَّامٍۢ سَوَآءًۭ لِّلسَّآئِلِينَ","e":"And He placed on the earth firmly set mountains over its surface, and He blessed it and determined therein its [creatures'] sustenance in four days without distinction - for [the information] of those who ask.","j":24,"p":477,"r":414,"h":191,"w":15,"u":"اور اسی نے زمین میں اس کے اوپر پہاڑ بنائے اور زمین میں برکت رکھی اور اس میں سب سامان معیشت مقرر کیا (سب) چار دن میں۔ (اور تمام) طلبگاروں کے لئے یکساں","s":"او دغه (الله) په دغې (ځمكه) كې د دې له پاسه غرونه كېښودل او په هغې كې يې بركت واچوه او په هغې كې يې د دې (د اوسېدونكو) روزي مقدره (په اندازه) كړه په څلورو ورځو كې، په داسې حال كې چې د تپوس كوونكو لپاره برابر دي","a":"For He [it is who, after creating the earth,] placed firm mountains on it, [towering] above its surface, and bestowed [so many] blessings on it, and equitably apportioned its means of subsistence to all who would seek it: [and all this He created] in four aeons."},{"n":11,"g":4229,"t":"ثُمَّ ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِىَ دُخَانٌۭ فَقَالَ لَهَا وَلِلْأَرْضِ ٱئْتِيَا طَوْعًا أَوْ كَرْهًۭا قَالَتَآ أَتَيْنَا طَآئِعِينَ","e":"Then He directed Himself to the heaven while it was smoke and said to it and to the earth, \"Come [into being], willingly or by compulsion.\" They said, \"We have come willingly.\"","j":24,"p":477,"r":414,"h":191,"w":16,"u":"پھر آسمان کی طرف متوجہ ہوا اور وہ دھواں تھا تو اس نے اس سے اور زمین سے فرمایا کہ دونوں آؤ (خواہ) خوشی سے خواہ ناخوشی سے۔ انہوں نے کہا کہ ہم خوشی سے آتے ہیں","s":"بیا يې د اسمان په طرف اراده وكړه، په داسې حال كې چې هغه یو لوګى و، نو هغه (الله) ده ته او ځمكې ته وویل: 