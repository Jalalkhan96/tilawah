 ستا د رب د رحمت ذكر دى په خپل بنده زكریا باندې","a":"AN ACCOUNT of the grace which thy Sustainer bestowed upon His servant Zachariah:"},{"n":3,"g":2253,"t":"إِذْ نَادَىٰ رَبَّهُۥ نِدَآءً خَفِيًّۭا","e":"When he called to his Lord a private supplication.","j":16,"p":305,"r":264,"h":122,"w":5,"u":"جب انہوں نے اپنے پروردگار کو دبی آواز سے پکارا","s":"كله چې ده خپل رب ته اواز وكړ ډېر ورو اواز","a":"When he called out to his Sustainer in the secrecy of his heart,"},{"n":4,"g":2254,"t":"قَالَ رَبِّ إِنِّى وَهَنَ ٱلْعَظْمُ مِنِّى وَٱشْتَعَلَ ٱلرَّأْسُ شَيْبًۭا وَلَمْ أَكُنۢ بِدُعَآئِكَ رَبِّ شَقِيًّۭا","e":"He said, \"My Lord, indeed my bones have weakened, and my head has filled with white, and never have I been in my supplication to You, my Lord, unhappy.","j":16,"p":305,"r":264,"h":122,"w":14,"u":"(اور) کہا کہ اے میرے پروردگار میری ہڈیاں بڑھاپے کے سبب کمزور ہوگئی ہیں اور سر (ہے کہ) بڑھاپے (کی وجہ سے) شعلہ مارنے لگا ہے اور اے میرے پروردگار میں تجھ سے مانگ کر کبھی محروم نہیں رہا","s":"ويې ويل: اى زما ربه! یقینًا زه چې یم زما هډوكي كمزوري (ضعیف) شوي دي او سر (مې) د سپین والي په وجه شغلې وهي، په دې حال كې چې اى زما ربه! زه هيڅكله له تا نه په سوال سره محروم (او نا امېده) نه یم پاتې شوى","a":"he prayed: \"O my Sustainer! Feeble have become my bones, and my head glistens with grey hair. But never yet, O my Lord, has my prayer unto Thee remained unanswered."},{"n":5,"g":2255,"t":"وَإِنِّى خِفْتُ ٱلْمَوَٰلِىَ مِن وَرَآءِى وَكَانَتِ ٱمْرَأَتِى عَاقِرًۭا فَهَبْ لِى مِن لَّدُنكَ وَلِيًّۭا","e":"And indeed, I fear the successors after me, and my wife has been barren, so give me from Yourself an heir","j":16,"p":305,"r":264,"h":122,"w":13,"u":"اور میں اپنے بعد اپنے بھائی بندوں سے ڈرتا ہوں اور میری بیوی بانجھ ہے تو مجھے اپنے پاس سے ایک وارث عطا فرما","s":"او بېشكه زه چې یم، خپل وروسته له خپلوانو نه وېرېږم، او زما ښځه له شروع نه شنډه ده، نو ته ما ته له خپل جانب نه یو وارث راكړه","a":"\"Now, behold, I am afraid of [what] my kinsfolk [will do] after I am gone, for my wife has always been barren. Bestow, then, upon me, out of Thy grace, the gift of a successor"},{"n":6,"g":2256,"t":"يَرِثُنِى وَيَرِثُ مِنْ ءَالِ يَعْقُوبَ ۖ وَٱجْعَلْهُ رَبِّ رَضِيًّۭا","e":"Who will inherit me and inherit from the family of Jacob. And make him, my Lord, pleasing [to You].\"","j":16,"p":305,"r":264,"h":122,"w":9,"u":"جو میری اور اولاد یعقوب کی میراث کا مالک ہو۔ اور (اے) میرے پروردگار اس کو خوش اطوار بنائیو","s":"چې وارث شي د دين زما او وارث شي د دين د اولاد د يعقوب او دى وګرځوه اى ربه غوره شوى","a":"who will be my heir as well as an heir [to the dignity] of the House of Jacob; and make him, O my Sustainer, well-pleasing to Thee!\""},{"n":7,"g":2257,"t":"يَٰزَكَرِيَّآ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ ٱسْمُهُۥ يَحْيَىٰ لَمْ نَجْعَل لَّهُۥ مِن قَبْلُ سَمِيًّۭا","e":"[He was told], \"O Zechariah, indeed We give you good tidings of a boy whose name will be John. We have not assigned to any before [this] name.\"","j":16,"p":305,"r":264,"h":122,"w":12,"u":"اے زکریا ہم تم کو ایک لڑکے کی بشارت دیتے ہیں جس کا نام یحییٰ ہے۔ اس سے پہلے ہم نے اس نام کا کوئی شخص پیدا نہیں کیا","s":"اى زكریا! بېشكه مونږ تا ته د داسې هلك زېرى دركوو چې د ده به نوم یحیٰی وي، مونږ ده ته له دې نه مخكې څوك همنامى نه دى ګرځولى","a":"[Thereupon the angels called out unto him: \"O Zachariah! We bring thee the glad tiding of [the birth of] a son whose name shall be John. [And God says,] `Never have We given this name to anyone before him.\""},{"n":8,"g":2258,"t":"قَالَ رَبِّ أَنَّىٰ يَكُونُ لِى غُلَٰمٌۭ وَكَانَتِ ٱمْرَأَتِى عَاقِرًۭا وَقَدْ بَلَغْتُ مِنَ ٱلْكِبَرِ عِتِيًّۭا","e":"He said, \"My Lord, how will I have a boy when my wife has been barren and I have reached extreme old age?\"","j":16,"p":305,"r":264,"h":122,"w":14,"u":"انہوں نے کہا پروردگار میرے ہاں کس طرح لڑکا ہوگا۔ جس حال میں میری بیوی بانجھ ہے اور میں بڑھاپے کی انتہا کو پہنچ گیا ہوں","s":"ده وویل: اى زما ربه! زما لپاره به هلك څنګه كېږي، په داسې حال كې چې زما ښځه له شروع نه شنډه ده اویقینًا زه د ډېر زوړوالي په وجه ډېرې كمزورۍ ته رسېدلى یم","a":"[Zachariah] exclaimed: \"O my Sustainer! How can I have a son when my wife has always been barren and I have become utterly infirm through old age?\""},{"n":9,"g":2259,"t":"قَالَ كَذَٰلِكَ قَالَ رَبُّكَ هُوَ عَلَىَّ هَيِّنٌۭ وَقَدْ خَلَقْتُكَ مِن قَبْلُ وَلَمْ تَكُ شَيْـًۭٔا","e":"[An angel] said, \"Thus [it will be]; your Lord says, 'It is easy for Me, for I created you before, while you were nothing.' \"","j":16,"p":305,"r":264,"h":122,"w":14,"u":"حکم ہوا کہ اسی طرح (ہوگا) تمہارے پروردگار نے فرمایا ہے کہ مجھے یہ آسان ہے اور میں پہلے تم کو بھی تو پیدا کرچکا ہوں اور تم کچھ چیز نہ تھے","s":"(الله) ورته وویل: هم داسې دي۔، ستا رب فرمایلي دي چې دغه (كار) ما ته ډېر اسان دى او تحقیق ته ما پیدا كړى يې له دې نه مخكې، حال دا چې ته هېڅ شى نه وې","a":"Answered [the angel]: \"Thus. it is; [but] thy 'Sustainer says, `This is easy for Me -even as I have created thee aforetime out of nothing."},{"n":10,"g":2260,"t":"قَالَ رَبِّ ٱجْعَل لِّىٓ ءَايَةًۭ ۚ قَالَ ءَايَتُكَ أَلَّا تُكَلِّمَ ٱلنَّاسَ ثَلَٰثَ لَيَالٍۢ سَوِيًّۭا","e":"[Zechariah] said, \"My Lord, make for me a sign.\" He said, \"Your sign is that you will not speak to the people for three nights, [being] sound.\"","j":16,"p":305,"r":264,"h":122,"w":14,"u":"کہا کہ پروردگار میرے لئے کوئی نشانی مقرر فرما۔ فرمایا نشانی یہ ہے کہ تم صحیح وسالم ہو کر تین (رات دن) لوگوں سے بات نہ کرسکو گے","s":"ده وویل: اى زما ربه! ته زما لپاره یوه نښه مقرره كړه (الله) وویل: ستا نښه داده چې ته به له خلقو سره درې شپې (او ورځې) خبرې نشې كولى، په داسې حال كې چې ته به ښه روغ يې","a":"[Zachariah] prayed: \"O my Sustainer! Appoint a sign for me!\" Said [the angel]: \"Thy sign shall be that for full three nights [and days] thou wilt not speak unto men."},{"n":11,"g":2261,"t":"فَخَرَجَ عَلَىٰ قَوْمِهِۦ مِنَ ٱلْمِحْرَابِ فَأَوْحَىٰٓ إِلَيْهِمْ أَن سَبِّحُوا۟ بُكْرَةًۭ وَعَشِيًّۭا","e":"So he came out to his people from the prayer chamber and signaled to them to exalt [Allah] in the morning and afternoon.","j":16,"p":305,"r":264,"h":122,"w":11,"u":"پھر وہ (عبادت کے) حجرے سے نکل کر اپنی قوم کے پاس آئے تو ان سے اشارے سے کہا کہ صبح وشام (خدا کو) یاد کرتے رہو","s":"نو دى په خپل قوم باندې له عبادت ځاى څخه راووت، پس دوى ته يې اشاره وكړه داسې چې تاسو سبا او بېګاه تسبیح وایئ","a":"Thereupon he came out of the sanctuary unto his people and signified to them [by gestures]: \"Extol His limitless glory by day and by night!\""},{"n":12,"g":2262,"t":"يَٰيَحْيَىٰ خُذِ ٱلْكِتَٰبَ بِقُوَّةٍۢ ۖ وَءَاتَيْنَٰهُ ٱلْحُكْمَ صَبِيًّۭا","e":"[Allah] said, \"O John, take the Scripture with determination.\" And We gave him judgement [while yet] a boy","j":16,"p":306,"r":264,"h":122,"w":8,"u":"اے یحییٰ (ہماری) کتاب کو زور سے پکڑے رہو۔ اور ہم نے ان کو لڑکپن میں دانائی عطا فرمائی تھی","s":"اى یحیٰی! ته دغه كتاب په قوت سره ونیسه، او مونږ ده ته حكم (حكمت او نبوت) وركړ، په داسې حال كې چې دى هلك و","a":"[And when the son was born and grew up, he was told,] \"O John! Hold fast unto the divine writ with [all thy] strength!\" - for We granted him wisdom \"while he was yet a little boy,"},{"n":13,"g":2263,"t":"وَحَنَانًۭا مِّن لَّدُنَّا وَزَكَوٰةًۭ ۖ وَكَانَ تَقِيًّۭا","e":"And affection from Us and purity, and he was fearing of Allah","j":16,"p":306,"r":264,"h":122,"w":7,"u":"اور اپنے پاس شفقت اور پاکیزگی دی تھی۔ اور پرہیزگار تھے","s":"او له خپل جانب نه مو (ده ته)، مهرباني (وركړې وه) او پاكي۔ او دى ډېر پرهېزګاره و","a":"as well as, by Our grace, [the gift of] compassion and purity; and he was [always] conscious of Us"},{"n":14,"g":2264,"t":"وَبَرًّۢا بِوَٰلِدَيْهِ وَلَمْ يَكُن جَبَّارًا عَصِيًّۭا","e":"And dutiful to his parents, and he was not a disobedient tyrant.","j":16,"p":306,"r":264,"h":122,"w":6,"u":"اور ماں باپ کے ساتھ نیکی کرنے والے تھے اور سرکش اور نافرمان نہیں تھے","s":"او له خپل مور و پلار سره نېكي كوونكى و، او سركشه، نافرمانه نه و","a":"and full of piety towards his parents; and never was he haughty or rebellious."},{"n":15,"g":2265,"t":"وَسَلَٰمٌ عَلَيْهِ يَوْمَ وُلِدَ وَيَوْمَ يَمُوتُ وَيَوْمَ يُبْعَثُ حَيًّۭا","e":"And peace be upon him the day he was born and the day he dies and the day he is raised alive.","j":16,"p":306,"r":264,"h":122,"w":9,"u":"اور جس دن وہ پیدا ہوئے اور جس دن وفات پائیں گے اور جس دن زندہ کرکے اٹھائے جائیں گے۔ ان پر سلام اور رحمت (ہے)","s":"او په ده دې سلام وي په هغې ورځ چې دى وزېږول شو او په هغې ورځ چې دى به مري او په هغې ورځ چې دى به بیا ژوندى راپورته كړى شي","a":"Hence, [God's] peace was upon him on the day when he was born, and on the day of his death, and. will be [upon him] on the day when he shall be raised to life [again]."},{"n":16,"g":2266,"t":"وَٱذْكُرْ فِى ٱلْكِتَٰبِ مَرْيَمَ إِذِ ٱنتَبَذَتْ مِنْ أَهْلِهَا مَكَانًۭا شَرْقِيًّۭا","e":"And mention, [O Muhammad], in the Book [the story of] Mary, when she withdrew from her family to a place toward the east.","j":16,"p":306,"r":265,"h":122,"w":10,"u":"اور کتاب (قرآن) میں مریم کا بھی مذکور کرو، جب وہ اپنے لوگوں سے الگ ہو کر مشرق کی طرف چلی گئیں","s":"او ته په كتاب كې (قصه د) مریم یاده كړه كله چې هغه له خپلې كورنۍ نه هغه ځاى ته په څنګ شوه چې (د كور) مشرقي جانب و","a":"AND CALL to mind, through this divine writ, Mary. Lo! She withdrew from her family to an eastern place"},{"n":17,"g":2267,"t":"فَٱتَّخَذَتْ مِن دُونِهِمْ حِجَابًۭا فَأَرْسَلْنَآ إِلَيْهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَرًۭا سَوِيًّۭا","e":"And she took, in seclusion from them, a screen. Then We sent to her Our Angel, and he represented himself to her as a well-proportioned man.","j":16,"p":306,"r":265,"h":122,"w":11,"u":"تو انہوں نے ان کی طرف سے پردہ کرلیا۔ (اس وقت) ہم نے ان کی طرف اپنا فرشتہ بھیجا۔ تو ان کے سامنے ٹھیک آدمی (کی شکل) بن گیا","s":"نو دې د دوى په طرف پرده ونیوله، نو مونږ دې ته خپل روح ولېږه، نو هغه دې ته خپل شكل د كامل سړي جوړ كړ","a":"and kept herself in seclusion from them, whereupon We sent unto her Our angel of revelation, who appeared to her in the shape of a well-made human being."},{"n":18,"g":2268,"t":"قَالَتْ إِنِّىٓ أَعُوذُ بِٱلرَّحْمَٰنِ مِنكَ إِن كُنتَ تَقِيًّۭا","e":"She said, \"Indeed, I seek refuge in the Most Merciful from you, [so leave me], if you should be fearing of Allah.\"","j":16,"p":306,"r":265,"h":122,"w":8,"u":"مریم بولیں کہ اگر تم پرہیزگار ہو تو میں تم سے خدا کی پناہ مانگتی ہوں","s":"(نو) دې وویل: بېشكه زه له تا نه په رحمٰن پورې پناه نیسم، كه چېرې ته پرهېزګاره يې","a":"She exclaimed: \"Verily, 'I seek refuge from thee with the Most Gracious! [Approach me not] if thou art conscious of Him!\""},{"n":19,"g":2269,"t":"قَالَ إِنَّمَآ أَنَا۠ رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَٰمًۭا زَكِيًّۭا","e":"He said, \"I am only the messenger of your Lord to give you [news of] a pure boy.\"","j":16,"p":306,"r":265,"h":122,"w":9,"u":"انہوں نے کہا کہ میں تو تمہارے پروردگار کا بھیجا ہوا (یعنی فرشتہ) ہوں (اور اس لئے آیا ہوں) کہ تمہیں پاکیزہ لڑکا بخشوں","s":"هغه وویل: یقینًا زه خو يواځې ستا د رب رسول یم، د دې لپاره چې (د خپل رب په حكم) تا ته یو ډېر پاك هلك دركړم","a":"[The angel] answered: \"I' am but a messenger of thy Sustainer, [who says,] `I shall bestow upon thee the gift of a son endowed with purity.'\""},{"n":20,"g":2270,"t":"قَالَتْ أَنَّىٰ يَكُونُ لِى غُلَٰمٌۭ وَلَمْ يَمْسَسْنِى بَشَرٌۭ وَلَمْ أَكُ بَغِيًّۭا","e":"She said, \"How can I have a boy while no man has touched me and I have not been unchaste?\"","j":16,"p":306,"r":265,"h":122,"w":11,"u":"مریم نے کہا کہ میرے ہاں لڑکا کیونکر ہوگا مجھے کسی بشر نے چھوا تک نہیں اور میں بدکار بھی نہیں ہوں","s":"دې وویل: زما به هلك څنګه پیدا شي؟ حال دا چې ما ته هېڅ بشر نه دى رارسېدلى، او زه چېرې بدكاره هم نه یم","a":"Said she: \"How can I have a son when no man has ever touched me? - for, never have I been a loose woman!\""},{"n":21,"g":2271,"t":"قَالَ كَذَٰلِكِ قَالَ رَبُّكِ هُوَ عَلَىَّ هَيِّنٌۭ ۖ وَلِنَجْعَلَهُۥٓ ءَايَةًۭ لِّلنَّاسِ وَرَحْمَةًۭ مِّنَّا ۚ وَكَانَ أَمْرًۭا مَّقْضِيًّۭا","e":"He said, \"Thus [it will be]; your Lord says, 'It is easy for Me, and We will make him a sign to the people and a mercy from Us. And it is a matter [already] decreed.' \"","j":16,"p":306,"r":265,"h":122,"w":17,"u":"(فرشتے نے) کہا کہ یونہی (ہوگا) تمہارے پروردگار نے فرمایا کہ یہ مجھے آسان ہے۔ اور (میں اسے اسی طریق پر پیدا کروں گا) تاکہ اس کو لوگوں کے لئے اپنی طرف سے نشانی اور (ذریعہٴ) رحمت اور (مہربانی) بناؤں اور یہ کام مقرر ہوچکا ہے","s":"ويې ويل: خبره همداسې ده (لېكن) ستا رب فرمایلي دي: دغه كار ما ته ډېر اسان دى او د دې لپاره چې مونږ دى د خلقو لپاره نښه وګرځوو او له خپل جانب نه رحمت۔ او دغه یو فیصله شوى كار دى","a":"[The angel] answered: \"Thus it is; [but] thy Sustainer says, `This is easy for Me; and [thou shalt have a son,] so that We might make him a symbol unto mankind and an act of grace from US. And it was a thing decreed [by God]:"},{"n":22,"g":2272,"t":"۞ فَحَمَلَتْهُ فَٱنتَبَذَتْ بِهِۦ مَكَانًۭا قَصِيًّۭا","e":"So she conceived him, and she withdrew with him to a remote place.","j":16,"p":306,"r":265,"h":123,"w":6,"u":"تو وہ اس (بچّے) کے ساتھ حاملہ ہوگئیں اور اسے لے کر ایک دور جگہ چلی گئیں","s":"نو (مریم) په دغه (عیسٰی) سره حامله شوه، نو سره له ده یو لرې ځاى ته په څنګ شوه","a":"and in time she conceived him, and then she withdrew with him to a far-off place."},{"n":23,"g":2273,"t":"فَأَجَآءَهَا ٱلْمَخَاضُ إِلَىٰ جِذْعِ ٱلنَّخْلَةِ قَالَتْ يَٰلَيْتَنِى مِتُّ قَبْلَ هَٰذَا وَكُنتُ نَسْيًۭا مَّنسِيًّۭا","e":"And the pains of childbirth drove her to the trunk of a palm tree. She said, \"Oh, I wish I had died before this and was in oblivion, forgotten.\"","j":16,"p":306,"r":265,"h":123,"w":13,"u":"پھر درد زہ ان کو کھجور کے تنے کی طرف لے آیا۔ کہنے لگیں کہ کاش میں اس سے پہلے مرچکتی اور بھولی بسری ہوگئی ہوتی","s":"نو دغې (مریم) لره د لنګوال درد د كجورې د ونې تنې (ډډ) ته راوسته، دې وویل: اى كاشكې زه له دې نه مخكې مړه شوې وى او زه بېخي هېره شوې، له زړونو وتلې وى","a":"And [when] the throes of childbirth drove her to the trunk of a palm-tree, she exclaimed: \"Oh, would that I had died ere this, and had become a thing forgotten, utterly forgotten!\""},{"n":24,"g":2274,"t":"فَنَادَىٰهَا مِن تَحْتِهَآ أَلَّا تَحْزَنِى قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّۭا","e":"But he called her from below her, \"Do not grieve; your Lord has provided beneath you a stream.","j":16,"p":306,"r":265,"h":123,"w":10,"u":"اس وقت ان کے نیچے کی جانب سے فرشتے نے ان کو آواز دی کہ غمناک نہ ہو تمہارے پروردگار نے تمہارے نیچے ایک چشمہ جاری کردیا ہے","s":"نو دې ته يې د دې له لاندې نه اواز وكړ چې مه خفه كېږه، یقینًا ستا رب له تا نه لاندې چینه پیدا كړې ده","a":"Thereupon [a voice] called out to her from beneath that [palm-tree]: \"Grieve not! Thy Sustainer has provided a rivulet [running] beneath thee;"},{"n":25,"g":2275,"t":"وَهُزِّىٓ إِلَيْكِ بِجِذْعِ ٱلنَّخْلَةِ تُسَٰقِطْ عَلَيْكِ رُطَبًۭا جَنِيًّۭا","e":"And shake toward you the trunk of the palm tree; it will drop upon you ripe, fresh dates.","j":16,"p":306,"r":265,"h":123,"w":8,"u":"اور کھجور کے تنے کو پکڑ کر اپنی طرف ہلاؤ تم پر تازہ تازہ کھجوریں جھڑ پڑیں گی","s":"او خپل ځان ته د كجورې تنه راوخوځوه، هغه به په تا پخې تازه لوندې كجورې راوغورځوي","a":"and shake the trunk of the palm-tree towards thee: it will drop fresh, ripe dates upon thee."},{"n":26,"g":2276,"t":"فَكُلِى وَٱشْرَبِى وَقَرِّى عَيْنًۭا ۖ فَإِمَّا تَرَيِنَّ مِنَ ٱلْبَشَرِ أَحَدًۭا فَقُولِىٓ إِنِّى نَذَرْتُ لِلرَّحْمَٰنِ صَوْمًۭا فَلَنْ أُكَلِّمَ ٱلْيَوْمَ إِنسِيًّۭا","e":"So eat and drink and be contented. And if you see from among humanity anyone, say, 'Indeed, I have vowed to the Most Merciful abstention, so I will not speak today to [any] man.' \"","j":16,"p":307,"r":265,"h":123,"w":19,"u":"تو کھاؤ اور پیو اور آنکھیں ٹھنڈی کرو۔ اگر تم کسی آدمی کو دیکھو تو کہنا کہ میں نے خدا کے لئے روزے کی منت مانی تو آج میں کسی آدمی سے ہرگز کلام نہیں کروں گی","s":"پس (دغه كجورې) خوره او (دغه اوبه) څښه او (په عیسٰی سره) سترګې یخې كړه، پس كه خامخا تا له خلقو ځنې یو څوك ولیده، نو (ورته) وایه: بېشكه ما د رحمٰن لپاره په ځان د روژې نذر منلى دى، پس نن ورځ به زه له سره خبرې ونه كړم له هېڅ یوه انسان سره","a":"Eat, then, and drink, and let thine eye be gladdened! And if thou shouldst see any human being, convey this unto him: `Behold, abstinence from speech have I vowed unto the Most Gracious; hence, I may not speak today to any mortal."},{"n":27,"g":2277,"t":"فَأَتَتْ بِهِۦ قَوْمَهَا تَحْمِلُهُۥ ۖ قَالُوا۟ يَٰمَرْيَمُ لَقَدْ جِئْتِ شَيْـًۭٔا فَرِيًّۭا","e":"Then she brought him to her people, carrying him. They said, \"O Mary, you have certainly done a thing unprecedented.","j":16,"p":307,"r":265,"h":123,"w":11,"u":"پھر وہ اس (بچّے) کو اٹھا کر اپنی قوم کے لوگوں کے پاس لے آئیں۔ وہ کہنے لگے کہ مریم یہ تو تُونے برا کام کیا","s":"نو دې (مریمې) هغه (عیسٰی) خپل قوم ته راوړ، چې دى يې راخيستى و، دوى (ورته) وویل: اى مریمې! یقینًا یقینًا تا ډېر بدكار كړى دى","a":"And in time she returned to her people, carrying the child with her. They said: \"O Mary! Thou hast indeed done an amazing thing!"},{"n":28,"g":2278,"t":"يَٰٓأُخْتَ هَٰرُونَ مَا كَانَ أَبُوكِ ٱمْرَأَ سَوْءٍۢ وَمَا كَانَتْ أُمُّكِ بَغِيًّۭا","e":"O sister of Aaron, your father was not a man of evil, nor was your mother unchaste.\"","j":16,"p":307,"r":265,"h":123,"w":11,"u":"اے ہارون کی بہن نہ تو تیرا باپ ہی بداطوار آدمی تھا اور نہ تیری ماں ہی بدکار تھی","s":"اى د هارون خورې! ستا پلار خو بد سړى نه و او نه ستا مور بدكاره (بد عمله) وه","a":"O sister of Aaron! Thy father was not a wicked man, nor was thy mother a loose woman!\""},{"n":29,"g":2279,"t":"فَأَشَارَتْ إِلَيْهِ ۖ قَالُوا۟ كَيْفَ نُكَلِّمُ مَن كَانَ فِى ٱلْمَهْدِ صَبِيًّۭا","e":"So she pointed to him. They said, \"How can we speak to one who is in the cradle a child?\"","j":16,"p":307,"r":265,"h":123,"w":11,"u":"تو مریم نے اس لڑکے کی طرف اشارہ کیا۔ وہ بولے کہ ہم اس سے کہ گود کا بچہ ہے کیونکر بات کریں","s":"نو هغې ده (عیسٰی) ته اشاره وكړه، دوى وویل: مونږ له هغه چا سره څنګه خبرې وكړو چې دى په غېږ كې دى، چې وړوكى دى","a":"Thereupon she pointed to him. They exclaimed: \"How can we talk to one who [as yet] is a little boy in the cradle?\""},{"n":30,"g":2280,"t":"قَالَ إِنِّى عَبْدُ ٱللَّهِ ءَاتَىٰنِىَ ٱلْكِتَٰبَ وَجَعَلَنِى نَبِيًّۭا","e":"[Jesus] said, \"Indeed, I am the servant of Allah. He has given me the Scripture and made me a prophet.","j":16,"p":307,"r":265,"h":123,"w":8,"u":"بچے نے کہا کہ میں خدا کا بندہ ہوں اس نے مجھے کتاب دی ہے اور نبی بنایا ہے","s":"ده وویل: بېشكه زه د الله بنده یم، هغه ما ته كتاب راكړى دى او زه يې نبي ګرځولى یم","a":"[But] he said: \"Behold, I am a servant of God. He has vouchsafed unto me revelation and made me a prophet,"},{"n":31,"g":2281,"t":"وَجَعَلَنِى مُبَارَكًا أَيْنَ مَا كُنتُ وَأَوْصَٰنِى بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ مَا دُمْتُ حَيًّۭا","e":"And He has made me blessed wherever I am and has enjoined upon me prayer and zakah as long as I remain alive","j":16,"p":307,"r":265,"h":123,"w":11,"u":"اور میں جہاں ہوں (اور جس حال میں ہوں) مجھے صاحب برکت کیا ہے اور جب تک زندہ ہوں مجھ کو نماز اور زکوٰة کا ارشاد فرمایا ہے","s":"او زه يې بركت ناك ګرځولى یم په هر ځاى كې چې اوسم او ده ما ته په لمانځه او زكات سره كلك حكم راكړى دى، ترڅو چې زه ژوندى یم","a":"and made me blessed wherever I may be; and He has enjoined upon me prayer and charity as long as I live,"},{"n":32,"g":2282,"t":"وَبَرًّۢا بِوَٰلِدَتِى وَلَمْ يَجْعَلْنِى جَبَّارًۭا شَقِيًّۭا","e":"And [made me] dutiful to my mother, and He has not made me a wretched tyrant.","j":16,"p":307,"r":265,"h":123,"w":6,"u":"اور (مجھے) اپنی ماں کے ساتھ نیک سلوک کرنے والا (بنایا ہے) اور سرکش وبدبخت نہیں بنایا","s":"(او زه يې ګرځولى یم) له خپلې مور سره نېكي كوونكى او زه يې سركشه، بدبخته نه یم ګرځولى","a":"and [has endowed me with] piety towards my mother; and He has not made me haughty or bereft of grace."},{"n":33,"g":2283,"t":"وَٱلسَّلَٰمُ عَلَىَّ يَوْمَ وُلِدتُّ وَيَوْمَ أَمُوتُ وَيَوْمَ أُبْعَثُ حَيًّۭا","e":"And peace is on me the day I was born and the day I will die and the day I am raised alive.\"","j":16,"p":307,"r":265,"h":123,"w":9,"u":"اور جس دن میں پیدا ہوا اور جس دن مروں گا اور جس دن زندہ کرکے اٹھایا جاؤں گا مجھ پر سلام (ورحمت) ہے","s":"او په ما دې سلام وي په هغې ورځ چې زه وزېږول شوم او په هغې ورځ چې زه به مرم او په هغې ورځ چې زه به بیا ژوندى راپورته كولى شم","a":"\"Hence, peace was upon me on the day when I was born, and [will be upon me] on the day of my death, and on the day when I shall be raised to life [again]!\""},{"n":34,"g":2284,"t":"ذَٰلِكَ عِيسَى ٱبْنُ مَرْيَمَ ۚ قَوْلَ ٱلْحَقِّ ٱلَّذِى فِيهِ يَمْتَرُونَ","e":"That is Jesus, the son of Mary - the word of truth about which they are in dispute.","j":16,"p":307,"r":265,"h":123,"w":10,"u":"یہ مریم کے بیٹے عیسیٰ ہیں (اور یہ) سچی بات ہے جس میں لوگ شک کرتے ہیں","s":"دغه عیسٰى د مریمې زوى دى (الله د ده په باره كې) حقه خبره كړې ده، هغه چې دوى په هغې كې سره جګړې كوي","a":"SUCH WAS, in the words of truth, Jesus the son of Mary, about whose nature they so deeply disagree."},{"n":35,"g":2285,"t":"مَا كَانَ لِلَّهِ أَن يَتَّخِذَ مِن وَلَدٍۢ ۖ سُبْحَٰنَهُۥٓ ۚ إِذَا قَضَىٰٓ أَمْرًۭا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ","e":"It is not [befitting] for Allah to take a son; exalted is He! When He decrees an affair, He only says to it, \"Be,\" and it is.","j":16,"p":307,"r":265,"h":123,"w":18,"u":"خدا کو سزاوار نہیں کہ کسی کو بیٹا بنائے۔ وہ پاک ہے جب کسی چیز کا ارادہ کرتا ہے تو اس کو یہی کہتا ہے کہ ہوجا تو وہ ہوجاتی ہے","s":"د الله لپاره نه ښايېږي چې دى دې څوك اولاد ونیسي، ده لره پاكي ده۔، دى چې كله د څه كار فیصله وكړي، نو بېشكه همدا خبره ده چې ده ته وايي: وشه! نو هغه (كار) وشي","a":"It is not conceivable that God should have taken unto Himself a son: limitless is He in His glory! When He wills a thing to be, He but says unto it \"Be\" -and it is!"},{"n":36,"g":2286,"t":"وَإِنَّ ٱللَّهَ رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُ ۚ هَٰذَا صِرَٰطٌۭ مُّسْتَقِيمٌۭ","e":"[Jesus said], \"And indeed, Allah is my Lord and your Lord, so worship Him. That is a straight path.\"","j":16,"p":307,"r":265,"h":123,"w":9,"u":"اور بےشک خدا ہی میرا اور تمہارا پروردگار ہے تو اسی کی عبادت کرو۔ یہی سیدھا رستہ ہے","s":"او بېشكه چې الله زما رب دى او ستاسو رب دى، نو تاسو د ده عبادت كوئ، دا ډېره نېغه لار ده","a":"And [thus it was that Jesus always said]: \"Verily, God is my Sustainer as well as your Sustainer; so worship [none but] Him: this (alone] is a straight way.\""},{"n":37,"g":2287,"t":"فَٱخْتَلَفَ ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْ ۖ فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن مَّشْهَدِ يَوْمٍ عَظِيمٍ","e":"Then the factions differed [concerning Jesus] from among them, so woe to those who disbelieved - from the scene of a tremendous Day.","j":16,"p":307,"r":265,"h":123,"w":12,"u":"پھر (اہل کتاب کے) فرقوں نے باہم اختلاف کیا۔ سو جو لوگ کافر ہوئے ہیں ان کو بڑے دن (یعنی قیامت کے روز) حاضر ہونے سے خرابی ہے","s":"نو دغه ډلې په خپل منځ كې سره مختلفې شوې، نو كافران شویو كسانو لپاره د ډېرې سترې ورځې له حاضرېدو هلاكت (او خرابي) دى","a":"And yet, the sects [that follow the Bible] are at variance among themselves [about the nature of Jesus Woe, then, unto all who deny the truth when that awesome Day will appear!"},{"n":38,"g":2288,"t":"أَسْمِعْ بِهِمْ وَأَبْصِرْ يَوْمَ يَأْتُونَنَا ۖ لَٰكِنِ ٱلظَّٰلِمُونَ ٱلْيَوْمَ فِى ضَلَٰلٍۢ مُّبِينٍۢ","e":"How [clearly] they will hear and see the Day they come to Us, but the wrongdoers today are in clear error.","j":16,"p":307,"r":265,"h":123,"w":12,"u":"وہ جس دن ہمارے سامنے آئیں گے۔ کیسے سننے والے اور کیسے دیکھنے والے ہوں گے مگر ظالم آج صریح گمراہی میں ہیں","s":"دوى به څه ښه اورېدونكي او څه ښه لیدونكي وي! په هغې ورځ چې مونږ ته به راځي، لېكن ظالمان نن ورځې په ښكاره ګمراهۍ كې دي","a":"How well will they hear and see [the truth] on the Day when they come before Us! Today, however, these evildoers are obviously lost in error:"},{"n":39,"g":2289,"t":"وَأَنذِرْهُمْ يَوْمَ ٱلْحَسْرَةِ إِذْ قُضِىَ ٱلْأَمْرُ وَهُمْ فِى غَفْلَةٍۢ وَهُمْ لَا يُؤْمِنُونَ","e":"And warn them, [O Muhammad], of the Day of Regret, when the matter will be concluded; and [yet], they are in [a state of] heedlessness, and they do not believe.","j":16,"p":308,"r":265,"h":123,"w":12,"u":"اور ان کو حسرت (وافسوس) کے دن سے ڈراؤ جب بات فیصل کردی جائے گی۔ اور (ہیہات) وہ غفلت میں (پڑے ہوئے ہیں) اور ایمان نہیں لاتے","s":"او ته دوى د حسرت (او ارمان) له ورځې نه ووېروه كله چې به كار فیصله كړى شي، حال دا چې دوى (اوس) په غفلت كې دي او دوى ایمان نه راوړي","a":"hence, warn them of [the coming of] the Day of Regrets, when everything will have been decided-for as yet they are heedless, and they do not believe [in it]."},{"n":40,"g":2290,"t":"إِنَّا نَحْنُ نَرِثُ ٱلْأَرْضَ وَمَنْ عَلَيْهَا وَإِلَيْنَا يُرْجَعُونَ","e":"Indeed, it is We who will inherit the earth and whoever is on it, and to Us they will be returned.","j":16,"p":308,"r":265,"h":123,"w":8,"u":"ہم ہی زمین کے اور جو لوگ اس پر (بستے) ہیں ان کے وارث ہیں۔ اور ہماری ہی طرف ان کو لوٹنا ہوگا","s":"بېشكه مونږ چې یو، هم دا مونږ د ځمكې او د هغه چا چې په دغه (ځمكه) باندې دي؛ وارثان كېږو او خاص مونږ ته به دوى بېرته راوستى شي","a":"Behold, We alone shall remain after the earth and all who live on it have passed away, and (when] unto Us all will have been brought back."},{"n":41,"g":2291,"t":"وَٱذْكُرْ فِى ٱلْكِتَٰبِ إِبْرَٰهِيمَ ۚ إِنَّهُۥ كَانَ صِدِّيقًۭا نَّبِيًّا","e":"And mention in the Book [the story of] Abraham. Indeed, he was a man of truth and a prophet.","j":16,"p":308,"r":266,"h":123,"w":9,"u":"اور کتاب میں ابراہیم کو یاد کرو۔ بےشک وہ نہایت سچے پیغمبر تھے","s":"او په كتاب كې ابراهیم یاد كړه، بېشكه دى ډېر رېښتینى (او) نبي و","a":"AND CALL to mind, through this divine writ, Abraham. Behold, he was a man of truth, [already] a prophet"},{"n":42,"g":2292,"t":"إِذْ قَالَ لِأَبِيهِ يَٰٓأَبَتِ لِمَ تَعْبُدُ مَا لَا يَسْمَعُ وَلَا يُبْصِرُ وَلَا يُغْنِى عَنكَ شَيْـًۭٔا","e":"[Mention] when he said to his father, \"O my father, why do you worship that which does not hear and does not see and will not benefit you at all?","j":16,"p":308,"r":266,"h":123,"w":15,"u":"جب انہوں نے اپنے باپ سے کہا کہ ابّا آپ ایسی چیزوں کو کیوں پوجتے ہیں جو نہ سنیں اور نہ دیکھیں اور نہ آپ کے کچھ کام آسکیں","s":"كله چې ده خپل پلار ته وویل: اى زما پلار جانه! ته ولې د هغه څیز عبادت كوې چې نه (څه) اوري او نه ویني او له تا نه هېڅ شى (تكلیف) نشي لرې كولى","a":"when he spoke [thus] unto his father: \"O my father! Why dost thou worship something that neither hears nor sees and can be of no avail whatever to thee?"},{"n":43,"g":2293,"t":"يَٰٓأَبَتِ إِنِّى قَدْ جَآءَنِى مِنَ ٱلْعِلْمِ مَا لَمْ يَأْتِكَ فَٱتَّبِعْنِىٓ أَهْدِكَ صِرَٰطًۭا سَوِيًّۭا","e":"O my father, indeed there has come to me of knowledge that which has not come to you, so follow me; I will guide you to an even path.","j":16,"p":308,"r":266,"h":123,"w":13,"u":"ابّا مجھے ایسا علم ملا ہے جو آپ کو نہیں ملا ہے تو میرے ساتھ ہوجیئے میں آپ کو سیدھی راہ پر چلا دوں گا","s":"اى زما پلار جانه! بېشكه زه چې یم یقینًا ما ته (د الله له جانبه) هغه علم راغلى دى چې تا ته نه دى راغلى، نو ته زما پیروي وكړه، زه به تا ته نېغه (سمه) لار وښیم","a":"\"O my father! Behold, there has indeed come to me [a ray] of knowledge such as has never yet come unto thee: follow me, then; I shall guide thee onto a perfect way."},{"n":44,"g":2294,"t":"يَٰٓأَبَتِ لَا تَعْبُدِ ٱلشَّيْطَٰنَ ۖ إِنَّ ٱلشَّيْطَٰنَ كَانَ لِلرَّحْمَٰنِ عَصِيًّۭا","e":"O my father, do not worship Satan. Indeed Satan has ever been, to the Most Merciful, disobedient.","j":16,"p":308,"r":266,"h":123,"w":10,"u":"ابّا شیطان کی پرستش نہ کیجیئے۔ بےشک شیطان خدا کا نافرمان ہے","s":"اى زما پلار جانه! د شيطان بندګي مه كوه، يقينًا شيطان له رحمان نه نافرمان دى","a":"\"O my father! Do not worship Satan-for, verily, Satan is a rebel against the Most Gracious!"},{"n":45,"g":2295,"t":"يَٰٓأَبَتِ إِنِّىٓ أَخَافُ أَن يَمَسَّكَ عَذَابٌۭ مِّنَ ٱلرَّحْمَٰنِ فَتَكُونَ لِلشَّيْطَٰنِ وَلِيًّۭا","e":"O my father, indeed I fear that there will touch you a punishment from the Most Merciful so you would be to Satan a companion [in Hellfire].\"","j":16,"p":308,"r":266,"h":123,"w":11,"u":"ابّا مجھے ڈر لگتا ہے کہ آپ کو خدا کا عذاب آپکڑے تو آپ شیطان کے ساتھی ہوجائیں","s":"اى زما پلارجانه! بېشكه زه چې یم، زه له دې نه وېرېږم چې تا ته به د رحمٰن له جانبه عذاب درورسېږي، نو ته به د شیطان دوست شې","a":"O my father! I dread lest a chastisement from the Most Gracious befall thee, and then thou wilt become [aware of having been] close unto Satan!\""},{"n":46,"g":2296,"t":"قَالَ أَرَاغِبٌ أَنتَ عَنْ ءَالِهَتِى يَٰٓإِبْرَٰهِيمُ ۖ لَئِن لَّمْ تَنتَهِ لَأَرْجُمَنَّكَ ۖ وَٱهْجُرْنِى مَلِيًّۭا","e":"[His father] said, \"Have you no desire for my gods, O Abraham? If you do not desist, I will surely stone you, so avoid me a prolonged time.\"","j":16,"p":308,"r":266,"h":123,"w":14,"u":"اس نے کہا ابراہیم کیا تو میرے معبودوں سے برگشتہ ہے؟ اگر تو باز نہ آئے گا تو میں تجھے سنگسار کردوں گا اور تو ہمیشہ کے لئے مجھ سے دور ہوجا","s":"هغه (پلار د ابراهیم) وویل: اى ابراهیمه! ایا ته زما له معبودانو نه مخ ګرځوونكى يې، یقینًا كه ته منع نه شوې، نو زه به تا خامخا ضرور سنګسار كړم او له ما څخه ډېره موده لرې شه","a":"He answered: \"Dost thou dislike my gods, O Abraham? Indeed, if thou desist not, I shall most certainly cause thee to be stoned to death! Now begone from me for good!\""},{"n":47,"g":2297,"t":"قَالَ سَلَٰمٌ عَلَيْكَ ۖ سَأَسْتَغْفِرُ لَكَ رَبِّىٓ ۖ إِنَّهُۥ كَانَ بِى حَفِيًّۭا","e":"[Abraham] said, \"Peace will be upon you. I will ask forgiveness for you of my Lord. Indeed, He is ever gracious to me.","j":16,"p":308,"r":266,"h":123,"w":12,"u":"ابراہیم نے سلام علیک کہا (اور کہا کہ) میں آپ کے لئے اپنے پروردگار سے بخشش مانگوں گا۔ بےشک وہ مجھ پر نہایت مہربان ہے","s":"ده وویل: په تا دې سلام وي، ضرور به زه تا لپاره له خپل رب نه مغفرت غواړم، بېشكه دى په ما باندې ډېر مهربان دى","a":"[Abraham] replied: \"Peace be upon thee! I shall ask my Sustainer to forgive thee: for, behold, He has always been kind unto me."},{"n":48,"g":2298,"t":"وَأَعْتَزِلُكُمْ وَمَا تَدْعُونَ مِن دُونِ ٱللَّهِ وَأَدْعُوا۟ رَبِّى عَسَىٰٓ أَلَّآ أَكُونَ بِدُعَآءِ رَبِّى شَقِيًّۭا","e":"And I will leave you and those you invoke other than Allah and will invoke my Lord. I expect that I will not be in invocation to my Lord unhappy.\"","j":16,"p":308,"r":266,"h":123,"w":14,"u":"اور میں آپ لوگوں سے اور جن کو آپ خدا کے سوا پکارا کرتے ہیں ان سے کنارہ کرتا ہوں اور اپنے پروردگار ہی کو پکاروں گا۔ امید ہے کہ میں اپنے پروردگار کو پکار کر محروم نہیں رہوں گا","s":"او زه جدا كېږم له تاسو نه او له هغو څیزونو نه چې تاسو يې له الله نه غیر بلئ، او زه خپل رب رابلم، امېد دى چې زه به د خپل رب په رابللو سره بدبخته نشم","a":"But I shall withdraw from you all and from whatever you invoke instead of God, and shall invoke my Sustainer [alone]: it may well be that my prayer [for thee] will not remain unanswered by my Sustainer.\""},{"n":49,"g":2299,"t":"فَلَمَّا ٱعْتَزَلَهُمْ وَمَا يَعْبُدُونَ مِن دُونِ ٱللَّهِ وَهَبْنَا لَهُۥٓ إِسْحَٰقَ وَيَعْقُوبَ ۖ وَكُلًّۭا جَعَلْنَا نَبِيًّۭا","e":"So when he had left them and those they worshipped other than Allah, We gave him Isaac and Jacob, and each [of them] We made a prophet.","j":16,"p":308,"r":266,"h":123,"w":15,"u":"اور جب ابراہیم ان لوگوں سے اور جن کی وہ خدا کے سوا پرستش کرتے تھے اُن سے الگ ہوگئے تو ہم نے ان کو اسحاق اور (اسحاق کو) یعقوب بخشے۔ اور سب کو پیغمبر بنایا","s":"نو كله چې دى له دوى نه او له هغو نه چې دغه خلق يې له الله نه غیر عبادت كوي؛ بېل شو (، نو) مونږ ده ته اسحق او یعقوب عطا كړل او دا هر یو مونږ نبیان ګرځولي وو","a":"And after he had withdrawn from them and from all that they were worshipping instead of God, We bestowed upon him Isaac and Jacob, and made each of them a prophet;"},{"n":50,"g":2300,"t":"وَوَهَبْنَا لَهُم مِّن رَّحْمَتِنَا وَجَعَلْنَا لَهُمْ لِسَانَ صِدْقٍ عَلِيًّۭا","e":"And We gave them of Our mercy, and we made for them a reputation of high honor.","j":16,"p":308,"r":266,"h":123,"w":9,"u":"اور ان کو اپنی رحمت سے (بہت سی چیزیں) عنایت کیں۔ اور ان کا ذکر جمیل بلند کیا","s":"مونږ دغو ته له خپل رحمته عطا وركړه او مونږ دوى ته د صدق ډېره اوچته ژبه وركړې وه","a":"and We bestowed upon them [manifold] gifts out of Our grace, and granted them a lofty power to convey the truth [unto others]."},{"n":51,"g":2301,"t":"وَٱذْكُرْ فِى ٱلْكِتَٰبِ مُوسَىٰٓ ۚ إِنَّهُۥ كَانَ مُخْلَصًۭا وَكَانَ رَسُولًۭا نَّبِيًّۭا","e":"And mention in the Book, Moses. Indeed, he was chosen, and he was a messenger and a prophet.","j":16,"p":308,"r":267,"h":123,"w":11,"u":"اور کتاب میں موسیٰ کا بھی ذکر کرو۔ بےشک وہ (ہمارے) برگزیدہ اور پیغمبر مُرسل تھے","s":"او په كتاب كې موسٰی یاد كړه، بېشكه چې دى خالص كړى شوى و او رسول (او)، نبي و","a":"AND CALL to mind, through this divine writ, Moses. Behold, he was a chosen one, and was an apostle [of God], a prophet."},{"n":52,"g":2302,"t":"وَنَٰدَيْنَٰهُ مِن جَانِبِ ٱلطُّورِ ٱلْأَيْمَنِ وَقَرَّبْنَٰهُ نَجِيًّۭا","e":"And We called him from the side of the mount at [his] right and brought him near, confiding [to him].","j":16,"p":309,"r":267,"h":123,"w":7,"u":"اور ہم نے ان کو طور کی داہنی جانب پکارا اور باتیں کرنے کے لئے نزدیک بلایا","s":"او مونږ ده ته د طور غر له ښي اړخ نه اواز كړى و او مونږ دى قریب كړ، چې د راز خبرې مو ورسره كولې","a":"And [remember how] We called upon him from the right-hand slope of Mount Sinai and drew him near [unto Us] in mystic communion,"},{"n":53,"g":2303,"t":"وَوَهَبْنَا لَهُۥ مِن رَّحْمَتِنَآ أَخَاهُ هَٰرُونَ نَبِيًّۭا","e":"And We gave him out of Our mercy his brother Aaron as a prophet.","j":16,"p":309,"r":267,"h":123,"w":7,"u":"اور اپنی مہربانی سے اُن کو اُن کا بھائی ہارون پیغمبر عطا کیا","s":"او مونږ ده ته له خپل رحمته د ده ورور هارون وركړ، چې نبي و","a":"and [how], out of Our grace, We granted unto him his brother Aaron, to be a prophet [by his side]."},{"n":54,"g":2304,"t":"وَٱذْكُرْ فِى ٱلْكِتَٰبِ إِسْمَٰعِيلَ ۚ إِنَّهُۥ كَانَ صَادِقَ ٱلْوَعْدِ وَكَانَ رَسُولًۭا نَّبِيًّۭا","e":"And mention in the Book, Ishmael. Indeed, he was true to his promise, and he was a messenger and a prophet.","j":16,"p":309,"r":267,"h":123,"w":12,"u":"اور کتاب میں اسمٰعیل کا بھی ذکر کرو وہ وعدے کے سچے اور ہمارے بھیجے ہوئے نبی تھے","s":"او په كتاب كې اسماعیل یاد كړه، بېشكه دى د وعدې رښتینى و او رسول (او) نبي و","a":"AND CALL to mind, through this divine writ, Ishmael. Behold, he was always true to his promise, and was an apostle [of God], a prophet,"},{"n":55,"g":2305,"t":"وَكَانَ يَأْمُرُ أَهْلَهُۥ بِٱلصَّلَوٰةِ وَٱلزَّكَوٰةِ وَكَانَ عِندَ رَبِّهِۦ مَرْضِيًّۭا","e":"And he used to enjoin on his people prayer and zakah and was to his Lord pleasing.","j":16,"p":309,"r":267,"h":123,"w":9,"u":"اور اپنے گھر والوں کو نماز اور زکوٰة کا حکم کرتے تھے اور اپنے پروردگار کے ہاں پسندیدہ (وبرگزیدہ) تھے","s":"او ده به خپل اهل ته په لمانځه او زكات سره حكم كاوه او دى د خپل رب په نیز پسندیده و","a":"who used to enjoin upon his people prayer and charity, and found favour in his Sustainer's sight."},{"n":56,"g":2306,"t":"وَٱذْكُرْ فِى ٱلْكِتَٰبِ إِدْرِيسَ ۚ إِنَّهُۥ كَانَ صِدِّيقًۭا نَّبِيًّۭا","e":"And mention in the Book, Idrees. Indeed, he was a man of truth and a prophet.","j":16,"p":309,"r":267,"h":123,"w":9,"u":"اور کتاب میں ادریس کا بھی ذکر کرو۔ وہ بھی نہایت سچے نبی تھے","s":"او په كتاب كې ادریس یاد كړه، يقينًا دى رښتينى (او) نبي و","a":"AND CALL to mind, through this divine writ, Idris. Behold, he was a man of truth, a prophet,"},{"n":57,"g":2307,"t":"وَرَفَعْنَٰهُ مَكَانًا عَلِيًّا","e":"And We raised him to a high station.","j":16,"p":309,"r":267,"h":123,"w":3,"u":"اور ہم نے ان کو اونچی جگہ اُٹھا لیا تھا","s":"او دى مونږ ډېر اوچت ځاى ته پورته كړى دى","a":"whom We exalted onto a lofty station."},{"n":58,"g":2308,"t":"أُو۟لَٰٓئِكَ ٱلَّذِينَ أَنْعَمَ ٱللَّهُ عَلَيْهِم مِّنَ ٱلنَّبِيِّۦنَ مِن ذُرِّيَّةِ ءَادَمَ وَمِمَّنْ حَمَلْنَا مَعَ نُوحٍۢ وَمِن ذُرِّيَّةِ إِبْرَٰهِيمَ وَإِسْرَٰٓءِيلَ وَمِمَّنْ هَدَيْنَا وَٱجْتَبَيْنَآ ۚ إِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَٰتُ ٱلرَّحْمَٰنِ خَرُّوا۟ سُجَّدًۭا وَبُكِيًّۭا ۩","e":"Those were the ones upon whom Allah bestowed favor from among the prophets of the descendants of Adam and of those We carried [in the ship] with Noah, and of the descendants of Abraham and Israel, and of those whom We guided and chose. When the verses of the Most Merciful were recited to them, they fell in prostration and weeping.","j":16,"p":309,"r":267,"h":123,"w":31,"u":"یہ وہ لوگ ہیں جن پر خدا نے اپنے پیغمبروں میں سے فضل کیا۔ (یعنی) اولاد آدم میں سے اور ان لوگوں میں سے جن کو نوح کے ساتھ (کشتی میں) سوار کیا اور ابراہیم اور یعقوب کی اولاد میں سے اور ان لوگوں میں سے جن کو ہم نے ہدایت دی اور برگزیدہ کیا۔ جب ان کے سامنے ہماری آیتیں پڑھی جاتی تھیں تو سجدے میں گر پڑتے اور روتے رہتے تھے","s":"دغه خلق هغه كسان دي چې الله په دوى باندې له انبیاوو ځنې انعام كړى دى، د ادم په اولاده كې او د هغه چا (په اولاد كې) چې مونږ له نوح سره بار كړي وو او د ابراهیم او اسرائیل (یعقوب) په اولاده كې۔ او له هغه چا نه چې مونږ (ورته) هدایت كړى و او مونږ غوره كړي وو كله چې به په دوى د رحمٰن ایتونه ولوستى شول (نو) دوى به پرېوتل، سجده كوونكي او ژړېدونكي","a":"THESE WERE some of the prophets upon whom God bestowed His blessings - [prophets] of the seed of Adam and of those whom We caused to be borne [in the ark] with Noah, and of the seed of Abraham and Israel and [all of them were] among those whom We had guided and elected; [and] whenever the messages of the Most Gracious were conveyed unto them, they would fall down [before Him], prostrating themselves and weeping."},{"n":59,"g":2309,"t":"۞ فَخَلَفَ مِنۢ بَعْدِهِمْ خَلْفٌ أَضَاعُوا۟ ٱلصَّلَوٰةَ وَٱتَّبَعُوا۟ ٱلشَّهَوَٰتِ ۖ فَسَوْفَ يَلْقَوْنَ غَيًّا","e":"But there came after them successors who neglected prayer and pursued desires; so they are going to meet evil -","j":16,"p":309,"r":267,"h":124,"w":13,"u":"پھر ان کے بعد چند ناخلف ان کے جانشیں ہوئے جنہوں نے نماز کو (چھوڑ دیا گویا اسے) کھو دیا۔ اور خواہشات نفسانی کے پیچھے لگ گئے۔ سو عنقریب ان کو گمراہی (کی سزا) ملے گی","s":"نو له دوى نه وروسته داسې بد ځاى ناستي پېدا شول چې لمونځونه يې ضايع كړل او د شهوتونو پیروي يې وكړه، نو ژر به دوى د خپلې بدۍ له انجام سره ملاقات وكړي","a":"Yet they were succeeded by generations [of people] who lost all [thought of] prayer and followed [but] their own lusts; and these will, in time, meet with utter disillusion."},{"n":60,"g":2310,"t":"إِلَّا مَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحًۭا فَأُو۟لَٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ وَلَا يُظْلَمُونَ شَيْـًۭٔا","e":"Except those who repent, believe and do righteousness; for those will enter Paradise and will not be wronged at all.","j":16,"p":309,"r":267,"h":124,"w":12,"u":"ہاں جس نے توبہ کی اور ایمان لایا اور عمل نیک کئے تو اسے لوگ بہشت میں داخل ہوں گے اور ان کا ذرا نقصان نہ کیا جائے گا","s":"مګر هغه څوك چې توبه وباسي او ایمان راوړي او نېك عمل وكړي، نو دغه كسان دي چې دوى به جنت ته داخلېږي او په دوى به هېڅ شى ظلم نه كېږي","a":"Excepted, however, shall be those who repent and attain to faith and do righteous deeds: for it is they who will enter paradise and will not be wronged in any way:"},{"n":61,"g":2311,"t":"جَنَّٰتِ عَدْنٍ ٱلَّتِى وَعَدَ ٱلرَّحْمَٰنُ عِبَادَهُۥ بِٱلْغَيْبِ ۚ إِنَّهُۥ كَانَ وَعْدُهُۥ مَأْتِيًّۭا","e":"[Therein are] gardens of perpetual residence which the Most Merciful has promised His servants in the unseen. Indeed, His promise has ever been coming.","j":16,"p":309,"r":267,"h":124,"w":12,"u":"(یعنی) بہشت جاودانی (میں) جس کا خدا نے اپنے بندوں سے وعدہ کیا ہے (اور جو ان کی آنکھوں سے) پوشیدہ (ہے) ۔ بےشک اس کا وعدہ (نیکوکاروں کے سامنے) آنے والا ہے","s":"د تل اوسېدونې جنتونو ته، هغه چې رحمٰن يې وعده كړې ده له خپلو بنده ګانو سره په نالیدلو، بېشكه دى (الله) چې دى، د ده وعده (خامخا) راتلونكې ده","a":"[theirs will be the] gardens of perpetual bliss which the Most Gracious has promised unto His servants, in a realm which is beyond the reach of human perception: [and,] verily, His promise is ever sure of fulfilment!"},{"n":62,"g":2312,"t":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا إِلَّا سَلَٰمًۭا ۖ وَلَهُمْ رِزْقُهُمْ فِيهَا بُكْرَةًۭ وَعَشِيًّۭا","e":"They will not hear therein any ill speech - only [greetings of] peace - and they will have their provision therein, morning and afternoon.","j":16,"p":309,"r":267,"h":124,"w":12,"u":"وہ اس میں سلام کے سوا کوئی بیہودہ کلام نہ سنیں گے، اور ان کے لئے صبح وشام کا کھانا تیار ہوگا","s":"دوى به په دغو (جنتونو) كې لغوه خبرې نه اوري غیر له سلام نه، او د دوى لپاره په دغو (جنتونو) كې سبا او بېګاه د دوى رزق دى","a":"No empty talk will they hear there-nothing but [tidings of] inner soundness and peace; and there will they have their sustenance by day and by night:"},{"n":63,"g":2313,"t":"تِلْكَ ٱلْجَنَّةُ ٱلَّتِى نُورِثُ مِنْ عِبَادِنَا مَن كَانَ تَقِيًّۭا","e":"That is Paradise, which We give as inheritance to those of Our servants who were fearing of Allah.","j":16,"p":309,"r":267,"h":124,"w":9,"u":"یہی وہ جنت ہے جس کا ہم اپنے بندوں میں سے ایسے شخص کو وارث بنائیں گے جو پرہیزگار ہوگا","s":"دغه هغه جنتونه دي چې مونږ يې په خپلو بنده ګانو كې هغه څوك وارث ګرځولو چې پرهېزګاره وي","a":"this is the paradise which We grant as a heritage unto such of Our servants as are conscious of Us."},{"n":64,"g":2314,"t":"وَمَا نَتَنَزَّلُ إِلَّا بِأَمْرِ رَبِّكَ ۖ لَهُۥ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَٰلِكَ ۚ وَمَا كَانَ رَبُّكَ نَسِيًّۭا","e":"[Gabriel said], \"And we [angels] descend not except by the order of your Lord. To Him belongs that before us and that behind us and what is in between. And never is your Lord forgetful -","j":16,"p":309,"r":267,"h":124,"w":20,"u":"اور (فرشتوں نے پیغمبر کو جواب دیا کہ) ہم تمہارے پروردگار کے حکم سوا اُتر نہیں سکتے۔ جو کچھ ہمارے آگے ہے اور پیچھے ہے اور جو ان کے درمیان ہے سب اسی کا ہے اور تمہارا پروردگار بھولنے والا نہیں","s":"او (جبریل وویل) مونږ نه راكوځېږو مګر د خپل رب په امر سره، خاص د هغه لپاره دي هغه څه چې زمونږ په وړاندې دي او هغې چې زمونږ وروسته دي او هغه څه چې د دغو په مینځ كې دي۔ او ستا رب هیڅكله هېروونكى نه دى","a":"AND [the angels say]: \"We do not descend [with revelation], again and again, other than by thy Sustainer's command: unto Him belongs all that lies open before us and all that is hidden-from us and all that is in-between. And never does thy Sustainer forget [anything] –"},{"n":65,"g":2315,"t":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا فَٱعْبُدْهُ وَٱصْطَبِرْ لِعِبَٰدَتِهِۦ ۚ هَلْ تَعْلَمُ لَهُۥ سَمِيًّۭا","e":"Lord of the heavens and the earth and whatever is between them - so worship Him and have patience for His worship. Do you know of any similarity to Him?\"","j":16,"p":310,"r":267,"h":124,"w":13,"u":"(یعنی) آسمان اور زمین کا اور جو ان دونوں کے درمیان ہے سب کا پروردگار ہے۔ تو اسی کی عبادت کرو اور اسی کی عبادت پر ثابت قدم رہو۔ بھلا تم کوئی اس کا ہم نام جانتے ہو","s":"(دغه) د اسمانونو او ځمكې رب دى او د هغه څه چې د دغو دواړو په مینځ كې دي، نو ته د ده عبادت كوه او د ده په عبادت ښه ټینګ اوسه۔، ایا ته د ده كوم همنام پېژنې","a":"the Sustainer of the heavens and the earth and all that is between them! Worship, then, Him alone, and remain steadfast in His worship! Dost thou know any whose name is worthy to be mentioned side by side with His?\""},{"n":66,"g":2316,"t":"وَيَقُولُ ٱلْإِنسَٰنُ أَءِذَا مَا مِتُّ لَسَوْفَ أُخْرَجُ حَيًّا","e":"And the disbeliever says, \"When I have died, am I going to be brought forth alive?\"","j":16,"p":310,"r":268,"h":124,"w":8,"u":"اور (کافر) انسان کہتا ہے کہ جب میں مر جاؤ گا تو کیا زندہ کرکے نکالا جاؤں گا؟","s":"او دغه (له بعث نه منكر) انسان وايي: ایا كله چې زه مړ شم خامخا عنقریب به زه بیا ژوندى را ایستلى شم","a":"WITH ALL THIS, man [often] says, \"What! Once I am dead, shall I again be brought forth alive?\""},{"n":67,"g":2317,"t":"أَوَلَا يَذْكُرُ ٱلْإِنسَٰنُ أَنَّا خَلَقْنَٰهُ مِن قَبْلُ وَلَمْ يَكُ شَيْـًۭٔا","e":"Does man not remember that We created him before, while he was nothing?","j":16,"p":310,"r":268,"h":124,"w":10,"u":"کیا (ایسا) انسان یاد نہیں کرتا کہ ہم نے اس کو پہلے بھی پیدا کیا تھا اور وہ کچھ بھی چیز نہ تھا","s":"ایا دغه انسان نه یادوي چې بېشكه مونږ دى له دې نه مخكې پیدا كړى و، او دى هېڅ شى نه و","a":"But does man not bear in mind that We have created him aforetime out of nothing?"},{"n":68,"g":2318,"t":"فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ وَٱلشَّيَٰطِينَ ثُمَّ لَنُحْضِرَنَّهُمْ حَوْلَ جَهَنَّمَ جِثِيًّۭا","e":"So by your Lord, We will surely gather them and the devils; then We will bring them to be present around Hell upon their knees.","j":16,"p":310,"r":268,"h":124,"w":8,"u":"تمہارے پروردگار کی قسم! ہم ان کو جمع کریں گے اور شیطانوں کو بھی۔ پھر ان سب کو جہنم کے گرد حاضر کریں گے (اور وہ) گھٹنوں پر گرے ہوئے (ہوں گے)","s":"نو قسم دى ستا په رب چې مونږ به خامخا ضرور دوى او شیطانان ټول راجمع كړو، بیا به مونږ دوى خامخا ضرور د دوزخ چاپېره په ګونډو پراته راحاضر كړو","a":"And so, by thy Sustainer, [on Judgment Day] We shall most certainly bring them forth together with the satanic forces [which impelled them in life] and then We shall most certainly gather them, on their knees, around hell;"},{"n":69,"g":2319,"t":"ثُمَّ لَنَنزِعَنَّ مِن كُلِّ شِيعَةٍ أَيُّهُمْ أَشَدُّ عَلَى ٱلرَّحْمَٰنِ عِتِيًّۭا","e":"Then We will surely extract from every sect those of them who were worst against the Most Merciful in insolence.","j":16,"p":310,"r":268,"h":124,"w":10,"u":"پھر ہر جماعت میں سے ہم ایسے لوگوں کو کھینچ نکالیں گے جو خدا سے سخت سرکشی کرتے تھے","s":"بیا به خامخا ضرور مونږ له هرې ډلې نه راوباسو هر هغه څوك چې د سركشۍ په لحاظ په رحمٰن باندې ډېر سخت دى","a":"and thereupon We shall, indeed, draw forth from every group [of sinners] the ones that had been most determined in their disdainful rebellion against the Most Gracious:"},{"n":70,"g":2320,"t":"ثُمَّ لَنَحْنُ أَعْلَمُ بِٱلَّذِينَ هُمْ أَوْلَىٰ بِهَا صِلِيًّۭا","e":"Then, surely it is We who are most knowing of those most worthy of burning therein.","j":16,"p":310,"r":268,"h":124,"w":8,"u":"اور ہم ان لوگوں سے خوب واقف ہیں جو ان میں داخل ہونے کے زیادہ لائق ہیں","s":"بیا خامخا مونږ په هغو خلقو ښه عالمان یو چې هغوى دغه (دوزخ) ته د داخلولو (او سوځولو) ښه لايق دي","a":"for, indeed, We know best as to which of them is most deserving of the fires of hell."},{"n":71,"g":2321,"t":"وَإِن مِّنكُمْ إِلَّا وَارِدُهَا ۚ كَانَ عَلَىٰ رَبِّكَ حَتْمًۭا مَّقْضِيًّۭا","e":"And there is none of you except he will come to it. This is upon your Lord an inevitability decreed.","j":16,"p":310,"r":268,"h":124,"w":10,"u":"اور تم میں کوئی (شخص) نہیں مگر اسے اس پر گزرنا ہوگا۔ یہ تمہارے پروردگار پر لازم اور مقرر ہے","s":"او نشته دى په تاسو كې هیڅوك مګر ده ته واردېدونكى دى دغه (واردېدل) ستا د رب په ذمه یقیني او فیصله كړى شوي دي","a":"And every one of you will come within sight of it: this is, with thy Sustainer, a decree that must be fulfilled."},{"n":72,"g":2322,"t":"ثُمَّ نُنَجِّى ٱلَّذِينَ ٱتَّقَوا۟ وَّنَذَرُ ٱلظَّٰلِمِينَ فِيهَا جِثِيًّۭا","e":"Then We will save those who feared Allah and leave the wrongdoers within it, on their knees.","j":16,"p":310,"r":268,"h":124,"w":8,"u":"پھر ہم پرہیزگاروں کو نجات دیں گے۔ اور ظالموں کو اس میں گھٹنوں کے بل پڑا ہوا چھوڑ دیں گے","s":"بیا به مونږ هغو كسانو ته نجات وركړو چې پرهېزګاري يې كړې ده او ظالمان (كافران) به په دغه (دوزخ) كې په ګونډو پراته پرېږدو","a":"And once again: We shall save [from hell] those who have been conscious of Us; but We shall leave in it the evildoers, on their knees."},{"n":73,"g":2323,"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَٰتُنَا بَيِّنَٰتٍۢ قَالَ ٱلَّذِينَ كَفَرُوا۟ لِلَّذِينَ ءَامَنُوٓا۟ أَىُّ ٱلْفَرِيقَيْنِ خَيْرٌۭ مَّقَامًۭا وَأَحْسَنُ نَدِيًّۭا","e":"And when Our verses are recited to them as clear evidences, those who disbelieve say to those who believe, \"Which of [our] two parties is best in position and best in association?\"","j":16,"p":310,"r":268,"h":124,"w":16,"u":"اور جب ان لوگوں کے سامنے ہماری آیتیں پڑھی جاتی ہیں تو جو کافر ہیں وہ مومنوں سے کہتے ہیں کہ دونوں فریق میں سے مکان کس کے اچھے اور مجلسیں کس کی بہتر ہیں","s":"او كله چې دوى ته زمونږ ایتونه لوستى شي، چې ښه واضح دي، (، نو) كافران شوي كسان هغو كسانو ته چې ایمان يې راوړى دى؛ وايي په دغو دواړو ډلو كې كومه یوه د مقام په لحاظ ډېره غوره او د مجلس په لحاظ ډېر ښايسته ده","a":"AS IT IS, whenever Our messages are conveyed to them in all their clarity, those who are bent on denying the truth are wont to say unto those who have attained to faith: \"Which of the two kinds of man is in a stronger position and superior as a community?\""},{"n":74,"g":2324,"t":"وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هُمْ أَحْسَنُ أَثَٰثًۭا وَرِءْيًۭا","e":"And how many a generation have We destroyed before them who were better in possessions and [outward] appearance?","j":16,"p":310,"r":268,"h":124,"w":9,"u":"اور ہم نے ان سے پہلے بہت سی اُمتیں ہلاک کردیں۔ وہ لوگ (ان سے) ٹھاٹھ اور نمود میں کہیں اچھے تھے","s":"او له دوى نه مخكې مونږ څومره ډېر قرنونه (امتونه) هلاك كړي دي، چې هغوى د سامانونو او لیدنې (شكل) په لحاظ ډېر ښه وو","a":"And yet, how many a generation have We destroyed before their time-[people] who surpassed them in material power and in outward show!"},{"n":75,"g":2325,"t":"قُلْ مَن كَانَ فِى ٱلضَّلَٰلَةِ فَلْيَمْدُدْ لَهُ ٱلرَّحْمَٰنُ مَدًّا ۚ حَتَّىٰٓ إِذَا رَأَوْا۟ مَا يُوعَدُونَ إِمَّا ٱلْعَذَابَ وَإِمَّا ٱلسَّاعَةَ فَسَيَعْلَمُونَ مَنْ هُوَ شَرٌّۭ مَّكَانًۭا وَأَضْعَفُ جُندًۭا","e":"Say, \"Whoever is in error - let the Most Merciful extend for him an extension [in wealth and time] until, when they see that which they were promised - either punishment [in this world] or the Hour [of resurrection] - they will come to know who is worst in position and weaker in soldiers.\"","j":16,"p":310,"r":268,"h":124,"w":26,"u":"کہہ دو کہ جو شخص گمراہی میں پڑا ہوا ہے خدا اس کو آہستہ آہستہ مہلت دیئے جاتا ہے۔ یہاں تک کہ جب اس چیز کو دیکھ لیں گے جس کا ان سے وعدہ کیا جاتا ہے خواہ عذاب اور خواہ قیامت۔ تو (اس وقت) جان لیں گے کہ مکان کس کا برا ہے اور لشکر کس کا کمزور ہے","s":"ته (دوي ته) ووایه: هر هغه څوك چې په ګمراهۍ كې وي، نو رحمٰن دې ده ته مهلت وركړي، مهلت وركول، تر هغه پورې چې كله دوى هغه څه وویني چې له دوى سره يې وعده كولى شي، یا عذاب، یا قیامت، نو دوى به ژر پوه شي چې څوك دى د ځاى په لحاظ ډېر بد او د لښكر په لحاظ ډېر كمزورى","a":"Say: \"As for him who lives in error, may the Most Gracious lengthen the span of his life! [And let them say whatever they say until the time when they behold that [doom] of which they were forewarned-whether it be suffering [in this world] or [at the coming of] the Last Hour -: for then they will understand which [of the two kinds of man] was worse in station and weaker in resources!"},{"n":76,"g":2326,"t":"وَيَزِيدُ ٱللَّهُ ٱلَّذِينَ ٱهْتَدَوْا۟ هُدًۭى ۗ وَٱلْبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ خَيْرٌ عِندَ رَبِّكَ ثَوَابًۭا وَخَيْرٌۭ مَّرَدًّا","e":"And Allah increases those who were guided, in guidance, and the enduring good deeds are better to your Lord for reward and better for recourse.","j":16,"p":310,"r":268,"h":124,"w":14,"u":"اور جو لوگ ہدایت یاب ہیں خدا ان کو زیادہ ہدایت دیتا ہے۔ اور نیکیاں جو باقی رہنے والی ہیں وہ تمہارے پروردگار کے صلے کے لحاظ سے خوب اور انجام کے اعتبار سے بہتر ہیں","s":"او الله هغو كسانو ته هدایت نور هم زیاتوي چې نېغه لار يې موندلې ده، او نېكۍ باقي پاتې كېدونكې ستا د رب په نیز د ثواب په لحاظ ډېرې غوره دي او د بېرته ورتللو په لحاظ ډېرې ښې دي","a":"And God endows those who avail themselves of [His] guidance with an ever-deeper consciousness of the right way; and good deeds, the fruit whereof endures forever, are, in thy Sustainer's sight, of far greater merit [than any worldly goods], and yield far better returns."},{"n":77,"g":2327,"t":"أَفَرَءَيْتَ ٱلَّذِى كَفَرَ بِـَٔايَٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالًۭا وَوَلَدًا","e":"Then, have you seen he who disbelieved in Our verses and said, \"I will surely be given wealth and children [in the next life]?\"","j":16,"p":311,"r":268,"h":124,"w":8,"u":"بھلا تم نے اس شخص کو دیکھا جس نے ہماری آیتوں سے کفر کیا اور کہنے لگا کہ (اگر میں ازسرنو زندہ ہوا بھی تو یہی) مال اور اولاد مجھے (وہاں) ملے گا","s":"ایا تا هغه كس لیدلى چې زمونږ په ایتونو باندې كافر شوى دى او وايي چې ما ته به (په اخرت كې) خامخا ضرور مال او اولاد راكول كېږي","a":"And hast thou ever considered [the kind of man] who is bent on denying the truth of Our messages and says, \"I will surely be given wealth and children\"?"},{"n":78,"g":2328,"t":"أَطَّلَعَ ٱلْغَيْبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا","e":"Has he looked into the unseen, or has he taken from the Most Merciful a promise?","j":16,"p":311,"r":268,"h":124,"w":7,"u":"کیا اس نے غیب کی خبر پالی ہے یا خدا کے یہاں (سے) عہد لے لیا ہے؟","s":"ایا دى په غیبو خبر شوى دى، یا ده د رحمٰن په نیز كومه وعده اخيستې ده","a":"Has he, perchance, attained to a realm which is beyond the reach of a created being's perception? or has he concluded a covenant with the Most Gracious?"},{"n":79,"g":2329,"t":"كَلَّا ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلْعَذَابِ مَدًّۭا","e":"No! We will record what he says and extend for him from the punishment extensively.","j":16,"p":311,"r":268,"h":124,"w":10,"u":"ہرگز نہیں۔ یہ جو کچھ کہتا ہے ہم اس کو لکھتے جاتے اور اس کے لئے آہستہ آہستہ عذاب بڑھاتے جاتے ہیں","s":"داسې نه ده ضرور مونږ لیكو هغه څه چې دى يې وايي او ده ته به له عذابه وغځوو، غځول","a":"Nay! We shall record what he says, and We shall lengthen the length of his suffering [in the hereafter],"},{"n":80,"g":2330,"t":"وَنَرِثُهُۥ مَا يَقُولُ وَيَأْتِينَا فَرْدًۭا","e":"And We will inherit him [in] what he mentions, and he will come to Us alone.","j":16,"p":311,"r":268,"h":124,"w":5,"u":"اور جو چیزیں یہ بتاتا ہے ان کے ہم وارث ہوں گے اور یہ اکیلا ہمارے سامنے آئے گا","s":"او په میراث به اخلو هغه څه چې دى يې وايي، او دى به مونږ ته يواځې (ځانله) راځي","a":"and divest him of all that he is [now] speaking of: for [on Judgment Day] he will appear before Us in a lonely state."},{"n":81,"g":2331,"t":"وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةًۭ لِّيَكُونُوا۟ لَهُمْ عِزًّۭا","e":"And they have taken besides Allah [false] deities that they would be for them [a source of] honor.","j":16,"p":311,"r":268,"h":124,"w":8,"u":"اور ان لوگوں نے خدا کے سوا اور معبود بنالئے ہیں تاکہ وہ ان کے لئے (موجب عزت و) مدد ہوں","s":"او دوى له الله نه غیر (نور) معبودان ونیول، د دې لپاره چې دغه (معبودان) د دوى د عزت سبب شي","a":"For [such as] these have taken to worshipping deities other than God, hoping that they would be a [source of] strength for them."},{"n":82,"g":2332,"t":"كَلَّا ۚ سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا","e":"No! Those \"gods\" will deny their worship of them and will be against them opponents [on the Day of Judgement].","j":16,"p":311,"r":268,"h":124,"w":7,"u":"ہرگز نہیں وہ (معبودان باطل) ان کی پرستش سے انکار کریں گے اور ان کے دشمن (ومخالف) ہوں گے","s":"داسې نه ده، ژر به دغه (معبودان) د دوى په عبادت سره منكر شي او دغه به د دوى په ضد (او خلاف) شي","a":"But nay! [On Judgment Day] these [very objects of adoration] will disavow the worship that was paid to them, and will turn against those [who had worshipped them]!"},{"n":83,"g":2333,"t":"أَلَمْ تَرَ أَنَّآ أَرْسَلْنَا ٱلشَّيَٰطِينَ عَلَى ٱلْكَٰفِرِينَ تَؤُزُّهُمْ أَزًّۭا","e":"Do you not see that We have sent the devils upon the disbelievers, inciting them to [evil] with [constant] incitement?","j":16,"p":311,"r":269,"h":124,"w":9,"u":"کیا تم نے نہیں دیکھا کہ ہم نے شیطانوں کو کافروں پر چھوڑ رکھا ہے کہ ان کو برانگیختہ کرتے رہتے ہیں","s":"ایا ته نه ګورې چې مونږ شیطانان په كافرانو باندې راخوشې كوو، چې دوى تېزوي، تېزول","a":"ART THOU NOT aware that We have let loose all [manner of] satanic forces upon those who deny the truth - [forces] that impel them [towards sin] with strong impulsion?"},{"n":84,"g":2334,"t":"فَلَا تَعْجَلْ عَلَيْهِمْ ۖ إِنَّمَا نَعُدُّ لَهُمْ عَدًّۭا","e":"So be not impatient over them. We only count out to them a [limited] number.","j":16,"p":311,"r":269,"h":124,"w":8,"u":"تو تم ان پر (عذاب کے لئے) جلدی نہ کرو۔ اور ہم تو ان کے لئے (دن) شمار کر رہے ہیں","s":"نو ته په دوى باندې (د عذاب په راتلو كې) تلوار مه كوه، بېشكه مونږ د دوى لپاره شمېرل كوو، شمېرل","a":"Hence, be not in haste [to call down God's punishment] upon them: for We but number the number of their days."},{"n":85,"g":2335,"t":"يَوْمَ نَحْشُرُ ٱلْمُتَّقِينَ إِلَى ٱلرَّحْمَٰنِ وَفْدًۭا","e":"On the Day We will gather the righteous to the Most Merciful as a delegation","j":16,"p":311,"r":269,"h":124,"w":6,"u":"جس روز ہم پرہیزگاروں کو خدا کے سامنے (بطور) مہمان جمع کریں گے","s":"(یاده كړه) هغه ورځ چې مونږ به متقیان راجمع كړو د رحمٰن په طرف بلل شوي سواره مېلمانه","a":"On the Day when We shall gather the Godconscious unto [Us,] the Most Gracious, as honoured guests,"},{"n":86,"g":2336,"t":"وَنَسُوقُ ٱلْمُجْرِمِينَ إِلَىٰ جَهَنَّمَ وِرْدًۭا","e":"And will drive the criminals to Hell in thirst","j":16,"p":311,"r":269,"h":124,"w":5,"u":"اور گنہگاروں کو دوزخ کی طرف پیاسے ہانک لے جائیں گے","s":"او مجرمان (كافران) به د جهنم په طرف تږي پیاده شړو","a":"and drive those who were lost in sin unto hell as a thirsty herd is driven to a well –"},{"n":87,"g":2337,"t":"لَّا يَمْلِكُونَ ٱلشَّفَٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا","e":"None will have [power of] intercession except he who had taken from the Most Merciful a covenant.","j":16,"p":311,"r":269,"h":124,"w":9,"u":"(تو لوگ) کسی کی سفارش کا اختیار نہ رکھیں گے مگر جس نے خدا سے اقرار لیا ہو","s":"هغوى د شفاعت اختیار نه لري، مګر هغه څوك چې د رحمٰن په نيز يې وعده اخيستې ده","a":"[on that Day] none will have [the benefit of] intercession unless he has [in his lifetime] entered into a bond with the Most Gracious."},{"n":88,"g":2338,"t":"وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَٰنُ وَلَدًۭا","e":"And they say, \"The Most Merciful has taken [for Himself] a son.\"","j":16,"p":311,"r":269,"h":124,"w":4,"u":"اور کہتے ہیں کہ خدا بیٹا رکھتا ہے","s":"او دغه (كافران) وايي: رحمٰن د ځان لپاره اولاد نیولى دى","a":"As it is, some assert, \"The Most Gracious has taken unto Himself a son„!"},{"n":89,"g":2339,"t":"لَّقَدْ جِئْتُمْ شَيْـًٔا إِدًّۭا","e":"You have done an atrocious thing.","j":16,"p":311,"r":269,"h":124,"w":4,"u":"(ایسا کہنے والو یہ تو) تم بری بات (زبان پر) لائے ہو","s":"یقینًا یقینًا تاسو ډېره لویه د ګناه خبره وكړه","a":"Indeed, [by this assertion] you have brought forth something monstrous,"},{"n":90,"g":2340,"t":"تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ ٱلْجِبَالُ هَدًّا","e":"The heavens almost rupture therefrom and the earth splits open and the mountains collapse in devastation","j":16,"p":311,"r":269,"h":124,"w":9,"u":"قریب ہے کہ اس (افتراء) سے آسمان پھٹ پڑیں اور زمین شق ہوجائے اور پہاڑ پارہ پارہ ہو کر گر پڑیں","s":"نژدې دي چې اسمانونه له دې نه وچوي او ځمكه ټوټې ټوټې شي او غرونه راولوېږي ذرې ذرې","a":"whereat the heavens might well-nigh be rent into fragments, and the earth be split asunder, and the mountains fall down in ruins!"},{"n":91,"g":2341,"t":"أَن دَعَوْا۟ لِلرَّحْمَٰنِ وَلَدًۭا","e":"That they attribute to the Most Merciful a son.","j":16,"p":311,"r":269,"h":124,"w":4,"u":"کہ انہوں نے خدا کے لئے بیٹا تجویز کیا","s":"په دې خبره چې دوى د رحمٰن لپاره اولاد وباله","a":"That men. should ascribe a son to the Most Gracious,"},{"n":92,"g":2342,"t":"وَمَا يَنۢبَغِى لِلرَّحْمَٰنِ أَن يَتَّخِذَ وَلَدًا","e":"And it is not appropriate for the Most Merciful that He should take a son.","j":16,"p":311,"r":269,"h":124,"w":6,"u":"اور خدا کو شایاں نہیں کہ کسی کو بیٹا بنائے","s":"او رحمٰن ته نه ښايي چې اولاد ونیسي","a":"although it is inconceivable that the Most Gracious should take unto Himself a son!"},{"n":93,"g":2343,"t":"إِن كُلُّ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ إِلَّآ ءَاتِى ٱلرَّحْمَٰنِ عَبْدًۭا","e":"There is no one in the heavens and earth but that he comes to the Most Merciful as a servant.","j":16,"p":311,"r":269,"h":124,"w":10,"u":"تمام شخص جو آسمانوں اور زمین میں ہیں سب خدا کے روبرو بندے ہو کر آئیں گے","s":"نه دي دغه هر یو چې په اسمانونو او ځمكه كې دي مګر رحمٰن ته راتلونكي دي، په دې حال كې چې بنده به وي","a":"Not one of all [the beings] that are in the heavens or on earth appears before the Most Gracious other than as a servant:"},{"n":94,"g":2344,"t":"لَّقَدْ أَحْصَىٰهُمْ وَعَدَّهُمْ عَدًّۭا","e":"He has enumerated them and counted them a [full] counting.","j":16,"p":311,"r":269,"h":124,"w":4,"u":"اُس نے ان (سب) کو (اپنے علم سے) گھیر رکھا اور (ایک ایک کو) شمار کر رکھا ہے","s":"یقینًا یقینًا ده دوى راګېر كړي دي او دوى يې شمېرلي دي، شمېرل","a":"indeed, He has full cognizance of them, and has numbered them with [unfailing] numbering;"},{"n":95,"g":2345,"t":"وَكُلُّهُمْ ءَاتِيهِ يَوْمَ ٱلْقِيَٰمَةِ فَرْدًا","e":"And all of them are coming to Him on the Day of Resurrection alone.","j":16,"p":311,"r":269,"h":124,"w":5,"u":"اور سب قیامت کے دن اس کے سامنے اکیلے اکیلے حاضر ہوں گے","s":"او هر يو له دوى نه ده ته راتلونكى دى په ورځ د قیامت كې يواځې","a":"and every one of them will appear before Him on Resurrection Day in a lonely state."},{"n":96,"g":2346,"t":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَٰنُ وُدًّۭا","e":"Indeed, those who have believed and done righteous deeds - the Most Merciful will appoint for them affection.","j":16,"p":312,"r":269,"h":124,"w":9,"u":"اور جو لوگ ایمان لائے اور عمل نیک کئے خدا ان کی محبت (مخلوقات کے دل میں) پیدا کردے گا","s":"بېشكه هغه كسان چې ایمان يې راوړى دى او نېك عملونه يې كړي دي ژر به رحمٰن د دوى لپاره (د خلقو په زړونو كې) مینه (او محبت) پیدا كړي","a":"VERILY, those who attain to faith and do righteous deeds will the Most Gracious endow with love:"},{"n":97,"g":2347,"t":"فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوْمًۭا لُّدًّۭا","e":"So, [O Muhammad], We have only made Qur'an easy in the Arabic language that you may give good tidings thereby to the righteous and warn thereby a hostile people.","j":16,"p":312,"r":269,"h":124,"w":10,"u":"(اے پیغمبر) ہم نے یہ (قرآن) تمہاری زبان میں آسان (نازل) کیا ہے تاکہ تم اس سے پرہیزگاروں کو خوشخبری پہنچا دو اور جھگڑالوؤں کو ڈر سنا دو","s":"پس بېشكه همدا خبره ده چې مونږ دغه (قرآن) ستا په ژبه آسان كړى دى، د دې لپاره چې ته په ده سره پرهېزګارانو ته زېرى وركړې او ته په ده سره ډېر جګړه كوونكى قوم ووېروې","a":"and only to this end have We made this [divine writ] easy to understand, in thine own tongue, [O Prophet,] so that thou might convey thereby a glad tiding to the God-conscious, and warn thereby those who are given to [futile] contention:"},{"n":98,"g":2348,"t":"وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هَلْ تُحِسُّ مِنْهُم مِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا","e":"And how many have We destroyed before them of generations? Do you perceive of them anyone or hear from them a sound?","j":16,"p":312,"r":269,"h":124,"w":14,"u":"اور ہم نے اس سے پہلے بہت سے گروہوں کو ہلاک کردیا ہے۔ بھلا تم ان میں سے کسی کو دیکھتے ہو یا (کہیں) ان کی بھنک سنتے ہو","s":"او له دوى نه مخكې مونږه څومره ډېر قرنونه هلاك كړي دي! ايا ته په دوى كې يو تن محسوسوې، يا ته د دوى كوم نرم غږ (اواز) هم اورې","a":"for, how many a generation have We destroyed before their time - [and] canst thou perceive any one of them [now], or hear any whisper of them?"}]},{"number":20,"name":"سُورَةُ طه","en":"Taa-Haa","tr":"Taa-Haa","rev":"Meccan","ayahs":[{"n":1,"g":2349,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طه","e":"Ta, Ha.","j":16,"p":312,"r":270,"h":125,"w":5,"u":"طہٰ","s":"طا، ها","a":"O MAN!"},{"n":2,"g":2350,"t":"مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ","e":"We have not sent down to you the Qur'an that you be distressed","j":16,"p":312,"r":270,"h":125,"w":5,"u":"(اے محمدﷺ) ہم نے تم پر قرآن اس لئے نازل نہیں کیا کہ تم مشقت میں پڑ جاؤ","s":"مونږ قرآن په تا باندې د دې لپاره نه دى نازل كړى چې ته په سختۍ او مشقت كې پرېوځې","a":"We did not bestow the Qur'an on thee from on high to make thee unhappy,"},{"n":3,"g":2351,"t":"إِلَّا تَذْكِرَةًۭ لِّمَن يَخْشَىٰ","e":"But only as a reminder for those who fear [Allah] -","j":16,"p":312,"r":270,"h":125,"w":4,"u":"بلکہ اس شخص کو نصیحت دینے کے لئے (نازل کیا ہے) جو خوف رکھتا ہے","s":"مګر (نازل كړى دى مونږ) نصیحت د هغه چا لپاره چې وېرېږي","a":"but only as an exhortation to all who stand in awe [of God]:"},{"n":4,"g":2352,"t":"تَنزِيلًۭا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَٰوَٰتِ ٱلْعُلَى","e":"A revelation from He who created the earth and highest heavens,","j":16,"p":312,"r":270,"h":125,"w":6,"u":"یہ اس (ذات برتر) کا اتارا ہوا ہے جس نے زمین اور اونچے اونچے آسمان بنائے","s":"(نازل كړى شوى دى) په نازلېدلو سره د هغه (الله) له جانبه چې ځمكه او ډېر اوچت اسمانونه يې پیدا كړي دي","a":"a revelation from Him who has created the earth and the high heavens"},{"n":5,"g":2353,"t":"ٱلرَّحْمَٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ","e":"The Most Merciful [who is] above the Throne established.","j":16,"p":312,"r":270,"h":125,"w":4,"u":"(یعنی خدائے) رحمٰن جس نےعرش پر قرار پکڑا","s":"رحمٰن په عرش باندې برقراره شو","a":"the Most Gracious, established on the throne of His almightiness?"},{"n":6,"g":2354,"t":"لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ","e":"To Him belongs what is in the heavens and what is on the earth and what is between them and what is under the soil.","j":16,"p":312,"r":270,"h":125,"w":12,"u":"جو کچھ آسمانوں میں ہے اور جو کچھ زمین میں ہے اور جو کچھ ان دونوں کے بیچ میں ہے اور جو کچھ (زمین کی) مٹی کے نیچے ہے سب اسی کا ہے","s":"خاص د ده لپاره دي هغه څه چې په اسمانونو كې دي او هغه څه چې په ځمكه كې دي او هغه څه چې د دواړو په مینځ كې دي او هغه څه چې د لوندې ځمكې نه لاندې دي","a":"Unto Him belongs all that is in the heavens and all that is on earth, as well as all that is between them and all that is beneath the sod."},{"n":7,"g":2355,"t":"وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى","e":"And if you speak aloud - then indeed, He knows the secret and what is [even] more hidden.","j":16,"p":312,"r":270,"h":125,"w":7,"u":"اور اگر تم پکار کر بات کہو تو وہ تو چھپے بھید اور نہایت پوشیدہ بات تک کو جانتا ہے","s":"او كه ته خبره په جهر سره كوې، نو یقینًا هغه په پټه خبره او په ډېره پټه خبره هم پوهېږي","a":"And if thou say anything aloud, [He hears it] since, behold, He knows [even] the secret [thoughts of man] as well as all that is yet more hidden [within him]."},{"n":8,"g":2356,"t":"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ","e":"Allah - there is no deity except Him. To Him belong the best names.","j":16,"p":312,"r":270,"h":125,"w":9,"u":"(وہ معبود برحق ہے کہ) اس کے سوا کوئی معبود نہیں ہے۔ اس کے (سب) نام اچھے ہیں","s":"الله (چې دى) نشته دى هېڅ لايق د عبادت مګر هم دى دى، خاص د ده لپاره تر ټولو ښكلي نومونه دي","a":"God-there is no deity save Him; His [alone] are the attributes of perfection!"},{"n":9,"g":2357,"t":"وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","e":"And has the story of Moses reached you? -","j":16,"p":312,"r":270,"h":125,"w":4,"u":"اور کیا تمہیں موسیٰ (کے حال) کی خبر ملی