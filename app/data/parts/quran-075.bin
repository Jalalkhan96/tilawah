s":"بېشكه له سختۍ سره اساني شته","a":"verily, with every hardship comes ease!"},{"n":7,"g":6097,"t":"فَإِذَا فَرَغْتَ فَٱنصَبْ","e":"So when you have finished [your duties], then stand up [for worship].","j":30,"p":596,"r":536,"h":239,"w":3,"u":"تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو","s":"نو كله چې ته فارغ شې، نو (په عبادت كې،) ځان ستړى كوه","a":"Hence, when thou art freed [from distress], remain steadfast,"},{"n":8,"g":6098,"t":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","e":"And to your Lord direct [your] longing.","j":30,"p":596,"r":536,"h":239,"w":3,"u":"اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو","s":"او خاص خپل رب ته رغبت (او زاري) كوه","a":"and unto thy Sustainer turn with love."}]},{"number":95,"name":"سُورَةُ التِّينِ","en":"At-Tin","tr":"The Fig","rev":"Meccan","ayahs":[{"n":1,"g":6099,"t":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","e":"By the fig and the olive","j":30,"p":597,"r":537,"h":239,"w":6,"u":"انجیر کی قسم اور زیتون کی","s":"قسم دى په انځر او زیتون (ښوون) باندې","a":"CONSIDER the fig and the olive,"},{"n":2,"g":6100,"t":"وَطُورِ سِينِينَ","e":"And [by] Mount Sinai","j":30,"p":597,"r":537,"h":239,"w":2,"u":"اور طور سینین کی","s":"او په طور سینین (غره) باندې","a":"and Mount Sinai,"},{"n":3,"g":6101,"t":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","e":"And [by] this secure city [Makkah],","j":30,"p":597,"r":537,"h":239,"w":3,"u":"اور اس امن والے شہر کی","s":"او په دې امان وركوونكي/امن والا ښار باندې","a":"and this land secure!"},{"n":4,"g":6102,"t":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ","e":"We have certainly created man in the best of stature;","j":30,"p":597,"r":537,"h":239,"w":6,"u":"کہ ہم نے انسان کو بہت اچھی صورت میں پیدا کیا ہے","s":"چې یقینًا یقینًا مونږ انسان په ډېر ښكلي صورت (او اعتدال) كې پیدا كړى دى","a":"Verily, We create man in the best conformation;"},{"n":5,"g":6103,"t":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","e":"Then We return him to the lowest of the low,","j":30,"p":597,"r":537,"h":239,"w":4,"u":"پھر (رفتہ رفتہ) اس (کی حالت) کو (بدل کر) پست سے پست کر دیا","s":"بیا دى مونږ وګرځاوه د ښكتو ډېر ښكته","a":"and thereafter We reduce him to the lowest of low"},{"n":6,"g":6104,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","e":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","j":30,"p":597,"r":537,"h":239,"w":9,"u":"مگر جو لوگ ایمان لائے اور نیک عمل کرتے رہے انکے لیے بےانتہا اجر ہے","s":"مګر هغه كسان چې ایمان يې راوړى دى او نېك عملونه يې كړې دي، نو د دوى لپاره نه ختمېدونكى اجر دى","a":"excepting only such as attain to faith and do good works: and theirs shall be a reward unending!"},{"n":7,"g":6105,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","e":"So what yet causes you to deny the Recompense?","j":30,"p":597,"r":537,"h":239,"w":4,"u":"تو (اے آدم زاد) پھر تو جزا کے دن کو کیوں جھٹلاتا ہے؟","s":"نو (اى د قیامت منكره!) له دې نه وروسته تا څه شى د قیامت په هكله دروغ ګڼلو ته اماده كوي؟","a":"What, then, [O man,] could henceforth cause thee to give the lie to this moral law?"},{"n":8,"g":6106,"t":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","e":"Is not Allah the most just of judges?","j":30,"p":597,"r":537,"h":239,"w":4,"u":"کیا خدا سب سے بڑا حاکم نہیں ہے؟","s":"ایا الله تر ټولو لوى حاكم نه دى؟","a":"Is not God the most just of judges?"}]},{"number":96,"name":"سُورَةُ العَلَقِ","en":"Al-Alaq","tr":"The Clot","rev":"Meccan","ayahs":[{"n":1,"g":6107,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","e":"Recite in the name of your Lord who created -","j":30,"p":597,"r":538,"h":239,"w":9,"u":"(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا","s":"ته د خپل هغه رب په نامه سره ولوله چې پیدا كړي يې دي (ټول مخلوقات)","a":"READ in the name of thy Sustainer, who has-"},{"n":2,"g":6108,"t":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","e":"Created man from a clinging substance.","j":30,"p":597,"r":538,"h":239,"w":4,"u":"جس نے انسان کو خون کی پھٹکی سے بنایا","s":"ده انسان له پرنې (ټوټې) وینې نه پیدا كړى دى","a":"created man out of a germ-cell"},{"n":3,"g":6109,"t":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","e":"Recite, and your Lord is the most Generous -","j":30,"p":597,"r":538,"h":239,"w":3,"u":"پڑھو اور تمہارا پروردگار بڑا کریم ہے","s":"ته ولوله، په داسې حال كې چې ستا رب تر ټولو لوى كریم دى","a":"Read - for thy Sustainer is the Most Bountiful One"},{"n":4,"g":6110,"t":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","e":"Who taught by the pen -","j":30,"p":597,"r":538,"h":239,"w":3,"u":"جس نے قلم کے ذریعے سے علم سکھایا","s":"هغه چې په قلم سره يې ښوونه كړې ده","a":"who has taught [man] the use of the pen –"},{"n":5,"g":6111,"t":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","e":"Taught man that which he knew not.","j":30,"p":597,"r":538,"h":239,"w":5,"u":"اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا","s":"انسان ته يې هغه څه ښودلي دي چې دى پرې نه پوهېده","a":"taught man what he did not know!"},{"n":6,"g":6112,"t":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","e":"No! [But] indeed, man transgresses","j":30,"p":597,"r":538,"h":239,"w":4,"u":"مگر انسان سرکش ہو جاتا ہے","s":"حقه دا خبره ده چې یقینًا انسان خامخا سركشي كوي","a":"Nay, verily, man becomes grossly overweening"},{"n":7,"g":6113,"t":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","e":"Because he sees himself self-sufficient.","j":30,"p":597,"r":538,"h":239,"w":3,"u":"جب کہ اپنے تیئں غنی دیکھتا ہے","s":"په دې وجه چې دى خپل ځان ویني چې دى بې پروا (بې حاجته) شو","a":"whenever he believes himself to be self-sufficient:"},{"n":8,"g":6114,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","e":"Indeed, to your Lord is the return.","j":30,"p":597,"r":538,"h":239,"w":4,"u":"کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے","s":"بېشكه خاص ستا رب ته بېرته ورتلل دي","a":"for, behold, unto thy Sustainer all must return."},{"n":9,"g":6115,"t":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","e":"Have you seen the one who forbids","j":30,"p":597,"r":538,"h":239,"w":3,"u":"بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے","s":"ته ما ته خبر راكړه د هغه كس چې منع كوي","a":"HAST THOU ever considered him who tries to prevent"},{"n":10,"g":6116,"t":"عَبْدًا إِذَا صَلَّىٰٓ","e":"A servant when he prays?","j":30,"p":597,"r":538,"h":239,"w":3,"u":"(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے","s":"بنده (محمدﷺ) لره كله چې دى لمونځ كوي","a":"a servant [of God] from praying?"},{"n":11,"g":6117,"t":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","e":"Have you seen if he is upon guidance","j":30,"p":597,"r":538,"h":239,"w":5,"u":"بھلا دیکھو تو اگر یہ راہِ راست پر ہو","s":"ته ما ته خبر راكړه كه چېرې دغه (بنده) په هدایت وي","a":"Hast thou considered whether he is on the right way,"},{"n":12,"g":6118,"t":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","e":"Or enjoins righteousness?","j":30,"p":597,"r":538,"h":239,"w":3,"u":"یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)","s":"یا په تقوٰی (پرهېزګارۍ) سره حكم كوي","a":"or is concerned with God-consciousness?"},{"n":13,"g":6119,"t":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","e":"Have you seen if he denies and turns away -","j":30,"p":597,"r":538,"h":239,"w":4,"u":"اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)","s":"ته ما ته خبر راكړه كه دغه (منع كوونكى) تكذیب كوي او (له حق نه) مخ اړوي","a":"Hast thou considered whether he may [not] be giving the lie to the truth and turning his back [upon it]?"},{"n":14,"g":6120,"t":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","e":"Does he not know that Allah sees?","j":30,"p":597,"r":538,"h":239,"w":5,"u":"کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے","s":"ایا دى نه پوهېږي چې بېشكه الله ویني؟","a":"Does he, then, not know that God sees [all]?"},{"n":15,"g":6121,"t":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","e":"No! If he does not desist, We will surely drag him by the forelock -","j":30,"p":597,"r":538,"h":239,"w":6,"u":"دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے","s":"داسې نه ده! قسم دى كه دى منع نشو، (نو) مونږ به (دى) خامخا ضرور ډېر سخت راكاږو د تندي (وچولي) په وېښتانو سره","a":"Nay, if he desist not, We shall most surely drag him down upon his forehead"},{"n":16,"g":6122,"t":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","e":"A lying, sinning forelock.","j":30,"p":597,"r":538,"h":239,"w":3,"u":"یعنی اس جھوٹے خطاکار کی پیشانی کے بال","s":"داسې تندى چې دروغجن (او) خطا كار دى","a":"the lying, rebellious forehead! –"},{"n":17,"g":6123,"t":"فَلْيَدْعُ نَادِيَهُۥ","e":"Then let him call his associates;","j":30,"p":597,"r":538,"h":239,"w":2,"u":"تو وہ اپنے یاروں کی مجلس کو بلالے","s":"نو دى دې خپل مجلس والا راوبلي","a":"and then let him summon [to his aid] the counsels of his own [spurious] wisdom,"},{"n":18,"g":6124,"t":"سَنَدْعُ ٱلزَّبَانِيَةَ","e":"We will call the angels of Hell.","j":30,"p":597,"r":538,"h":239,"w":2,"u":"ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے","s":"ژر ده چې مونږ به ډېر سخت تند خویه ملايك راوبلو","a":"[the while] We shall summon the forces of heavenly chastisement!"},{"n":19,"g":6125,"t":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","e":"No! Do not obey him. But prostrate and draw near [to Allah].","j":30,"p":597,"r":538,"h":239,"w":6,"u":"دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا","s":"داسې نه ده ته د ده خبره مه منه، او (الله ته) سجده كوه او (الله ته) ښه نژدې شه","a":"Nay, pay thou no heed to him, but prostrate thyself [before God] and draw close [unto Him]!"}]},{"number":97,"name":"سُورَةُ القَدۡرِ","en":"Al-Qadr","tr":"The Power, Fate","rev":"Meccan","ayahs":[{"n":1,"g":6126,"t":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","e":"Indeed, We sent the Qur'an down during the Night of Decree.","j":30,"p":598,"r":539,"h":239,"w":9,"u":"ہم نے اس (قرآن) کو شب قدر میں نازل (کرنا شروع) کیا","s":"بېشكه مونږ دا (قرآن) د قدر په شپه كې نازل كړى دى","a":"BEHOLD, from on high have We bestowed this [divine writ] on Night of Destiny."},{"n":2,"g":6127,"t":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","e":"And what can make you know what is the Night of Decree?","j":30,"p":598,"r":539,"h":239,"w":5,"u":"اور تمہیں کیا معلوم کہ شب قدر کیا ہے؟","s":"او ته څه شي پوه كړې چې د قدر شپه څه شى دى؟","a":"And what could make thee conceive what it is, that Night of Destiny?"},{"n":3,"g":6128,"t":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ","e":"The Night of Decree is better than a thousand months.","j":30,"p":598,"r":539,"h":239,"w":6,"u":"شب قدر ہزار مہینے سے بہتر ہے","s":"د قدر شپه له زرو میاشتو نه غوره ده","a":"The Night of Destiny is better than a thousand months:"},{"n":4,"g":6129,"t":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ","e":"The angels and the Spirit descend therein by permission of their Lord for every matter.","j":30,"p":598,"r":539,"h":239,"w":9,"u":"اس میں روح (الامین) اور فرشتے ہر کام کے (انتظام کے) لیے اپنے پروردگار کے حکم سے اترتے ہیں","s":"په دغه (شپه) كې (نور) ملايك او روح (جبریل) د خپل رب په حكم سره نازلېږي لپاره (د پوره كولو) د هر (مقرر شوي) كار","a":"in hosts descend in it the angels, bearing divine inspiration by their Sustainer's leave; from all [evil] that may happen"},{"n":5,"g":6130,"t":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","e":"Peace it is until the emergence of dawn.","j":30,"p":598,"r":539,"h":239,"w":5,"u":"یہ (رات) طلوع صبح تک (امان اور) سلامتی ہے","s":"(دغه شپه) سلامتیا ده، دغه (شپه) تر سبا ختلو پورې ده","a":"does it make secure, until the rise of dawn."}]},{"number":98,"name":"سُورَةُ البَيِّنَةِ","en":"Al-Bayyina","tr":"The Evidence","rev":"Medinan","ayahs":[{"n":1,"g":6131,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ","e":"Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence -","j":30,"p":598,"r":540,"h":239,"w":16,"u":"جو لوگ کافر ہیں (یعنی) اہل کتاب اور مشرک وہ (کفر سے) باز رہنے والے نہ تھے جب تک ان کے پاس کھلی دلیل (نہ) آتی","s":"هغه كسان چې كافران شوي دي، چې كتابیان او مشركان دي، جدا كېدونكي نه وو تر دې چې دوى ته ښكاره دلیل راشي","a":"IT IS NOT [conceivable] that such as are bent on denying the truth - [be they] from among the followers of earlier revelation or from among those who ascribe divinity to aught beside God should ever be abandoned [by Him] ere there comes unto them the [full] evidence of the truth:"},{"n":2,"g":6132,"t":"رَسُولٌۭ مِّنَ ٱللَّهِ يَتْلُوا۟ صُحُفًۭا مُّطَهَّرَةًۭ","e":"A Messenger from Allah, reciting purified scriptures","j":30,"p":598,"r":540,"h":239,"w":6,"u":"(یعنی) خدا کے پیغمبر جو پاک اوراق پڑھتے ہیں","s":"چې د الله له جانبه رسول دى، چې (دوى ته) ډېرې پاكې صحیفې لولي","a":"an apostle from God, conveying [unto them] revelations blest with purity,"},{"n":3,"g":6133,"t":"فِيهَا كُتُبٌۭ قَيِّمَةٌۭ","e":"Within which are correct writings.","j":30,"p":598,"r":540,"h":239,"w":3,"u":"جن میں (مستحکم) آیتیں لکھی ہوئی ہیں","s":"په دغو (صحیفو) كې ډېر سم (او درست) حكمونه (او فریضې) دي","a":"wherein there are ordinances of ever-true soundness and clarity."},{"n":4,"g":6134,"t":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ","e":"Nor did those who were given the Scripture become divided until after there had come to them clear evidence.","j":30,"p":598,"r":540,"h":239,"w":11,"u":"اور اہل کتاب جو متفرق (و مختلف) ہوئے ہیں تو دلیل واضح آنے کے بعد (ہوئے ہیں)","s":"او اهل كتاب په خپل مینځ كې سره جدا (او مختلف) شوي نه وو مګر وروسته له دې چې دوى ته ښكاره دلیل راغى","a":"Now those who have been vouchsafed revelation aforetime did break up their unity [of faith] after such an evidence of the truth had come to them."},{"n":5,"g":6135,"t":"وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ","e":"And they were not commanded except to worship Allah, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakah. And that is the correct religion.","j":30,"p":598,"r":540,"h":239,"w":17,"u":"اور ان کو حکم تو یہی ہوا تھا کہ اخلاص عمل کے ساتھ خدا کی عبادت کریں (اور) یکسو ہو کراورنماز پڑھیں اور زکوٰة دیں اور یہی سچا دین ہے","s":"حال دا چې دوى ته حكم نه و وركړى شوى مګر په دې چې دوى دې د الله عبادت كوي، په داسې حال كې چې دین (عبادت) دغه (الله) لره خالص كوونكي وي (او) حنیفان (له باطله حق ته راګرځېدونكي) وي، او (د دې چې) دوى دې لمونځ قايموي او زكاۃت دې وركوي اوهم دغه ډېر محكم دین دى","a":"And withal, they were not enjoined aught but that they should worship God, sincere in their faith in Him alone, turning away from all that is false; and that they should be constant in prayer; and that they should spend in charity: for this is a moral law endowed with ever-true soundness and clarity."},{"n":6,"g":6136,"t":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآ ۚ أُو۟لَٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ","e":"Indeed, they who disbelieved among the People of the Scripture and the polytheists will be in the fire of Hell, abiding eternally therein. Those are the worst of creatures.","j":30,"p":598,"r":540,"h":239,"w":17,"u":"جو لوگ کافر ہیں (یعنی) اہل کتاب اور مشرک وہ دوزخ کی آگ میں پڑیں گے (اور) ہمیشہ اس میں رہیں گے۔ یہ لوگ سب مخلوق سے بدتر ہیں","s":"بېشكه هغه كسان چې كافران شوي دي، چې اهل كتاب او مشركان دي، (دوى به) د دوزخ په اور كې وي، چې په ده كې به تل ترتله وي. هم دغه كسان د خلقو بدترین دي","a":"Verily, those who [despite all evidence] are bent on denying the truth - [be they] from among the followers of earlier revelation or from among those who ascribe divinity to aught beside God - will find themselves in the fire of hell, therein to abide: they are the worst of all creatures."},{"n":7,"g":6137,"t":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ أُو۟لَٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ","e":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","j":30,"p":598,"r":540,"h":239,"w":9,"u":"(اور) جو لوگ ایمان لائے اور نیک عمل کرتے رہے وہ تمام خلقت سے بہتر ہیں","s":"بېشكه هغه كسان چې ایمان يې راوړى دى او نېك عملونه يې كړي دي همدغه كسان د خلقو بهترین دي","a":"[And,] verily, those who have attained to faith, and do righteous deeds - it is they, they who are the best of all creatures."},{"n":8,"g":6138,"t":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنٍۢ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًۭا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ","e":"Their reward with Allah will be gardens of perpetual residence beneath which rivers flow, wherein they will abide forever, Allah being pleased with them and they with Him. That is for whoever has feared his Lord.","j":30,"p":599,"r":540,"h":239,"w":23,"u":"ان کا صلہ ان کے پروردگار کے ہاں ہمیشہ رہنے کے باغ ہیں جن کے نیچے نہریں بہہ رہی ہیں ابدالاباد ان میں رہیں گے۔ خدا ان سے خوش اور وہ اس سے خوش۔ یہ (صلہ) اس کے لیے ہے جو اپنے پروردگار سے ڈرتا رہا","s":"د خپل رب په نیز د دوى بدله د تل اوسېدنې جنتونه دي چې د هغو له لاندې ولې بهېږي، چې دوى به په دغو كې تل ترتله همېشه وي، الله له دوى نه راضي شوى دى او دوى له هغه نه راضي شوي دي، دغه (وعده) د هغه چا لپاره ده چې له خپل رب نه وېرېږي","a":"Their reward [awaits them] with God: gardens of perpetual bliss, through which running waters flow, therein to abide beyond the count of time; well-pleased is God with them, and well-pleased are they with Him: all this awaits him who of his Sustainer stands in awe!."}]},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","en":"Az-Zalzala","tr":"The Earthquake","rev":"Medinan","ayahs":[{"n":1,"g":6139,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","e":"When the earth is shaken with its [final] earthquake","j":30,"p":599,"r":541,"h":239,"w":8,"u":"جب زمین بھونچال سے ہلا دی جائے گی","s":"كله چې ځمكه وخوزلى شي په خپلو سختو خوزولو سره","a":"WHEN THE EARTH quakes with her [last] mighty quaking,"},{"n":2,"g":6140,"t":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","e":"And the earth discharges its burdens","j":30,"p":599,"r":541,"h":239,"w":3,"u":"اور زمین اپنے (اندر) کے بوجھ نکال ڈالے گی","s":"او ځمكه خپل درانه بارونه بهر ته راوباسي","a":"and [when] the earth yields up her burdens,"},{"n":3,"g":6141,"t":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","e":"And man says, \"What is [wrong] with it?\" -","j":30,"p":599,"r":541,"h":239,"w":4,"u":"اور انسان کہے گا کہ اس کو کیا ہوا ہے؟","s":"او انسان به ووايي چې په دې څه شوي دي","a":"and man cries out, \"What has happened to her?\" -"},{"n":4,"g":6142,"t":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","e":"That Day, it will report its news","j":30,"p":599,"r":541,"h":239,"w":3,"u":"اس روز وہ اپنے حالات بیان کردے گی","s":"په دغې ورځې كې به دا ځمكه خپلې خبرې (حالات) بیانوي","a":"on that Day will she recount all her tidings,"},{"n":5,"g":6143,"t":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","e":"Because your Lord has commanded it.","j":30,"p":599,"r":541,"h":239,"w":4,"u":"کیونکہ تمہارے پروردگار نے اس کو حکم بھیجا (ہوگا)","s":"په دې سبب چې ستا رب به دې ته وحي وكړي","a":"as thy Sustainer will have inspired her to do!"},{"n":6,"g":6144,"t":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","e":"That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.","j":30,"p":599,"r":541,"h":239,"w":6,"u":"اس دن لوگ گروہ گروہ ہو کر آئیں گے تاکہ ان کو ان کے اعمال دکھا دیئے جائیں","s":"په دغې ورځ كې به خلق بېرته راګرځي، په داسې حال كې چې بېل بېل (او مختلف) به وي، د دې لپاره چې دوى ته خپل عملونه وښودل شي","a":"On that Day will all men come forward, cut off from one another, to be shown their [past] deeds."},{"n":7,"g":6145,"t":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","e":"So whoever does an atom's weight of good will see it,","j":30,"p":599,"r":541,"h":239,"w":6,"u":"تو جس نے ذرہ بھر نیکی کی ہو گی وہ اس کو دیکھ لے گا","s":"نو هغه څوك چې د یوې ذرې په اندازه نېك عمل وكړي (، نو) دى به هغه وویني","a":"And so, he who shall have done an atom's weight of good, shall behold it;"},{"n":8,"g":6146,"t":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","e":"And whoever does an atom's weight of evil will see it.","j":30,"p":599,"r":541,"h":239,"w":6,"u":"اور جس نے ذرہ بھر برائی کی ہوگی وہ اسے دیکھ لے گا","s":"او هغه څوك چې د یوې ذرې په اندازه د شر (او بدۍ) عمل كوي (، نو) دى به هغه وویني","a":"and he who shall have done an atom's weight of evil, shall behold it."}]},{"number":100,"name":"سُورَةُ العَادِيَاتِ","en":"Al-Aadiyaat","tr":"The Chargers","rev":"Meccan","ayahs":[{"n":1,"g":6147,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","e":"By the racers, panting,","j":30,"p":599,"r":542,"h":239,"w":6,"u":"ان سرپٹ دوڑنے والے گھوڑوں کی قسم جو ہانپ اٹھتےہیں","s":"قسم دى په تېزو ځغلېدونكو اسونو، چې له سینو او ګېډو نه اواز ایستونكي دي","a":"Oh, the chargers that run panting,"},{"n":2,"g":6148,"t":"فَٱلْمُورِيَٰتِ قَدْحًۭا","e":"And the producers of sparks [when] striking","j":30,"p":599,"r":542,"h":239,"w":2,"u":"پھر (پتھروں پر نعل) مار کر آگ نکالتے ہیں","s":"پس (قسم دى) په هغو اسونو چې په خپلو سُمانو سره تیږې وهي او اور را ایستونكي دي","a":"sparks of fire striking,"},{"n":3,"g":6149,"t":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","e":"And the chargers at dawn,","j":30,"p":599,"r":542,"h":239,"w":2,"u":"پھر صبح کو چھاپہ مارتے ہیں","s":"پس (قسم دى) په هغو اسونو چې د سبا په وخت كې لوټمار كوونكي دي","a":"rushing to assault at morn,"},{"n":4,"g":6150,"t":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","e":"Stirring up thereby [clouds of] dust,","j":30,"p":599,"r":542,"h":239,"w":3,"u":"پھر اس میں گرد اٹھاتے ہیں","s":"نو په دغه وخت كې دغه (اسونه) ګرد پورته كوي","a":"thereby raising clouds of dust,"},{"n":5,"g":6151,"t":"فَوَسَطْنَ بِهِۦ جَمْعًا","e":"Arriving thereby in the center collectively,","j":30,"p":599,"r":542,"h":239,"w":3,"u":"پھر اس وقت دشمن کی فوج میں جا گھستے ہیں","s":"پس په دغه وخت كې د لويې ډلې په مینځ كې ننوځي","a":"thereby storming [blindly] into any host!"},{"n":6,"g":6152,"t":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","e":"Indeed mankind, to his Lord, is ungrateful.","j":30,"p":599,"r":542,"h":239,"w":4,"u":"کہ انسان اپنے پروردگار کا احسان ناشناس (اور ناشکرا) ہے","s":"چې بېشكه انسان د خپل رب ډېر ناشكره دى","a":"VERILY, towards his Sustainer man is most ungrateful"},{"n":7,"g":6153,"t":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","e":"And indeed, he is to that a witness.","j":30,"p":599,"r":542,"h":239,"w":4,"u":"اور وہ اس سے آگاہ بھی ہے","s":"او بېشكه دى په دې خبره یقینًا ښه خبردار (او ګواه) دى","a":"and to this, behold, he [himself] bears witness indeed:"},{"n":8,"g":6154,"t":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","e":"And indeed he is, in love of wealth, intense.","j":30,"p":599,"r":542,"h":239,"w":4,"u":"وہ تو مال سے سخت محبت کرنے والا ہے","s":"او بېشكه دى د مال په مینه كې یقینًا ډېر سخت دى","a":"for, verily, to the love of wealth is he most ardently devoted."},{"n":9,"g":6155,"t":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","e":"But does he not know that when the contents of the graves are scattered","j":30,"p":599,"r":542,"h":240,"w":8,"u":"کیا وہ اس وقت کو نہیں جانتا کہ جو (مردے) قبروں میں ہیں وہ باہر نکال لیے جائیں گے","s":"ایا نو دى نه پوهېږي كله چې هغه (مړي) راوښكل شي چې په قبرونو كې دي؟","a":"But does he not know that [on the Last Day,] when all that is in the graves is raised and brought out,"},{"n":10,"g":6156,"t":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","e":"And that within the breasts is obtained,","j":30,"p":600,"r":542,"h":240,"w":4,"u":"اور جو (بھید) دلوں میں ہیں وہ ظاہر کر دیئے جائیں گے","s":"او هغه څه راښكاره كړى شي چې په سینو كې دي","a":"and all that is [hidden] in men's hearts is bared"},{"n":11,"g":6157,"t":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","e":"Indeed, their Lord with them, that Day, is [fully] Acquainted.","j":30,"p":600,"r":542,"h":240,"w":5,"u":"بےشک ان کا پروردگار اس روز ان سے خوب واقف ہوگا","s":"بېشكه د دوى رب په دغې ورځ كې په دوى باندې یقینًا ښه خبردار دى۔","a":"that on that Day their Sustainer [will show that He] has always been fully aware of them?"}]},{"number":101,"name":"سُورَةُ القَارِعَةِ","en":"Al-Qaari'a","tr":"The Calamity","rev":"Meccan","ayahs":[{"n":1,"g":6158,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","e":"The Striking Calamity -","j":30,"p":600,"r":543,"h":240,"w":5,"u":"کھڑ کھڑانے والی","s":"(د زړونو) ټكوونكى (قیامت)","a":"OH, the sudden calamity!"},{"n":2,"g":6159,"t":"مَا ٱلْقَارِعَةُ","e":"What is the Striking Calamity?","j":30,"p":600,"r":543,"h":240,"w":2,"u":"کھڑ کھڑانے والی کیا ہے؟","s":"(د زړونو) ټكوونكى څه شى دى؟","a":"How awesome the sudden calamity!"},{"n":3,"g":6160,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","e":"And what can make you know what is the Striking Calamity?","j":30,"p":600,"r":543,"h":240,"w":4,"u":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟","s":"او ته څه شي پوه كړې چې (د زړونو) ټكوونكى څه شى دى؟","a":"And what could make thee conceive what that sudden calamity will be?"},{"n":4,"g":6161,"t":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","e":"It is the Day when people will be like moths, dispersed,","j":30,"p":600,"r":543,"h":240,"w":5,"u":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے","s":"(دى به زړونه ټكوي) په هغې ورځ كې چې خلق به د خواره كړى شویو پتنګانو په شان شي","a":"[It will occur] on the Day when men will be like moths swarming in confusion,"},{"n":5,"g":6162,"t":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","e":"And the mountains will be like wool, fluffed up.","j":30,"p":600,"r":543,"h":240,"w":4,"u":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون","s":"او غرونه به د ډانډس كړى شوې رنګینې وړۍ په شان شي","a":"and the mountains will be like fluffy tufts of wool...."},{"n":6,"g":6163,"t":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","e":"Then as for one whose scales are heavy [with good deeds],","j":30,"p":600,"r":543,"h":240,"w":4,"u":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے","s":"نو هر چې هغه څوك دى چې د هغه تلې درنې شوې","a":"And then, he whose weight [of good deeds] is heavy in the balance"},{"n":7,"g":6164,"t":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","e":"He will be in a pleasant life.","j":30,"p":600,"r":543,"h":240,"w":4,"u":"وہ دل پسند عیش میں ہو گا","s":"نو دى به په ډېر ښه ژوندون كې وي","a":"shall find himself in a happy' state of life;"},{"n":8,"g":6165,"t":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","e":"But as for one whose scales are light,","j":30,"p":600,"r":543,"h":240,"w":4,"u":"اور جس کے وزن ہلکے نکلیں گے","s":"او پاتې شو هغه كس چې د هغه تلې سپكې شوې","a":"whereas he whose weight is light in the balance"},{"n":9,"g":6166,"t":"فَأُمُّهُۥ هَاوِيَةٌۭ","e":"His refuge will be an abyss.","j":30,"p":600,"r":543,"h":240,"w":2,"u":"اس کا مرجع ہاویہ ہے","s":"نو د ده استوګنځى هاویه ده","a":"shall be engulfed by an abyss."},{"n":10,"g":6167,"t":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","e":"And what can make you know what that is?","j":30,"p":600,"r":543,"h":240,"w":4,"u":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟","s":"او ته څه شي پوه كړې چې دغه (هاویه) څه شى دى؟","a":"And what could make thee conceive what that [abyss] will be?"},{"n":11,"g":6168,"t":"نَارٌ حَامِيَةٌۢ","e":"It is a Fire, intensely hot.","j":30,"p":600,"r":543,"h":240,"w":2,"u":"دہکتی ہوئی آگ ہے","s":"(دغه) ډېر ګرم اور دى","a":"A fire hotly burning!"}]},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","en":"At-Takaathur","tr":"Competition","rev":"Meccan","ayahs":[{"n":1,"g":6169,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","e":"Competition in [worldly] increase diverts you","j":30,"p":600,"r":544,"h":240,"w":6,"u":"(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا","s":"تاسو غافله كړئ فخر كولو په یو بل باندې په ډېروالي (د مال، اولاد او قام) سره","a":"YOU ARE OBSESSED by greed for more and more"},{"n":2,"g":6170,"t":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","e":"Until you visit the graveyards.","j":30,"p":600,"r":544,"h":240,"w":3,"u":"یہاں تک کہ تم نے قبریں جا دیکھیں","s":"تر هغه پورې چې تاسو هدېرو ته ورشئ","a":"until you go down to your graves."},{"n":3,"g":6171,"t":"كَلَّا سَوْفَ تَعْلَمُونَ","e":"No! You are going to know.","j":30,"p":600,"r":544,"h":240,"w":3,"u":"دیکھو تمہیں عنقریب معلوم ہو جائے گا","s":"داسې نه ده په كار، ژر ده چې تاسو به پوه شئ","a":"Nay, in time you will come to understand!"},{"n":4,"g":6172,"t":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","e":"Then no! You are going to know.","j":30,"p":600,"r":544,"h":240,"w":4,"u":"پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا","s":"بیا بېخي داسې نه ده، ژر ده چې تاسو به پوه شئ","a":"And once again: Nay, in time you will come to understand!"},{"n":5,"g":6173,"t":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","e":"No! If you only knew with knowledge of certainty...","j":30,"p":600,"r":544,"h":240,"w":5,"u":"دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)","s":"داسې نه ده كه تاسو په علم اليقين سره پوهېدلى","a":"Nay, if you could but understand [it] with an understanding [born] of certainty,"},{"n":6,"g":6174,"t":"لَتَرَوُنَّ ٱلْجَحِيمَ","e":"You will surely see the Hellfire.","j":30,"p":600,"r":544,"h":240,"w":2,"u":"تم ضرور دوزخ کو دیکھو گے","s":"تاسو به خامخا ضرور دوزخ وینئ","a":"you would indeed, most surely, behold the blazing fire [of hell]!"},{"n":7,"g":6175,"t":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","e":"Then you will surely see it with the eye of certainty.","j":30,"p":600,"r":544,"h":240,"w":4,"u":"پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)","s":"بیا به تاسو خامخا ضرور دغه (دوزخ) د یقین په سترګو وینئ","a":"In the end you will indeed, most surely, behold it with the eye of certainty:"},{"n":8,"g":6176,"t":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","e":"Then you will surely be asked that Day about pleasure.","j":30,"p":600,"r":544,"h":240,"w":5,"u":"پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی","s":"بیا به په دغې ورځ كې له تاسو نه خامخا ضرور د نعمتونو په باره كې تپوس كېږي","a":"and on that Day you will most surely be called to account for [what you did with] the boon of life!"}]},{"number":103,"name":"سُورَةُ العَصۡرِ","en":"Al-Asr","tr":"The Declining Day, Epoch","rev":"Meccan","ayahs":[{"n":1,"g":6177,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ","e":"By time,","j":30,"p":601,"r":545,"h":240,"w":5,"u":"عصر کی قسم","s":"قسم دى په عصر (مازیګر، یا زمانه)","a":"CONSIDER the flight of time!"},{"n":2,"g":6178,"t":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","e":"Indeed, mankind is in loss,","j":30,"p":601,"r":545,"h":240,"w":4,"u":"کہ انسان نقصان میں ہے","s":"چې بېشكه یقینًا انسان په زیان (او تاوان) كې دى","a":"Verily, man is bound to lose himself"},{"n":3,"g":6179,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","e":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","j":30,"p":601,"r":545,"h":240,"w":9,"u":"مگر وہ لوگ جو ایمان لائے اور نیک عمل کرتے رہے اور آپس میں حق (بات) کی تلقین اور صبر کی تاکید کرتے رہے","s":"غیر له هغو كسانو نه چې ایمان يې راوړى دى او نېك عملونه يې كړې دي او یو بل ته يې د حق (دین) وصیت كړى دى، او یو بل ته يې د صبر وصیت كړى دى","a":"unless he be of those who attain to faith, and do good works, and enjoin upon one another the keeping to truth, and enjoin upon one another patience in adversity."}]},{"number":104,"name":"سُورَةُ الهُمَزَةِ","en":"Al-Humaza","tr":"The Traducer","rev":"Meccan","ayahs":[{"n":1,"g":6180,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","e":"Woe to every scorner and mocker","j":30,"p":601,"r":546,"h":240,"w":8,"u":"ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے","s":"هلاكت دى د هر ډېر غیبت كوونكي، ډېر عیبت لګوونكي لپاره","a":"WOE unto every slanderer, fault-finder!"},{"n":2,"g":6181,"t":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","e":"Who collects wealth and [continuously] counts it.","j":30,"p":601,"r":546,"h":240,"w":4,"u":"جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے","s":"هغه چې مال يې جمع كړى دى او دغه يې بیا بیا شمېرلى (او ذخیره كړى) دى","a":"[Woe unto him who amasses wealth and counts it a safeguard,"},{"n":3,"g":6182,"t":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","e":"He thinks that his wealth will make him immortal.","j":30,"p":601,"r":546,"h":240,"w":4,"u":"(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا","s":"دى خیال كوي چې بېشكه د ده مال به دى تل ژوندى وساتي؟","a":"thinking that his wealth will make him live forever!"},{"n":4,"g":6183,"t":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","e":"No! He will surely be thrown into the Crusher.","j":30,"p":601,"r":546,"h":240,"w":5,"u":"ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا","s":"داسې هیڅكله نشي كېدى، دى به خامخا ضرور په حطمه (ماتوونكي او سوځوونكي دوزخ) كې وغورځول شي","a":"Nay, but [in the life to come such as] he shall indeed be abandoned to crushing torment!"},{"n":5,"g":6184,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","e":"And what can make you know what is the Crusher?","j":30,"p":601,"r":546,"h":240,"w":4,"u":"اور تم کیا سمجھے حطمہ کیا ہے؟","s":"او ته څه شي پوه كړې چې حطمه څه شى دى؟","a":"And what could make thee conceive what that crushing torment will be?"},{"n":6,"g":6185,"t":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","e":"It is the fire of Allah, [eternally] fueled,","j":30,"p":601,"r":546,"h":240,"w":3,"u":"وہ خدا کی بھڑکائی ہوئی آگ ہے","s":"د الله هغه بل كړى شوى اور دى","a":"A fire kindled by God,"},{"n":7,"g":6186,"t":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","e":"Which mounts directed at the hearts.","j":30,"p":601,"r":546,"h":240,"w":4,"u":"جو دلوں پر جا لپٹے گی","s":"هغه چې په زړونو راخېژي (او غالب كېږي)","a":"which will rise over the [guilty] hearts:"},{"n":8,"g":6187,"t":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","e":"Indeed, Hellfire will be closed down upon them","j":30,"p":601,"r":546,"h":240,"w":3,"u":"(اور) وہ اس میں بند کر دیئے جائیں گے","s":"بېشكه دغه (اور) به په دوى باندې (له هره جانبه) رابند كړى شوى وي","a":"verily, it will close in upon them"},{"n":9,"g":6188,"t":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","e":"In extended columns.","j":30,"p":601,"r":546,"h":240,"w":3,"u":"(یعنی آگ کے) لمبے لمبے ستونوں میں","s":"په اوږدو (راښكلى شویو) ستنو كې","a":"in endless columns!"}]},{"number":105,"name":"سُورَةُ الفِيلِ","en":"Al-Fil","tr":"The Elephant","rev":"Meccan","ayahs":[{"n":1,"g":6189,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","e":"Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant?","j":30,"p":601,"r":547,"h":240,"w":11,"u":"کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے ہاتھی والوں کے ساتھ کیا کیا","s":"ایا ته نه يې خبر شوى چې ستا رب له فیل والاو سره څنګه كار كړى و؟","a":"ART THOU NOT aware of how thy Sustainer dealt with the Army of the Elephant?"},{"n":2,"g":6190,"t":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","e":"Did He not make their plan into misguidance?","j":30,"p":601,"r":547,"h":240,"w":5,"u":"کیا ان کا داؤں غلط نہیں کیا؟ (گیا)","s":"ایا د هغوى چل (او مكر) يې په ګمراهۍ او زیان كې نه و ګرځولى؟","a":"Did He not utterly confound their artful planning?"},{"n":3,"g":6191,"t":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","e":"And He sent against them birds in flocks,","j":30,"p":601,"r":547,"h":240,"w":4,"u":"اور ان پر جھلڑ کے جھلڑ جانور بھیجے","s":"او په دوى باندې يې ډلې ډلې مرغان راخوشې كړل","a":"Thus, He let loose upon them great swarms of flying creatures"},{"n":4,"g":6192,"t":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","e":"Striking them with stones of hard clay,","j":30,"p":601,"r":547,"h":240,"w":4,"u":"جو ان پر کھنگر کی پتھریاں پھینکتے تھے","s":"چې دغو (مرغانو) به دوى لره په داسې كاڼو ویشتل چې له خټو نه جوړ، په اور پخ شوي وو","a":"which smote them with stone-hard blows of chastisement pre-ordained,"},{"n":5,"g":6193,"t":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","e":"And He made them like eaten straw.","j":30,"p":601,"r":547,"h":240,"w":3,"u":"تو ان کو ایسا کر دیا جیسے کھایا ہوا بھس","s":"نو دغه (خلق) يې د خوړل شویو وښو په شان وګرځول","a":"and caused them to become like a field of grain that has been eaten down to stubble"}]},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","en":"Quraish","tr":"Quraysh","rev":"Meccan","ayahs":[{"n":1,"g":6194,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ","e":"For the accustomed security of the Quraysh -","j":30,"p":602,"r":548,"h":240,"w":6,"u":"قریش کے مانوس کرنے کے سبب","s":"د قریشو له یو بل سره د الفت له وجې نه","a":"SO THAT the Quraysh might remain secure,"},{"n":2,"g":6195,"t":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","e":"Their accustomed security [in] the caravan of winter and summer -","j":30,"p":602,"r":548,"h":240,"w":4,"u":"(یعنی) ان کو جاڑے اور گرمی کے سفر سے مانوس کرنے کے سبب","s":"د ژمي او اوړي په سفر كې د دوى د الفت په وجه","a":"secure in their winter and summer journeys,"},{"n":3,"g":6196,"t":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","e":"Let them worship the Lord of this House,","j":30,"p":602,"r":548,"h":240,"w":4,"u":"لوگوں کو چاہیئے کہ (اس نعمت کے شکر میں) اس گھر کے مالک کی عبادت کریں","s":"نو لازم دي چې دوى د دې كور د رب عبادت وكړي","a":"Let them, therefore, worship the Sustainer of this Temple;"},{"n":4,"g":6197,"t":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ","e":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.","j":30,"p":602,"r":548,"h":240,"w":7,"u":"جس نے ان کو بھوک میں کھانا کھلایا اور خوف سے امن بخشا","s":"هغه (رب) چې دوى ته يې له لوږې نه (د بچ كولو لپاره) طعام وركړى دى او دوى ته يې له وېرې نه (د ساتلو لپاره) امن (او بې خوفي) وركړې ده","a":"who has given them food against hunger, and made them safe from danger."}]},{"number":107,"name":"سُورَةُ المَاعُونِ","en":"Al-Maa'un","tr":"Almsgiving","rev":"Meccan","ayahs":[{"n":1,"g":6198,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","e":"Have you seen the one who denies the Recompense?","j":30,"p":602,"r":549,"h":240,"w":8,"u":"بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟","s":"ایا تا هغه كس لیدلى چې د بدلي ورځ (قیامت) دروغ ګڼي","a":"HAST THOU ever considered [the kind of man] who gives the lie to all moral law?"},{"n":2,"g":6199,"t":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","e":"For that is the one who drives away the orphan","j":30,"p":602,"r":549,"h":240,"w":4,"u":"یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے","s":"نو همدغه هغه كس دى چې یتیم ته دیكې وركوي","a":"Behold, it is this [kind of man] that thrusts the orphan away,"},{"n":3,"g":6200,"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","e":"And does not encourage the feeding of the poor.","j":30,"p":602,"r":549,"h":240,"w":5,"u":"اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا","s":"او مسكین ته په طعام وركولو ترغیب نه وركوي","a":"and feels no urge to feed the needy."},{"n":4,"g":6201,"t":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","e":"So woe to those who pray","j":30,"p":602,"r":549,"h":240,"w":2,"u":"تو ایسے نمازیوں کی خرابی ہے","s":"نو هلاكت دى لمونځ كوونكو لره","a":"Woe, then, unto those praying ones"},{"n":5,"g":6202,"t":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","e":"[But] who are heedless of their prayer -","j":30,"p":602,"r":549,"h":240,"w":5,"u":"جو نماز کی طرف سے غافل رہتے ہیں","s":"هغه كسان چې دوى له خپلو لمونځونو نه غافله (او اعراض كوونكي) وي","a":"whose hearts from their prayer are remote"},{"n":6,"g":6203,"t":"ٱلَّذِينَ هُمْ يُرَآءُونَ","e":"Those who make show [of their deeds]","j":30,"p":602,"r":549,"h":240,"w":3,"u":"جو ریا کاری کرتے ہیں","s":"هغه كسان چې دوى ریاكاري كوي","a":"those who want only to be seen and praised,"},{"n":7,"g":6204,"t":"وَيَمْنَعُونَ ٱلْمَاعُونَ","e":"And withhold [simple] assistance.","j":30,"p":602,"r":549,"h":240,"w":2,"u":"اور برتنے کی چیزیں عاریتہً نہیں دیتے","s":"او دوى ماعون (د استعمال عام څیزونه هم له یو بل نه) منع كوي","a":"and, withal, deny all assistance [to their fellow-men]!"}]},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","en":"Al-Kawthar","tr":"Abundance","rev":"Meccan","ayahs":[{"n":1,"g":6205,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","e":"Indeed, We have granted you, [O Muhammad], al-Kawthar.","j":30,"p":602,"r":550,"h":240,"w":7,"u":"(اے محمدﷺ) ہم نے تم کو کوثر عطا فرمائی ہے","s":"بېشكه مونږ تا ته كوثر دركړى دى","a":"BEHOLD, We have bestowed upon thee good in abundance:"},{"n":2,"g":6206,"t":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","e":"So pray to your Lord and sacrifice [to Him alone].","j":30,"p":602,"r":550,"h":240,"w":3,"u":"تو اپنے پروردگار کے لیے نماز پڑھا کرو اور قربانی دیا کرو","s":"نو ته د خپل رب لپاره لمونځ كوه او قرباني كوه","a":"hence, pray unto thy Sustainer [alone], and sacrifice [unto Him alone]."},{"n":3,"g":6207,"t":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","e":"Indeed, your enemy is the one cut off.","j":30,"p":602,"r":550,"h":240,"w":4,"u":"کچھ شک نہیں کہ تمہارا دشمن ہی بےاولاد رہے گا","s":"بېشكه ستا دښمن هم هغه بې بنیاده (او لاولده) دى","a":"Verily, he that hates thee has indeed been cut off [from all that is good]!"}]},{"number":109,"name":"سُورَةُ الكَافِرُونَ","en":"Al-Kaafiroon","tr":"The Disbelievers","rev":"Meccan","ayahs":[{"n":1,"g":6208,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","e":"Say, \"O disbelievers,","j":30,"p":603,"r":551,"h":240,"w":7,"u":"(اے پیغمبر ان منکران اسلام سے) کہہ دو کہ اے کافرو!","s":"(اى نبي!) ته (دوى ته) ووایه: اى كافرانو!","a":"SAY: \"O you who deny the truth!"},{"n":2,"g":6209,"t":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","e":"I do not worship what you worship.","j":30,"p":603,"r":551,"h":240,"w":4,"u":"جن (بتوں) کو تم پوچتے ہو ان کو میں نہیں پوجتا","s":"زه د هغو (شیانو) عبادت نه كوم چی تاسو يې عبادت كوئ","a":"\"I do not worship that which you worship,"},{"n":3,"g":6210,"t":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","e":"Nor are you worshippers of what I worship.","j":30,"p":603,"r":551,"h":240,"w":5,"u":"اور جس (خدا) کی میں عبادت کرتا ہوں اس کی تم عبادت نہیں کرتے","s":"او نه تاسو د هغه ذات عبادت كوونكي يئ چې زه يې عبادت كوم","a":"and neither do you worship that which I worship!"},{"n":4,"g":6211,"t":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","e":"Nor will I be a worshipper of what you worship.","j":30,"p":603,"r":551,"h":240,"w":5,"u":"اور (میں پھر کہتا ہوں کہ) جن کی تم پرستش کرتے ہوں ان کی میں پرستش کرنے والا نہیں ہوں","s":"او نه زه د هغه شي عبادت كوونكى یم چی تاسو يې عبادت كړى دى","a":"\"And I will not worship ~hat which you have [ever] worshipped,"},{"n":5,"g":6212,"t":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","e":"Nor will you be worshippers of what I worship.","j":30,"p":603,"r":551,"h":240,"w":5,"u":"اور نہ تم اس کی بندگی کرنے والے (معلوم ہوتے) ہو جس کی میں بندگی کرتا ہوں","s":"او نه تاسو عبادت كوونكي یئ د هغه ذات چې زه يې عبادت كوم","a":"and neither will you [ever] worship that which I worship."},{"n":6,"g":6213,"t":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","e":"For you is your religion, and for me is my religion.\"","j":30,"p":603,"r":551,"h":240,"w":4,"u":"تم اپنے دین پر میں اپنے دین پر","s":"تاسو لپاره ستاسو دین دى او زما لپاره زما دین دى","a":"Unto you, your moral law, and unto me, mine!\""}]},{"number":110,"name":"سُورَةُ النَّصۡرِ","en":"An-Nasr","tr":"Divine Support","rev":"Medinan","ayahs":[{"n":1,"g":6214,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","e":"When the victory of Allah has come and the conquest,","j":30,"p":603,"r":552,"h":240,"w":9,"u":"جب خدا کی مدد آ پہنچی اور فتح (حاصل ہو گئی)","s":"كله چې د الله مدد راشي او فتح","a":"WHEN GOD'S SUCCOUR comes, and victory,"},{"n":2,"g":6215,"t":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا","e":"And you see the people entering into the religion of Allah in multitudes,","j":30,"p":603,"r":552,"h":240,"w":7,"u":"اور تم نے دیکھ لیا کہ لوگ غول کے غول خدا کے دین میں داخل ہو رہے ہیں","s":"او ته خلق ووینې چې د الله په دین كې ډلې ډلې داخلېږي","a":"and thou seest people enter God's religion in hosts,"},{"n":3,"g":6216,"t":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","e":"Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.","j":30,"p":603,"r":552,"h":240,"w":8,"u":"تو اپنے پروردگار کی تعریف کے ساتھ تسبیح کرو اور اس سے مغفرت مانگو، بے شک وہ معاف کرنے والا ہے","s":"نو ته پاكي بیانوه د خپل رب له ستاينې سره او له ده نه مغفرت غواړه، بېشكه دى تل ښه توبه قبلوونكى دى","a":"extol thy Sustainer's limitless glory, and praise Him, and seek His forgiveness: for, behold, He is ever an acceptor of repentance."}]},{"number":111,"name":"سُورَةُ المَسَدِ","en":"Al-Masad","tr":"The Palm Fibre","rev":"Meccan","ayahs":[{"n":1,"g":6217,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","e":"May the hands of Abu Lahab be ruined, and ruined is he.","j":30,"p":603,"r":553,"h":240,"w":9,"u":"ابولہب کے ہاتھ ٹوٹیں اور وہ ہلاک ہو","s":"د ابو لهب دواړه لاسونه دې هلاك شي او دى هلاك شو","a":"DOOMED are the hands of him of the glowing countence: and doomed is he!"},{"n":2,"g":6218,"t":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","e":"His wealth will not avail him or that which he gained.","j":30,"p":603,"r":553,"h":240,"w":6,"u":"نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا","s":"د ده هېڅ په كار رانغى د ده مال او (نه) هغه څه چې ده ګټلي وو","a":"What will his wealth avail him, and all that he has gained?"},{"n":3,"g":6219,"t":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","e":"He will [enter to] burn in a Fire of [blazing] flame","j":30,"p":603,"r":553,"h":240,"w":4,"u":"وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا","s":"ژر ده چې دى به لمبې وهونكي اور ته داخل شي","a":"[In the life to come] he shall have to endure a fire fiercely glowing;"},{"n":4,"g":6220,"t":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","e":"And his wife [as well] - the carrier of firewood.","j":30,"p":603,"r":553,"h":240,"w":3,"u":"اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے","s":"او د ده ښځه هم، (زه د دغې) د لرګو اوچتوونكې (مذمت كوم)","a":"together with his wife, that carrier of evil tales,"},{"n":5,"g":6221,"t":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","e":"Around her neck is a rope of [twisted] fiber.","j":30,"p":603,"r":553,"h":240,"w":5,"u":"اس کے گلے میں مونج کی رسّی ہو گی","s":"د دې په غاړه كې د كجورې د پټ مضبوطه رسۍ ده","a":"[who bears] around her neck a rope of twisted strands!"}]},{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","en":"Al-Ikhlaas","tr":"Sincerity","rev":"Meccan","ayahs":[{"n":1,"g":6222,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","e":"Say, \"He is Allah, [who is] One,","j":30,"p":604,"r":554,"h":240,"w":8,"u":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","s":"(اى نبي!) ته (دوى ته) ووایه: شان دا دى چی الله یو دى","a":"SAY: \"He is the One God:"},{"n":2,"g":6223,"t":"ٱللَّهُ ٱلصَّمَدُ","e":"Allah, the Eternal Refuge.","j":30,"p":604,"r":554,"h":240,"w":2,"u":"معبود برحق جو بےنیاز ہے","s":"هم دا الله بې نیاز (بې حاجته) دى","a":"\"God the Eternal, the Uncaused Cause of All Being."},{"n":3,"g":6224,"t":"لَمْ يَلِدْ وَلَمْ يُولَدْ","e":"He neither begets nor is born,","j":30,"p":604,"r":554,"h":240,"w":4,"u":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","s":"نه يې (څوك) زېږولى دى او نه دى (له چا) زېږول شوى دى","a":"\"He begets not, and neither is He begotten;"},{"n":4,"g":6225,"t":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","e":"Nor is there to Him any equivalent.\"","j":30,"p":604,"r":554,"h":240,"w":5,"u":"اور کوئی اس کا ہمسر نہیں","s":"او د ده هیڅوك سیال (او) برابر نشته","a":"\"and there is nothing that could be compared with Him."}]},{"number":113,"name":"سُورَةُ الفَلَقِ","en":"Al-Falaq","tr":"The Dawn","rev":"Meccan","ayahs":[{"n":1,"g":6226,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","e":"Say, \"I seek refuge in the Lord of daybreak","j":30,"p":604,"r":555,"h":240,"w":8,"u":"کہو کہ میں صبح کے پروردگار کی پناہ مانگتا ہوں","s":"(اى نبي) ته ووایه: زه په رب د سبا پورې پناه نيسم","a":"SAY: \"I seek refuge with the Sustainer of the rising dawn,"},{"n":2,"g":6227,"t":"مِن شَرِّ مَا خَلَقَ","e":"From the evil of that which He created","j":30,"p":604,"r":555,"h":240,"w":4,"u":"ہر چیز کی بدی سے جو اس نے پیدا کی","s":"د هر هغه شي له شر نه چې ده پیدا كړى دى","a":"\"from the evil of aught that He has created,"},{"n":3,"g":6228,"t":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","e":"And from the evil of darkness when it settles","j":30,"p":604,"r":555,"h":240,"w":5,"u":"اور شب تاریکی کی برائی سے جب اس کااندھیرا چھا جائے","s":"او د تیارې شپې له شر نه كله چې تكه توره (او خوره) شي","a":"\"and from the evil of the black darkness whenever it descends,"},{"n":4,"g":6229,"t":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","e":"And from the evil of the blowers in knots","j":30,"p":604,"r":555,"h":240,"w":5,"u":"اور گنڈوں پر (پڑھ پڑھ کر) پھونکنے والیوں کی برائی سے","s":"او له شره د هغو (جادوګرو) ښځو چې په غوټو كې پوكي وهونكې دي","a":"\"and from the evil of all human beings bent on occult endeavours,"},{"n":5,"g":6230,"t":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","e":"And from the evil of an envier when he envies.\"","j":30,"p":604,"r":555,"h":240,"w":5,"u":"اور حسد کرنے والے کی برائی سے جب حسد کرنے لگے","s":"او د حسد كوونكي له شر نه كله چی دى حسد (شروع او ښكاره) كړي","a":"\"and from the evil of the envious when he envies.\""}]},{"number":114,"name":"سُورَةُ النَّاسِ","en":"An-Naas","tr":"Mankind","rev":"Meccan","ayahs":[{"n":1,"g":6231,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","e":"Say, \"I seek refuge in the Lord of mankind,","j":30,"p":604,"r":556,"h":240,"w":8,"u":"کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں","s":"(اى نبي) ته ووایه: زه د خلقو په رب پورې پناه نیسم","a":"SAY: \"I seek refuge with the Sustainer of men,"},{"n":2,"g":6232,"t":"مَلِكِ ٱلنَّاسِ","e":"The Sovereign of mankind.","j":30,"p":604,"r":556,"h":240,"w":2,"u":"(یعنی) لوگوں کے حقیقی بادشاہ کی","s":"چې د خلقو بادشاه دى","a":"\"the Sovereign of men,"},{"n":3,"g":6233,"t":"إِلَٰهِ ٱلنَّاسِ","e":"The God of mankind,","j":30,"p":604,"r":556,"h":240,"w":2,"u":"لوگوں کے معبود برحق کی","s":"د خلقو (حقیقي) معبود دى","a":"\"the God of men,"},{"n":4,"g":6234,"t":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","e":"From the evil of the retreating whisperer -","j":30,"p":604,"r":556,"h":240,"w":4,"u":"(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے","s":"له شره د وسوسې اچوونكي، تښتېدونكي","a":"\"from the evil of the whispering, elusive tempter"},{"n":5,"g":6235,"t":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","e":"Who whispers [evil] into the breasts of mankind -","j":30,"p":604,"r":556,"h":240,"w":5,"u":"جو لوگوں کے دلوں میں وسوسے ڈالتا ہے","s":"هغه چې د خلقو په سینو كې وسوسې اچوي","a":"\"who whispers in the hearts of men"},{"n":6,"g":6236,"t":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","e":"From among the jinn and mankind.\"","j":30,"p":604,"r":556,"h":240,"w":3,"u":"وہ جنّات میں سے (ہو) یا انسانوں میں سے","s":"چی (دغه وسوسې اچوونكي) له پېریانو او انسانانو ځنې دي","a":"\"from all [temptation to evil by] invisible forces as well as men,\""}]}]}