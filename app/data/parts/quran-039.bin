ۭا وَصَرَّفْنَا فِيهِ مِنَ ٱلْوَعِيدِ لَعَلَّهُمْ يَتَّقُونَ أَوْ يُحْدِثُ لَهُمْ ذِكْرًۭا","e":"And thus We have sent it down as an Arabic Qur'an and have diversified therein the warnings that perhaps they will avoid [sin] or it would cause them remembrance.","j":16,"p":319,"r":275,"h":128,"w":14,"u":"اور ہم نے اس کو اسی طرح کا قرآن عربی نازل کیا ہے اور اس میں طرح طرح کے ڈراوے بیان کردیئے ہیں تاکہ لوگ پرہیزگار بنیں یا خدا ان کے لئے نصیحت پیدا کردے","s":"او هم داسې مونږ دغه (كتاب) نازل كړى دى عربي قرآن، او مونږ په ده كې (ایتونه) له وعید ځنې بیا بیا راوړي دي، د دې لپاره چې دوى پرهېزګاره شي یا دغه (قرآن) دوى ته څه پند پیدا كړي","a":"AND THUS have We bestowed from on high this [divine writ] as a discourse in the Arabic tongue, and have given therein many facets to all manner of warnings, so that men might remain conscious of Us, or that it give rise to a new awareness in them"},{"n":114,"g":2462,"t":"فَتَعَٰلَى ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ۗ وَلَا تَعْجَلْ بِٱلْقُرْءَانِ مِن قَبْلِ أَن يُقْضَىٰٓ إِلَيْكَ وَحْيُهُۥ ۖ وَقُل رَّبِّ زِدْنِى عِلْمًۭا","e":"So high [above all] is Allah, the Sovereign, the Truth. And, [O Muhammad], do not hasten with [recitation of] the Qur'an before its revelation is completed to you, and say, \"My Lord, increase me in knowledge.\"","j":16,"p":320,"r":275,"h":128,"w":19,"u":"تو خدا جو سچا بادشاہ ہے عالی قدر ہے۔ اور قرآن کی وحی جو تمہاری طرف بھیجی جاتی ہے اس کے پورا ہونے سے پہلے قرآن کے (پڑھنے کے) لئے جلدی نہ کیا کرو اور دعا کرو کہ میرے پروردگار مجھے اور زیادہ علم دے","s":"نو اوچت دى الله حق بادشاه دى او ته په (لوستلو د) قرآن سره تلوار مه كوه مخكې له دې چې تا ته د ده وحي پوره كړى شي او ته وایه: اى زما ربه ما ته (زما) په علم كې زیاتوالى راكړې","a":"[Know,] then, [that) God is sublimely exalted. the Ultimate Sovereign, the Ultimate Truth and [knowing this,] do not approach the Qur'an in haste, ere it has been revealed unto thee in full, but [always) say: \"O my Sustainer, cause me to grow in knowledge!"},{"n":115,"g":2463,"t":"وَلَقَدْ عَهِدْنَآ إِلَىٰٓ ءَادَمَ مِن قَبْلُ فَنَسِىَ وَلَمْ نَجِدْ لَهُۥ عَزْمًۭا","e":"And We had already taken a promise from Adam before, but he forgot; and We found not in him determination.","j":16,"p":320,"r":275,"h":128,"w":11,"u":"اور ہم نے پہلے آدم سے عہد لیا تھا مگر وہ (اسے) بھول گئے اور ہم نے ان میں صبر وثبات نہ دیکھا","s":"او یقینًا په تحقیق سره مونږ ادم ته له دې نه مخكې حكم كړى و، نو هغه هېر كړ او مونږ د ده پخه اراده ونه مونده","a":"AND, INDEED, long ago did We impose Our commandment on Adam; but he forgot it, and We found no firmness of purpose in him."},{"n":116,"g":2464,"t":"وَإِذْ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ أَبَىٰ","e":"And [mention] when We said to the angels, \"Prostrate to Adam,\" and they prostrated, except Iblees; he refused.","j":16,"p":320,"r":276,"h":128,"w":9,"u":"اور جب ہم نے فرشتوں سے کہا کہ آدم کے آگے سجدہ کرو تو سب سجدے میں گر پڑے مگر ابلیس نے انکار کیا","s":"او كله چې مونږ ملايكو ته وویل: تاسو ادم ته سجده وكړئ، نو دوى سجده وكړه، غیر له ابلیس نه، ده انكار وكړ","a":"For [thus it was:] when We told the angels, \"Prostrate yourselves before Adam!\"- they all prostrated themselves, save Ibis, who refused [to do it];"},{"n":117,"g":2465,"t":"فَقُلْنَا يَٰٓـَٔادَمُ إِنَّ هَٰذَا عَدُوٌّۭ لَّكَ وَلِزَوْجِكَ فَلَا يُخْرِجَنَّكُمَا مِنَ ٱلْجَنَّةِ فَتَشْقَىٰٓ","e":"So We said, \"O Adam, indeed this is an enemy to you and to your wife. Then let him not remove you from Paradise so you would suffer.","j":16,"p":320,"r":276,"h":128,"w":12,"u":"ہم نے فرمایا کہ آدم یہ تمہارا اور تمہاری بیوی کا دشمن ہے تو یہ کہیں تم دونوں کو بہشت سے نکلوا نہ دے۔ پھر تم تکلیف میں پڑجاؤ","s":"نو مونږ ادم ته وویل: بېشكه دا (ابلیس) ستا او ستا د ښځې دښمن دى، نو دى دې تاسو هرګز له جنت نه ونه باسي، (ګنې) نو په مشقت كې به پرېوځئ","a":"and thereupon We said: \"O Adam! Verily, this is a foe unto thee and thy wife: so let him not drive the two of you out of this garden and render thee unhappy."},{"n":118,"g":2466,"t":"إِنَّ لَكَ أَلَّا تَجُوعَ فِيهَا وَلَا تَعْرَىٰ","e":"Indeed, it is [promised] for you not to be hungry therein or be unclothed.","j":16,"p":320,"r":276,"h":128,"w":7,"u":"یہاں تم کو یہ (آسائش) ہوگی کہ نہ بھوکے رہو نہ ننگے","s":"بېشكه تا لپاره دا مقرر ده چې ته به په دې (جنت) كې نه وږى كېږې او نه به بربنډېږې","a":"Behold, it is provided for thee that thou shalt not hunger here or feel naked,"},{"n":119,"g":2467,"t":"وَأَنَّكَ لَا تَظْمَؤُا۟ فِيهَا وَلَا تَضْحَىٰ","e":"And indeed, you will not be thirsty therein or be hot from the sun.\"","j":16,"p":320,"r":276,"h":128,"w":6,"u":"اور یہ کہ نہ پیاسے رہو اور نہ دھوپ کھاؤ","s":"او دا چې بېشكه ته به نه په ده كې تږى كېږې او نه به دې ګرمي كېږي","a":"and that thou shalt not thirst here or suffer from the heat of the sun.\""},{"n":120,"g":2468,"t":"فَوَسْوَسَ إِلَيْهِ ٱلشَّيْطَٰنُ قَالَ يَٰٓـَٔادَمُ هَلْ أَدُلُّكَ عَلَىٰ شَجَرَةِ ٱلْخُلْدِ وَمُلْكٍۢ لَّا يَبْلَىٰ","e":"Then Satan whispered to him; he said, \"O Adam, shall I direct you to the tree of eternity and possession that will not deteriorate?\"","j":16,"p":320,"r":276,"h":128,"w":13,"u":"تو شیطان نے ان کے دل میں وسوسہ ڈالا۔ (اور) کہا کہ آدم بھلا میں تم کو (ایسا) درخت بتاؤں (جو) ہمیشہ کی زندگی کا (ثمرہ دے) اور (ایسی) بادشاہت کہ کبھی زائل نہ ہو","s":"نو ده ته شیطان وسوسه واچوله، ويې ويل: اى ادمه! ایا زه تا ته د تل ژوندي پاتې كېدلو ونه وښیم او داسې بادشاهي چې نه به ختمېږي","a":"But Satan whispered unto him, saying: \"O Adam! Shall I lead thee to the tree of life eternal; and [thus] to a kingdom that will never decay?\""},{"n":121,"g":2469,"t":"فَأَكَلَا مِنْهَا فَبَدَتْ لَهُمَا سَوْءَٰتُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا مِن وَرَقِ ٱلْجَنَّةِ ۚ وَعَصَىٰٓ ءَادَمُ رَبَّهُۥ فَغَوَىٰ","e":"And Adam and his wife ate of it, and their private parts became apparent to them, and they began to fasten over themselves from the leaves of Paradise. And Adam disobeyed his Lord and erred.","j":16,"p":320,"r":276,"h":128,"w":16,"u":"تو دونوں نے اس درخت کا پھل کھا لیا تو ان پر ان کی شرمگاہیں ظاہر ہوگئیں اور وہ اپنے (بدنوں) پر بہشت کے پتّے چپکانے لگے۔ اور آدم نے اپنے پروردگار کے حکم خلاف کیا تو (وہ اپنے مطلوب سے) بےراہ ہو گئے","s":"نو دوى دواړو (ښځې خاوند) له دغې (ونې) نه خوراك وكړ، نو دوى ته خپل د شرم ځایونه ښكاره شول او دوى شروع شول چې په خپلو ځانونو يې د جنت پاڼې نښلولې او ادم د خپل رب نافرماني وكړه، نو وښویده","a":"And so the two ate [of the fruit] thereof: and thereupon they became conscious of their nakedness and began to cover themselves with pieced-together leaves from the garden. And [thus] did Adam disobey his Sustainer, and thus did he fall into grievous error."},{"n":122,"g":2470,"t":"ثُمَّ ٱجْتَبَٰهُ رَبُّهُۥ فَتَابَ عَلَيْهِ وَهَدَىٰ","e":"Then his Lord chose him and turned to him in forgiveness and guided [him].","j":16,"p":320,"r":276,"h":128,"w":6,"u":"پھر ان کے پروردگار نے ان کو نوازا تو ان پر مہربانی سے توجہ فرمائی اور سیدھی راہ بتائی","s":"بیا دى خپل رب غوره كړ، نو د ده توبه يې قبوله كړه او هدایت يې وكړ (ده ته)","a":"Thereafter, [however,) his Sustainer elected him [for His grace], and accepted his repentance, and bestowed His guidance upon him,"},{"n":123,"g":2471,"t":"قَالَ ٱهْبِطَا مِنْهَا جَمِيعًۢا ۖ بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۭ ۖ فَإِمَّا يَأْتِيَنَّكُم مِّنِّى هُدًۭى فَمَنِ ٱتَّبَعَ هُدَاىَ فَلَا يَضِلُّ وَلَا يَشْقَىٰ","e":"[Allah] said, \"Descend from Paradise - all, [your descendants] being enemies to one another. And if there should come to you guidance from Me - then whoever follows My guidance will neither go astray [in the world] nor suffer [in the Hereafter].","j":16,"p":320,"r":276,"h":128,"w":20,"u":"فرمایا کہ تم دونوں یہاں سے نیچے اتر جاؤ۔ تم میں بعض بعض کے دشمن (ہوں گے) پھر اگر میری طرف سے تمہارے پاس ہدایت آئے تو جو شخص میری ہدایت کی پیروی کرے گا وہ نہ گمراہ ہوگا اور نہ تکلیف میں پڑے گا","s":"(الله) وویل: تاسو دواړه له دې (جنت) نه كوز شئ ټول، ستاسو ځینې به د ځینو نورو دښمنان وي، نو كه تاسو ته زما له جانبه هدایت راغى، نو چا چې زما د هدایت پیروي وكړه، نو دى به نه ګمراه كېږي او نه به بدبخته كېږي","a":"saying: \"Down with you all from this [state of innocence, and be henceforth] enemies unto one another! None the less, there shall most certainly come unto you guidance from Me: and he who follows My guidance will not go astray, and neither will he be unhappy."},{"n":124,"g":2472,"t":"وَمَنْ أَعْرَضَ عَن ذِكْرِى فَإِنَّ لَهُۥ مَعِيشَةًۭ ضَنكًۭا وَنَحْشُرُهُۥ يَوْمَ ٱلْقِيَٰمَةِ أَعْمَىٰ","e":"And whoever turns away from My remembrance - indeed, he will have a depressed life, and We will gather him on the Day of Resurrection blind.\"","j":16,"p":320,"r":276,"h":128,"w":12,"u":"اور جو میری نصیحت سے منہ پھیرے گا اس کی زندگی تنگ ہوجائے گی اور قیامت کو ہم اسے اندھا کرکے اٹھائیں گے","s":"او هغه څوك چې زما له ذكر (قرآن) نه مخ وګرځوي، نو بېشكه د ده لپاره ډېر تنګ ګذران (او ژوند) دى او دى به مونږ د قیامت په ورځ ړوند راپورته كوو","a":"But as for him who shall turn away from remembering Me - his shall be a life of narrow scope and on the Day of Resurrection We shall raise him up blind.\""},{"n":125,"g":2473,"t":"قَالَ رَبِّ لِمَ حَشَرْتَنِىٓ أَعْمَىٰ وَقَدْ كُنتُ بَصِيرًۭا","e":"He will say, \"My Lord, why have you raised me blind while I was [once] seeing?\"","j":16,"p":320,"r":276,"h":128,"w":8,"u":"وہ کہے گا میرے پروردگار تو نے مجھے اندھا کرکے کیوں اٹھایا میں تو دیکھتا بھالتا تھا","s":"دى به وايي: اى زما ربه! تا زه ولې ړوند راپاڅولم، حال دا چې زه (په دنیا كې) بینا وم","a":"[And so, on Resurrection Day, the sinner] will ask: \"O my Sustainer! Why hast Thou raised me up blind, whereas [on earth] I was endowed with sight?\""},{"n":126,"g":2474,"t":"قَالَ كَذَٰلِكَ أَتَتْكَ ءَايَٰتُنَا فَنَسِيتَهَا ۖ وَكَذَٰلِكَ ٱلْيَوْمَ تُنسَىٰ","e":"[Allah] will say, \"Thus did Our signs come to you, and you forgot them; and thus will you this Day be forgotten.\"","j":16,"p":321,"r":276,"h":128,"w":9,"u":"خدا فرمائے گا کہ ایسا ہی (چاہیئے تھا) تیرے پاس میری آیتیں آئیں تو تونے ان کو بھلا دیا۔ اسی طرح آج ہم تجھ کو بھلا دیں گے","s":"(الله به) ووايي: همداسې و، تا ته زمونږ ایتونه راغلي وو، نو تا هغه هېر كړل، او همداسې به ته نن ورځ هېرولى شې","a":"[God] will reply: \"Thus it is: there came unto thee Our messages, but thou wert oblivious of them; and thus shalt thou be today consigned to oblivion!\""},{"n":127,"g":2475,"t":"وَكَذَٰلِكَ نَجْزِى مَنْ أَسْرَفَ وَلَمْ يُؤْمِنۢ بِـَٔايَٰتِ رَبِّهِۦ ۚ وَلَعَذَابُ ٱلْءَاخِرَةِ أَشَدُّ وَأَبْقَىٰٓ","e":"And thus do We recompense he who transgressed and did not believe in the signs of his Lord. And the punishment of the Hereafter is more severe and more enduring.","j":16,"p":321,"r":276,"h":128,"w":13,"u":"اور جو شخص حد سے نکل جائے اور اپنے پروردگار کی آیتوں پر ایمان نہ لائے ہم اس کو ایسا ہی بدلہ دیتے ہیں۔ اور آخرت کا عذاب بہت سخت اور بہت دیر رہنے والا ہے","s":"او همداسې مونږ جزا وركوو هغه چا ته چې له حده ووت او د خپل رب په ایتونو يې ایمان رانه وړ او خامخا د اخرت عذاب ډېر سخت دى او ډېر باقي پاتې كېدونكى دى","a":"For, thus shall We recompense him who wastes his own self and does not believe in his Sustainer's messages: and, indeed, the suffering [of such sinners] in the life to come shall be most severe and most enduring!"},{"n":128,"g":2476,"t":"أَفَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا قَبْلَهُم مِّنَ ٱلْقُرُونِ يَمْشُونَ فِى مَسَٰكِنِهِمْ ۗ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍۢ لِّأُو۟لِى ٱلنُّهَىٰ","e":"Then, has it not become clear to them how many generations We destroyed before them as they walk among their dwellings? Indeed in that are signs for those of intelligence.","j":16,"p":321,"r":276,"h":128,"w":18,"u":"کیا یہ بات ان لوگوں کے لئے موجب ہدایت نہ ہوئی کہ ہم ان سے پہلے بہت سے لوگوں کو ہلاک کرچکے ہیں جن کے رہنے کے مقامات میں یہ چلتے پھرتے ہیں۔ عقل والوں کے لئے اس میں (بہت سی) نشانیاں ہیں","s":"ایا نو دوى ته نه ده څرګنده شوې چې څومره ډېرې پېړۍ (امتونه) مونږ هلاكې كړې دي، چې دوى د هغوى په استوګنځایونو كې تېرېږي، بېشكه په دغو كې د عقل والاو لپاره ډېرې نښې دي","a":"CAN, THEN, they [who reject the truth] learn no lesson by recalling how many a generation We have destroyed before their time? - [people] in whose dwelling-places they [themselves now] walk about? In this, behold, there are messages indeed for those who are endowed with reason!"},{"n":129,"g":2477,"t":"وَلَوْلَا كَلِمَةٌۭ سَبَقَتْ مِن رَّبِّكَ لَكَانَ لِزَامًۭا وَأَجَلٌۭ مُّسَمًّۭى","e":"And if not for a word that preceded from your Lord, punishment would have been an obligation [due immediately], and [if not for] a specified term [decreed].","j":16,"p":321,"r":277,"h":128,"w":9,"u":"اور اگر ایک بات تمہارے پروردگار کی طرف سے پہلے صادر اور (جزائے اعمال کے لئے) ایک میعاد مقرر نہ ہوچکی ہوتی تو (نزول) عذاب لازم ہوجاتا","s":"او كه چېرې هغه خبره نه وى چې ستا د رب له جانبه مخكې شوې ده (، نو) خامخا دغه (هلاكت د دوى) به لازم و، (او كه چېرې نه وى، مقرر شوې نېټه","a":"Now were it not for a decree that has already gone forth from thy Sustainer, setting a term [for each sinner's repentance], it would inescapably follow [that all who sin must be doomed at once]."},{"n":130,"g":2478,"t":"فَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ ٱلشَّمْسِ وَقَبْلَ غُرُوبِهَا ۖ وَمِنْ ءَانَآئِ ٱلَّيْلِ فَسَبِّحْ وَأَطْرَافَ ٱلنَّهَارِ لَعَلَّكَ تَرْضَىٰ","e":"So be patient over what they say and exalt [Allah] with praise of your Lord before the rising of the sun and before its setting; and during periods of the night [exalt Him] and at the ends of the day, that you may be satisfied.","j":16,"p":321,"r":277,"h":128,"w":21,"u":"پس جو کچھ یہ بکواس کرتے ہیں اس پر صبر کرو۔ اور سورج کے نکلنے سے پہلے اور اس کے غروب ہونے سے پہلے اپنے پروردگار کی تسبیح وتحمید کیا کرو۔ اور رات کی ساعات (اولین) میں بھی اس کی تسبیح کیا کرو اور دن کی اطراف (یعنی دوپہر کے قریب ظہر کے وقت بھی) تاکہ تم خوش ہوجاؤ","s":"نو (اى نبي!) ته په هغو خبرو صبر كوه چې دوى يې وايي او ته د خپل رب له ستاينې سره تسبیح وایه له لمر ختو نه مخكې او مخكې د پرېوتو له ده نه، او د شپې په ځینو وختونو كې، نو ته تسبیح وایه۔ او د ورځې په غاړو كې، ښايي چې ته به خوشاله شې","a":"Hence, bear with patience whatever they [who deny the truth] may say, and extol thy Sustainer's limitless glory and praise Him before the rising of the sun and before its setting; and extol His glory, too, during some of the hours of the night as well as during the hours of the day, so that thou might attain to happiness."},{"n":131,"g":2479,"t":"وَلَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ زَهْرَةَ ٱلْحَيَوٰةِ ٱلدُّنْيَا لِنَفْتِنَهُمْ فِيهِ ۚ وَرِزْقُ رَبِّكَ خَيْرٌۭ وَأَبْقَىٰ","e":"And do not extend your eyes toward that by which We have given enjoyment to [some] categories of them, [its being but] the splendor of worldly life by which We test them. And the provision of your Lord is better and more enduring.","j":16,"p":321,"r":277,"h":128,"w":19,"u":"اور کئی طرح کے لوگوں کو جو ہم نے دنیا کی زندگی میں آرائش کی چیزوں سے بہرہ مند کیا ہے تاکہ ان کی آزمائش کریں ان پر نگاہ نہ کرنا۔ اور تمہاری پروردگار کی (عطا فرمائی ہوئی) روزی بہت بہتر اور باقی رہنے والی ہے","s":"او ته خپلې سترګې هرګز مه اوږدوه هغه څیز ته چې مونږ په هغه سره دغو ته نفع وركړې ده چې قسما قسم څیزونه دي۔ د دنيايي ژوند ښايست، د دې لپاره چې مونږ دغه (كفار) په دې كې وازمایو۔ او ستا د رب رزق ډېر غوره او ډېر باقي پاتې كېدونكى دى","a":"And never turn thine, eyes [with longing] towards whatever splendour of this world's life We may have allowed so many others to enjoy in order that We might test them thereby: for the sustenance which thy Sustainer provides [for thee] is better and more enduring."},{"n":132,"g":2480,"t":"وَأْمُرْ أَهْلَكَ بِٱلصَّلَوٰةِ وَٱصْطَبِرْ عَلَيْهَا ۖ لَا نَسْـَٔلُكَ رِزْقًۭا ۖ نَّحْنُ نَرْزُقُكَ ۗ وَٱلْعَٰقِبَةُ لِلتَّقْوَىٰ","e":"And enjoin prayer upon your family [and people] and be steadfast therein. We ask you not for provision; We provide for you, and the [best] outcome is for [those of] righteousness.","j":16,"p":321,"r":277,"h":128,"w":15,"u":"اور اپنے گھر والوں کو نماز کا حکم کرو اور اس پر قائم رہو۔ ہم تم سے روزی کے خواستگار نہیں۔ بلکہ تمہیں ہم روزی دیتے ہیں اور (نیک) انجام (اہل) تقویٰ کا ہے","s":"او ته خپل اهل ته د لمانځه حكم كوه او ته هم په دې (لمانځه) ټینګ ولاړ اوسه، مونږ له تا نه رزق نه غواړو، مونږ تا ته رزق دركوو، او ښه انجام د پرهېزګارۍ لپاره دى","a":"And bid thy people to pray, and persevere therein. [But remember:] We do not ask thee to provide sustenance [for Us]: it is We who provide sustenance for thee. And the future belongs to the God-conscious."},{"n":133,"g":2481,"t":"وَقَالُوا۟ لَوْلَا يَأْتِينَا بِـَٔايَةٍۢ مِّن رَّبِّهِۦٓ ۚ أَوَلَمْ تَأْتِهِم بَيِّنَةُ مَا فِى ٱلصُّحُفِ ٱلْأُولَىٰ","e":"And they say, \"Why does he not bring us a sign from his Lord?\" Has there not come to them evidence of what was in the former scriptures?","j":16,"p":321,"r":277,"h":128,"w":14,"u":"اور کہتے ہیں کہ یہ (پیغمبر) اپنے پروردگار کی طرف سے ہمارے پاس کوئی نشانی کیوں نہیں لاتے۔ کیا ان کے پاس پہلی کتابوں کی نشانی نہیں آئی؟","s":"او دوى وايي: دى (محمد) د خپل رب له جانبه مونږ ته كومه نښه (معجزه) ولې نه راوړي؟ ایا دوى ته واضح دلیل له هغه څه نه دى راغلى چې په ړومبنیو صحیفو كې دي","a":"NOW THEY [who are blind to the truth] are wont to say, \"If [Muhammad] would but produce for us a miracle from his Sustainer! [But] has there not come unto them a clear evidence [of the truth of this divine writ] in what is [to be found] in the earlier scriptures?"},{"n":134,"g":2482,"t":"وَلَوْ أَنَّآ أَهْلَكْنَٰهُم بِعَذَابٍۢ مِّن قَبْلِهِۦ لَقَالُوا۟ رَبَّنَا لَوْلَآ أَرْسَلْتَ إِلَيْنَا رَسُولًۭا فَنَتَّبِعَ ءَايَٰتِكَ مِن قَبْلِ أَن نَّذِلَّ وَنَخْزَىٰ","e":"And if We had destroyed them with a punishment before him, they would have said, \"Our Lord, why did You not send to us a messenger so we could have followed Your verses before we were humiliated and disgraced?\"","j":16,"p":321,"r":277,"h":128,"w":19,"u":"اور اگر ہم ان کو پیغمبر (کے بھیجنے) سے پیشتر کسی عذاب سے ہلاک کردیتے تو وہ کہتے کہ اے ہمارے پروردگار تو نے ہماری طرف کوئی پیغمبر کیوں نہ بھیجا کہ ہم ذلیل اور رسوا ہونے سے پہلے تیرے کلام (واحکام) کی پیروی کرتے","s":"او كه یقینًا مونږ دوى له دغه (قرآن) نه مخكې هلاك كړي وى (، نو) خامخا دوى به ویلى: اى زمونږ ربه! تا مونږ ته ولې یو رسول راونه لېږه، پس چې مونږ ستا د ایتونو پیروي كړې وى، مخكې له دې نه چې مونږ ذلیله شو او رسوا شو","a":"For [thus it is:] had We destroyed them by means of a chastisement ere this [divine writ was revealed], they would indeed [be justified to] say [on Judgment Day]: \"O our Sustainer! If only Thou hadst sent an apostle unto us, we would have followed Thy messages rather than be humiliated and disgraced [in the hereafter]!\""},{"n":135,"g":2483,"t":"قُلْ كُلٌّۭ مُّتَرَبِّصٌۭ فَتَرَبَّصُوا۟ ۖ فَسَتَعْلَمُونَ مَنْ أَصْحَٰبُ ٱلصِّرَٰطِ ٱلسَّوِىِّ وَمَنِ ٱهْتَدَىٰ","e":"Say, \"Each [of us] is waiting; so wait. For you will know who are the companions of the sound path and who is guided.\"","j":16,"p":321,"r":277,"h":128,"w":12,"u":"کہہ دو کہ سب (نتائج اعمال) کے منتظر ہیں سو تم بھی منتظر رہو۔ عنقریب تم کو معلوم ہوجائے گا کہ (دین کے) سیدھے رستے پر چلنے والے کون ہیں اور (جنت کی طرف) راہ پانے والے کون ہیں (ہم یا تم)","s":"ته (دوى ته) ووایه: هر یو انتظار كوونكى دى، نو تاسو (هم) انتظار كوئ، نو ژر ده چې تاسو به پوه شئ چې د نېغې لارې خاوندان څوك دي او څوك دى چې نېغه لار يې موندلې ده","a":"Say: \"Everyone is hopefully waiting [for what the future may bring]: wait, then, [for the Day of Judgment] for then you will come to know as to who has followed the even path, and who has found guidance!\""}]},{"number":21,"name":"سُورَةُ الأَنبِيَاءِ","en":"Al-Anbiyaa","tr":"The Prophets","rev":"Meccan","ayahs":[{"n":1,"g":2484,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فِى غَفْلَةٍۢ مُّعْرِضُونَ","e":"[The time of] their account has approached for the people, while they are in heedlessness turning away.","j":17,"p":322,"r":278,"h":129,"w":11,"u":"لوگوں کا حساب (اعمال کا وقت) نزدیک آپہنچا ہے اور وہ غفلت میں (پڑے اس سے) منہ پھیر رہے ہیں","s":"خلقو ته د هغوى (د) حساب (وخت) ډېر نژدې شو، حال دا چې دوى په غفلت كې دي، مخ ګرځوونكي دي","a":"CLOSER DRAWS unto men their reckoning: and yet they remain stubbornly heedless [of its approach]."},{"n":2,"g":2485,"t":"مَا يَأْتِيهِم مِّن ذِكْرٍۢ مِّن رَّبِّهِم مُّحْدَثٍ إِلَّا ٱسْتَمَعُوهُ وَهُمْ يَلْعَبُونَ","e":"No mention comes to them anew from their Lord except that they listen to it while they are at play","j":17,"p":322,"r":278,"h":129,"w":11,"u":"ان کے پاس کوئی نئی نصیحت ان کے پروردگار کی طرف سے نہیں آتی مگر وہ اسے کھیلتے ہوئے سنتے ہیں","s":"دوى ته د خپل رب له جانبه هېڅ نوى نصیحت نه راځي مګر دوى هغه اوري، په داسې حال كې چې دوى لوبې (مسخرې پرې) كوي","a":"Whenever there comes unto them any new re­minder from their Sustainer, they but listen to it with playful amusement,"},{"n":3,"g":2486,"t":"لَاهِيَةًۭ قُلُوبُهُمْ ۗ وَأَسَرُّوا۟ ٱلنَّجْوَى ٱلَّذِينَ ظَلَمُوا۟ هَلْ هَٰذَآ إِلَّا بَشَرٌۭ مِّثْلُكُمْ ۖ أَفَتَأْتُونَ ٱلسِّحْرَ وَأَنتُمْ تُبْصِرُونَ","e":"With their hearts distracted. And those who do wrong conceal their private conversation, [saying], \"Is this [Prophet] except a human being like you? So would you approach magic while you are aware [of it]?\"","j":17,"p":322,"r":278,"h":129,"w":17,"u":"ان کے دل غفلت میں پڑے ہوئے ہیں اور ظالم لوگ (آپس میں) چپکے چپکے باتیں کرتے ہیں کہ یہ (شخص کچھ بھی) نہیں مگر تمہارے جیسا آدمی ہے۔ تو تم آنکھوں دیکھتے جادو (کی لپیٹ) میں کیوں آتے ہو","s":"په دې حال كې چې د دوى زړونه غافله وي، او خفیه مشوره يې پټه وساتله هغو كسانو چې ظلم يې كړى دى (او ويې ویل:) دا (محمد) نه دى مګر ستاسو په شان یو انسان دى، ایا نو تاسو جادو ته راځئ، حال دا چې تاسو ګورئ","a":"their hearts set on passing ­delights; yet they who are [thus] bent on wrongdoing conceal their innermost thoughts [when they say to one another], “Is this [Muhammad] anything but a mortal like yourselves? Will you, then, yield to [his] spellbinding eloquence with your eyes open?”"},{"n":4,"g":2487,"t":"قَالَ رَبِّى يَعْلَمُ ٱلْقَوْلَ فِى ٱلسَّمَآءِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ","e":"The Prophet said, \"My Lord knows whatever is said throughout the heaven and earth, and He is the Hearing, the Knowing.\"","j":17,"p":322,"r":278,"h":129,"w":11,"u":"(پیغمبر نے) کہا کہ جو بات آسمان اور زمین میں (کہی جاتی) ہے میرا پروردگار اسے جانتا ہے۔ اور وہ سننے والا (اور) جاننے والا ہے","s":"(رسول دوى ته) وویل: زما رب په اسمان او ځمكه كې په هره خبره پوهېږي او هم هغه ښه اورېدونكى، ښه عالم دى","a":"Say: “My Sustainer knows whatever is spoken in heaven and on earth; and He alone is all-hearing, all-knowing.”"},{"n":5,"g":2488,"t":"بَلْ قَالُوٓا۟ أَضْغَٰثُ أَحْلَٰمٍۭ بَلِ ٱفْتَرَىٰهُ بَلْ هُوَ شَاعِرٌۭ فَلْيَأْتِنَا بِـَٔايَةٍۢ كَمَآ أُرْسِلَ ٱلْأَوَّلُونَ","e":"But they say, \"[The revelation is but] a mixture of false dreams; rather, he has invented it; rather, he is a poet. So let him bring us a sign just as the previous [messengers] were sent [with miracles].\"","j":17,"p":322,"r":278,"h":129,"w":14,"u":"بلکہ (ظالم) کہنے لگے کہ (یہ قرآن) پریشان (باتیں ہیں جو) خواب (میں دیکھ لی) ہیں۔ (نہیں) بلکہ اس نے اس کو اپنی طرف سے بنا لیا ہے (نہیں) بلکہ (یہ شعر ہے جو اس) شاعر (کا نتیجہٴ طبع) ہے۔ تو جیسے پہلے (پیغمبر نشانیاں دے کر) بھیجے گئے تھے (اسی طرح) یہ بھی ہمارے پاس کوئی نشانی لائے","s":"بلكې دوى وايي: (دا قرآن) ګډوډ خوبونه دي، بلكې دا يې له خپل ځانه جوړ كړى دى، بلكې دا شاعر دى، نو دا دې مونږ ته لویه نښه (معجزه) راوړي، له څنګه چې ړومبني (پېغمبران په هغو سره) لېږل شوي وو","a":"“Nay,” they say, “[Muhammad propounds] the most involved and confusing of dreams!” “Nay, but he has invented [all] this!” - “Nay, but he is [only] a poet!” - [and,] “Let him, then, come unto us with a miracle, just as those [prophets] of old were sent [with miracles]?”"},{"n":6,"g":2489,"t":"مَآ ءَامَنَتْ قَبْلَهُم مِّن قَرْيَةٍ أَهْلَكْنَٰهَآ ۖ أَفَهُمْ يُؤْمِنُونَ","e":"Not a [single] city which We destroyed believed before them, so will they believe?","j":17,"p":322,"r":278,"h":129,"w":9,"u":"ان سے پہلے جن بستیوں کو ہم نے ہلاک کیا وہ ایمان نہیں لاتی تھیں۔ تو کیا یہ ایمان لے آئیں گے","s":"ایمان نه دى راوړى له دوى نه مخكې هېڅ یو داسې كلي، چې مونږ هغه هلاك كړى، ایا نو دوى به ایمان راوړي؟","a":"Not one of the communities that We destroyed in bygone times would ever believe [their prophets]: will these, then, [be more willing to] believe?"},{"n":7,"g":2490,"t":"وَمَآ أَرْسَلْنَا قَبْلَكَ إِلَّا رِجَالًۭا نُّوحِىٓ إِلَيْهِمْ ۖ فَسْـَٔلُوٓا۟ أَهْلَ ٱلذِّكْرِ إِن كُنتُمْ لَا تَعْلَمُونَ","e":"And We sent not before you, [O Muhammad], except men to whom We revealed [the message], so ask the people of the message if you do not know.","j":17,"p":322,"r":278,"h":129,"w":15,"u":"اور ہم نے تم سے پہلے مرد ہی (پیغمبر بنا کر) بھیجے جن کی طرف ہم وحی بھیجتے تھے۔ اگر تم نہیں جانتے تو جو یاد رکھتے ہیں ان سے پوچھ لو","s":"او مونږ له تا نه مخكې رسولان نه دي لېږلي مګر سړي چې مونږ به هغوى ته وحي كوله، نو تاسو د ذكر له خاوندانو (عالمانو) نه تپوس وكړئ كه تاسو نه پوهېږئ","a":"For [even] before thy time, [O Muhammad,] We never sent [as Our apostles] any but [mortal] men, whom We inspired - hence, [tell the deniers of the truth,] “If you do not know this, ask the followers of earlier revelation”"},{"n":8,"g":2491,"t":"وَمَا جَعَلْنَٰهُمْ جَسَدًۭا لَّا يَأْكُلُونَ ٱلطَّعَامَ وَمَا كَانُوا۟ خَٰلِدِينَ","e":"And We did not make the prophets forms not eating food, nor were they immortal [on earth].","j":17,"p":322,"r":278,"h":129,"w":9,"u":"اور ہم نے ان کے لئے ایسے جسم نہیں بنائے تھے کہ کھانا نہ کھائیں اور نہ وہ ہمیشہ رہنے والے تھے","s":"او مونږ هغه (رسولان داسې) جسدونه نه ووګرځولي چې طعام به نه خوري او هغوى تل ژوندي پاتې كېدونكي نه وو","a":"and neither did We endow them with bodies that could dispense with food nor were they immortal."},{"n":9,"g":2492,"t":"ثُمَّ صَدَقْنَٰهُمُ ٱلْوَعْدَ فَأَنجَيْنَٰهُمْ وَمَن نَّشَآءُ وَأَهْلَكْنَا ٱلْمُسْرِفِينَ","e":"Then We fulfilled for them the promise, and We saved them and whom We willed and destroyed the transgressors.","j":17,"p":322,"r":278,"h":129,"w":8,"u":"پھر ہم نے ان کے بارے میں (اپنا) وعدہ سچا کردیا تو ان کو اور جس کو چاہا نجات دی اور حد سے نکل جانے والوں کو ہلاک کردیا","s":"بیا مونږ له دوى سره وعده رښتیا كړه، نو مونږ دوى ته نجات وركړ او هغه چا ته چې زمونږ اراده (د هغوى د نجات) وه او له حد نه تېرېدونكي مو هلاك كړل","a":"In the end, We made good unto them Our promise, and We saved them and all whom We willed [to save], and We destroyed those who had wasted their own selves."},{"n":10,"g":2493,"t":"لَقَدْ أَنزَلْنَآ إِلَيْكُمْ كِتَٰبًۭا فِيهِ ذِكْرُكُمْ ۖ أَفَلَا تَعْقِلُونَ","e":"We have certainly sent down to you a Book in which is your mention. Then will you not reason?","j":17,"p":322,"r":278,"h":129,"w":9,"u":"ہم نے تمہاری طرف ایسی کتاب نازل کی ہے جس میں تمہارا تذکرہ ہے۔ کیا تم نہیں سمجھتے","s":"یقینًا يقینًا مونږ تاسو ته داسې كتاب نازل كړى دى چې په هغه كې ستاسو ذكر (او عزت) دى، ایا نو تاسو عقل نه لرئ؟","a":"[O MEN!] We have now bestowed upon you from on high a divine writ containing all that you ought to bear in mind will you not, then, use your reason?"},{"n":11,"g":2494,"t":"وَكَمْ قَصَمْنَا مِن قَرْيَةٍۢ كَانَتْ ظَالِمَةًۭ وَأَنشَأْنَا بَعْدَهَا قَوْمًا ءَاخَرِينَ","e":"And how many a city which was unjust have We shattered and produced after it another people.","j":17,"p":323,"r":279,"h":129,"w":10,"u":"اور ہم نے بہت سی بستیوں کو جو ستمگار تھیں ہلاک کر مارا اور ان کے بعد اور لوگ پیدا کردیئے","s":"او څومره ډېر كلي چې ظالم وو، مونږ مات (او ټوټې) كړي دي او له هغو نه پس مو نور خلق پیدا كړل","a":"For, how many a community that persisted in evildoing have We dashed into fragments, and raised another people in its stead!"},{"n":12,"g":2495,"t":"فَلَمَّآ أَحَسُّوا۟ بَأْسَنَآ إِذَا هُم مِّنْهَا يَرْكُضُونَ","e":"And when its inhabitants perceived Our punishment, at once they fled from it.","j":17,"p":323,"r":279,"h":129,"w":7,"u":"جب انہوں نے ہمارے (مقدمہ) عذاب کو دیکھا تو لگے اس سے بھاگنے","s":"نو كله چې به يې زمونږ عذاب محسوس كړ، ناڅاپه به هغوى له دغو (كلیو) نه (په ډېره بيړه) تښتېدل","a":"And [every time,] as soon as they began to feel Our punishing might, lo! they tried to flee from it"},{"n":13,"g":2496,"t":"لَا تَرْكُضُوا۟ وَٱرْجِعُوٓا۟ إِلَىٰ مَآ أُتْرِفْتُمْ فِيهِ وَمَسَٰكِنِكُمْ لَعَلَّكُمْ تُسْـَٔلُونَ","e":"[Some angels said], \"Do not flee but return to where you were given luxury and to your homes - perhaps you will be questioned.\"","j":17,"p":323,"r":279,"h":129,"w":10,"u":"مت بھاگو اور جن (نعمتوں) میں تم عیش وآسائش کرتے تھے ان کی اور اپنے گھروں کی طرف لوٹ جاؤ۔ شاید تم سے (اس بارے میں) دریافت کیا جائے","s":"تاسو مه تښتئ، او واپس لاړ شئ هغو (نعمتونو) ته چې تاسو ته په هغو كې خوشحالي دركړى شوې وه او خپلو كورونو ته، د دې لپاره چې له تاسو نه پوښتنه وكړى شي","a":"[and at the same time they seemed to hear a scornful voice]: “Do not try to flee, but return to all that [once] gave you pleasure and corrupted your whole being. and [return] to your homes, so that you might be called to account [for what you have done]!”"},{"n":14,"g":2497,"t":"قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا ظَٰلِمِينَ","e":"They said, \"O woe to us! Indeed, we were wrongdoers.\"","j":17,"p":323,"r":279,"h":129,"w":5,"u":"کہنے لگے ہائے شامت بےشک ہم ظالم تھے","s":"دوى وویل: اى زمونږ هلاكته! بېشكه همدا مونږ ظالمان وو","a":"And they could only cry: “Oh, woe unto us! Verily, we were wrongdoers!”"},{"n":15,"g":2498,"t":"فَمَا زَالَت تِّلْكَ دَعْوَىٰهُمْ حَتَّىٰ جَعَلْنَٰهُمْ حَصِيدًا خَٰمِدِينَ","e":"And that declaration of theirs did not cease until We made them [as] a harvest [mowed down], extinguished [like a fire].","j":17,"p":323,"r":279,"h":129,"w":8,"u":"تو وہ ہمیشہ اسی طرح پکارتے رہے یہاں تک کہ ہم نے ان کو (کھیتی کی طرح) کاٹ کر (اور آگ کی طرح) بجھا کر ڈھیر کردیا","s":"نو تل به د دوى دغه چغه وه تر دې چې مونږ به دوى وګرځول رېبل شوي، مړه یخ پراته","a":"And that cry of theirs did not cease until We caused them to become [like] a field mown down, still and silent as ashes."},{"n":16,"g":2499,"t":"وَمَا خَلَقْنَا ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَ","e":"And We did not create the heaven and earth and that between them in play.","j":17,"p":323,"r":279,"h":129,"w":7,"u":"اور ہم نے آسمان اور زمین کو جو اور (مخلوقات) ان دونوں کے درمیان ہے اس کو لہوولعب کے لئے پیدا نہیں کیا","s":"او مونږ اسمان او ځمكه او هغه څه چې د دواړو په مینځ كې دي (داسې) نه دي پیدا كړي، چې لوبې كوونكي یو","a":"AND [know that] We have not created the heavens and the earth and all that is between them in mere idle play:"},{"n":17,"g":2500,"t":"لَوْ أَرَدْنَآ أَن نَّتَّخِذَ لَهْوًۭا لَّٱتَّخَذْنَٰهُ مِن لَّدُنَّآ إِن كُنَّا فَٰعِلِينَ","e":"Had We intended to take a diversion, We could have taken it from [what is] with Us - if [indeed] We were to do so.","j":17,"p":323,"r":279,"h":129,"w":11,"u":"اگر ہم چاہتے کہ کھیل (کی چیزیں یعنی زن وفرزند) بنائیں تو اگر ہم کو کرنا ہوتا تو ہم اپنے پاس سے بنالیتے","s":"كه مونږ اراده كړې وى چې څه لوبه تماشه جوړه كړو (نو) یقینًا هغه به مو له خپلې خوا نه جوړه كړې وى كه مونږ (دا كار) كوونكي وى","a":"[for,] had We willed to indulge in a pastime, We would indeed have produced it from within Ourselves - if such had been Our will at all!"},{"n":18,"g":2501,"t":"بَلْ نَقْذِفُ بِٱلْحَقِّ عَلَى ٱلْبَٰطِلِ فَيَدْمَغُهُۥ فَإِذَا هُوَ زَاهِقٌۭ ۚ وَلَكُمُ ٱلْوَيْلُ مِمَّا تَصِفُونَ","e":"Rather, We dash the truth upon falsehood, and it destroys it, and thereupon it departs. And for you is destruction from that which you describe.","j":17,"p":323,"r":279,"h":129,"w":14,"u":"بلکہ ہم سچ کو جھوٹ پر کھینچ مارتے ہیں تو وہ اس کا سر توڑ دیتا ہے اور جھوٹ اسی وقت نابود ہوجاتا ہے۔ اور جو باتیں تم بناتے ہو ان سے تمہاری ہی خرابی ہے","s":"بلكې مونږ په حق سره باطل وُلو، نو دا د هغه دماغ راوباسي، نو ناڅاپه هغه ختمېدونكى وي، او تاسو ته د هغه څه په وجه هلاكت دى چې تاسو يې بیانوئ","a":"Nay, but [by the very act of creation] We hurl the truth against falsehood, and it crushes the latter: and lo! it withers away. But woe unto you for all your [attempts at] defining [God] –"},{"n":19,"g":2502,"t":"وَلَهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَمَنْ عِندَهُۥ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِۦ وَلَا يَسْتَحْسِرُونَ","e":"To Him belongs whoever is in the heavens and the earth. And those near Him are not prevented by arrogance from His worship, nor do they tire.","j":17,"p":323,"r":279,"h":129,"w":14,"u":"اور جو لوگ آسمانوں میں اور جو زمین میں ہیں سب اسی کے (مملوک اور اُسی کا مال) ہیں۔ اور جو (فرشتے) اُس کے پاس ہیں وہ اس کی عبادت سے نہ کنیاتے ہیں اور نہ اکتاتے ہیں","s":"او خاص د هغه لپاره دي هغه څوك چې په اسمانونو او ځمكه كې دي، او هغه څوك چې له هغه سره دي، هغوى د هغه له عبادت نه تكبر نه كوي او نه ستومانه كېږي","a":"for, unto Him belong all [beings] that are in the heavens and on earth; and those that are with Him are never too proud to worship Him and never grow weary [thereof]:"},{"n":20,"g":2503,"t":"يُسَبِّحُونَ ٱلَّيْلَ وَٱلنَّهَارَ لَا يَفْتُرُونَ","e":"They exalt [Him] night and day [and] do not slacken.","j":17,"p":323,"r":279,"h":129,"w":5,"u":"رات دن (اُس کی) تسبیح کرتے رہتے ہیں (نہ تھکتے ہیں) نہ اکتاتے ہیں","s":"هغوى شپه او روځ تسبیح وايي، نه څه وقفه كوي","a":"they extol His lim­itless glory by night and by day, never flagging [therein]."},{"n":21,"g":2504,"t":"أَمِ ٱتَّخَذُوٓا۟ ءَالِهَةًۭ مِّنَ ٱلْأَرْضِ هُمْ يُنشِرُونَ","e":"Or have men taken for themselves gods from the earth who resurrect [the dead]?","j":17,"p":323,"r":279,"h":129,"w":7,"u":"بھلا لوگوں نے جو زمین کی چیزوں سے (بعض کو) معبود بنا لیا ہے (تو کیا) وہ ان کو (مرنے کے بعد) اُٹھا کھڑا کریں گے؟","s":"ایا دوى له ځمكې نه نور معبودان نیولي دي چې هغوى ژوندي كول كوي؟","a":"And yet some people choose to worship certain earthly things or beings as deities that [are supposed to] resurrect [the dead; and they fail to realize that],"},{"n":22,"g":2505,"t":"لَوْ كَانَ فِيهِمَآ ءَالِهَةٌ إِلَّا ٱللَّهُ لَفَسَدَتَا ۚ فَسُبْحَٰنَ ٱللَّهِ رَبِّ ٱلْعَرْشِ عَمَّا يَصِفُونَ","e":"Had there been within the heavens and earth gods besides Allah, they both would have been ruined. So exalted is Allah, Lord of the Throne, above what they describe.","j":17,"p":323,"r":279,"h":129,"w":14,"u":"اگر آسمان اور زمین میں خدا کے سوا اور معبود ہوتے تو زمین وآسمان درہم برہم ہوجاتے۔ جو باتیں یہ لوگ بتاتے ہیں خدائے مالک عرش ان سے پاک ہے","s":"كه چېرې په دغو (ځمكه او اسمان) كې له الله نه پرته نور معبودان وى (نو) دواړه به خامخا وران شوي وو، نو الله د عرش مالك، پاك دى له هغو خبرو چې دوى يې بیانوي","a":"had there been in heaven or on earth any deities other than God, both [those realms would surely have fallen into ruin! But limitless in His glory is God, enthroned in His awesome almightiness far] above anything that men may devise by way of definition!"},{"n":23,"g":2506,"t":"لَا يُسْـَٔلُ عَمَّا يَفْعَلُ وَهُمْ يُسْـَٔلُونَ","e":"He is not questioned about what He does, but they will be questioned.","j":17,"p":323,"r":279,"h":129,"w":6,"u":"وہ جو کام کرتا ہے اس کی پرستش نہیں ہوگی اور (جو کام یہ لوگ کرتے ہیں اس کی) ان سے پرستش ہوگی","s":"له هغه نه پوښتنه نشي كېدى د هغه څه په باره كې چې هغه يې كوي او له دوى نه پوښتنه كېږي","a":"He cannot be called to account for whatever He does, whereas they will be called to account:"},{"n":24,"g":2507,"t":"أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةًۭ ۖ قُلْ هَاتُوا۟ بُرْهَٰنَكُمْ ۖ هَٰذَا ذِكْرُ مَن مَّعِىَ وَذِكْرُ مَن قَبْلِى ۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ٱلْحَقَّ ۖ فَهُم مُّعْرِضُونَ","e":"Or have they taken gods besides Him? Say, [O Muhammad], \"Produce your proof. This [Qur'an] is the message for those with me and the message of those before me.\" But most of them do not know the truth, so they are turning away.","j":17,"p":323,"r":279,"h":129,"w":26,"u":"کیا لوگوں نے خدا کو چھوڑ کر اور معبود بنالئے ہیں۔ کہہ دو کہ (اس بات پر) اپنی دلیل پیش کرو۔ یہ (میری اور) میرے ساتھ والوں کی کتاب بھی ہے اور جو مجھ سے پہلے (پیغمبر) ہوئے ہیں۔ ان کی کتابیں بھی ہیں۔ بلکہ (بات یہ ہے کہ) ان اکثر حق بات کو نہیں جانتے اور اس لئے اس سے منہ پھیر لیتے ہیں","s":"ایا دوى له هغه (الله) نه پرته نور معبودان نیولي دي، ته ووایه: تاسو خپل پوخ دلیل راوړئ، دا (وحي) د هغه چا نصیحت دى چې زما سره دي او د هغه چا نصیحت دى چې له ما نه مخكې تېر شوي دي، بلكې د دوى (كافر) اكثره خلق حق نه پېژني، نو دوى مخ ګروځونكي دي","a":"and yet, they choose to worship [imaginary] deities instead of Him! Say [O Prophet]: “Produce an evidence for what you are claiming: this is a reminder [unceasingly voiced] by those who are with me, just as it was a reminder [voiced] by those who came before me.” But nay, most of them do not know the truth, and so they stubbornly turn away [from it]"},{"n":25,"g":2508,"t":"وَمَآ أَرْسَلْنَا مِن قَبْلِكَ مِن رَّسُولٍ إِلَّا نُوحِىٓ إِلَيْهِ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدُونِ","e":"And We sent not before you any messenger except that We revealed to him that, \"There is no deity except Me, so worship Me.\"","j":17,"p":324,"r":279,"h":129,"w":15,"u":"اور جو پیغمبر ہم نےتم سے پہلے بھیجے ان کی طرف یہی وحی بھیجی کہ میرے سوا کوئی معبود نہیں تو میری ہی عبادت کرو","s":"او مونږ له تا نه مخكې هېڅ رسول نه دى لېږلى مګر چې هغه ته به مونږ (دا) وحي كوله چې بېشكه شان دا دى چې له ما نه پرته بل هېڅ حق معبود نشته، لهذا تاسو زما عبادت كوئ","a":"and [this despite the fact that even] before thy time We never sent any apostle without having revealed to him that there is no deity save Me, - [and that,] therefore, you shall worship Me [alone]!"},{"n":26,"g":2509,"t":"وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَٰنُ وَلَدًۭا ۗ سُبْحَٰنَهُۥ ۚ بَلْ عِبَادٌۭ مُّكْرَمُونَ","e":"And they say, \"The Most Merciful has taken a son.\" Exalted is He! Rather, they are [but] honored servants.","j":17,"p":324,"r":279,"h":129,"w":10,"u":"اور کہتے ہیں کہ خدا بیٹا رکھتا ہے۔ وہ پاک ہے (اس کے نہ بیٹا ہے نہ بیٹی) بلکہ (جن کو یہ لوگ اس کے بیٹے بیٹیاں سمجھتے ہیں) وہ اس کے عزت والے بندے ہیں","s":"او دوى (كافر) وايي: الله (د ځان لپاره) اولاد نیولى دى، هغه (له دې نه) پاك دى، بلكې (ملايك خو) ډېر معزز بنده ګان دي","a":"And [yet,] some say, “The Most Gracious has taken unto Himself a son”! Limitless is He in His glory! Nay, [those whom they regard as God’s “offspring” are but His] honoured servants:"},{"n":27,"g":2510,"t":"لَا يَسْبِقُونَهُۥ بِٱلْقَوْلِ وَهُم بِأَمْرِهِۦ يَعْمَلُونَ","e":"They cannot precede Him in word, and they act by His command.","j":17,"p":324,"r":279,"h":129,"w":6,"u":"اس کے آگے بڑھ کر بول نہیں سکتے۔ اور اس کے حکم پر عمل کرتے ہیں","s":"له هغه (الله) نه په خبره كولو كې ړومبى والى نه كوئ او دوى خاص د هغه په حكم عمل كوي","a":"they speak not until He has spoken unto them, and [whenever they act,] they act at His behest."},{"n":28,"g":2511,"t":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ ٱرْتَضَىٰ وَهُم مِّنْ خَشْيَتِهِۦ مُشْفِقُونَ","e":"He knows what is [presently] before them and what will be after them, and they cannot intercede except on behalf of one whom He approves. And they, from fear of Him, are apprehensive.","j":17,"p":324,"r":279,"h":129,"w":15,"u":"جو کچھ ان کے آگے ہوچکا ہے اور پیچھے ہوگا وہ سب سے واقف ہے اور وہ (اس کے پاس کسی کی) سفارش نہیں کرسکتے مگر اس شخص کی جس سے خدا خوش ہو اور وہ اس کی ہیبت سے ڈرتے رہتے ہیں","s":"هغه ته معلوم دي څه چې د دوى په وړاندې دي او څه چې له دوى نه وروسته دي، او دوى شفاعت نشي كولى مګر د هغه چا لپاره چې هغه (الله) ترې راضي وي او دوى خاص د هغه له هیبته وېرېدونكي دي","a":"He knows all that lies open before them and all that is hidden from them: hence, they cannot intercede for any but those whom He has [already] graced with His goodly acceptance, since they themselves stand in reverent awe of Him."},{"n":29,"g":2512,"t":"۞ وَمَن يَقُلْ مِنْهُمْ إِنِّىٓ إِلَٰهٌۭ مِّن دُونِهِۦ فَذَٰلِكَ نَجْزِيهِ جَهَنَّمَ ۚ كَذَٰلِكَ نَجْزِى ٱلظَّٰلِمِينَ","e":"And whoever of them should say, \"Indeed, I am a god besides Him\"- that one We would recompense with Hell. Thus do We recompense the wrongdoers.","j":17,"p":324,"r":279,"h":130,"w":15,"u":"اور جو شخص ان میں سے یہ کہے کہ خدا کے سوا میں معبود ہوں تو اسے ہم دوزخ کی سزا دیں گے اور ظالموں کو ہم ایسی ہی سزا دیا کرتے ہیں","s":"او په دوى كې چې څوك ووايي چې بېشكه زه له هغه (الله) نه پرته معبود یم، نو دغه دى چې مونږ ده ته (د) جهنم جزا وركوو، همداسې مونږ ظالمانو ته جزا وركوو","a":"And if any of them were to say, “Behold, I am deity beside Him” - that one We should requite with hell: thus do We requite all [such] evildoers."},{"n":30,"g":2513,"t":"أَوَلَمْ يَرَ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ كَانَتَا رَتْقًۭا فَفَتَقْنَٰهُمَا ۖ وَجَعَلْنَا مِنَ ٱلْمَآءِ كُلَّ شَىْءٍ حَىٍّ ۖ أَفَلَا يُؤْمِنُونَ","e":"Have those who disbelieved not considered that the heavens and the earth were a joined entity, and We separated them and made from water every living thing? Then will they not believe?","j":17,"p":324,"r":280,"h":130,"w":20,"u":"کیا کافروں نے نہیں دیکھا کہ آسمان اور زمین دونوں ملے ہوئے تھے تو ہم نے جدا جدا کردیا۔ اور تمام جاندار چیزیں ہم نے پانی سے بنائیں۔ پھر یہ لوگ ایمان کیوں نہیں لاتے؟","s":"ایا هغه كسان چې كافران شوي دي په دې نه دي خبر شوي چې یقینًا یقینًا اسمانونه او ځمكه دواړه سره نښتي وو، بیا مونږ دواړه بېل كړل، او مونږ له اوبو څخه هر ژوند شى پیدا كړى دى، ایا نو دوى ایمان نه راوړي؟","a":"ARE, THEN, they who are bent on denying the truth not aware that the heavens and the earth were [once] one single entity, which We then parted asunder? – and [that] We made out of water every living thing? Will they not, then, [begin to] believe?"},{"n":31,"g":2514,"t":"وَجَعَلْنَا فِى ٱلْأَرْضِ رَوَٰسِىَ أَن تَمِيدَ بِهِمْ وَجَعَلْنَا فِيهَا فِجَاجًۭا سُبُلًۭا لَّعَلَّهُمْ يَهْتَدُونَ","e":"And We placed within the earth firmly set mountains, lest it should shift with them, and We made therein [mountain] passes [as] roads that they might be guided.","j":17,"p":324,"r":280,"h":130,"w":13,"u":"اور ہم نے زمین میں پہاڑ بنائے تاکہ لوگوں (کے بوجھ) سے ہلنے (اور جھکنے) نہ لگے اور اس میں کشادہ راستے بنائے تاکہ لوگ ان پر چلیں","s":"او مونږ په ځمكه كې پاخه غرونه پیدا كړي دي چې په دوى باندې (دغه ځمكه) ونه خوځېږي او مونږ په دې كې لارې پیدا كړې دي، چې ارتې پراخه دي، د دې لپاره چې دوى لار ومومي","a":"And [are they not aware that] We have set up firm mountains on earth, lest it sway with them, and [that] We have appointed thereon broad paths, so that they might find their way,"},{"n":32,"g":2515,"t":"وَجَعَلْنَا ٱلسَّمَآءَ سَقْفًۭا مَّحْفُوظًۭا ۖ وَهُمْ عَنْ ءَايَٰتِهَا مُعْرِضُونَ","e":"And We made the sky a protected ceiling, but they, from its signs, are turning away.","j":17,"p":324,"r":280,"h":130,"w":9,"u":"اور آسمان کو محفوظ چھت بنایا۔ اس پر بھی وہ ہماری نشانیوں سے منہ پھیر رہے ہیں","s":"او مونږ اسمان محفوظ چت جوړ كړى دى او دوى (كفار) د هغه (اسمان) له نخښونه مخ ګرځوونكي دي","a":"and [that] We have set up the sky as a canopy well-secured? And yet, they stubbornly turn away from [all] the signs of this [creation],"},{"n":33,"g":2516,"t":"وَهُوَ ٱلَّذِى خَلَقَ ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَ ۖ كُلٌّۭ فِى فَلَكٍۢ يَسْبَحُونَ","e":"And it is He who created the night and the day and the sun and the moon; all [heavenly bodies] in an orbit are swimming.","j":17,"p":324,"r":280,"h":130,"w":12,"u":"اور وہی تو ہے جس نے رات اور دن اور سورج اور چاند کو بنایا۔ (یہ) سب (یعنی سورج اور چاند اور ستارے) آسمان میں (اس طرح چلتے ہیں گویا) تیر رہے ہیں","s":"او دى همغه ذات دى چې شپه او ورځ او لمر او سپوږمۍ يې پیدا كړي دي، هر یو په (خپل) فلك (دايره) كې ګرځي","a":"and [fail to see that] it is He who has created the night and the day and the sun and the moon - all of them floating through space!"},{"n":34,"g":2517,"t":"وَمَا جَعَلْنَا لِبَشَرٍۢ مِّن قَبْلِكَ ٱلْخُلْدَ ۖ أَفَإِي۟ن مِّتَّ فَهُمُ ٱلْخَٰلِدُونَ","e":"And We did not grant to any man before you eternity [on earth]; so if you die - would they be eternal?","j":17,"p":324,"r":280,"h":130,"w":11,"u":"اور (اے پیغمبر) ہم نے تم سے پہلے کسی آدمی کو بقائے دوام نہیں بخشا۔ بھلا اگر تم مرجاؤ تو کیا یہ لوگ ہمیشہ رہیں گے","s":"اومونږ له تا نه مخكې هېڅ یو انسان ته تل ژوندي پاتې كېدل نه دي مقرر كړي، ایا نو كه ته مړ شې، نو دوى به تل ژوندي پاتې كېدونكي وي؟","a":"AND [remind those who deny thee, O Prophet, that] never have We granted life everlasting to any mortal before thee: but do they, perchance, hope that al­though thou must die, they will live forever?”"},{"n":35,"g":2518,"t":"كُلُّ نَفْسٍۢ ذَآئِقَةُ ٱلْمَوْتِ ۗ وَنَبْلُوكُم بِٱلشَّرِّ وَٱلْخَيْرِ فِتْنَةًۭ ۖ وَإِلَيْنَا تُرْجَعُونَ","e":"Every soul will taste death. And We test you with evil and with good as trial; and to Us you will be returned.","j":17,"p":324,"r":280,"h":130,"w":12,"u":"ہر متنفس کو موت کا مزا چکھنا ہے۔ اور ہم تو لوگوں کو سختی اور آسودگی میں آزمائش کے طور پر مبتلا کرتے ہیں۔ اور تم ہماری طرف ہی لوٹ کر آؤ گے","s":"هر یو نفس د مرګ (مزه) څكونكى دى، او مونږ تاسو په شر او خیر سره ازمایو، ازمایل، او تاسو به خاص مونږ ته راوستلى شئ","a":"Every human being is bound to taste death; and We test you [all] through the bad and the good [things of life] by way of trial: and unto Us you all must return."},{"n":36,"g":2519,"t":"وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓا۟ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِى يَذْكُرُ ءَالِهَتَكُمْ وَهُم بِذِكْرِ ٱلرَّحْمَٰنِ هُمْ كَٰفِرُونَ","e":"And when those who disbelieve see you, [O Muhammad], they take you not except in ridicule, [saying], \"Is this the one who insults your gods?\" And they are, at the mention of the Most Merciful, disbelievers.","j":17,"p":325,"r":280,"h":130,"w":17,"u":"اور جب کافر تم کو دیکھتے ہیں تو تم سے استہزاء کرتے ہیں کہ کیا یہی شخص ہے جو تمہارے معبودوں کا ذکر (برائی سے) کیا کرتا ہے حالانکہ وہ خود رحمٰن کے نام سے منکر ہیں","s":"او كله چې تا هغه كسان وویني چې كافران شوي دي (نو) دوى تا نه نیسي مګر مسخره كړى شوى (او په خپل مینځ كې وايي:) ایا دا همغه كس دى چې ستاسو معبودان (په سپكه) یادوي؟ حال دا چې همدوى پخپله د رحمن له یادولو نه انكاري دي","a":"But [thus it is:] whenever they who are bent on denying the truth consider thee, they make thee but a target of their mockery, [saying to one another,] “Is this the one who speaks [so contemptuously] of your gods?” and yet, it is they themselves who, at [every] mention of the Most Gracious, are wont to deny the truth!"},{"n":37,"g":2520,"t":"خُلِقَ ٱلْإِنسَٰنُ مِنْ عَجَلٍۢ ۚ سَأُو۟رِيكُمْ ءَايَٰتِى فَلَا تَسْتَعْجِلُونِ","e":"Man was created of haste. I will show you My signs, so do not impatiently urge Me.","j":17,"p":325,"r":280,"h":130,"w":9,"u":"انسان (کچھ ایسا جلد باز ہے کہ گویا) جلد بازی ہی سے بنایا گیا ہے۔ میں تم لوگوں کو عنقریب اپنی نشانیاں دکھاؤں گا تو تم جلدی نہ کرو","s":"انسان له تلواره پیدا كړى شوى دى، ژر به تاسو ته خپلې نښې وښيم، لهذا له ما نه ژر مطالبه مه كوئ","a":"Man is a creature of haste; [but in time] I shall make obvious to you [the truth of] My mes­sages: do not, then, ask Me to hasten [it]!"},{"n":38,"g":2521,"t":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ","e":"And they say, \"When is this promise, if you should be truthful?\"","j":17,"p":325,"r":280,"h":130,"w":7,"u":"اور کہتے ہیں کہ اگر تم سچے ہو تو (جس عذاب کا) یہ وعید (ہے وہ) کب (آئے گا)؟","s":"او دوى وايي: دغه وعده به كله وي، كه تاسو رښتیني یئ؟","a":"But they [who reject My messages are wont to] ask, “When is that promise [of God’s judgment] to be fulfilled? [Answer this, O you who believe in it,] if you are men of truth!”"},{"n":39,"g":2522,"t":"لَوْ يَعْلَمُ ٱلَّذِينَ كَفَرُوا۟ حِينَ لَا يَكُفُّونَ عَن وُجُوهِهِمُ ٱلنَّارَ وَلَا عَن ظُهُورِهِمْ وَلَا هُمْ يُنصَرُونَ","e":"If those who disbelieved but knew the time when they will not avert the Fire from their faces or from their backs and they will not be aided...","j":17,"p":325,"r":280,"h":130,"w":16,"u":"اے کاش کافر اس وقت کو جانیں جب وہ اپنے مونہوں پر سے (دوزخ کی) آگ کو روک نہ سکیں گے اور نہ اپنی پیٹھوں پر سے اور نہ ان کا کوئی مددگار ہوگا","s":"كه كافران شوي كسان په هغه وخت كې پوه شي چې له خپلو مخونو نه به اور نشي منع كولى او نه له خپلو شاګانو او نه به د دوى مرسته كولى شي","a":"If they but knew - they who are bent on deny­ing the truth - [that there will come] a time when they will not be able to ward off the fire from their faces, nor from their backs, and will not find any succour!"},{"n":40,"g":2523,"t":"بَلْ تَأْتِيهِم بَغْتَةًۭ فَتَبْهَتُهُمْ فَلَا يَسْتَطِيعُونَ رَدَّهَا وَلَا هُمْ يُنظَرُونَ","e":"Rather, it will come to them unexpectedly and bewilder them, and they will not be able to repel it, nor will they be reprieved.","j":17,"p":325,"r":280,"h":130,"w":10,"u":"بلکہ قیامت ان پر ناگہاں آ واقع ہوگی۔ اور ان کے ہوش کھو دے گی۔ پھر نہ تو وہ اس کو ہٹا سکیں گے اور نہ ان کو مہلت دی جائے گی","s":"بلكې دا (قیامت) به په دوى ناڅاپه راشي، نو دوى به حیران كړي، بیا دوى د هغه د لرې كولو طاقت نه لري او نه به دوى ته مهلت وركاوه شي","a":"Nay, but [the Last Hour] will come upon them of a sudden, and will stupefy them: and they will be unable to avert it, and neither wilt they be allowed any respite."},{"n":41,"g":2524,"t":"وَلَقَدِ ٱسْتُهْزِئَ بِرُسُلٍۢ مِّن قَبْلِكَ فَحَاقَ بِٱلَّذِينَ سَخِرُوا۟ مِنْهُم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","e":"And already were messengers ridiculed before you, but those who mocked them were enveloped by what they used to ridicule.","j":17,"p":325,"r":280,"h":130,"w":13,"u":"اور تم سے پہلے بھی پیغمبروں کے ساتھ استہزاء ہوتا رہا ہے تو جو لوگ ان میں سے تمسخر کیا کرتے تھے ان کو اسی (عذاب) نے جس کی ہنسی اُڑاتے تھے آگھیرا","s":"او یقینًا یقینًا له تا نه مخكې رسولانو پورې استهزاګانې شوې دي، نو ګېر كړل هغو كسانو لره چې په دوى پورې به يې مسخرې كولې، هغه شي چې دوى به ورپورې استهزا كوله","a":"And, indeed, [O Muhammad, even] before thy time have [God’s] apostles been derided - but those who scoffed at them were [in the end] overwhelmed by the very thing which they had been wont to deride."},{"n":42,"g":2525,"t":"قُلْ مَن يَكْلَؤُكُم بِٱلَّيْلِ وَٱلنَّهَارِ مِنَ ٱلرَّحْمَٰنِ ۗ بَلْ هُمْ عَن ذِكْرِ رَبِّهِم مُّعْرِضُونَ","e":"Say, \"Who can protect you at night or by day from the Most Merciful?\" But they are, from the remembrance of their Lord, turning away.","j":17,"p":325,"r":281,"h":130,"w":14,"u":"کہو کہ رات اور دن میں خدا سے تمہاری کون حفاظت کرسکتا ہے؟ بات یہ ہے کہ اپنے پروردگار کی یاد سے منہ پھیرے ہوئے ہیں","s":"(دوى ته) ته ووایه: تاسو د رحمن (له عذاب) نه د شپې او د ورځې څوك ساتي؟ بلكې دوى دخپل رب له ذكر نه مخ ګرځوونكي دي","a":"Say: “Who could protect you, by night or by day, from the Most Gracious?” And yet, from a remembrance of their Sustainer do they stubbornly turn away!"},{"n":43,"g":2526,"t":"أَمْ لَهُمْ ءَالِهَةٌۭ تَمْنَعُهُم مِّن دُونِنَا ۚ لَا يَسْتَطِيعُونَ نَصْرَ أَنفُسِهِمْ وَلَا هُم مِّنَّا يُصْحَبُونَ","e":"Or do they have gods to defend them other than Us? They are unable [even] to help themselves, nor can they be protected from Us.","j":17,"p":325,"r":281,"h":130,"w":15,"u":"کیا ہمارے سوا ان کے اور معبود ہیں کہ ان کو (مصائب سے) بچاسکیں۔ وہ آپ اپنی مدد تو کر ہی نہیں سکتے اور نہ ہم سے پناہ ہی دیئے جائیں گے","s":"ایا د دوى لپاره نور معبودان شته چې زمونږ نه پرته دوى ساتي؟ هغوى د خپلو ځانونو د مرستې طاقت نه لري او نه دوى زمونږ (د عذاب) نه ساتل كېږي","a":"Do they [really think that they] have deities that could shield them from Us? Those [alleged dei­ties] are not [even] able to succour themselves: hence, neither can they [who worship them hope to] be aided [by them] against Us."},{"n":44,"g":2527,"t":"بَلْ مَتَّعْنَا هَٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ طَالَ عَلَيْهِمُ ٱلْعُمُرُ ۗ أَفَلَا يَرَوْنَ أَنَّا نَأْتِى ٱلْأَرْضَ نَنقُصُهَا مِنْ أَطْرَافِهَآ ۚ أَفَهُمُ ٱلْغَٰلِبُونَ","e":"But, [on the contrary], We have provided good things for these [disbelievers] and their fathers until life was prolonged for them. Then do they not see that We set upon the land, reducing it from its borders? So it is they who will overcome?","j":17,"p":325,"r":281,"h":130,"w":20,"u":"بلکہ ہم ان لوگوں کو اور ان کے باپ دادا کو متمتع کرتے رہے یہاں تک کہ (اسی حالت میں) ان کی عمریں بسر ہوگئیں۔ کیا یہ نہیں دیکھتے کہ ہم زمین کو اس کے کناروں سے گھٹاتے چلے آتے ہیں۔ تو کیا یہ لوگ غلبہ پانے والے ہیں؟","s":"بلكې مونږ دوى ته او د دوى پلرونو ته نفع وركړه تر دې چې په دوى باندې عمر اوږد شو، ایا نو دوى نه ویني چې بېشكه مونږ ځمكې ته راځو، د هغې له غاړو نه هغه كموو، ایا نو هم دوى غالب دي؟","a":"Nay, We have allowed these [sinners] – as [We allowed] their forebears – to enjoy the good things of life for a great length of time: but then – have they never yet seen how We visit the earth [with Our punishment], gradually depriving it of all that is best thereon? Can they, then, [hope to] be the winners?"},{"n":45,"g":2528,"t":"قُلْ إِنَّمَآ أُنذِرُكُم بِٱلْوَحْىِ ۚ وَلَا يَسْمَعُ ٱلصُّمُّ ٱلدُّعَآءَ إِذَا مَا يُنذَرُونَ","e":"Say, \"I only warn you by revelation.\" But the deaf do not hear the call when they are warned.","j":17,"p":326,"r":281,"h":130,"w":12,"u":"کہہ دو کہ میں تم کو حکم خدا کے مطابق نصیحت کرتا ہوں۔ اور بہروں کوجب نصیحت کی جائے تو وہ پکار کر سنتے ہی نہیں","s":"ته (دوى ته) ووایه: یقینًا زه تاسو يواځې په وحي سره وېروم او كاڼه بلنه نه اوري كله چې هغوى وېرولى شي","a":"SAY [unto all men]: “I but warn you on the strength of divine revelation!” But the deaf [of heart] will not hearken to this call, however often they are warned."},{"n":46,"g":2529,"t":"وَلَئِن مَّسَّتْهُمْ نَفْحَةٌۭ مِّنْ عَذَابِ رَبِّكَ لَيَقُولُنَّ يَٰوَيْلَنَآ إِنَّا كُنَّا ظَٰلِمِينَ","e":"And if [as much as] a whiff of the punishment of your Lord should touch them, they would surely say, \"O woe to us! Indeed, we have been wrongdoers.\"","j":17,"p":326,"r":281,"h":130,"w":11,"u":"اور اگر ان کو تمہارے پروردگار کا تھوڑا سا عذاب بھی پہنچے تو کہنے لگیں کہ ہائے کم بختی ہم بےشک ستمگار تھے","s":"او كه یقینًا دوى ته ستا د رب له عذاب نه لږ تپ ورسېږي، (نو) دوى به خامخا لازمًا وايي: اى زمونږ هلاكته! بېشكه هم مونږ ظالمان وو","a":"And yet, if but a breath of thy Sustainer’s chastisement touches them, they are sure to cry, “Oh, woe unto us! Verily, we were evildoers!”"},{"n":47,"g":2530,"t":"وَنَضَعُ ٱلْمَوَٰزِينَ ٱلْقِسْطَ لِيَوْمِ ٱلْقِيَٰمَةِ فَلَا تُظْلَمُ نَفْسٌۭ شَيْـًۭٔا ۖ وَإِن كَانَ مِثْقَالَ حَبَّةٍۢ مِّنْ خَرْدَلٍ أَتَيْنَا بِهَا ۗ وَكَفَىٰ بِنَا حَٰسِبِينَ","e":"And We place the scales of justice for the Day of Resurrection, so no soul will be treated unjustly at all. And if there is [even] the weight of a mustard seed, We will bring it forth. And sufficient are We as accountant.","j":17,"p":326,"r":281,"h":130,"w":22,"u":"اور ہم قیامت کے دن انصاف کی ترازو کھڑی کریں گے تو کسی شخص کی ذرا بھی حق تلفی نہ کی جائے گی۔ اور اگر رائی کے دانے کے برابر بھی (کسی کا عمل) ہوگا تو ہم اس کو لاحاضر کریں گے۔ اور ہم حساب کرنے کو کافی ہیں","s":"او د قیامت په ورځ به مونږ ډېر د انصاف تلې كېږدو، نو په هېڅ نفس باندې به هېڅ شى ظلم ونه كړى شي او كه دا (عمل) د اوري د دانې په وزن وي مونږ به هغه راوړو او هم مونږ حساب كوونكي بس یو","a":"But We shall set up just balance-scales on Resurrection Day, and no human being shall be wrong­ed in the least: for though there be [in him but] the weight of a mustard-seed [of good or evil], We shall bring it forth; and none can take count as We do!"},{"n":48,"g":2531,"t":"وَلَقَدْ ءَاتَيْنَا مُوسَىٰ وَهَٰرُونَ ٱلْفُرْقَانَ وَضِيَآءًۭ وَذِكْرًۭا لِّلْمُتَّقِينَ","e":"And We had already given Moses and Aaron the criterion and a light and a reminder for the righteous","j":17,"p":326,"r":281,"h":130,"w":8,"u":"اور ہم نے موسیٰ اور ہارون کو (ہدایت اور گمراہی میں) فرق کر دینے والی اور (سرتاپا) روشنی اور نصیحت (کی کتاب) عطا کی (یعنی) پرہیز گاروں کے لئے","s":"او یقینًا یقینًا مونږ موسٰى او هارون ته فرقان (حق او باطل سره بېلوونكى كتاب) او رڼا او د متقیانو لپاره ذكر (نصیحت) وركړى و","a":"AND, INDEED, We vouchsafed unto Moses and Aaron [Our revelation as] the standard by which to discern the true from the false, and as a [guiding] light and a reminder for the God-conscious"},{"n":49,"g":2532,"t":"ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم بِٱلْغَيْبِ وَهُم مِّنَ ٱلسَّاعَةِ مُشْفِقُونَ","e":"Who fear their Lord unseen, while they are of the Hour apprehensive.","j":17,"p":326,"r":281,"h":130,"w":8,"u":"جو بن دیکھے اپنے پروردگار سے ڈرتے ہیں اور قیامت کا بھی خوف رکھتے ہیں","s":"هغه كسان چې له خپل رب نه خشیت (وېره) كوي بې له ليدلو او دوى د قیامت څخه وېرېدونكي دي","a":"who stand in awe of their Sustainer although He is beyond the reach of human perception, and who tremble at the thought of the Last Hour."},{"n":50,"g":2533,"t":"وَهَٰذَا ذِكْرٌۭ مُّبَارَكٌ أَنزَلْنَٰهُ ۚ أَفَأَنتُمْ لَهُۥ مُنكِرُونَ","e":"And this [Qur'an] is a blessed message which We have sent down. Then are you with it unacquainted?","j":17,"p":326,"r":281,"h":130,"w":8,"u":"یہ مبارک نصیحت ہے جسے ہم نے نازل فرمایا ہے تو کیا تم اس سے انکار کرتے ہو؟","s":"او دا (قرآن) مبارك نصیحت دى چې مونږ دا نازل كړى دى، ایا نو تاسو له ده نه انكار كوونكي یئ","a":"And [like those earlier revelations,] this one, too, is a blessed reminder which We have bestowed from on high: will you, then, disavow it?"},{"n":51,"g":2534,"t":"۞ وَلَقَدْ ءَاتَيْنَآ إِبْرَٰهِيمَ رُشْدَهُۥ مِن قَبْلُ وَكُنَّا بِهِۦ عَٰلِمِينَ","e":"And We had certainly given Abraham his sound judgement before, and We were of him well-Knowing","j":17,"p":326,"r":282,"h":131,"w":10,"u":"اور ہم نے ابراہیمؑ کو پہلے ہی سے ہدایت دی تھی اور ہم ان کے حال سے واقف تھے","s":"او یقینًا یقینًا مونږ ابراهیم ته د هغه هدایت له دې نه مخكې وركړى و او مونږ په هغه باندې پوه وو","a":"AND, INDEED, long before [the time of Moses] We vouchsafed unto Abraham his consciousness of what is right; and We were aware of [what moved] him"},{"n":52,"g":2535,"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا هَٰذِهِ ٱلتَّمَاثِيلُ ٱلَّتِىٓ أَنتُمْ لَهَا عَٰكِفُونَ","e":"When he said to his father and his people, \"What are these statues to which you are devoted?\"","j":17,"p":326,"r":282,"h":131,"w":11,"u":"جب انہوں نے اپنے باپ اور اپنی قوم کے لوگوں سے کہا یہ کیا مورتیں ہیں جن (کی پرستش) پر تم معتکف (وقائم) ہو؟","s":"كله چې هغه خپل پلار او خپل قوم ته وویل: دا بتان، څه شى دى هغه چې تاسو دوى ته په عبادت ټینګ ولاړ یئ؟","a":"when he said unto his father and his people, “What are these images to which you are so intensely devoted?”"},{"n":53,"g":2536,"t":"قَالُوا۟ وَجَدْنَآ ءَابَآءَنَا لَهَا عَٰبِدِينَ","e":"They said, \"We found our fathers worshippers of them.\"","j":17,"p":326,"r":282,"h":131,"w":5,"u":"وہ کہنے لگے کہ ہم نے اپنے باپ دادا کو ان کی پرستش کرتے دیکھا ہے","s":"هغوى وویل: مونږ خپل پلرونه دوى ته عبادت كوونكي موندلي دي","a":"They answered: “We found our forefathers worshipping them.”"},{"n":54,"g":2537,"t":"قَالَ لَقَدْ كُنتُمْ أَنتُمْ وَءَابَآؤُكُمْ فِى ضَلَٰلٍۢ مُّبِينٍۢ","e":"He said, \"You were certainly, you and your fathers, in manifest error.\"","j":17,"p":326,"r":282,"h":131,"w":8,"u":"(ابراہیم نے) کہا کہ تم بھی (گمراہ ہو) اور تمہارے باپ دادا بھی صریح گمراہی میں پڑے رہے","s":"هغه وویل: یقینًا یقینًا تاسو او ستاسو پلرونه په ښكاره ګمراهۍ كې یئ","a":"Said he: “Indeed, you and your forefathers have obviously gone astray!”"},{"n":55,"g":2538,"t":"قَالُوٓا۟ أَجِئْتَنَا بِٱلْحَقِّ أَمْ أَنتَ مِنَ ٱللَّٰعِبِينَ","e":"They said, \"Have you come to us with truth, or are you of those who jest?\"","j":17,"p":326,"r":282,"h":131,"w":7,"u":"وہ بولے کیا تم ہمارے پاس (واقعی) حق لائے ہو یا (ہم سے) کھیل (کی باتیں) کرتے ہو؟","s":"هغوى وویل: ایا تا مونږ ته حق راوړى دى، یا ته له لوبو كوونكو څخه يې؟","a":"They asked: “Hast thou come unto us [with this claim] in all earnest - or art thou one of those jesters?”"},{"n":56,"g":2539,"t":"قَالَ بَل رَّبُّكُمْ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ٱلَّذِى فَطَرَهُنَّ وَأَنَا۠ عَلَىٰ ذَٰلِكُم مِّنَ ٱلشَّٰهِدِينَ","e":"He said, \"[No], rather, your Lord is the Lord of the heavens and the earth who created them, and I, to that, am of those who testify.","j":17,"p":326,"r":282,"h":131,"w":13,"u":"(ابراہیم نے) کہا (نہیں) بلکہ تمہارا پروردگار آسمانوں اور زمین کا پروردگار ہے جس نے ان کو پیدا کیا ہے۔ اور میں اس (بات) کا گواہ (اور اسی کا قائل) ہوں","s":"هغه وویل: بلكې ستاسو رب د اسمانونو او ځمكې رب دى۔ هغه (رب) چې دغه يې پیدا كړي دي او زه په دې باندې له ګواهانو ځنې یم","a":"He answered: “Nay, but your [true] Sustainer is the Sustainer of the heavens and the earth - He who has brought them into being: and I am one of those who bear witness to this [truth]!”"},{"n":57,"g":2540,"t":"وَتَٱللَّهِ لَأَكِيدَنَّ أَصْنَٰمَكُم بَعْدَ أَن تُوَلُّوا۟ مُدْبِرِينَ","e":"And [I swear] by Allah, I will surely plan against your idols after you have turned and gone away.\"","j":17,"p":326,"r":282,"h":131,"w":7,"u":"اور خدا کی قسم جب تم پیٹھ پھیر کر چلے جاؤ گے تو میں تمہارے بتوں سے ایک چال چلوں گا","s":"او په الله قسم دى چې هرومرو خامخا به زه ستاسو له بتانو سره یو چال چلوم وروسته له دې چې تاسو وګرځئ شاكوونكي","a":"And [he added to himself.] “By God, I shall most certainly bring about the downfall of your idols as soon as you have turned your backs and gone away!”"},{"n":58,"g":2541,"t":"فَجَعَلَهُمْ جُذَٰذًا إِلَّا كَبِيرًۭا لَّهُمْ لَعَلَّهُمْ إِلَيْهِ يَرْجِعُونَ","e":"So he made them into fragments, except a large one among them, that they might return to it [and question].","j":17,"p":327,"r":282,"h":131,"w":8,"u":"پھر ان کو توڑ کر ریزہ ریزہ کردیا مگر ایک بڑے (بت) کو (نہ توڑا) تاکہ وہ اس کی طرف رجوع کریں","s":"نو هغه، دغه (بتان) ټوټې ټوټې كړل د هغو له لوى نه غير (چې هغه يې پرېښود)، د دې لپاره چې هغوى همده ته رجوع وكړي","a":"And then he broke those [idols] to pieces, [all] save the biggest of them, so that they might [be able to] turn to it."},{"n":59,"g":2542,"t":"قَالُوا۟ مَن فَعَلَ هَٰذَا بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ ٱلظَّٰلِمِينَ","e":"They said, \"Who has done this to our gods? Indeed, he is of the wrongdoers.\"","j":17,"p":327,"r":282,"h":131,"w":8,"u":"کہنے لگے کہ ہمارے معبودوں کے ساتھ یہ معاملہ کس نے کیا؟ وہ تو کوئی ظالم ہے","s":"دوى وویل: زمونږ له معبودانو سره دا كار چا كړى دى، بېشكه دغه كس یقینًا له ظالمانو ځنې دى","a":"[When they saw what had happened,] they said: “Who has done this to our gods? Verily, one of the worst wrongdoers is he!”"},{"n":60,"g":2543,"t":"قَالُوا۟ سَمِعْنَا فَتًۭى يَذْكُرُهُمْ يُقَالُ لَهُۥٓ إِبْرَٰهِيمُ","e":"They said, \"We heard a young man mention them who is called Abraham.\"","j":17,"p":327,"r":282,"h":131,"w":7,"u":"لوگوں نے کہا کہ ہم نے ایک جوان کو ان کا ذکر کرتے ہوئے سنا ہے اس کو ابراہیم کہتے ہیں","s":"دوى وویل: مونږ له یو زلمي نه اورېدلي وو، چې دوى به يې (په سپكه) یادول، هغه ته ابراهیم ویلى شي","a":"Said some [of them]: “We heard a youth speak of these [gods with scorn]: he is called Abraham.”"},{"n":61,"g":2544,"t":"قَالُوا۟ فَأْتُوا۟ بِهِۦ عَلَىٰٓ أَعْيُنِ ٱلنَّاسِ لَعَلَّهُمْ يَشْهَدُونَ","e":"They said, \"Then bring him before the eyes of the people that they may testify.\"","j":17,"p":327,"r":282,"h":131,"w":8,"u":"وہ بولے کہ اسے لوگوں کے سامنے لاؤ تاکہ گواہ رہیں","s":"هغوى وویل: نو هغه د خلقو د سترګو په وړاندې راولئ، د دې لپاره چې هغوى (يې وویني او) ګواهي وكړي","a":"[The others] said: “Then bring him before the peoples eyes, so that they might bear witness [against him]!”"},{"n":62,"g":2545,"t":"قَالُوٓا۟ ءَأَنتَ فَعَلْتَ هَٰذَا بِـَٔالِهَتِنَا يَٰٓإِبْرَٰهِيمُ","e":"They said, \"Have you done this to our gods, O Abraham?\"","j":17,"p":327,"r":282,"h":131,"w":6,"u":"(جب ابراہیم آئے تو) بت پرستوں نے کہا کہ ابراہیم بھلا یہ کام ہمارے معبودوں کے ساتھ تم نے کیا ہے؟","s":"ويې ويل: اى ابراهیمه! ایا تا زمونږ له معبودانو سره دا كار كړى دى؟","a":"[And when he came.] they asked: “Hast thou done this to our gods, O Abraham?”"},{"n":63,"g":2546,"t":"قَالَ بَلْ فَعَلَهُۥ كَبِيرُهُمْ هَٰذَا فَسْـَٔلُوهُمْ إِن كَانُوا۟ يَنطِقُونَ","e":"He said, \"Rather, this - the largest of them - did it, so ask them, if they should [be able to] speak.\"","j":17,"p":327,"r":282,"h":131,"w":9,"u":"(ابراہیم نے) کہا (نہیں) بلکہ یہ ان کے اس بڑے (بت) نے کیا (ہوگا) ۔ اگر یہ بولتے ہیں تو ان سے پوچھ لو","s":"هغه وویل: بلكې دا كار د دوى دې مشر (لوى بت) كړى دى، نو تاسو له دوى نه پوښتنه وكړئ كه دوى خبرې كوي","a":"He answered: “Nay, it was this one, the big­gest of them, that did it: but ask them [yourselves] - provided they can speak!”"},{"n":64,"g":2547,"t":"فَرَجَعُوٓا۟ إِلَىٰٓ أَنفُسِهِمْ فَقَالُوٓا۟ إِنَّكُمْ أَنتُمُ ٱلظَّٰلِمُونَ","e":"So they returned to [blaming] themselves and said [to each other], \"Indeed, you are the wrongdoers.\"","j":17,"p":327,"r":282,"h":131,"w":7,"u":"انہوں نے اپنے دل غور کیا تو آپس میں کہنے لگے بےشک تم ہی بےانصاف ہو","s":"نو دوى خپلو نفسونو ته رجوع وكړه، بیا يې وویل: بېشكه هم تاسو ظالمان یئ","a":"And so they turned upon one another, saying, “Behold, it is you who are doing wrong.”"},{"n":65,"g":2548,"t":"ثُمَّ نُكِسُوا۟ عَلَىٰ رُءُوسِهِمْ لَقَدْ عَلِمْتَ مَا هَٰٓؤُلَآءِ يَنطِقُونَ","e":"Then they reversed themselves, [saying], \"You have already known that these do not speak!\"","j":17,"p":327,"r":282,"h":131,"w":9,"u":"پھر (شرمندہ ہو کر) سر نیچا کرلیا (اس پر بھی ابراہیم سے کہنے لگے کہ) تم جانتے ہو یہ بولتے نہیں","s":"بیا دوى په خپلو سرونو نسكور كړى شول (ويې ویل:) یقینًا یقینًا ته پوه يې چې دا (بتان) خبرې نشي كولى","a":"But then they relapsed into their former way of thinking and said: “Thou knowest very well that these [idols] cannot speak!”"},{"n":66,"g":2549,"t":"قَالَ أَفَتَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكُمْ شَيْـًۭٔا وَلَا يَضُرُّكُمْ","e":"He said, \"Then do you worship instead of Allah that which does not benefit you at all or harm you?","j":17,"p":327,"r":282,"h":131,"w":11,"u":"(ابراہیم نے) کہا پھر تم خدا کو چھوڑ کر کیوں ایسی چیزوں کو پوجتے ہو جو نہ تمہیں کچھ فائدہ دے سکیں اور نقصان پہنچا سکیں؟","s":"هغه وویل: ایا نو تاسو له الله نه پرته د هغه څه عبادت كوئ چې تاسو ته هېڅ نفع نشي رسولى او نه تاسو ته ضرر رسولى شي","a":"Said [Abraham]: “Do you then worship, instead of God, something that cannot benefit you in any way, nor harm you?"},{"n":67,"g":2550,"t":"أُفٍّۢ لَّكُمْ وَلِمَا تَعْبُدُونَ مِن دُونِ ٱللَّهِ ۖ أَفَلَا تَعْقِلُونَ","e":"Uff to you and to what you worship instead of Allah. Then will you not use reason?\"","j":17,"p":327,"r":282,"h":131,"w":10,"u":"تف ہے تم پر اور جن کو تم خدا کے سوا پوجتے ہو ان پر بھی کیا تم عقل نہیں رکھتے؟","s":"اُف په تاسو او په هغو چې تاسو يې له الله نه پرته عبادت كوئ، ایا نو تاسو عقل نه لرئ","a":"Fie upon you and upon all that you worship instead of God! Will you not, then, use your reason?”"},{"n":68,"g":2551,"t":"قَالُوا۟ حَرِّقُوهُ وَٱنصُرُوٓا۟ ءَالِهَتَكُمْ إِن كُنتُمْ فَٰع